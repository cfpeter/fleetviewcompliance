# ── Supabase ────────────────────────────────────────────────
# Two projects: a dev one and a production one. Unlike the sibling project,
# local dev must never point at production — this database holds other
# carriers' driver medical certificates.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Migrations and tests only — NEVER read by the Worker.
# Supabase dashboard -> Connect -> Session pooler (port 5432, not 6543).
# The direct db.<ref> host is IPv6-only and this network is IPv4-only, so it
# fails with a misleading ENETUNREACH rather than a clear error.
# EASIEST: paste the whole URI from Connect -> Session pooler here and
# leave the four fields below blank. Contains the password, so it is secret.
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
# Looks like postgres.abcdefghijklmnop — the project ref is part of the username.
SUPABASE_DB_USER=
SUPABASE_DB_NAME=postgres
# SECRET
SUPABASE_DB_PASSWORD=

# ── Site ────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://fleetviewcompliance.com

# ── FMCSA ───────────────────────────────────────────────────
# QCMobile webKey. One already exists from the earlier project.
FMCSA_WEBKEY=

# ── Notifications ───────────────────────────────────────────
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# In dev, every email and SMS is redirected here instead of the real
# recipient. Unset in production. Sending a real carrier a test alert
# about a deadline they do not have is a trust-losing bug.
DEV_REDIRECT_EMAIL=
DEV_REDIRECT_PHONE=

# 'production' is the ONLY value that lets a message reach a real recipient.
# Anything else redirects everything to the two addresses above, and if those
# are blank, sends nothing at all. See docs/OPERATIONS.md.
DEPLOY_ENV=development

# The privileged key. A cron run has no signed-in user to act as and must read
# across every carrier; /app/admin/claims is the second and only other place it
# is legitimate, and it reads this ONLY after the allowlist below has said yes.
# Never in a page a carrier can reach.
SUPABASE_SECRET_KEY=

# Who may open the operator screens under /app/admin. User ids or account email
# addresses, separated by commas or spaces. A user id is the stronger form; an
# email only matches a CONFIRMED account.
#
# FAILS CLOSED. Empty, unset, or full of anything this does not recognise means
# NOBODY gets in — '*' is not a wildcard here, it is an entry that matches no
# one. A non-operator gets the same bare 404 a missing page gives, so the screen
# does not announce itself. Production is NOT behind Cloudflare Access; this
# variable is the whole gate. See src/lib/admin/operators.ts.
ADMIN_OPERATORS=

# Shared secret for the scheduled digest/poll endpoints. Without it the endpoint
# refuses to run rather than defaulting to unauthenticated.
CRON_SECRET=

# USDOT claim verification. At least 32 characters, unique per environment.
# A verification code is six digits, so a bare SHA-256 of one is a million
# digests away from plaintext — this value is what makes a stolen hash useless.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAIM_CODE_PEPPER=

# ── Stripe (billing) ────────────────────────────────────────
# All three are SECRETS and belong in `wrangler secret`, never in a
# deployed .env. See docs/OPERATIONS.md "Billing" for how to create the
# price — it must be a VOLUME-tiered price or the invoice will not match
# the pricing page.
#
# NOT read through import.meta.env, on purpose: Vite inlines that whole
# object into the built bundle, secrets included. src/lib/billing/config.ts
# reads the Worker env and falls back to process.env only. So `astro dev`
# does NOT see these from this file — export them in your shell, or run the
# built Worker under `wrangler dev`, where .dev.vars reaches it properly.
#
# A LIVE key (sk_live_…) is REFUSED unless DEPLOY_ENV=production, so a
# button press on the dev Worker cannot create a real subscription.
STRIPE_SECRET_KEY=
# The recurring price customers are subscribed to. Volume tiers: up to 4
# units a flat $29, then $6 per unit for every unit. tests/billing.test.ts
# checks that shape against monthlyPrice() for every fleet size.
STRIPE_PRICE_ID=
# Signing secret for the endpoint at /api/stripe/webhook. Without it the
# webhook refuses every event rather than trusting unsigned ones.
STRIPE_WEBHOOK_SECRET=
