---
/**
 * The signed-in shell. Never indexed, never cached.
 */
import '../styles/global.css'

interface Props {
  title: string
  subtitle?: string
}
const { title, subtitle } = Astro.props
const path = Astro.url.pathname

/**
 * Ten flat sections in one row was too many to scan, and the people scanning are
 * Glendale and Sun Valley fleet owners who often read English as a second
 * language. That fact decided every call below, and it decided them differently
 * on a desktop and on a phone.
 *
 * NO CATEGORY MENU, ANYWHERE. A reader hunting for a word he only half
 * recognises must be able to reach that word without first naming the box it
 * lives in. "Work", "Fleet", "Money" — the category name is the one piece of
 * English he does not have. So nothing here is ever filed under a heading, and
 * the group headings that were tried are still gone for the same reason: the
 * children are visible, so the heading had no job left to do.
 *
 * ON A DESKTOP the sections stay on screen, grouped by spacing alone:
 *
 *   Deadlines Reminders │ Trucks Drivers │ Dispatch Loads Customers │ Driver pay IFTA │ Proof
 *
 * Deadlines first, then the two things deadlines hang off. Then the day's work,
 * then the money, then the page you hand to somebody else. Free to read, costs
 * no taps, needs none of the client JavaScript this app does not ship.
 *
 * ON A PHONE that row cost 201px of sticky header at 320px and 169px at 375px,
 * on every single page, and the owner said so: the header was eating the screen
 * he had come to read. So below `sm` the row folds into one `<details>`.
 *
 * That is not a retreat from the paragraph above, and the difference is the
 * whole point. A category menu asks the reader for a word before it will show
 * him anything. This one asks for nothing: one tap anywhere on the bar and all
 * ten sections are there, in a column, whole words, same order as the desktop
 * row, no headings between them. There is no category name in it to not know.
 *
 * THE CLOSED BAR NAMES THE PAGE HE IS ON — "Deadlines", "Loads" — in the same
 * brand-tinted pill the row uses to mark the current section, with a chevron
 * next to it. A bare hamburger would have told him nothing; this way the header
 * still answers "where am I" at a glance, which is most of what he was reading
 * it for, and the mark he learns here is the same mark he sees beside the
 * current row once the list is open. The chevron carries the "this opens" job
 * because it is not a word in any language and so cannot be the wrong one.
 *
 * Billing, Settings and Sign out leave the phone bar and sit at the foot of the
 * open list, under a hairline, so the closed header is one line and nothing is
 * stranded. On a desktop they stay where they were, beside the wordmark.
 *
 * `<details>` and no script: it opens on touch and from the keyboard on its own,
 * and because every navigation here is a real page load, the menu is shut again
 * the moment he lands. The shell still ships zero client JavaScript.
 *
 * LABELS are the words an owner says out loud, not the words a TMS prints.
 * "Dashboard" became "Deadlines" — the page lists deadlines, and "dashboard"
 * names a piece of software rather than anything he owns. (Label only; the page
 * is still /app, and its own H1 is the carrier's legal name.) "Settlements"
 * became "Driver pay" — three syllables, abstract, and also a legal word, where
 * the page simply says what each driver is owed. Everything else was already a
 * word he uses: Trucks, Drivers, Dispatch, Loads, Customers, Proof, and IFTA,
 * which is not English at all but the name of the filing itself.
 *
 * NO ABBREVIATIONS ARE LEFT. "Disp" / "Drv" / "Trk" / "Cust" / "Set" went when
 * the row learned to wrap; "Pay" for "Driver pay" was the last one, and it went
 * here — a list down the page has room for the whole word, so the phone reader
 * finally sees exactly what the desktop reader sees.
 */
type Section = { href: string; label: string }

const groups: Section[][] = [
  [
    { href: '/app', label: 'Deadlines' },
    { href: '/app/reminders', label: 'Reminders' },
  ],
  [
    { href: '/app/vehicles', label: 'Trucks' },
    { href: '/app/drivers', label: 'Drivers' },
  ],
  [
    { href: '/app/dispatch', label: 'Dispatch' },
    { href: '/app/loads', label: 'Loads' },
    { href: '/app/customers', label: 'Customers' },
  ],
  [
    { href: '/app/settlements', label: 'Driver pay' },
    { href: '/app/ifta', label: 'IFTA' },
  ],
  [{ href: '/app/proof', label: 'Proof' }],
]

const settings: Section = { href: '/app/settings', label: 'Settings' }
// Billing sits with Settings, not in the section row: it is about the account
// rather than about the fleet, and it is not somewhere an owner goes daily.
const billing: Section = { href: '/app/billing', label: 'Billing' }

const active = (href: string) =>
  path === href || (href !== '/app' && path.startsWith(href))

/**
 * One pill, shared by the row and by Settings, so the page you are on lights up
 * the same way wherever its link happens to sit. Grouping changed the layout
 * around the links and nothing about how the current one is marked — a link
 * inside a group is still just a link, and still carries `aria-current`.
 *
 * Desktop only: below `sm` the row is behind the menu, and a link in the menu is
 * a full-width row rather than a pill.
 *
 * Both of these are now `.nav-item` and `.is-current` out of global.css, which
 * is where the one selected mark and the one 44px nav target live. Two things
 * changed by adopting them.
 *
 * THE PILL IS 44px. It was py-1.5 on 14px type, which is 32px — a third short
 * of what a thumb needs and the reason the phone menu had to invent its own
 * 48px row in the first place. The header is 12px taller per deck for it.
 *
 * THE CURRENT PAGE IS bg-blue-100, not brand-500 at 10% opacity. A tint mixed
 * from an opacity is a colour nothing can be checked against — it changes with
 * whatever is behind it — and the pill sits on white here and on the backdrop
 * blur of a sticky header, which are not the same white. The solid tint is
 * 8.23:1 under brand-700 wherever it lands.
 *
 * `text-sm` is written over the class on purpose: `.nav-item` inherits the 16px
 * body size, and 16px labels push this row past one line between 640px and
 * 900px, where it already wraps to two.
 */
const pill = (href: string) => [
  'nav-item text-sm whitespace-nowrap transition',
  active(href) && 'is-current',
]

/**
 * A line in the phone menu. `min-h-12` is 48px — 4px more than the floor, and a
 * yard is exactly where that gets paid for. A list down the page has the room,
 * so it takes it. Same `.is-current` mark as `pill`, so "blue means you are
 * here" is one rule, not two.
 */
const row = (href: string) => [
  'nav-item flex min-h-12 px-3 text-base transition',
  active(href) && 'is-current',
]

const sections: Section[] = groups.flat()
const account: Section[] = [billing, settings]

/**
 * The word in the closed bar. At most one of these can match: no href is a
 * prefix of another, and '/app' is compared exactly. The fallback covers the
 * few pages that are not sections — /app/setup is the one that ships today.
 */
const current = [...sections, ...account].find((s) => active(s.href))?.label ?? 'Menu'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · FleetView</title>
  </head>
  <body class="min-h-dvh bg-ink-50 font-sans text-ink-900 antialiased">
    {/*
      FIRST TAB STOP, and the app had none while the marketing site did.

      The signed-in header is about thirteen tab stops deep — wordmark, the
      section row, the phone disclosure, sign out — so without this a keyboard
      or switch-control user walked the whole navigation again on every single
      page before reaching the page itself. The owner screens are where somebody
      actually works, which makes this the half that needed it more.

      `focus:` and not `focus-visible:` on the reveal: the link has to appear the
      moment it takes focus, and it is only ever reached by keyboard anyway. The
      2px ring around it comes from the global `:focus-visible` rule, so this
      markup carries no ring of its own — see src/styles/global.css.
    */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-10 border-b border-ink-100 bg-white/85 backdrop-blur">
      {/*
        PHONE. One line: the wordmark, and the page you are on. 49px of header
        against the 201px the wrapped row needed at 320px.

        The whole bar is the control — `summary` fills the width and stands 48px
        tall — so opening it needs no aim. It is the only interactive thing on
        the line, which is why the wordmark can be plain text here: a link
        nested inside a `summary` fights it for the tap, and /app is the first
        line of the list anyway, under the name the owner uses for it.
      */}
      <details class="group sm:hidden">
        <summary
          class="flex min-h-12 cursor-pointer list-none items-center gap-3 px-4 py-2 select-none [&::-webkit-details-marker]:hidden"
        >
          {/* "Compliance" still waits for `sm`, the way the public header
              does — on this line the page name has the better claim on the
              space. */}
          <span class="font-semibold tracking-tight">FleetView</span>
          {/* `.is-current` and nothing hand-mixed: the mark on the closed bar is
              the same mark the reader will see beside the current row once the
              list is open, and there is now one place that decides what it looks
              like. No `aria-current` on it — this is a label inside the control,
              not a link, and the page name is spelled out in words either way,
              so the pill is never carrying the meaning on its own. */}
          <span
            class="is-current ml-auto flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm"
          >
            {current}
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0 transition-transform group-open:rotate-180"
            >
              <path d="M5 8l5 5 5-5"></path>
            </svg>
          </span>
        </summary>

        {/*
          The list scrolls inside itself rather than growing the sticky header
          past the screen, which is what strands the last item on a short phone:
          thirteen 48px lines are 661px and the shortest phone still in the wild
          is 568px tall. What it has to give back is the closed bar above it,
          3rem, and the header's own bottom border, 1px.
        */}
        <nav
          aria-label="Menu"
          class="max-h-[calc(100dvh-3rem-1px)] overflow-y-auto border-t border-ink-100 px-2 pt-2 pb-3"
        >
          {
            sections.map((n) => (
              <a
                href={n.href}
                aria-current={active(n.href) ? 'page' : undefined}
                class:list={row(n.href)}
              >
                {n.label}
              </a>
            ))
          }
          {/* The account controls, kept apart by a hairline and no heading. */}
          <div class="mt-2 border-t border-ink-100 pt-2">
            {
              account.map((n) => (
                <a
                  href={n.href}
                  aria-current={active(n.href) ? 'page' : undefined}
                  class:list={row(n.href)}
                >
                  {n.label}
                </a>
              ))
            }
            <form method="POST" action="/logout">
              <button
                type="submit"
                class="flex min-h-12 w-full cursor-pointer items-center rounded-lg px-3 text-base font-medium text-ink-700 transition hover:bg-ink-50 hover:text-ink-900"
              >
                Sign out
              </button>
            </form>
          </div>
        </nav>
      </details>

      {/*
        DESKTOP, from `sm` up. Two decks: the wordmark and the account controls
        on top, the section row on its own full-width line underneath.

        It was one deck, with the row scrolling sideways inside whatever was left
        over — about 374px on a tablet. That hid most of the sections on every
        signed-in page, which is the wrong trade for this reader twice over: he
        cannot scan for a word he cannot see, and a strip that ends flush looks
        finished, so he has no reason to suspect six more items sit to the right
        of it.

        Keeping the row on the top line was tried and does not survive contact
        with real numbers. Inside `max-w-7xl`, once the wordmark and Sign out
        have been paid for, the row has 890px to live in and needs 886 — a 4px
        margin, which any font substitution erases. Its own line has 1232px. So
        the row gets its own line, permanently, and in exchange it never scrolls
        and never hides anything. Measured: one row from about 900px up, two
        rows from 640px to 900px. The cost is 97px of sticky header on a desktop
        and 133px on a tablet, unchanged by the phone work above.
      */}
      <div
        class="mx-auto hidden max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:flex sm:px-6"
      >
        <a href="/app" class="shrink-0 font-semibold tracking-tight whitespace-nowrap">
          FleetView<span class="hidden text-brand-600 sm:inline">Compliance</span>
        </a>

        {/* Settings and Sign out: the two controls that are about the account
            rather than about the fleet, so they sit together, away from the row
            and out of the path anyone scans for a section. */}
        <div class="ml-auto flex shrink-0 items-center gap-1">
          <a
            href={billing.href}
            aria-current={active(billing.href) ? 'page' : undefined}
            class:list={pill(billing.href)}
          >
            {billing.label}
          </a>
          <a
            href={settings.href}
            aria-current={active(settings.href) ? 'page' : undefined}
            class:list={pill(settings.href)}
          >
            {settings.label}
          </a>
          <form method="POST" action="/logout">
            {/* A button, so it takes the button classes rather than the nav
                ones — it signs you out, it does not go anywhere. `.btn-sm` is
                the dense-table size: 14px type to sit level with the pills
                beside it, still 44px tall, because padding is what gives way
                and never the target. */}
            <button
              type="submit"
              class="btn btn-sm text-ink-700 hover:bg-ink-50 hover:text-ink-900"
            >
              Sign out
            </button>
          </form>
        </div>

        {/* `w-full` drops the row onto the second line. It is last in the DOM as
            well as last on the page, so tab order and reading order agree and no
            `order-*` class is needed to fake it. */}
        <nav
          id="appnav"
          class="flex w-full flex-wrap items-center gap-1 sm:gap-x-5 lg:gap-x-3"
          aria-label="Sections"
        >
          {
            groups.map((group, i) => (
              <Fragment>
                {/*
                  The hairline only appears at `lg`, which is the width from which
                  the row is comfortably one line — so it cannot end up dangling at
                  the end of a wrapped line. Narrower than that, the grouping is
                  the gap alone: 4px inside a group against 20px between them.
                */}
                {i > 0 && (
                  <span aria-hidden="true" class="hidden h-4 w-px shrink-0 bg-ink-200 lg:block" />
                )}
                <div class="flex items-center gap-1">
                  {group.map((n) => (
                    <a
                      href={n.href}
                      aria-current={active(n.href) ? 'page' : undefined}
                      class:list={pill(n.href)}
                    >
                      {n.label}
                    </a>
                  ))}
                </div>
              </Fragment>
            ))
          }
        </nav>
      </div>
    </header>

    {/*
      The script that used to live here scrolled the current section into view,
      because the row scrolled sideways and the current section was routinely off
      screen. The row wraps now and nothing is ever off screen, and the phone
      menu opens on `<details>` alone. The signed-in shell still has no client
      JavaScript at all, which is what the rest of this app already assumes.
    */}

    <main id="main" class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
      <div class="mb-6">
        <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h1>
        {subtitle && <p class="mt-1 text-sm text-ink-500">{subtitle}</p>}
      </div>
      <slot />
    </main>
  </body>
</html>
