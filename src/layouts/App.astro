---
/**
 * The signed-in shell. Never indexed, never cached.
 */
import '../styles/global.css'

interface Props {
  title: string
  subtitle?: string
  /**
   * Submit this page's forms without reloading it. OFF by default.
   *
   * The owner's complaint is about buttons, not about links: "i dont care if
   * going from one page to another to render from server... this is fine, but
   * the actual content like updates, create, done, finish, add date — this is
   * what we need". So the page keeps every handler it has and the only thing
   * that changes is that the answer arrives in place.
   *
   * A PAGE AT A TIME, on purpose. Nothing about the server changes, so a page
   * that has not opted in behaves exactly as it always has — and a page that
   * has still behaves exactly as it always has whenever the script cannot run,
   * because the fallback is the plain form submit that is already there.
   */
  live?: boolean
}
const { title, subtitle, live = false } = Astro.props
const path = Astro.url.pathname

/**
 * Ten flat sections in one row was too many to scan, and the people scanning are
 * Glendale and Sun Valley fleet owners who often read English as a second
 * language. That fact decided every call below, and it decided them differently
 * on a desktop and on a phone.
 *
 * NO CATEGORY MENU OVER THE SECTIONS, ANYWHERE. A reader hunting for a word he
 * only half recognises must be able to reach that word without first naming the
 * box it lives in. "Work", "Fleet", "Money" — the category name is the one piece
 * of English he does not have. So no section is ever filed under a heading, and
 * the group headings that were tried are still gone for the same reason: the
 * children are visible, so the heading had no job left to do.
 *
 * ON A DESKTOP the sections stay on screen, grouped by spacing alone:
 *
 *   Deadlines Reminders  Trucks Drivers  Dispatch Loads Customers  Driver pay IFTA  Proof
 *
 * Deadlines first, then the two things deadlines hang off. Then the day's work,
 * then the money, then the page you hand to somebody else. Free to read, costs
 * no taps, needs none of the client JavaScript this app does not ship.
 *
 * ON A PHONE that row cost 201px of sticky header at 320px and 169px at 375px,
 * on every single page, and the owner said so: the header was eating the screen
 * he had come to read. So below `md` the row folds into one `<details>`.
 *
 * That is not a retreat from the paragraph above, and the difference is the
 * whole point. A category menu asks the reader for a word before it will show
 * him anything. This one asks for nothing: one tap anywhere on the bar and all
 * ten sections are there, in a column, whole words, same order as the desktop
 * row, no headings between them. There is no category name in it to not know.
 *
 * THE CLOSED BAR NAMES THE PAGE HE IS ON — "Deadlines", "Loads" — in the same
 * brand-tinted pill the row uses to mark the current section, with a chevron
 * next to it. A bare hamburger would have told him nothing; this way the header
 * still answers "where am I" at a glance, which is most of what he was reading
 * it for, and the mark he learns here is the same mark he sees beside the
 * current row once the list is open. The chevron carries the "this opens" job
 * because it is not a word in any language and so cannot be the wrong one.
 *
 * Billing, Settings and Sign out leave the phone bar and sit at the foot of the
 * open list, under a hairline, so the closed header is one line and nothing is
 * stranded.
 *
 * `<details>` and no script: it opens on touch and from the keyboard on its own,
 * and because every navigation here is a real page load, the menu is shut again
 * the moment he lands. The shell still ships zero client JavaScript.
 *
 * THE DISCLOSURE RUNS TO `md`, NOT `sm`. It used to stop at 640px, and the range
 * it handed back to the desktop layout was the range the desktop layout is worst
 * at: at 640px the section row wraps to three lines and the header stands 133px
 * on a mouse and 157px on a touchscreen, inside a window only 640px wide. The
 * same width behind this bar is 49px. The break moved to 768px, which is the
 * narrowest width where the sections wrap to no more than two lines.
 *
 * LABELS are the words an owner says out loud, not the words a TMS prints.
 * "Dashboard" became "Deadlines" — the page lists deadlines, and "dashboard"
 * names a piece of software rather than anything he owns. (Label only; the page
 * is still /app, and its own H1 is the carrier's legal name.) "Settlements"
 * became "Driver pay" — three syllables, abstract, and also a legal word, where
 * the page simply says what each driver is owed. Everything else was already a
 * word he uses: Trucks, Drivers, Dispatch, Loads, Customers, Proof, and IFTA,
 * which is not English at all but the name of the filing itself.
 *
 * NO ABBREVIATIONS ARE LEFT. "Disp" / "Drv" / "Trk" / "Cust" / "Set" went when
 * the row learned to wrap; "Pay" for "Driver pay" was the last one, and it went
 * here — a list down the page has room for the whole word, so the phone reader
 * finally sees exactly what the desktop reader sees.
 */
type Section = { href: string; label: string }

const groups: Section[][] = [
  [
    { href: '/app', label: 'Deadlines' },
    { href: '/app/reminders', label: 'Reminders' },
  ],
  [
    { href: '/app/vehicles', label: 'Trucks' },
    { href: '/app/drivers', label: 'Drivers' },
  ],
  [
    { href: '/app/dispatch', label: 'Dispatch' },
    { href: '/app/loads', label: 'Loads' },
    { href: '/app/customers', label: 'Customers' },
  ],
  [
    { href: '/app/settlements', label: 'Driver pay' },
    { href: '/app/ifta', label: 'IFTA' },
  ],
  [{ href: '/app/proof', label: 'Proof' }],
]

const settings: Section = { href: '/app/settings', label: 'Settings' }
// Billing sits with Settings, not in the section row: it is about the account
// rather than about the fleet, and it is not somewhere an owner goes daily.
const billing: Section = { href: '/app/billing', label: 'Billing' }

const active = (href: string) =>
  path === href || (href !== '/app' && path.startsWith(href))

/**
 * One pill, shared by the row and by the account bar, so the page you are on
 * lights up the same way wherever its link happens to sit. Grouping changed the
 * layout around the links and nothing about how the current one is marked — a
 * link inside a group is still just a link, and still carries `aria-current`.
 *
 * Desktop only: below `md` the row is behind the menu, and a link in the menu is
 * a full-width row rather than a pill.
 *
 * Both of these are now `.nav-item` and `.is-current` out of global.css, which
 * is where the one selected mark and the one 44px nav target live. Three things
 * are written over the class on purpose.
 *
 * `text-sm`, because `.nav-item` inherits the 16px body size and 16px labels
 * push this row onto an extra line at every width under about 1200px.
 *
 * `px-2.5` and not the class's `px-3`. Ten pills pay it twice each, so the 2px
 * is 40px off the width of the row — which is 40px of the margin that decides
 * whether the header is one line or two on a 1280px screen. The target is not
 * what gives way: the pill is still 36px tall on a mouse and 44px on a thumb.
 *
 * `whitespace-nowrap`, so a label breaks the row onto a second line rather than
 * breaking itself in half.
 */
const pill = (href: string) => [
  'nav-item px-2.5 text-sm whitespace-nowrap transition',
  active(href) && 'is-current',
]

/**
 * A line in the phone menu. `min-h-12` is 48px — 4px more than the floor, and a
 * yard is exactly where that gets paid for. A list down the page has the room,
 * so it takes it. Same `.is-current` mark as `pill`, so "the Champagne pill
 * means you are here" is one rule, not two.
 */
const row = (href: string) => [
  'nav-item flex min-h-12 px-3 text-base transition',
  active(href) && 'is-current',
]

/** A line in the desktop account menu: full width of the panel, same mark. */
const menuRow = (href: string) => [
  'nav-item flex w-full px-3 text-sm transition',
  active(href) && 'is-current',
]

const sections: Section[] = groups.flat()
const account: Section[] = [billing, settings]

/**
 * The word in the closed phone bar. At most one of these can match: no href is a
 * prefix of another, and '/app' is compared exactly. The fallback covers the
 * few pages that are not sections — /app/setup is the one that ships today.
 */
const current = [...sections, ...account].find((s) => active(s.href))?.label ?? 'Menu'

/** Set only while the reader is on Billing or Settings. See the header. */
const accountCurrent = account.find((s) => active(s.href))
---

<html lang="en" data-shell="app">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · FleetView</title>
  </head>
  <body class="min-h-dvh bg-ink-50 font-sans text-ink-900 antialiased">
    {/*
      FIRST TAB STOP, and the app had none while the marketing site did.

      The signed-in header is about a dozen tab stops deep — wordmark, the
      section row, the account menu — so without this a keyboard or switch
      control user walked the whole navigation again on every single page before
      reaching the page itself. The owner screens are where somebody actually
      works, which makes this the half that needed it more.

      `focus:` and not `focus-visible:` on the reveal: the link has to appear the
      moment it takes focus, and it is only ever reached by keyboard anyway. The
      2px ring around it comes from the global `:focus-visible` rule, so this
      markup carries no ring of its own — see src/styles/global.css.
    */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-10 border-b border-ink-100 bg-white/85 backdrop-blur">
      {/*
        PHONE, and now every window under 768px. One line: the wordmark, and the
        page you are on. 49px of header against the 201px the wrapped row needed
        at 320px.

        The whole bar is the control — `summary` fills the width and stands 48px
        tall — so opening it needs no aim. It is the only interactive thing on
        the line, which is why the wordmark can be plain text here: a link
        nested inside a `summary` fights it for the tap, and /app is the first
        line of the list anyway, under the name the owner uses for it.

        `sm:px-6` tracks `<main>`: this bar now runs past 640px, where the page
        under it steps from 16px of gutter to 24px, and the wordmark has to stay
        over the H1 rather than 8px to the left of it.
      */}
      <details class="group md:hidden">
        <summary
          class="flex min-h-12 cursor-pointer list-none items-center gap-3 px-4 py-2 select-none sm:px-6 [&::-webkit-details-marker]:hidden"
        >
          {/* "Compliance" waits for a wide desktop, the way it waits for `sm` on
              the public header — on this line the page name has the better
              claim on the space. */}
          <span class="font-semibold tracking-tight">FleetView</span>
          {/* `.is-current` and nothing hand-mixed: the mark on the closed bar is
              the same mark the reader will see beside the current row once the
              list is open, and there is now one place that decides what it looks
              like. No `aria-current` on it — this is a label inside the control,
              not a link, and the page name is spelled out in words either way,
              so the pill is never carrying the meaning on its own. */}
          <span
            class="is-current ml-auto flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm"
          >
            {current}
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0 transition-transform group-open:rotate-180"
            >
              <path d="M5 8l5 5 5-5"></path>
            </svg>
          </span>
        </summary>

        {/*
          The list scrolls inside itself rather than growing the sticky header
          past the screen, which is what strands the last item on a short phone:
          thirteen 48px lines are 661px and the shortest phone still in the wild
          is 568px tall. What it has to give back is the closed bar above it,
          3rem, and the header's own bottom border, 1px.
        */}
        <nav
          aria-label="Menu"
          class="max-h-[calc(100dvh-3rem-1px)] overflow-y-auto border-t border-ink-100 px-2 pt-2 pb-3"
        >
          {
            sections.map((n) => (
              <a
                href={n.href}
                aria-current={active(n.href) ? 'page' : undefined}
                class:list={row(n.href)}
              >
                {n.label}
              </a>
            ))
          }
          {/* The account controls, kept apart by a hairline and no heading. */}
          <div class="mt-2 border-t border-ink-100 pt-2">
            {
              account.map((n) => (
                <a
                  href={n.href}
                  aria-current={active(n.href) ? 'page' : undefined}
                  class:list={row(n.href)}
                >
                  {n.label}
                </a>
              ))
            }
            <form method="POST" action="/logout">
              <button
                type="submit"
                class="flex min-h-12 w-full cursor-pointer items-center rounded-lg px-3 text-base font-medium text-ink-700 transition hover:bg-ink-50 hover:text-ink-900"
              >
                Sign out
              </button>
            </form>
          </div>
        </nav>
      </details>

      {/*
        DESKTOP, from `md` up. ONE DECK: wordmark, then every section, then the
        account control hard right. The header is 53px on a mouse and 61px on a
        touchscreen once the sections fit on the line, which they do from about
        1045px up; under that the sections wrap inside their own box and the
        header is 93px / 109px. Before this it was two decks and 101px / 113px on
        a wide screen and 141px / 161px on a tablet.

        THIS IS THE LAYOUT THE OLD COMMENT SAID COULD NOT BE DONE, and the reason
        it can be done now is that the thing in the way was never the sections.
        Inside `max-w-7xl` the line is 1232px, and the note that put the row on
        its own deck had it needing 886px with 890px left over once the wordmark
        and the account controls were paid for. A 4px margin is not a margin, and
        that note was right to stop there. What was wrong was which side to take
        it out of.

        Billing, Settings and Sign out spelled out are 272px of that line. Behind
        one `Account` disclosure they are 97px including its chevron: 175px back.
        The wordmark gives back 85px more by holding "Compliance" until `xl`,
        where the line is wide enough to carry it again. And the row itself came
        down from 898px to 830px when the group hairlines went and each pill gave
        up 2px of padding a side. So, measured on a 1280px screen: 1232, less 156
        for the wordmark with "Compliance" on it, less 97 for Account, less 32
        for the two gaps, leaves 947px for a row that wants 830. It clears by
        117px — by 122px at 1200px, where the wordmark is the short one. That is
        not a margin a font substitution erases; it is 14% of the row.

        The whole line fits from 1078px up. Under that the sections wrap to two,
        and the width where they would need a third — the tablet case that used
        to make this header 161px tall — is now behind the `<details>` bar.

        THE PRICE IS ONE TAP ON BILLING AND SETTINGS, and it is the right one to
        pay. They are about the account and not about the fleet, an owner does
        not open them in a working day, they were already grouped and already
        parked out of the path anyone scans for a section — and putting them
        behind a word buys every section a permanent place on screen, which is
        the thing this header exists to do. Sign out went in with them, and is
        now harder to hit by accident on the way to Proof.

        THE SECTIONS ARE NOT BEHIND ANYTHING, and still never scroll sideways: a
        strip that ends flush looks finished, so a reader has no reason to
        suspect six more items sit off the right of it. When the line runs out
        the sections wrap onto a second line inside their own box, under the
        wordmark, all of them visible, none of them hidden.

        The hairlines between the groups went with the second deck. They only
        ever appeared at `lg` — they could not survive a wrapped line without
        dangling at the end of one — and at 25px per gap they cost 100px, which
        is most of what the account menu had just won back. Spacing alone does
        the grouping now at every width, at the same numbers this row already
        used under `lg`: 4px inside a group against 20px between them.
      */}
      <div
        class="mx-auto hidden max-w-7xl items-center gap-x-4 px-4 py-2 sm:px-6 md:flex"
      >
        <a href="/app" class="shrink-0 font-semibold tracking-tight whitespace-nowrap">
          FleetView<span class="hidden text-brand-600 xl:inline">Compliance</span>
        </a>

        {/* `flex-1` and not `w-full`: the sections take the whole middle of the
            one line, which pushes the account control hard right, and when they
            do not fit they wrap inside this box instead of pushing anything onto
            a deck of its own. DOM order is wordmark, sections, account, which is
            also reading order and tab order, so nothing is reordered in CSS. */}
        <nav
          id="appnav"
          class="flex flex-1 flex-wrap items-center gap-x-5 gap-y-1"
          aria-label="Sections"
        >
          {
            groups.map((group) => (
              <div class="flex items-center gap-1">
                {group.map((n) => (
                  <a
                    href={n.href}
                    aria-current={active(n.href) ? 'page' : undefined}
                    class:list={pill(n.href)}
                  >
                    {n.label}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>

        {/*
          THE ACCOUNT CONTROL. `<details>` again, and for the same reasons as the
          phone bar: it opens on click, on Enter and on Space with no script, and
          every single thing inside it is a link or a submit, so the page load
          closes it. There is nothing here that needs a click-outside handler.

          WHEN THE READER IS ON BILLING OR SETTINGS THE BAR SAYS SO — the summary
          takes the page's own name and the same tinted pill the section row
          uses, exactly like the closed phone bar. A menu that swallowed the
          current-page mark would have made this the one page in the app that
          cannot answer "where am I", and "Account" is precisely the category
          word this reader may not have. Every other page it just says Account.

          No `aria-current` on the summary: it is a label inside a control, not a
          link. The link inside the panel carries it.
        */}
        {/* The wrapper is the panel's anchor, and it is `self-stretch` so that
            anchor is the full height of the line. Hang the panel off the
            `<details>` instead and it opens from the middle of the header the
            moment the sections wrap, cutting across the second line of them. */}
        <div class="relative flex shrink-0 items-center self-stretch">
          <details class="group">
            <summary
              class:list={[
                'nav-item cursor-pointer list-none gap-1.5 px-2.5 text-sm whitespace-nowrap transition select-none [&::-webkit-details-marker]:hidden',
                accountCurrent && 'is-current',
              ]}
            >
              {accountCurrent?.label ?? 'Account'}
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 shrink-0 transition-transform group-open:rotate-180"
              >
                <path d="M5 8l5 5 5-5"></path>
              </svg>
            </summary>

            {/* Absolute, so opening it draws over the page instead of growing
                the sticky header and shoving the page down. Solid white and a
                border: it is floating over arbitrary content, and the header's
                own background is translucent. */}
            <nav
              aria-label="Account"
              class="absolute top-full right-0 z-20 mt-1 w-44 rounded-xl border border-ink-200 bg-white p-1 shadow-lg"
            >
              {
                account.map((n) => (
                  <a
                    href={n.href}
                    aria-current={active(n.href) ? 'page' : undefined}
                    class:list={menuRow(n.href)}
                  >
                    {n.label}
                  </a>
                ))
              }
              <form method="POST" action="/logout">
                {/* A button and not a link: it signs you out, it does not go
                    anywhere. `.nav-item` rather than `.btn` so it is the same
                    height and the same 14px as the two rows above it. */}
                <button
                  type="submit"
                  class="nav-item flex w-full cursor-pointer px-3 text-sm transition"
                >
                  Sign out
                </button>
              </form>
            </nav>
          </details>
        </div>
      </div>
    </header>

    {/*
      The script that used to live here scrolled the current section into view,
      because the row scrolled sideways and the current section was routinely off
      screen. The row wraps now and nothing is ever off screen, and both
      disclosures open on `<details>` alone. The signed-in shell still has no
      client JavaScript at all, which is what the rest of this app already
      assumes.

      The header's height is written down in one other place: the
      `scroll-padding-top` rules on `html[data-shell='app']` in global.css, which
      are what keeps a jump link like "#date_medical_card" from landing behind
      this bar. Their breakpoints are this file's breakpoints. Move one, move
      both.
    */}

    <main id="main" data-live={live ? '' : undefined} class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
      <div class="mb-6">
        <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h1>
        {/* ink-700, not ink-500, and the reason is the body under it: the
            signed-in shell is `bg-ink-50`, and `<main>` paints no background of
            its own, so this line is on a TINT. ink-500 is 4.74:1 on white but
            4.42:1 on ink-50 — under the threshold, on the one line that tells
            the reader what the page he just opened is for. On a tint the floor
            is ink-700 at every size. Nothing about the header moved. */}
        {subtitle && <p class="mt-1 text-sm text-ink-700">{subtitle}</p>}
      </div>
      <slot />
    </main>

    {/*
      THE ONLY SCRIPT IN THE SIGNED-IN APP, and only on pages that asked for it.
      Rendered conditionally so a page without `live` still ships nothing at all.
      Everything it does is in src/scripts/live-forms.ts; with it blocked,
      missing or failed, every form on the page still works, because it is still
      the same plain form posting to the same handler.
    */}
    {
      live && (
        <script>
          import '../scripts/live-forms.ts'
        </script>
      )
    }
  </body>
</html>
