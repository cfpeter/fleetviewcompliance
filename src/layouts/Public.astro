---
/**
 * The marketing shell.
 *
 * Zero client JavaScript by design — every control on the public site is a link
 * or a plain GET form. A fleet owner checking us out is often on a phone with
 * bad signal at a truck stop.
 */
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  noindex?: boolean
}

const { title, description, noindex } = Astro.props

const BRAND = 'FleetView Compliance'
const site = Astro.site ?? new URL('https://fleetviewcompliance.com')
const canonical = new URL(Astro.url.pathname, site).toString()
const fullTitle = title === BRAND ? title : `${title} · ${BRAND}`
const path = Astro.url.pathname

/**
 * Home is a link, not just the wordmark.
 *
 * The wordmark went to `/` all along, but the owner's report was literally "I
 * don't see a home page" — a mark in the top-left is a convention people who
 * build websites know, and a fleet owner reading a nav for the word he wants is
 * not that person. The wordmark keeps its href; this just stops it being the
 * only way back.
 *
 * A fourth item costs about 56px, and the header had nowhere near that spare.
 * Measured at the three widths where it is tightest, wordmark + links + CTA:
 *
 *   375px  331 of 343 usable   short labels, no "Compliance", px-2
 *   400px  331 of 368          the wordmark used to double here, and 407 > 368
 *   640px  577 of 592          full labels and About arrive, px-3
 *
 * Two things paid for Home. "Compliance" now appears at `sm` rather than at
 * 400px, so the wordmark cannot double in width while the nav is still using
 * short labels — that 400px cliff was the actual overflow, not 375px. And the
 * wordmark grows to `text-lg` at `md` rather than `sm`, which is what keeps the
 * 640px column from being 2px short at the moment About appears.
 *
 * About stays desktop-only for the reason it always was: it does not fit on a
 * phone, and it is in the footer.
 */
const nav = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
  { href: '/login', label: 'Sign in' },
]

/**
 * MEASURED, NOT ASSUMED: the one-line header did not fit on a phone.
 *
 * At 375px the row above — wordmark, Home, Features, Pricing, Sign in, Check —
 * was 414px wide. The browser answered the way a phone answers content wider
 * than the screen: it zoomed the whole page out to 0.9 so the row would fit,
 * on every public page, and the "331 of 343 usable" in the old note was a
 * measurement taken before Home and the 44px pills were added. The items were
 * also 2px apart, where two targets a thumb aims at need 8px.
 *
 * So under `md` the public header does what the signed-in header does: one
 * line — the wordmark, the page you are on in the tinted pill with a chevron,
 * and the one button — and the sections open from the pill as a column of
 * 48px rows. No category word: the pill names the page, and the list is the
 * same five words the desktop row shows, whole, in the same order. About is
 * back on the phone, where it used to be hidden. The `<details>` opens on
 * touch and from the keyboard on its own, and every line in it is a link, so
 * the page load closes it; the site still ships no client JavaScript.
 *
 * From `md` up the row is one deck, 8px between pills, full labels. At 768px
 * it needs about 620px of the 720px inside the padding.
 */
const active = (href: string) => path === href

/** The word in the closed phone pill; 'Menu' on the pages that are not sections. */
const current = nav.find((n) => active(n.href))?.label ?? 'Menu'

const row = (href: string) => [
  'nav-item flex min-h-12 px-3 text-base transition',
  active(href) && 'is-current',
]

const pill = (href: string) => [
  'nav-item px-3 whitespace-nowrap transition',
  active(href) && 'is-current',
]
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {/*
      A `noindex` page declares no canonical and no og:url, and the proof page
      is why.

      `astro.config.mjs` sets no `site`, so `Astro.site` is undefined and the
      fallback below always wins — which stamped the PRODUCTION apex onto every
      public page, including /proof/<token> served from dev. The canonical was
      wrong on its face, and og:url was worse: it handed a live proof token to
      the production host, so any link preview fetcher — Slack, Outlook,
      WhatsApp — would go and present that token to a different deployment.

      A page we are asking search engines to ignore has nothing to gain from
      either tag, so neither is emitted. The marketing pages, which do want
      them, are unaffected.
    */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#064e3b" />
  </head>

  <body class="min-h-dvh bg-white font-sans text-ink-900 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-ink-100 bg-white/85 backdrop-blur">
      {/*
        UNDER `md`: wordmark, the page you are on, the one button. The bar is
        `relative` so the open list can hang under it at full width instead of
        growing the sticky header. The wordmark is a 44px target, like every
        other link; it was a 24px line of text.
      */}
      <div class="relative mx-auto flex max-w-6xl items-center gap-3 px-4 py-2 sm:px-6 md:hidden">
        <a
          href="/"
          class="inline-flex min-h-11 shrink-0 items-center font-semibold tracking-tight whitespace-nowrap"
        >
          FleetView<span class="hidden text-brand-600 sm:inline">Compliance</span>
        </a>

        <details class="group ml-auto">
          {/* The closed pill: the same `.is-current` mark the signed-in header
              uses, the page name in words, and a chevron that says "this opens"
              without being a word in any language. Not a link — the list under
              it carries `aria-current`. */}
          <summary
            class="nav-item is-current cursor-pointer list-none gap-1.5 px-2.5 text-sm whitespace-nowrap transition select-none [&::-webkit-details-marker]:hidden"
          >
            {current}
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0 transition-transform group-open:rotate-180"
            >
              <path d="M5 8l5 5 5-5"></path>
            </svg>
          </summary>
          <nav
            aria-label="Menu"
            class="absolute inset-x-0 top-full border-b border-ink-100 bg-white px-2 pt-2 pb-3 shadow-lg"
          >
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  aria-current={active(n.href) ? 'page' : undefined}
                  class:list={row(n.href)}
                >
                  {n.label}
                </a>
              ))
            }
          </nav>
        </details>

        {/* Emerald Ink, the same fill as `.btn-primary` and `.btn-dark`: the
            one button in the marketing chrome is the brand colour. Outside the
            `<details>`, so it never fights the pill for a tap. */}
        <a
          href="/check"
          class="inline-flex min-h-11 shrink-0 items-center rounded-lg bg-brand-700 px-3 py-2 font-medium whitespace-nowrap text-white transition hover:bg-brand-800"
        >
          <span class="sm:hidden">Check</span>
          <span class="hidden sm:inline">Check my fleet</span>
        </a>
      </div>

      {/*
        FROM `md`: one deck. `.nav-item` and `.is-current` from global.css: one
        44px target and one selected mark, the same two the signed-in header
        uses. `gap-2` between the pills is the 8px floor between two targets.

        Sign in is a plain link in the row, never the button. The button is for
        the visitor we do not have yet; the link is for the customer we do, who
        knows exactly what he is looking for and will find a text link.
      */}
      <div class="mx-auto hidden max-w-6xl items-center gap-4 px-4 py-2 sm:px-6 md:flex">
        <a
          href="/"
          class="inline-flex min-h-11 shrink-0 items-center text-lg font-semibold tracking-tight whitespace-nowrap"
        >
          FleetView<span class="text-brand-600">Compliance</span>
        </a>

        <nav class="ml-auto flex items-center gap-2 text-sm" aria-label="Site">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={pill(n.href)}>
                {n.label}
              </a>
            ))
          }
          <a
            href="/check"
            class="ml-2 inline-flex min-h-11 shrink-0 items-center rounded-lg bg-brand-700 px-3.5 py-2 font-medium whitespace-nowrap text-white transition hover:bg-brand-800"
          >
            Check my fleet
          </a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="mt-20 border-t border-ink-100 bg-champagne-50">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-3 sm:px-6">
        <div>
          <p class="font-semibold tracking-tight">{BRAND}</p>
          {/* The whole footer sits on `bg-champagne-50`, and on a tint the floor is
              ink-700 at every size — ink-500 is measured against white and gets
              no credit here. That is the rule for the three paragraphs below as
              well; two of them are also 12px, where ink-700 is the floor anyway. */}
          <p class="mt-2 max-w-xs text-sm text-ink-700">
            Deadline tracking, loads and trips for small US carriers who would rather be
            driving than filing.
          </p>
        </div>
        <div>
          <p class="text-xs tracking-wide text-ink-700 uppercase">Product</p>
          {/* `.link` on every one of these, here and in the Company column: the
              brand colour AND underlined at rest. They used to be plain ink-900
              that changed colour on hover — and on a phone there is no hover, so the whole
              footer read as two lists of words with nothing to say that any of
              them went anywhere. A link this audience can see is a link that
              looks like one before it is touched. */}
          {/* Each line is a 44px target. They were 17px lines 8px apart, which
              on a phone is a column of eight things one thumb covers three of. */}
          <ul class="mt-1 text-sm">
            <li><a href="/features" class="link inline-flex min-h-11 min-w-11 items-center">Features</a></li>
            <li><a href="/pricing" class="link inline-flex min-h-11 min-w-11 items-center">Pricing</a></li>
            <li><a href="/check" class="link inline-flex min-h-11 min-w-11 items-center">Check your DOT number</a></li>
            <li><a href="/login" class="link inline-flex min-h-11 min-w-11 items-center">Sign in</a></li>
            <li>
              <a href="/login?mode=signup" class="link inline-flex min-h-11 min-w-11 items-center">
                Create an account
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="text-xs tracking-wide text-ink-700 uppercase">Company</p>
          <ul class="mt-1 text-sm">
            <li><a href="/about" class="link inline-flex min-h-11 min-w-11 items-center">About</a></li>
            <li><a href="/privacy" class="link inline-flex min-h-11 min-w-11 items-center">Privacy</a></li>
            <li><a href="/terms" class="link inline-flex min-h-11 min-w-11 items-center">Terms</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-ink-100">
        {/* The line that says we are not a law firm. It was ink-300 on the
            footer tint, which is 1.85:1 — present, load-bearing, and
            unreadable. On a tint at 12px the floor is ink-700. */}
        <div
          class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-5 text-xs text-ink-700 sm:px-6"
        >
          <span>© {new Date().getFullYear()} {BRAND}</span>
          <span aria-hidden="true">·</span>
          <span>
            Not a law firm. We track deadlines and keep records — we do not file on your behalf.
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
