---
/**
 * The next quarter of deadlines as a shape, with what is already behind him
 * standing at the left of the same strip.
 *
 * The vertical rule in the middle is 'today'. Everything left of it is the pile
 * he is already carrying; everything right of it is what is coming. Splitting
 * those onto two separate cards was the obvious layout and the wrong one — the
 * upcoming chart then reads as the whole answer, and a carrier whose entire
 * exposure is behind him sees a calm timeline.
 *
 * The left block is TEXT, not a bar, and that is deliberate. Drawn as a column
 * it would sit on an axis scaled to weekly counts, where eleven overdue items
 * against a peak week of four would tower off the top and, worse, invite the
 * reading that the two are measured in the same thing. They are not: one is a
 * rate, one is a debt.
 *
 * A week with no deadlines draws as a baseline tick, not as the dashed
 * we-do-not-know slot the other charts use. Here zero is a real finding — every
 * dated obligation has been placed, so an empty week is an empty week. The
 * undated ones never entered the axis at all; they are counted on the left.
 */
import type { Runway } from '../../lib/charts/runway.ts'
import { weekRangeLabel } from '../../lib/charts/runway.ts'

interface Props {
  runway: Runway
  /** Where the left block's counts link to. */
  overdueHref?: string
  undatedHref?: string
}
const { runway, overdueHref, undatedHref } = Astro.props
const behind = runway.overdue + runway.undated
---

<div>
  <div class="flex items-stretch gap-3">
    {/* ------------------------------------------------------------- behind */}
    <div class="w-24 shrink-0 sm:w-32">
      {
        behind === 0 ? (
          <div class="flex h-full flex-col justify-center rounded-lg border border-emerald-200 bg-emerald-50/60 px-2.5 py-2">
            <div class="text-[10px] tracking-wide text-emerald-800 uppercase">Behind you</div>
            <div class="mt-0.5 text-sm leading-tight font-medium text-emerald-800">Nothing</div>
          </div>
        ) : (
          <div class="flex h-full flex-col justify-center rounded-lg border border-red-200 bg-red-50/60 px-2.5 py-2">
            <div class="text-[10px] tracking-wide text-red-700 uppercase">Behind you</div>
            {runway.overdue > 0 && (
              <a
                href={overdueHref}
                class="mt-1 block text-xs leading-tight text-red-700 tabular-nums hover:underline"
              >
                <span class="text-lg font-semibold">{runway.overdue}</span> overdue
              </a>
            )}
            {runway.undated > 0 && (
              /* Sitting in the same red box as the overdue count, not in a
                 grey one of its own. The ranking in src/lib/rules/index.ts
                 puts 'no date' level with 'expired' because the exposure is
                 identical; a calmer colour here would quietly overrule that. */
              <a
                href={undatedHref}
                class="mt-1 block text-xs leading-tight text-red-700 tabular-nums hover:underline"
              >
                <span class="text-lg font-semibold">{runway.undated}</span> no date
              </a>
            )}
          </div>
        )
      }
    </div>

    {/* -------------------------------------------------------------- ahead */}
    {/*
      The plot is hidden from the accessibility tree, and the sentence under the
      chart is the equivalent rather than a summary of it. Announced, thirteen
      columns are "1" followed by twelve silences — noise that buries the two
      things that matter, both of which are already real text: the counts in the
      block to the left, and the heaviest week named below.
    */}
    <div class="min-w-0 flex-1 border-l-2 border-ink-900 pl-3" aria-hidden="true">
      <div class="flex h-20 items-end gap-0.5 sm:h-32 sm:gap-1">
        {
          runway.weeks.map((w) => {
            const h = (w.count / runway.max) * 100
            return (
              <div class="flex h-full min-w-0 flex-1 flex-col justify-end">
                {w.count > 0 && (
                  <div class="mb-0.5 text-center text-[10px] font-medium text-ink-500 tabular-nums">
                    {w.count}
                  </div>
                )}
                <div
                  class:list={[
                    'rounded-t-sm',
                    w.count === 0 ? 'bg-ink-100' : w.isCurrent ? 'bg-amber-500' : 'bg-brand-500',
                  ]}
                  style={w.count === 0 ? 'height:2px' : `height:${h}%;min-height:4px`}
                />
              </div>
            )
          })
        }
      </div>

      <div class="mt-1.5 flex gap-0.5 border-t border-ink-100 pt-1.5 sm:gap-1">
        {
          runway.weeks.map((w) => (
            /* A label on the first week of each month only. Thirteen 'Sep 8'
               labels across a phone is a grey smear; the month boundaries are
               the only thing anyone actually reads off a quarter axis.

               Allowed to OVERFLOW its column rather than truncate. A 13-column
               axis gives each cell ~25px on a phone, and truncation turned the
               four labels into 'S..', 'O..', 'N..', 'D..' — an axis of
               ellipses. The cells either side are always empty (a month
               boundary cannot fall in two consecutive weeks), so there is
               nothing for it to collide with. */
            <div class="min-w-0 flex-1 text-[10px] whitespace-nowrap text-ink-500">
              {w.monthLabel}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/*
    The sentence under the chart is the chart's whole point restated for
    somebody who cannot see it — a screen reader, or an owner glancing at a
    phone in sunlight. If this line and the bars ever disagree, the line is what
    he will act on, so it is derived from the same numbers rather than written.
  */}
  <p class="mt-3 text-sm text-ink-500">
    {
      runway.peak ? (
        <>
          Heaviest week ahead is{' '}
          <span class="font-medium text-ink-900">{weekRangeLabel(runway.peak)}</span> —{' '}
          <span class="tabular-nums">{runway.peak.count} items</span>.
        </>
      ) : runway.scheduled > 0 ? (
        <>
          <span class="tabular-nums">{runway.scheduled}</span> coming up over the next{' '}
          {runway.horizonWeeks} weeks, no more than one in any week.
        </>
      ) : (
        <>Nothing falls due in the next {runway.horizonWeeks} weeks.</>
      )
    }
    {
      runway.beyond > 0 && (
        <span class="text-ink-300">
          {' '}
          {runway.beyond} more {runway.beyond === 1 ? 'is' : 'are'} further out.
        </span>
      )
    }
  </p>
</div>
