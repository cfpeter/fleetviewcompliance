---
/**
 * The owner's own reminders, on the record they are about.
 *
 * WHY THIS EXISTS, in his words, looking at a dashboard row: "the my reminders
 * shows the row but should we also show it to where it belongs like the driver
 * or truck — in this case it says for the truck, but when I go to the truck…"
 * He was right. A reminder carries a `vehicle_id` since 0023, the dashboard
 * prints the truck's name on the row and links to it, and the truck's own page
 * knew nothing about it. So the one place he goes to ask "what is going on with
 * truck 12" was the one place that did not say.
 *
 * NOT A SECOND REMINDERS SCREEN. There is no add form, no edit, no Done button
 * here — those all live on /app/reminders, which is one page with one set of
 * rules about repeats, lead days and completion. A second copy of that form is
 * a second set of those rules. This is a LIST and a way through to the page that
 * owns them.
 *
 * WHOLE-COMPANY REMINDERS ARE NOT SHOWN, and that is a decision rather than an
 * oversight — see `loadReminders`. "Renew the general liability policy" is not a
 * fact about truck 12, and printing it on all seven trucks would teach him to
 * skim the section.
 *
 * THE BADGE AND THE SENTENCE ARE THE SAME ONES EVERYWHERE. Every other row on a
 * truck page cites a regulation. These cite nothing, because there is nothing to
 * look up — an owner skimming on a phone must never read his own note as
 * something the government sent him. That is what `REMINDER_ORIGIN` and the
 * sentence under the heading are for, and they are imported rather than
 * re-typed so the three screens cannot drift apart.
 */
import { REMINDER_ORIGIN, type ReminderItem, repeatLabel } from '../lib/reminders.ts'
import { dueLine, standingPill } from '../lib/rules/index.ts'

interface Props {
  /** Which kind of record this is on. Decides the words and the add link. */
  subjectType: 'driver' | 'vehicle'
  subjectId: string
  reminders: readonly ReminderItem[]
  /** 'this driver' / 'this truck'. The sentences below read as one language. */
  noun: string
}
const { subjectType, subjectId, reminders, noun } = Astro.props

/**
 * The add link, carrying the record it was pressed on.
 *
 * `driver:<id>` / `vehicle:<id>` is the exact value the subject `<select>` on
 * /app/reminders already uses, so the page can preselect it without a second
 * way of naming a subject. Anything it does not recognise falls back to "Whole
 * company" there, which is the safe end to fail at.
 */
const addHref = `/app/reminders?for=${subjectType}:${encodeURIComponent(subjectId)}`
---

<section class="mt-10">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 class="text-base font-semibold tracking-tight">
      Your reminders{' '}
      {reminders.length > 0 && (
        <span class="ml-2 text-sm font-normal text-ink-700 tabular-nums">{reminders.length}</span>
      )}
    </h2>
    <a href="/app/reminders" class="link inline-flex min-h-11 items-center text-sm font-medium">
      All reminders →
    </a>
  </div>

  <p class="mt-1 max-w-2xl text-sm text-ink-700">
    Notes you set yourself about {noun}. They are not a rule, and nobody checks them but you.
  </p>

  {
    reminders.length === 0 ? (
      /* An empty state that says what the thing is FOR. "No reminders" on its
         own teaches him the section is broken or pointless; the examples are
         the ones owners actually ask for. */
      <div class="mt-3 rounded-xl border border-ink-100 bg-white p-5">
        <p class="text-sm text-ink-700">
          Nothing set for {noun} yet. This is where you put the things no
          regulation tracks — the truck payment, an appointment, a tyre change.
        </p>
        <a href={addHref} class="btn btn-primary mt-4 inline-flex">
          Add a reminder for {noun}
        </a>
      </div>
    ) : (
      <>
        <div class="mt-3 space-y-2">
          {reminders.map((r) => {
            const pill = standingPill(r.status.standing)
            const repeat = repeatLabel(r.repeatMonths)
            return (
              <div class="rounded-xl border border-ink-100 bg-white p-4 sm:flex sm:items-start sm:gap-4">
                <div class="min-w-0 sm:flex-1">
                  <div class="font-medium">{r.title}</div>
                  {r.note && <div class="mt-0.5 text-xs text-ink-700">{r.note}</div>}
                  {/* The badge every other screen uses for these rows. Colour is
                      never the only signal — the word is on it. */}
                  <span
                    class:list={[
                      'mt-2 inline-flex rounded-md px-1.5 py-0.5 text-xs font-medium',
                      REMINDER_ORIGIN.className,
                    ]}
                  >
                    {REMINDER_ORIGIN.label}
                  </span>
                  {repeat && <span class="ml-2 text-xs text-ink-700">{repeat}</span>}
                </div>
                <div class="mt-2 shrink-0 sm:mt-0 sm:text-right">
                  <span class={pill.className}>{pill.label}</span>
                  <span class="ml-2 text-sm tabular-nums sm:mt-1 sm:ml-0 sm:block">
                    {dueLine(r)}
                  </span>
                </div>
              </div>
            )
          })}
        </div>
        {/* Under the list, not above it: the rows are what he came for. */}
        <a href={addHref} class="link mt-3 inline-flex min-h-11 items-center text-sm font-medium">
          Add another for {noun} →
        </a>
      </>
    )
  }
</section>
