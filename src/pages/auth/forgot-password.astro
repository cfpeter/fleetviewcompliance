---
/**
 * "I cannot remember my password."
 *
 * UNTIL TODAY THERE WAS NO ANSWER TO THAT SENTENCE. The sign-in form asked for
 * a password and nothing else; there was no link, no route, no recovery branch
 * anywhere in the application. A carrier who forgot the password to the account
 * holding his driver files, his medical certificates and his IFTA quarters was
 * locked out of it permanently, and the only way back was an email to a person.
 *
 * One box, one button, one sentence back. The sentence is the same whatever
 * happens, and that is the whole design of this screen — see below.
 *
 * Handles its own POST and always 303s, so a refresh cannot send a second link.
 */
import Public from '../../layouts/Public.astro'
import { notice, resetOutcome } from '../../lib/onboarding.ts'
import { sessionClient } from '../../lib/supabase/server.ts'

const PAGE = '/auth/forgot-password'

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const email = String(form.get('email') ?? '')
    .trim()
    .toLowerCase()

  /**
   * Back with a code, never with the address that was typed.
   *
   * login.astro refuses to put an email in a query string because it would land
   * in every access log and proxy between here and the customer's desk. The
   * address on THIS form belongs to somebody who may not have an account at
   * all — a mistyped one belongs to a stranger — so it matters more here, not
   * less.
   */
  const back = (code: string) => Astro.redirect(`${PAGE}?notice=${code}`, 303)

  if (!email) return back('email_needed')

  /**
   * The REQUEST'S OWN client, not `anonClient()`, and that is not a style
   * choice. `@supabase/ssr` runs the PKCE flow: resetPasswordForEmail mints a
   * code verifier and writes it to storage, which for this client is the
   * browser's cookies. The link in the email carries only half the secret; the
   * verifier cookie set on THIS response is the other half, and without it the
   * exchange on /auth/new-password cannot succeed. A cookieless client would
   * send a link that is guaranteed to fail.
   */
  const supabase = sessionClient(Astro.cookies, Astro.request.headers)

  const { error } = await supabase.auth.resetPasswordForEmail(email, {
    /**
     * Built from the ORIGIN of this request, for the reason signUp does it:
     * PUBLIC_SITE_URL is inlined at build time, so one build serving both
     * dev.fleetviewcompliance.com and the apex would mail every dev reset a
     * link pointing at production.
     *
     * NO QUERY STRING ON IT, deliberately. Supabase matches this whole URL
     * against the project's redirect allow-list and falls back to the Site URL
     * without saying so when it does not match — `?type=recovery` on the end
     * would need a wildcard entry that the allow-list does not have today. A
     * bare path is the shape that is already known to work for /auth/callback.
     */
    redirectTo: new URL('/auth/new-password', Astro.url.origin).toString(),
  })

  return back(resetOutcome(error))
}

const msg = notice(Astro.url.searchParams.get('notice'))

const tone =
  msg?.tone === 'ok'
    ? 'bg-emerald-50 text-emerald-800'
    : msg?.tone === 'info'
      ? 'bg-sky-50 text-sky-900'
      : 'bg-red-50 text-red-700'

const field =
  'mt-1 w-full rounded-lg border border-ink-100 bg-white px-3 py-2.5 text-base outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20'
---

<Public title="Forgot your password" noindex>
  <section class="mx-auto max-w-sm px-4 py-16 sm:px-6">
    <h1 class="text-2xl font-semibold tracking-tight">Forgot your password</h1>

    <p class="mt-2 text-sm text-ink-500">
      Type your email. We send you a link. Open the link and pick a new password.
    </p>

    {msg && <p class:list={['mt-5 rounded-lg px-4 py-3 text-sm', tone]}>{msg.text}</p>}

    <form method="POST" class="mt-6 space-y-4">
      <label class="block">
        <span class="text-sm font-medium">Email</span>
        <input type="email" name="email" autocomplete="email" required autofocus class={field} />
        <span class="mt-1 block text-xs text-ink-500">
          Use the email you sign in with.
        </span>
      </label>

      <button
        type="submit"
        class="w-full rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white transition hover:bg-brand-700"
      >
        Send me the link
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-ink-500">
      Remembered it?{' '}
      <a href="/login" class="font-medium text-brand-600 hover:underline">Sign in</a>
    </p>

    {/*
      WHY THE ANSWER IS ALWAYS THE SAME, said to the customer rather than only
      to the next programmer. A reset form that answers "we have no account for
      that address" is a free lookup service: anybody can type a competitor's
      dispatcher into it and be told whether he is a customer here. The sign-in
      form refuses to give that away and so does this one — so a person who
      mistypes their address sees the same green message as everybody else, and
      has to be told plainly that the email simply will not arrive.
    */}
    <p class="mt-8 border-t border-ink-100 pt-6 text-xs text-ink-500">
      We answer every email address the same way, even one that has no account here. That keeps
      other people from using this page to find out who our customers are. So if no email arrives
      in a few minutes, check that you typed the right address and look in your spam folder.
    </p>
  </section>
</Public>
