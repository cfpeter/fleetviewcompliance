---
/**
 * Where a reset link lands: pick a new password.
 *
 * THE LINK IS NOT SPENT UNTIL THE PASSWORD IS TYPED, and that is the one
 * decision this page is built around.
 *
 * The obvious build exchanges the code for a session the moment the link is
 * opened, and then shows a password box to whoever holds the resulting session.
 * It has two faults. The first is that merely clicking a link out of an email —
 * something a mail scanner, a preview pane or a curious thumb does — would sign
 * somebody in and leave a live session on that browser. The second is worse: a
 * page that sets a password for any signed-in visitor, without asking for the
 * old one, is a second and much easier version of the takeover that
 * /app/settings refuses by demanding the current password. It would have to
 * tell a recovery session apart from an ordinary one, and there is no honest
 * way to do that from a cookie somebody at an unlocked laptop can edit.
 *
 * So nothing is exchanged on the way in. The code rides through the form in a
 * hidden field, and it is spent only when a new password has already been typed
 * twice and checked. Sign-in and password change then happen in the same
 * request, and no click on its own signs anybody in.
 *
 * TWO SHAPES OF LINK, because the email template decides which arrives:
 *
 *   ?code=…        the default `{{ .ConfirmationURL }}` template with the PKCE
 *                  flow @supabase/ssr uses. Exchanged with the verifier cookie
 *                  written when the reset was asked for, WHICH MEANS THE SAME
 *                  BROWSER — open the mail on a phone and it cannot work.
 *   ?token_hash=…  the `{{ .TokenHash }}` template. Verified without a cookie,
 *                  so it works on any device. See docs/OPERATIONS.md: switching
 *                  the template is what fixes reset-on-the-phone, and this page
 *                  accepts both so that switching it needs no code change.
 *
 * Handles its own POST and always 303s.
 */
import Public from '../../layouts/Public.astro'
import { MIN_PASSWORD, notice, passwordProblem } from '../../lib/onboarding.ts'
import { sessionClient } from '../../lib/supabase/server.ts'

const PAGE = '/auth/new-password'
const FORGOT = '/auth/forgot-password'

/** Keep the link's credential on the URL while sending back a notice. */
function pageHref(code: string | null, tokenHash: string | null, noticeCode: string): string {
  const q = new URLSearchParams()
  if (code) q.set('code', code)
  if (tokenHash) q.set('token_hash', tokenHash)
  q.set('notice', noticeCode)
  return `${PAGE}?${q}`
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const code = String(form.get('code') ?? '') || null
  const tokenHash = String(form.get('token_hash') ?? '') || null
  const password = String(form.get('password') ?? '')
  const again = String(form.get('password_again') ?? '')

  // Nothing to spend. Somebody posted this form without a link behind it.
  if (!code && !tokenHash) return Astro.redirect(`${FORGOT}?notice=reset_link_missing`, 303)

  /**
   * CHECKED BEFORE THE LINK IS SPENT. A reset token works exactly once, so
   * exchanging it first and validating after would mean a mistyped password —
   * eight characters where the rule wants more, or two boxes that disagree —
   * burns the link and sends the customer back to their inbox for another one.
   */
  const problem = passwordProblem(password, again)
  if (problem) return Astro.redirect(pageHref(code, tokenHash, problem), 303)

  const supabase = sessionClient(Astro.cookies, Astro.request.headers)

  const { error: linkError } = tokenHash
    ? await supabase.auth.verifyOtp({ type: 'recovery', token_hash: tokenHash })
    : await supabase.auth.exchangeCodeForSession(code ?? '')

  /**
   * Back to the start rather than back to this form, because the form cannot
   * work a second time: the token is either dead or belongs to another browser.
   * The message is dropped on purpose — Supabase distinguishes an expired token
   * from one already used, and surfacing that tells whoever is holding an
   * intercepted link which one they have.
   */
  if (linkError) return Astro.redirect(`${FORGOT}?notice=reset_link_unusable`, 303)

  const { error: saveError } = await supabase.auth.updateUser({ password })
  // The link is spent by now, so there is nothing to retry on this page. The
  // honest instruction is to ask for another one.
  if (saveError) return Astro.redirect(`${FORGOT}?notice=password_not_saved`, 303)

  /**
   * Straight into the application, signed in. Verifying the token above IS a
   * sign-in, and asking somebody to type the password they chose four seconds
   * ago is a step that exists only because the redirect was lazy — the same
   * reasoning /auth/callback gives for not bouncing a confirmed signup to
   * /login. Middleware sends them to /app/setup if they have no carrier yet.
   */
  return Astro.redirect('/app', 303)
}

const params = Astro.url.searchParams
const code = params.get('code')
const tokenHash = params.get('token_hash')

/**
 * Supabase reports a REFUSED link in the query string rather than by failing an
 * exchange, so an expired one says so before the customer types anything. It is
 * the common failure on this page — reset links are opened late — and catching
 * it here is what stops somebody filling in two password boxes for nothing.
 */
const refused = params.get('error') ?? params.get('error_code')

const state = refused
  ? 'unusable'
  : code || tokenHash
    ? 'ready'
    : // No credential at all: a hand-typed URL, or a link that lost its query
      // string somewhere between the mail client and here.
      'missing'

const msg = notice(
  state === 'unusable'
    ? 'reset_link_unusable'
    : state === 'missing'
      ? 'reset_link_missing'
      : params.get('notice'),
)

const tone =
  msg?.tone === 'ok'
    ? 'bg-emerald-50 text-emerald-800'
    : msg?.tone === 'info'
      ? 'bg-sky-50 text-sky-900'
      : 'bg-red-50 text-red-700'

const field =
  'mt-1 w-full rounded-lg border border-ink-100 bg-white px-3 py-2.5 text-base outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20'
---

<Public title="Pick a new password" noindex>
  <section class="mx-auto max-w-sm px-4 py-16 sm:px-6">
    <h1 class="text-2xl font-semibold tracking-tight">Pick a new password</h1>

    {
      state === 'ready' && (
        <p class="mt-2 text-sm text-ink-500">
          Type your new password two times. Then you are signed in.
        </p>
      )
    }

    {msg && <p class:list={['mt-5 rounded-lg px-4 py-3 text-sm', tone]}>{msg.text}</p>}

    {
      state === 'ready' ? (
        <form method="POST" class="mt-6 space-y-4">
          {/*
            The link's credential travels with the form, never in a cookie of
            our own, and is read again on the server. It is spent in the POST
            above and only after the two boxes agree.
          */}
          {code && <input type="hidden" name="code" value={code} />}
          {tokenHash && <input type="hidden" name="token_hash" value={tokenHash} />}

          <label class="block">
            <span class="text-sm font-medium">New password</span>
            <input
              type="password"
              name="password"
              autocomplete="new-password"
              required
              minlength={MIN_PASSWORD}
              autofocus
              class={field}
            />
            <span class="mt-1 block text-xs text-ink-500">
              Use {MIN_PASSWORD} letters or numbers or more.
            </span>
          </label>

          <label class="block">
            <span class="text-sm font-medium">New password again</span>
            <input
              type="password"
              name="password_again"
              autocomplete="new-password"
              required
              minlength={MIN_PASSWORD}
              class={field}
            />
            <span class="mt-1 block text-xs text-ink-500">
              Type the same password one more time.
            </span>
          </label>

          {/*
            Said BEFORE the button. Two things happen when it is pressed and a
            person who is already locked out of one account should not have to
            guess at either of them.
          */}
          <p class="text-sm text-ink-500">
            When you press the button we save this password and sign you in. This link stops
            working after that.
          </p>

          <button
            type="submit"
            class="w-full rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white transition hover:bg-brand-700"
          >
            Save my new password
          </button>
        </form>
      ) : (
        <p class="mt-6">
          <a
            href={FORGOT}
            class="block w-full rounded-lg bg-brand-600 px-5 py-2.5 text-center font-medium text-white transition hover:bg-brand-700"
          >
            Ask for a new link
          </a>
        </p>
      )
    }

    <p class="mt-6 text-center text-sm text-ink-500">
      <a href="/login" class="font-medium text-brand-600 hover:underline">Back to sign in</a>
    </p>
  </section>
</Public>
