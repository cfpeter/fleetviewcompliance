---
/**
 * The DOT lookup the hero points at.
 *
 * This runs before signup and asks for nothing. It exists to answer one
 * question honestly — "does this thing actually know anything about MY fleet?"
 * — so every number on it is either read from the federal record or computed
 * from the DOT number itself. Nothing here is estimated.
 */
import Public from '../layouts/Public.astro'
import {
  lookupAuthority,
  lookupCarrier,
  normalizeDot,
  parseCensusDate,
  statusLabel,
  type AuthorityRow,
  type CensusRow,
  type FederalResult,
} from '../lib/fmcsa.ts'
import { mcs150Status } from '../lib/mcs150.ts'
import { operationLabel } from '../lib/onboarding.ts'

const raw = Astro.url.searchParams.get('dot') ?? ''
const dot = normalizeDot(raw)

let carrier: CensusRow | null = null
let authority: FederalResult<AuthorityRow> = { state: 'empty' }
let failed = false

if (dot) {
  try {
    // One round trip each, in parallel — together well under a second.
    // lookupAuthority never throws: it reports its own failure as a state, so a
    // dead authority endpoint cannot take down a carrier lookup that succeeded.
    const [c, a] = await Promise.all([lookupCarrier(dot), lookupAuthority(dot)])
    carrier = c
    authority = a
  } catch {
    failed = true
  }
}

const card = 'rounded-xl border border-ink-100 bg-white p-5'
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
// Socrata OMITS null keys rather than sending null, so a missing count arrives
// as undefined. Number('') is 0, though, so an empty string would render as a
// real zero — guard the blank explicitly rather than relying on isFinite.
const num = (v: string | undefined) => {
  if (v === undefined || v === null || v === '') return '—'
  const n = Number(v)
  return Number.isFinite(n) ? n.toLocaleString('en-US') : '—'
}
const money = (v: string | undefined) => {
  const n = Number(v)
  return Number.isFinite(n) ? `$${Math.round(n).toLocaleString('en-US')}` : null
}

const lastFiled = parseCensusDate(carrier?.mcs150_date)
const mcs150 = dot ? mcs150Status(dot, lastFiled) : null
const status = statusLabel(carrier?.status_code)

// Required vs actually on file. Both come from the same authority row, so this
// comparison is the federal record disagreeing with itself when it disagrees.
const authRows = authority.state === 'rows' ? authority.rows : []
const required = Number(authRows[0]?.min_cov_amount)
const onFile = Number(authRows[0]?.bipd_file)
const insuranceShort =
  Number.isFinite(required) && Number.isFinite(onFile) && onFile < required

const title = carrier
  ? `USDOT ${dot} · ${carrier.legal_name ?? 'Carrier'}`
  : 'Check your USDOT number'

/**
 * The shared badge, picked from the colour pair the library hands back.
 *
 * `statusLabel` and the authority rows still return a bare `bg-… text-…` pair,
 * which is a second badge construction living beside `.badge` in global.css —
 * different radius, different weight, and in the grey case `text-ink-500` on a
 * tint, which is under the floor. This maps the pair onto the shared set so a
 * status reads the same here as it does on every screen inside the app.
 */
const badgeFor = (tone: string): string =>
  tone.includes('emerald')
    ? 'badge badge-success'
    : tone.includes('red')
      ? 'badge badge-danger'
      : tone.includes('amber')
        ? 'badge badge-warning'
        : 'badge badge-neutral'
---

<Public
  title={title}
  description="Type a USDOT number. See the federal record and the next deadlines. Free."
  noindex
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
    <form method="GET" action="/check" class="mb-8 flex max-w-md flex-col gap-3 sm:flex-row">
      <input
        type="text"
        name="dot"
        inputmode="numeric"
        value={dot ?? ''}
        required
        placeholder="USDOT number"
        aria-label="USDOT number"
        class="w-full rounded-xl border border-ink-100 bg-white px-4 py-3 text-base tabular-nums outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
      />
      <button type="submit" class="btn btn-primary shrink-0 rounded-xl px-6">
        Check
      </button>
    </form>

    {!dot && raw && (
      <p class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
        That is not a USDOT number. A USDOT number has 1 to 8 digits, numbers only. Check it and
        type it again.
      </p>
    )}

    {failed && (
      <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
        The federal database did not answer. The problem is on their side, not yours. Wait a minute
        and press Check again.
      </p>
    )}

    {dot && !failed && !carrier && (
      <div class="rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
        <p class="font-medium">We found no carrier with USDOT {dot}</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          Check the number and try again. If you registered in the last few days, your record may
          not be in the public file yet.
        </p>
      </div>
    )}

    {carrier && (
      <>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {carrier.legal_name}
            </h1>
            {carrier.dba_name && (
              <p class="mt-1 text-sm text-ink-500">Doing business as {carrier.dba_name}</p>
            )}
            <p class="mt-1 text-sm text-ink-500">
              USDOT <span class="tabular-nums">{dot}</span>
              {carrier.phy_city && (
                <>
                  <span aria-hidden="true" class="mx-2 text-ink-300">·</span>
                  {carrier.phy_city}, {carrier.phy_state}
                </>
              )}
            </p>
          </div>
          <span class={badgeFor(status.tone)}>{status.label}</span>
        </div>

        {carrier.status_code === 'I' && (
          <p class="mt-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
            <strong>Inactive means one thing:</strong> your MCS-150 update was not filed. It is not
            a safety problem. File the update and the status clears. Rule: 49 CFR 390.19(b)(4).
          </p>
        )}

        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class={card}>
            <div class="text-xs tracking-wide text-ink-700 uppercase">Trucks</div>
            <div class="mt-1 text-3xl font-semibold tabular-nums">{num(carrier.power_units)}</div>
          </div>
          <div class={card}>
            <div class="text-xs tracking-wide text-ink-700 uppercase">Drivers</div>
            <div class="mt-1 text-3xl font-semibold tabular-nums">{num(carrier.total_drivers)}</div>
            <div class="mt-1 text-xs text-ink-700">{num(carrier.total_cdl)} have a CDL</div>
          </div>
          <div class={card}>
            <div class="text-xs tracking-wide text-ink-700 uppercase">Operation</div>
            <div class="mt-1 text-lg font-semibold">
              {/* operationLabel, not a ternary. A blank field in the federal file is
                  not a statement that he runs intrastate only, and that distinction
                  decides which half of the rule catalogue he is shown. */}
              {operationLabel(carrier.carrier_operation)}
            </div>
            <div class="mt-1 text-xs text-ink-700">
              {carrier.hm_ind === 'Y'
                ? 'Carries hazardous materials'
                : 'No hazardous materials on file'}
            </div>
          </div>
        </div>

        <h2 class="mt-10 text-xl font-semibold tracking-tight">What we can tell you now</h2>

        <div class="mt-4 space-y-4">
          {mcs150 && (
            <div
              class:list={[
                'rounded-xl border p-5',
                mcs150.state === 'overdue'
                  ? 'border-red-200 bg-red-50/60'
                  : mcs150.state === 'unknown'
                    ? 'border-ink-100 bg-white'
                    : 'border-brand-500/30 bg-brand-500/[0.04]',
              ]}
            >
              <div class="flex flex-wrap items-center gap-2">
                <p class="font-medium">MCS-150 update (every 2 years)</p>
                <span
                  class:list={[
                    'badge',
                    mcs150.state === 'overdue'
                      ? 'badge-danger'
                      : mcs150.state === 'unknown'
                        ? 'badge-neutral'
                        : 'badge-success',
                  ]}
                >
                  {mcs150.state === 'overdue'
                    ? 'Late'
                    : mcs150.state === 'unknown'
                      ? 'Not sure'
                      : 'Up to date'}
                </span>
              </div>

              {mcs150.state === 'overdue' ? (
                <>
                  <p class="mt-1 text-2xl font-semibold text-red-700 tabular-nums">
                    Was due {fmt(mcs150.lastDue)}
                  </p>
                  <p class="mt-2 text-sm text-ink-700">
                    The federal record shows your last filing on {fmt(lastFiled!)}. That is older
                    than the deadline above, so your update is late. This is the most common reason
                    a carrier shows as Inactive. File the update and it clears.
                  </p>
                  <p class="mt-2 text-sm text-ink-500">
                    Your next deadline after that is {fmt(mcs150.nextDue)}.
                  </p>
                </>
              ) : mcs150.state === 'unknown' ? (
                <>
                  <p class="mt-1 text-2xl font-semibold tabular-nums">{fmt(mcs150.nextDue)}</p>
                  <p class="mt-2 text-sm text-ink-500">
                    The federal record does not show the date of your last filing. So we cannot say
                    if you are up to date. We can only show you the next deadline.
                  </p>
                </>
              ) : (
                <>
                  <p class="mt-1 text-2xl font-semibold tabular-nums">{fmt(mcs150.nextDue)}</p>
                  <p class="mt-2 text-sm text-ink-500">
                    You filed on {fmt(lastFiled!)}. That covers the deadline of{' '}
                    {fmt(mcs150.lastDue)}.
                  </p>
                </>
              )}

              <p class="mt-3 text-xs text-ink-700">
                Your filing month comes from the last digit of your USDOT number. The year comes
                from the digit before it. You file in {mcs150.oddYears ? 'odd' : 'even'}-numbered
                years. Rule: 49 CFR 390.19T(b). If you miss it, FMCSA can fine you and turn off
                your USDOT number.
              </p>
            </div>
          )}

          {authority.state === 'rows' && (
            <div class={card}>
              <p class="font-medium">Operating authority</p>
              <ul class="mt-2 space-y-1 text-sm">
                {authRows.map((a) => (
                  <li class="flex flex-wrap items-center gap-2">
                    <span class="font-medium tabular-nums">{a.docket_number}</span>
                    <span class="text-ink-500">{a.op_auth_type}</span>
                    <span
                      class:list={[
                        'badge',
                        a.op_auth_status === 'Active' ? 'badge-success' : 'badge-warning',
                      ]}
                    >
                      {a.op_auth_status}
                    </span>
                  </li>
                ))}
              </ul>
              {money(authRows[0]?.min_cov_amount) && (
                <p class="mt-3 text-sm text-ink-500">
                  Liability insurance required: {money(authRows[0]?.min_cov_amount)}. On file:{' '}
                  {money(authRows[0]?.bipd_file) ?? '—'}.
                  {insuranceShort && (
                    <strong class="text-red-700"> This is less than the law requires.</strong>
                  )}
                </p>
              )}
            </div>
          )}

          {authority.state === 'empty' && (
            <div class={card}>
              <p class="font-medium">Operating authority</p>
              <p class="mt-2 text-sm text-ink-500">
                We found no authority record for this USDOT number. This does not mean you have no
                authority. The federal file does not list every carrier, and a carrier that drives
                only inside one state never needed one. We will check this with you. We will not
                guess.
              </p>
            </div>
          )}

          {authority.state === 'error' && (
            <div class="rounded-xl border border-ink-100 bg-white p-5">
              <p class="font-medium">Operating authority</p>
              <p class="mt-2 text-sm text-ink-500">
                We could not reach the federal authority file. We do not know your authority status
                right now, so we are showing nothing here. Wait a minute and reload this page.
              </p>
            </div>
          )}
        </div>

        <div class="mt-10 rounded-2xl border border-ink-100 bg-ink-50 p-6 sm:p-8">
          <h2 class="text-xl font-semibold tracking-tight">What we cannot see here</h2>
          <p class="mt-2 text-sm text-ink-500">
            The federal file has no driver records. Medical card dates, CDL dates, yearly MVR
            reviews, Clearinghouse checks, your CHP terminal inspection and your Clean Truck Check
            dates are only in your office. These are the dates that stop a truck. We set them up
            with you one time, then we watch them for you.
          </p>
          {/* Marketing chrome keeps the dark button. */}
          <a href="/pricing" class="btn btn-dark mt-5 rounded-xl px-7 py-3.5 font-semibold">
            See the price →
          </a>
        </div>

        {/* Was ink-300 at 1.85:1 — the line that says we are not the government,
            which is the one sentence on this page nobody may miss. */}
        <p class="mt-8 text-xs text-ink-700">
          This carrier data comes live from the FMCSA public census and authority files. FleetView
          Compliance is not part of FMCSA, the DOT, or any government agency.
        </p>
      </>
    )}
  </section>
</Public>
