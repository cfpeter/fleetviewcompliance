---
/**
 * Marketing home.
 *
 * The hero is a USDOT lookup, not a "Book a demo" button. A carrier can see
 * their own real deadlines before they give us an email address — which is the
 * one thing no competitor in this tier lets them do, and it costs us nothing
 * because the underlying FMCSA data is free and unauthenticated.
 */
import Public from '../layouts/Public.astro'
import { coverage } from '../lib/site.ts'

const card = 'rounded-xl border border-ink-100 bg-white p-5'

const steps = [
  {
    n: '1',
    title: 'Type your DOT number',
    body: 'We get your carrier record, your trucks, your drivers and your authority status from the federal database. You do not upload anything.',
  },
  {
    n: '2',
    title: 'We show you what expires next',
    body: 'One list, with the soonest date first. Federal deadlines, California deadlines, and the dates that are only on paper in your office. You type in only what the government does not already know.',
  },
  {
    n: '3',
    title: 'We email you before the date',
    body: 'You pick how many days ahead, and who gets the email. Text messages are not on yet. They are coming later.',
  },
]

const features = [
  {
    title: 'All your deadlines in one list',
    body: 'Medical cards, CDLs, annual MVR reviews, Clearinghouse queries, the annual DOT inspection, MCS-150, UCR and Form 2290. These are federal rules, so they are the same in every state. California rules go on top. The soonest date is first.',
  },
  {
    title: 'Loads and trips',
    body: 'Book a load, give it a driver and a truck, and track the stops. Loads with many stops are normal here. You do not pay extra for them. We count deadhead miles on their own, so your revenue per mile is the real number.',
  },
  {
    title: 'Dispatch checks the rules',
    body: 'If a driver medical card expired last week, you cannot give him a load. The app stops you right there on the dispatch screen, not in a report you read next month.',
  },
  {
    title: 'Email alerts you control',
    body: 'For each kind of deadline, pick how many days ahead you want to know and who gets the email. One email a day, not fourteen. Quiet hours, so nothing arrives at 2am about a renewal due next month.',
  },
  {
    title: 'Proof you can hand over',
    body: 'A dated packet for a broker, an insurance company, or an officer at the scale. It says what we saw and when. It links to the federal record, so the person reading it can check us.',
  },
]

const faqs = [
  // The first question a carrier outside California now asks, answered with the
  // count rather than with reassurance. Federal rules outnumber Californian ones
  // better than two to one, so "most of it" is a fact he can go and check, and
  // the sentence admitting what is missing is what earns the rest of the page.
  {
    q: 'I do not run in California. Is this for me?',
    a: `Yes, for most of it. ${coverage.federal} of the ${coverage.total} rules we track are federal: medical cards, CDLs, the annual MVR review and its signed note, Clearinghouse queries, the annual DOT inspection, MCS-150, UCR and Form 2290. Those are the same in every state. The other ${coverage.california} rules are California rules, and California is the only state we have added so far. If your state has its own extra rules, we do not track them yet. We will not pretend that we do. Other states are next.`,
  },
  {
    q: 'I run in California. What does that add?',
    a: 'Clean Truck Check testing and its yearly fee, the CHP terminal inspection program, your Motor Carrier Permit on its own schedule, and CVRA weight decals. These four can put a hold on your registration. Most national software leaves all four out. That is why we did California first.',
  },
  {
    q: 'Do I have to enter all my drivers and trucks?',
    a: 'No. With your DOT number we read your truck and driver counts, your address, your authority and your last MCS-150 filing from public federal data. You check it and fill in what is missing. That is mostly the dates that are only on paper in your office, like medical card expiry dates.',
  },
  {
    q: 'Do you file my paperwork for me?',
    a: 'No. We track your deadlines and keep your records. We tell you what is due, which form it is, and where it goes. You file it, or the service you already use files it. We are not a law firm.',
  },
  {
    q: 'Can you check the Drug and Alcohol Clearinghouse for me?',
    a: 'No. Be careful with anyone who says they can do it by logging in as you. Clearinghouse rules do not allow sharing your login, and they do not allow blanket consent. We track when each query is due and we keep your proof that you ran it.',
  },
  {
    q: 'What if I already use an ELD?',
    a: 'Keep it. We are not an ELD and we will not become one. We read hours and trip data from Motive, Samsara and others, so dispatch knows if a driver has enough hours to finish a run.',
  },
]
---

<Public
  title="FleetView Compliance"
  description="Deadline tracking, loads and trips for small US trucking fleets. Federal rules in every state, plus the California rules. Type your DOT number and see what expires next."
>
  <!-- Hero -->
  <section class="border-b border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="text-sm font-medium tracking-widest text-brand-600 uppercase">
        For small US fleets
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
        See what expires next, before it costs you money.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-500">
        A fleet with 12 trucks has more than 100 deadlines every year. Miss one and you can get
        a fine over $10,000, a hold on your registration, or a truck stopped at the scale. Type
        your DOT number and see your dates in about 10 seconds.
      </p>

      {/*
        `.field-affix` and `.field-affix-input` from global.css — the shared box
        that holds a control beside an input. The local version of it drew its
        own `focus-within:ring-2` and put `outline-none` on the input, which gave
        this box TWO focus indicators at once: the unlayered `:focus-visible`
        rule in global.css outranks `outline-none` on purpose, so the shared 2px
        ring was drawn anyway and the local halo sat under it at a different
        radius. One ring, the one every other control in the product uses.

        Explicit `for` rather than a wrapping label, and the hint moved out from
        under it: a <label> that wraps its control folds all of its text into that
        control's accessible name, so this box announced as "Your USDOT number No
        account, no email, no card. We read the public federal record." The hint
        is a description, and `aria-describedby` is how a description is said.

        `rounded-xl` and the padding are kept as utilities, which outrank the
        component class — the marketing shape does not change.
      */}
      <form method="GET" action="/check" class="mt-8 max-w-md">
        <label class="field-label" for="hero-dot">Your USDOT number</label>
        <div class="field-affix mt-1 rounded-xl">
          <input
            type="text"
            id="hero-dot"
            name="dot"
            inputmode="numeric"
            pattern="[0-9]*"
            required
            placeholder="e.g. 1234567"
            class="field-affix-input px-4 py-3.5 tabular-nums"
            aria-describedby="hero-dot-hint"
          />
          <button type="submit" class="btn btn-primary m-1 shrink-0">
            Check
          </button>
        </div>
        <p class="mt-2 text-xs text-ink-700" id="hero-dot-hint">
          No account, no email, no card. We read the public federal record.
        </p>
      </form>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-b border-ink-100">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-6 text-sm text-ink-500 sm:px-6"
    >
      <span>Federal deadlines in every state, plus the California ones</span>
      <span aria-hidden="true" class="hidden text-ink-500 sm:inline">·</span>
      <span>Your data is yours. We never sell it</span>
      <span aria-hidden="true" class="hidden text-ink-500 sm:inline">·</span>
      <span>No contract, cancel any month</span>
    </div>
  </section>

  <!-- Problem -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      One date is easy to miss.
    </h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class={card}>
        <p class="font-medium">The owner</p>
        <p class="mt-2 text-sm text-ink-500">
          You find out a driver medical card expired after he is loaded and 80 miles out. Now
          you choose between a late load and a driver who is not legal.
        </p>
      </div>
      <div class={card}>
        <p class="font-medium">The office</p>
        <p class="mt-2 text-sm text-ink-500">
          Your dates live in a spreadsheet, a wall calendar and one person's memory. That works
          until that person takes a week off.
        </p>
      </div>
      <div class={card}>
        <p class="font-medium">The audit</p>
        <p class="mt-2 text-sm text-ink-500">
          An officer asks for a driver qualification file. If you cannot show the paper, it does
          not count as done.
        </p>
      </div>
    </div>

    <div
      class="mt-8 rounded-xl border border-amber-300 bg-amber-50 p-5 text-sm text-amber-900"
    >
      <p class="font-medium">What a fine costs</p>
      <p class="mt-2">
        A Part 382 violation costs the employer up to{' '}
        <strong class="tabular-nums">$19,246</strong> and the driver{' '}
        <strong class="tabular-nums">$4,812</strong>. A Clearinghouse violation is{' '}
        <strong class="tabular-nums">$7,155</strong>. A recordkeeping violation is{' '}
        <strong class="tabular-nums">$1,584</strong> a day, up to{' '}
        <strong class="tabular-nums">$15,846</strong>.
      </p>
      <p class="mt-2 text-xs text-amber-800">
        These amounts come from 49 CFR 386 Appendix B and took effect on 30 December 2024. We
        name the rule so you can check it yourself.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Three steps. One evening.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-ink-100 bg-white p-5">
              <div class="flex size-8 items-center justify-center rounded-full bg-brand-500/10 text-sm font-semibold text-brand-700">
                {s.n}
              </div>
              <p class="mt-3 font-medium">{s.title}</p>
              <p class="mt-2 text-sm text-ink-500">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!--
    Where it works.

    This exists because the honest answer is a selling point and the vague one
    is a refund. A carrier outside California gets real value here — the federal
    catalogue is most of it and it does not stop at a state line — but he has to
    be told, before he pays, that his own state's extras are not in the product
    yet. The third card is the one that makes the other two believable.
  -->
  <section class="border-b border-ink-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
        Where it works.
      </h2>
      <p class="mt-3 max-w-2xl text-ink-500">
        Here is exactly what we cover and what we do not cover.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class={card}>
          <p class="text-sm font-medium tracking-widest text-brand-600 uppercase">
            Every US state
          </p>
          <p class="mt-3 font-medium">
            <span class="tabular-nums">{coverage.federal}</span> federal rules
          </p>
          <p class="mt-2 text-sm text-ink-500">
            The FMCSA, IRS and PHMSA rules. This is most of what any carrier owes: driver
            qualification, Clearinghouse queries, hours records, the annual inspection,
            MCS-150, UCR and Form 2290. They are the same in every state, so you get all of
            them wherever you run.
          </p>
        </div>
        <div class={card}>
          <p class="text-sm font-medium tracking-widest text-brand-600 uppercase">California</p>
          <p class="mt-3 font-medium">
            <span class="tabular-nums">{coverage.california}</span> state rules on top
          </p>
          <p class="mt-2 text-sm text-ink-500">
            Clean Truck Check, the CHP terminal inspection program, the Motor Carrier Permit,
            CVRA weight decals, and the fuel-tax and apportioned-plate filings that go through
            Sacramento. Most national software leaves these out. That is why we started here.
          </p>
        </div>
        <div class={card}>
          <p class="text-sm font-medium tracking-widest text-ink-500 uppercase">Not yet</p>
          <p class="mt-3 font-medium">The rules of other states</p>
          <p class="mt-2 text-sm text-ink-500">
            Today California is the only state we have added. If your state has extra rules of
            its own, we do not track them yet. We tell you now, not after you pay. More states
            are coming. For us a rule is data, not code, so adding a state means adding rules,
            not rebuilding the software.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">What you get</h2>
      {/* A button, not a bare link: it is an action beside a heading, and at
          14px type a text link is a 20px target on the screen this is read on. */}
      <a href="/features" class="btn btn-tertiary btn-sm -mr-3">
        All features →
      </a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class={card}>
            <p class="font-medium">{f.title}</p>
            <p class="mt-2 text-sm text-ink-500">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Straight answers</h2>
      <dl class="mt-8 space-y-4">
        {
          faqs.map((f) => (
            <div class="rounded-xl border border-ink-100 bg-white p-5">
              <dt class="font-medium">{f.q}</dt>
              <dd class="mt-2 text-sm text-ink-500">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="rounded-2xl border border-brand-500/30 bg-brand-500/[0.04] p-8 sm:p-12">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        See your own deadlines first.
      </h2>
      <p class="mt-4 max-w-xl text-ink-500">
        Type your DOT number. If it is not useful, close the page. You gave us nothing.
      </p>
      <form method="GET" action="/check" class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
        {/* `.field-input`, for the reason the hero box above uses the shared
            affix: the local construction drew a second focus ring under the one
            global.css draws anyway. The heading and the line above it are what
            name this box on screen, so it keeps its `aria-label`. */}
        <input
          type="text"
          name="dot"
          inputmode="numeric"
          pattern="[0-9]*"
          required
          placeholder="USDOT number"
          aria-label="Your USDOT number"
          class="field-input rounded-xl px-4 py-3.5 tabular-nums"
        />
        {/* Dark is the marketing chrome variant and stays dark out here. Inside
            /app the action colour is brand blue; this page is not /app. */}
        <button type="submit" class="btn btn-dark shrink-0 rounded-xl px-7 py-3.5 font-semibold">
          Check my fleet
        </button>
      </form>
    </div>
  </section>
</Public>
