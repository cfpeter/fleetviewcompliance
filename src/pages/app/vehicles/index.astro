---
/**
 * The fleet list.
 *
 * Power units and trailers live in ONE table split by `kind`, so this page is
 * also the only place the split is visible to the owner. The segmented control
 * is three plain links: a filtered view stays shareable, survives a back button,
 * and works on a phone with one bar of signal in a yard — which is where this
 * screen actually gets used.
 */
import Figure from '../../../components/charts/Figure.astro'
import Ring from '../../../components/charts/Ring.astro'
import App from '../../../layouts/App.astro'
import { monthBuckets } from '../../../lib/charts/scale.ts'
import {
  COVERAGE_NOTE,
  fleetLine,
  rowLine,
  TRAILER_NOTE,
  truckRing,
  type TruckRing,
} from '../../../lib/charts/truck-rings.ts'
import { loadDeadlines } from '../../../lib/deadlines.ts'
import { isActiveVehicle } from '../../../lib/fleet/active.ts'
import { removedMessage } from '../../../lib/fleet/remove.ts'
import { isDueSoon } from '../../../lib/charts/runway.ts'
import type { DeadlineItem } from '../../../lib/rules/index.ts'
import {
  byUnitNumber,
  gvwrReading,
  likeSafe,
  statusLabel,
  statusPillClass,
  vehicleLabel,
  type VehicleKind,
  type VehicleRow,
} from '../../../lib/vehicles.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

const params = Astro.url.searchParams
const rawKind = params.get('kind') ?? ''
// Anything that is not one of the two real kinds means "All". A bad ?kind= in a
// pasted URL must not produce an empty page that reads as an empty fleet.
const kind: VehicleKind | null =
  rawKind === 'power_unit' || rawKind === 'trailer' ? rawKind : null
const q = (params.get('q') ?? '').trim()
const error = params.get('error')
// A flag, not a sentence. The wording is in src/lib/fleet/remove.ts and never
// comes out of the query string — /app/billing documents why this app refuses to
// print query-string text back at the owner.
const removed = params.get('removed') === '1'

const search = likeSafe(q)

// No .eq('carrier_id', ...) anywhere here. RLS on `vehicles` already scopes this
// to the signed-in user's carrier, and adding the filter would say in code that
// we do not quite believe the policy — which is the sentence that eventually
// justifies someone reaching for a service-role client.
let query = supabase
  .from('vehicles')
  .select(
    'id, kind, unit_number, vin, make, model, model_year, gvwr_lbs, plate, plate_state, status, notes',
  )
  .limit(500)

if (search) {
  // ilike both columns. Chained .ilike() calls would AND, which finds nothing:
  // no string is both a unit number and a VIN.
  query = query.or(`unit_number.ilike.%${search}%,vin.ilike.%${search}%`)
}

// In the same round trip as the fleet itself. It is four more reads, not four
// more per truck: the engine takes the whole carrier at once and the scoring
// afterwards is arithmetic on what already came back.
const [{ data, error: loadError }, deadlines] = await Promise.all([
  query,
  loadDeadlines(supabase, carrierId),
])
const all = ((data ?? []) as VehicleRow[]).slice().sort(byUnitNumber)

// The segment counts are taken from the SEARCHED set, not from the whole fleet.
// Counted off everything, the control would say "3 trailers" while the search
// showing beneath it has none of them, and the owner would click through to an
// empty list and conclude the filter is broken.
const powerUnits = all.filter((v) => v.kind === 'power_unit')
const trailers = all.filter((v) => v.kind === 'trailer')
const shown = kind === 'power_unit' ? powerUnits : kind === 'trailer' ? trailers : all

/** A segment link that keeps the current search. */
function viewHref(k: string): string {
  const next = new URLSearchParams()
  if (k) next.set('kind', k)
  if (q) next.set('q', q)
  const s = next.toString()
  return `/app/vehicles${s ? `?${s}` : ''}`
}

const segments = [
  { key: 'power_unit', label: 'Power units', count: powerUnits.length },
  { key: 'trailer', label: 'Trailers', count: trailers.length },
  { key: '', label: 'All', count: all.length },
]

/**
 * The ring beside each unit number.
 *
 * `loadDeadlines` → `truckRing` → `buildHealth`, which is the same chain the
 * dashboard's own ring runs. The fleet table and the dashboard cannot disagree
 * about how many things are overdue, because only one of them counts.
 *
 * A TRAILER IS NOT A TRUCK AND IS NOT SCORED AS ONE. The engine already hands
 * a trailer only the rules written `subject: 'trailer'` — the annual § 396.17
 * inspection and keeping its report — so its denominator is 2 where a power
 * unit's is 7 or more. `truckRing` is told the kind and filters again on it, so
 * a Clean Truck Check or a Form 2290 can never reach a thing with no engine.
 * The IFTA screen made that mistake this morning and asked for miles on
 * trailers; the ring is where it would have been drawn in red.
 */
const observedAt = new Date()

const byVehicle = new Map<string, DeadlineItem[]>()
for (const i of deadlines) {
  if (i.subjectType !== 'power_unit' && i.subjectType !== 'trailer') continue
  if (!i.subjectId) continue
  const list = byVehicle.get(i.subjectId)
  if (list) list.push(i)
  else byVehicle.set(i.subjectId, [i])
}

/**
 * Only the units the engine actually looked at.
 *
 * `loadDeadlines` evaluates ACTIVE units and nothing else, so anything sold,
 * parked or out of service comes back with no items at all — and an empty list
 * scores as an empty circle. A blank ring on a truck he sold last year, next to
 * the nine he still runs, teaches him to ignore the shape. So a unit that is not
 * active gets a dash and the reason instead.
 *
 * The filter is the shared predicate, not a hand-written status test: this list
 * and the loader must never disagree about which units were looked at.
 */
const ringByVehicle = new Map<string, TruckRing>(
  shown
    .filter(isActiveVehicle)
    .map((v) => [v.id, truckRing(byVehicle.get(v.id) ?? [], v.kind, observedAt)]),
)

const rings = [...ringByVehicle.values()]
const answer = fleetLine(rings)
// Counted rather than assumed: the caveat is only true of the rows on screen.
const unscored = shown.length - rings.length
const showsTrailers = shown.some((v) => v.kind === 'trailer')

/**
 * THE DUE STRIP: one row per unit, one column per month, three months out.
 *
 * The table below answers "what is wrong with this unit". It cannot answer the
 * one an owner asks in the same breath — "what does the yard owe the calendar
 * between now and Christmas" — because that answer is a shape, and a shape made
 * of forty rows is only visible by reading all forty and holding them in your
 * head. Four inspections landing in the same month is a bad month whether or
 * not any single one of them is alarming on its own.
 *
 * FOUR COLUMNS OF THE FIVE ARE MONTHS; THE FIRST TWO ARE NOT, AND THAT IS THE
 * WHOLE POINT. A calendar can only hold things that have a date. Something
 * already past its date has no future month to sit in, and something nobody has
 * typed a date for has none either — on day one that is most of the yard. Drawn
 * as months alone, the fleet with eleven late inspections and thirty undated
 * ones gets three empty columns: the calmest picture in the app, shown to the
 * fleet that is most exposed. So "Overdue" and "No date" stand at the left of
 * the same strip, ahead of the months, and are counted first. The runway on the
 * dashboard has carried its own block on the left for the same reason — see the
 * header of src/lib/charts/runway.ts.
 *
 * The buckets are `buildHealth`'s, decided in `buildHealth`'s order: standing
 * first, and only then the number of days. See `dueMarks`.
 */
const stripMonths = monthBuckets(
  observedAt,
  new Date(Date.UTC(observedAt.getUTCFullYear(), observedAt.getUTCMonth() + 2, 1)),
)

/** Sorts after every real countdown, without the NaN that `Infinity - Infinity` gives. */
const NOTHING_DATED = 100_000

interface DueMark {
  /** Which of the four meanings this cell carries. Never colour alone — see the legend. */
  tone: 'act' | 'nodate' | 'soon' | 'ok'
  count: number
  /** Said in words for a reader who gets no colour at all. */
  said: string
}

interface DueRow {
  id: string
  label: string
  marks: DueMark[]
  /** Sort keys, worst first. */
  overdue: number
  noDate: number
  soonest: number
  drawn: number
}

/** How many dated items fall past the right edge of the strip. Declared, never dropped. */
let beyondStrip = 0

/**
 * One unit's row.
 *
 * A NEGATIVE COUNTDOWN IS NOT "COMING UP", and both sides of zero are guarded
 * here. A one-time duty that is already done comes back `current` with no next
 * date at all, and a computed one can come back `current` with a date behind us.
 * Neither is a gap and neither is a deadline: both are finished, so neither is
 * drawn and neither is counted as missing. Bucketing on the number of days
 * before the standing is the bug that has shipped in this codebase before.
 */
function dueMarks(items: readonly DeadlineItem[]): {
  marks: DueMark[]
  overdue: number
  noDate: number
  soonest: number
} {
  let overdue = 0
  let noDate = 0
  let soonest = NOTHING_DATED
  const months = stripMonths.map(() => ({ count: 0, tone: 'ok' as 'soon' | 'ok' }))

  for (const i of items) {
    const standing = i.status.standing
    // A duty with no schedule anybody can work out is not late, not coming up
    // and not a missing date. It has no cell here; the unit's own page names it.
    if (standing === 'unsupported' || standing === 'not_applicable') continue
    if (standing === 'overdue') {
      overdue++
      continue
    }
    if (standing === 'unknown') {
      noDate++
      continue
    }

    const due = i.status.nextDue
    const days = i.daysUntil
    if (!due || days === undefined || days < 0) continue

    const at = stripMonths.findIndex((m) => due >= m.start && due < m.end)
    if (at < 0) {
      beyondStrip++
      continue
    }
    months[at].count++
    // Amber wins the cell: a month holding one thing due inside 45 days and one
    // due at the end of it is an amber month, not a green one.
    //
    // `isDueSoon` rather than `days <= SOON_DAYS`, even though the `days < 0`
    // guard eleven lines up already makes the bare comparison correct here. That
    // guard being far away is the whole problem: this exact shape has shipped
    // wrong three times in this codebase, and each time it was correct when
    // written and broken by a later edit that moved or dropped the guard. The
    // predicate carries both sides of zero with it and cannot be separated.
    if (isDueSoon(days)) months[at].tone = 'soon'
    if (days < soonest) soonest = days
  }

  const marks: DueMark[] = [
    { tone: 'act', count: overdue, said: 'overdue' },
    { tone: 'nodate', count: noDate, said: 'with no date on file' },
    ...months.map((m, n) => ({
      tone: m.tone,
      count: m.count,
      said: `due in ${stripMonths[n].label}`,
    })),
  ]

  return { marks, overdue, noDate, soonest }
}

/**
 * Only the units with something in the window, and only when nothing is being
 * searched for.
 *
 * A strip of empty rows teaches the owner to skip the strip, and pushing the
 * rows somebody has just searched for further down the page undoes the reason
 * the search exists. What is left out is counted and said underneath, so an
 * absent row never reads as a unit with nothing to do.
 */
const STRIP_ROWS = 12

const allDueRows: DueRow[] = shown
  .filter((v) => ringByVehicle.has(v.id))
  .map((v) => {
    const counted = dueMarks(byVehicle.get(v.id) ?? [])
    return {
      id: v.id,
      label: vehicleLabel(v),
      marks: counted.marks,
      overdue: counted.overdue,
      noDate: counted.noDate,
      soonest: counted.soonest,
      drawn: counted.marks.reduce((n, m) => n + m.count, 0),
    }
  })

const withSomething = allDueRows
  .filter((r) => r.drawn > 0)
  // Worst first: late, then the dates we do not hold, then the soonest real
  // date. `shown` is already in unit-number order, and the sort is stable, so
  // two units with the same story stay in the order the table below lists them.
  .sort((a, b) => b.overdue - a.overdue || b.noDate - a.noDate || a.soonest - b.soonest)

const dueRows = withSomething.slice(0, STRIP_ROWS)
const quietUnits = allDueRows.length - withSomething.length
const stripHidden = withSomething.length - dueRows.length
const lastMonth = stripMonths[stripMonths.length - 1]?.label ?? ''

// The strip is drawn from the units on screen, so the caveats have to be too.
const stripCaveats = [
  COVERAGE_NOTE,
  `Only what is due by the end of ${lastMonth}.${
    beyondStrip > 0 ? ` ${beyondStrip} dated ${beyondStrip === 1 ? 'item is' : 'items are'} further out.` : ''
  }`,
  quietUnits > 0
    ? `${quietUnits} ${quietUnits === 1 ? 'unit has' : 'units have'} nothing in these three months, so ${quietUnits === 1 ? 'it is' : 'they are'} not on the strip.`
    : '',
  stripHidden > 0
    ? `${stripHidden} more ${stripHidden === 1 ? 'unit is' : 'units are'} not shown here. The table below has every one of them.`
    : '',
].filter(Boolean)

/**
 * The answer, not the name of the chart — and it names all three columns the
 * strip is made of. "Something due in the next three months" would be the
 * months only, and would read as though the two columns in front of them were
 * part of the same claim.
 */
const stripTitle = `${withSomething.length} of ${allDueRows.length} ${
  allDueRows.length === 1 ? 'unit has' : 'units have'
} something late, missing, or due by ${lastMonth}`

/** The dot in a cell. Grey is an absence, so it is drawn as an outline, never as a fill. */
const DUE_DOT: Record<DueMark['tone'], string> = {
  act: 'bg-red-500',
  nodate: 'border border-dashed border-ink-300',
  soon: 'bg-amber-500',
  ok: 'bg-emerald-500',
}
const DUE_TEXT: Record<DueMark['tone'], string> = {
  act: 'text-red-700',
  nodate: 'text-ink-500',
  soon: 'text-amber-800',
  ok: 'text-emerald-800',
}
/** Colour is never the only carrier. This is the same table, in words. */
const DUE_LEGEND: readonly { tone: DueMark['tone']; label: string }[] = [
  { tone: 'act', label: 'Overdue' },
  { tone: 'nodate', label: 'No date on file' },
  { tone: 'soon', label: 'Due within 45 days' },
  { tone: 'ok', label: 'Later' },
]
const stripHeadings = ['Overdue', 'No date', ...stripMonths.map((m) => m.label)]

// The add button carries the segment you are standing on, so "Add" from the
// Trailers tab pre-selects trailer instead of making that choice twice.
const addHref = kind ? `/app/vehicles/new?kind=${kind}` : '/app/vehicles/new'

const tab = 'rounded-lg px-3 py-1.5 text-sm font-medium transition'
const emptyAll = all.length === 0 && !q

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * The table is 56rem wide and the window on a 375px phone is about 341px, so
 * roughly 60% of every row was behind a sideways scroll — the status among it.
 * Below `sm` every cell becomes a block; from `sm` the same markup is a table
 * again. ONE set of cells, not two: a second copy of a row is a second place to
 * forget a rule. The pattern is written down in src/components/Documents.astro.
 *
 * THE BLOCKS ARE ORDERED, WHICH IS THE ONE ADDITION TO THAT PATTERN. A yard is
 * read by what is painted on the truck — the unit number, then the plate, then
 * the year and make. The VIN is 17 characters nobody scans a list by, and in
 * column order it was third, breaking across two lines above both of them.
 * `order-*` needs the row to be a flex column below `sm`; from `sm` it is
 * `table-row` again and the property is ignored, so the desktop table is
 * untouched and the header row still names the columns in their own order.
 */
const cell = 'block px-4 sm:table-cell sm:py-3'
/** The column name, said on the block that has no column. */
const said = 'text-ink-500 sm:hidden'
---

<App
  title="Trucks"
  subtitle="Power units and trailers. A tractor and its trailer each have their own inspection dates."
>
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}
  {
    removed && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        {removedMessage('vehicle')}
      </p>
    )
  }
  {
    loadError && (
      <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
        We could not load your fleet: {loadError.message}
      </p>
    )
  }

  <div class="mb-4 flex flex-wrap items-center gap-3">
    <div class="-mx-4 flex items-center gap-1 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0">
      {
        segments.map((s) => (
          <a
            href={viewHref(s.key)}
            class:list={[
              tab,
              (s.key === '' ? kind === null : s.key === kind)
                ? 'bg-brand-500/10 text-brand-700'
                : 'text-ink-500 hover:bg-ink-100 hover:text-ink-900',
            ]}
          >
            {s.label}
            <span class="ml-1.5 text-xs tabular-nums opacity-70">{s.count}</span>
          </a>
        ))
      }
    </div>

    <form method="GET" class="ml-auto flex items-center gap-2">
      {/* Carried so a search does not silently drop you back to All. */}
      {kind && <input type="hidden" name="kind" value={kind} />}
      <div class="relative">
        <svg
          class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-ink-300"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Unit number or VIN…"
          aria-label="Search by unit number or VIN"
          class="w-56 rounded-lg border border-ink-100 bg-white py-2 pr-3 pl-10 text-base outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 sm:w-64"
        />
      </div>
      <button
        type="submit"
        class="rounded-lg border border-ink-100 px-4 py-2 text-sm font-medium transition hover:bg-ink-50"
      >
        Search
      </button>
    </form>

    <a
      href={addHref}
      class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-brand-700"
    >
      Add a vehicle
    </a>
  </div>

  {
    q && (
      <p class="mb-4 text-sm text-ink-500">
        <span class="tabular-nums">{shown.length}</span>
        {shown.length === 1 ? ' match' : ' matches'} for “{q}”.
        <a href={viewHref(kind ?? '')} class="ml-2 font-medium text-brand-600 hover:underline">
          Clear
        </a>
      </p>
    )
  }

  {
    shown.length === 0 ? (
      <div class="rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
        <p class="font-medium">{emptyAll ? 'No trucks yet' : 'Nothing here matches'}</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          {emptyAll
            ? 'Add a power unit or a trailer. You can start with just the unit number. Add the VIN, the weight and the dates later.'
            : 'No vehicle in this view matches. Try the All tab, or type a shorter part of the VIN.'}
        </p>
        {emptyAll && (
          <a
            href={addHref}
            class="mt-4 inline-block rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-brand-700"
          >
            Add a vehicle →
          </a>
        )}
      </div>
    ) : (
      <>
        {/*
          The answer, not the name of a chart. One sentence that says how much
          of the yard has something outstanding, ABOVE the table while the rings
          sit INSIDE it — a work surface leads with its rows, and nothing here
          pushes the first truck down the page.
        */}
        <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
          <span class="text-ink-500">
            <span class="tabular-nums">{shown.length}</span>
            {shown.length === 1 ? ' unit' : ' units'}
          </span>
          {answer && <span class="font-medium">{answer}</span>}
        </div>

        {/*
          What the rings do NOT cover, beside them rather than in a footnote.
          The shape is taken in before any prose is read, so the caveat has to
          be where the shape is.
        */}
        <p class="mb-3 text-xs text-ink-500">
          The circle is the deadlines we track for that one unit. It counts the dates you typed
          in. Nobody here has looked at the truck or the paper.
          {showsTrailers && <span> {TRAILER_NOTE}</span>}
          {unscored > 0 && (
            <span>
              {' '}
              <span class="tabular-nums">{unscored}</span>
              {unscored === 1 ? ' unit here is not Active' : ' units here are not Active'}, so we
              do not check {unscored === 1 ? 'it' : 'them'} and you do not pay for
              {unscored === 1 ? ' it' : ' them'}.
            </span>
          )}
        </p>

        {/*
          THE STRIP SITS ABOVE THE TABLE AND IS KEPT SHORT ON PURPOSE.
          docs/charts.md: a work surface leads with its rows, so every line here
          is earning its height against the first truck being pushed down a
          phone screen. Twelve rows at a time, none of them empty, and nothing
          at all while a search is on screen.
        */}
        {
          !q && dueRows.length > 0 && (
            <Figure
              title={stripTitle}
              subtitle="Each dot is something due that month. The first two columns are not months."
              coverage={stripCaveats}
              class="mb-4"
            >
              <div class="-mx-1 overflow-x-auto px-1">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="text-ink-500">
                      <th scope="col" class="py-1 pr-3 text-left font-medium">
                        Unit
                      </th>
                      {stripHeadings.map((h) => (
                        <th
                          scope="col"
                          class="px-1 pb-1 text-center font-medium whitespace-nowrap"
                        >
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-ink-100">
                    {dueRows.map((r) => (
                      <tr>
                        <th scope="row" class="max-w-[9rem] py-1 pr-3 text-left font-medium">
                          <a
                            href={`/app/vehicles/${r.id}`}
                            class="block truncate py-1.5 hover:text-brand-600 hover:underline"
                          >
                            {r.label}
                          </a>
                        </th>
                        {r.marks.map((m) => (
                          <td class="px-1 text-center">
                            {m.count > 0 ? (
                              <span class="inline-flex items-center gap-1">
                                <span
                                  class:list={['size-2.5 shrink-0 rounded-full', DUE_DOT[m.tone]]}
                                  aria-hidden="true"
                                />
                                <span
                                  class:list={['font-medium tabular-nums', DUE_TEXT[m.tone]]}
                                  aria-hidden="true"
                                >
                                  {m.count}
                                </span>
                                {/* The colour carries nothing on its own, so the
                                    cell says the whole thing in words for a
                                    reader who never sees it. */}
                                <span class="sr-only">
                                  {m.count} {m.said}
                                </span>
                              </span>
                            ) : (
                              <span class="text-ink-200">
                                <span aria-hidden="true">·</span>
                                <span class="sr-only">none</span>
                              </span>
                            )}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-500">
                {DUE_LEGEND.map((l) => (
                  <li class="flex items-center gap-1.5 whitespace-nowrap">
                    <span
                      class:list={['size-2 shrink-0 rounded-full', DUE_DOT[l.tone]]}
                      aria-hidden="true"
                    />
                    {l.label}
                  </li>
                ))}
              </ul>
            </Figure>
          )
        }

        <div class="overflow-x-auto rounded-xl border border-ink-100 bg-white">
        <table class="w-full text-sm sm:min-w-[56rem]">
          {/*
            No header line on a phone. Six column names above blocks that are not
            columns explain nothing — each block says what it is in its own words
            instead.

            STATUS MOVED TO THE SECOND COLUMN. On a phone the block reads down,
            so the second column is the second line — and the second thing an
            owner wants after the unit number is whether the unit is still his to
            worry about. It was last, which on a phone is the bottom of the
            block and off the right edge of the old sideways scroll.
          */}
          <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-500 uppercase sm:table-header-group">
            <tr>
              <th class="px-4 py-3 font-medium">Unit</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3 font-medium">VIN</th>
              <th class="px-4 py-3 font-medium">Year / make / model</th>
              <th class="px-4 py-3 font-medium">Plate</th>
              <th class="px-4 py-3 text-right font-medium">GVWR</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {shown.map((v) => {
              const gvwr = gvwrReading(v.gvwr_lbs)
              const ymm = [v.model_year, v.make, v.model].filter(Boolean).join(' ')
              const ring = ringByVehicle.get(v.id)
              return (
                <tr class="flex flex-col py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                  {/* The ring lives in the FIRST column, with the unit number,
                      and on a phone that block is what the row leads with: the
                      unit number, and whether anything on it is outstanding.
                      A seventh column would be a seventh line nobody reads. */}
                  <td class={`${cell} order-1`}>
                    <div class="flex items-center gap-3">
                      {ring ? (
                        <Ring ring={ring} size={34} />
                      ) : (
                        <span
                          class="flex size-[34px] shrink-0 items-center justify-center rounded-full border border-dashed border-ink-200 text-ink-300"
                          aria-hidden="true"
                        >
                          —
                        </span>
                      )}
                      <div class="min-w-0">
                        <a
                          href={`/app/vehicles/${v.id}`}
                          class="font-medium hover:text-brand-600 hover:underline"
                        >
                          {vehicleLabel(v)}
                        </a>
                        {/* The numbers, in words, under the unit number: the
                            ring is never the only carrier. One man in twelve
                            cannot separate the red arc from the amber one. */}
                        <div class="text-xs tabular-nums">
                          {ring ? (
                            <a
                              href={`/app/vehicles/${v.id}#dates`}
                              class="text-ink-500 hover:text-brand-600 hover:underline"
                            >
                              {rowLine(ring)}
                            </a>
                          ) : (
                            <span class="text-ink-300">Not checked — not Active</span>
                          )}
                        </div>
                        <div class="text-xs text-ink-300">
                          {v.kind === 'trailer' ? 'Trailer' : 'Power unit'}
                        </div>
                      </div>
                    </div>
                  </td>
                  {/* Second: is this unit still one we watch and charge for. */}
                  <td class={`${cell} order-2 mt-1.5 sm:mt-0`}>
                    <span
                      class:list={[
                        'rounded-md px-2 py-0.5 text-xs font-medium whitespace-nowrap',
                        statusPillClass(v.status),
                      ]}
                    >
                      {statusLabel(v.status)}
                    </span>
                  </td>
                  {/* LAST ON A PHONE. It is the longest string on the row and the
                      one nobody reads a list by — it is copied off a title or a
                      registration when there is a reason to. */}
                  <td
                    class={`${cell} order-6 mt-1.5 font-mono text-xs tracking-tight break-all text-ink-500 tabular-nums sm:mt-0 sm:break-normal`}
                  >
                    <span class={`${said} font-sans`}>VIN </span>
                    {v.vin ?? <span class="font-sans text-ink-300">Not given</span>}
                  </td>
                  {/* Third and fourth: what the truck looks like and what is on
                      the back of it. This is how a unit is recognised standing
                      in front of it. */}
                  <td class={`${cell} order-3 mt-1 sm:mt-0`}>
                    {ymm || <span class="text-ink-300">Not given</span>}
                  </td>
                  <td class={`${cell} order-4 mt-1 whitespace-nowrap sm:mt-0`}>
                    <span class={said}>Plate </span>
                    {v.plate ? (
                      <>
                        <span class="tabular-nums">{v.plate}</span>
                        {v.plate_state && <span class="ml-1 text-ink-500">{v.plate_state}</span>}
                      </>
                    ) : (
                      <span class="text-ink-300">Not given</span>
                    )}
                  </td>
                  {/*
                    NULL renders as "Unknown", in amber, and never as a dash.
                    A blank or a dash in a weight column reads as "this truck is
                    under the line" — the engine reads it as the opposite, and
                    treats the unit as fully regulated.
                  */}
                  <td
                    class={`${cell} order-5 mt-1 tabular-nums sm:mt-0 sm:text-right ${gvwr.className}`}
                  >
                    <span class={said}>GVWR </span>
                    {gvwr.text}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
        </div>
      </>
    )
  }

  {
    all.some((v) => v.gvwr_lbs === null) && (
      <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
        <span class="tabular-nums">{all.filter((v) => v.gvwr_lbs === null).length}</span> of these
        have no GVWR on file. That does not make them exempt. We treat a truck of unknown weight
        as fully regulated, so every weight-based deadline stays on until you fill the weight in.
      </p>
    )
  }
</App>
