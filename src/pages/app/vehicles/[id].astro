---
/**
 * One vehicle: the record, and the dates the rule engine reads off it.
 *
 * The dates are the point. Everything above them is bookkeeping the owner does
 * once; the "Compliance dates" card is what turns a row in a table into a
 * dashboard that knows when his truck stops being legal.
 *
 * Two things about that card are not negotiable and are commented where they
 * happen: every field asks for the LAST time something happened rather than the
 * next time it is due, and saving APPENDS. A compliance record is evidence that
 * the unit was in order during the period it covers, so it is never overwritten
 * and never deleted — the grant on the table does not even include DELETE.
 */
import Figure from '../../../components/charts/Figure.astro'
import Ring from '../../../components/charts/Ring.astro'
import Documents from '../../../components/Documents.astro'
import { type AnswerEntry, anchorSlot, planAnchorWrites } from '../../../lib/anchors/plan.ts'
import {
  COVERAGE_NOTE,
  noScheduleNote,
  ringSubtitle,
  TRAILER_NOTE,
  truckLine,
  truckRing,
} from '../../../lib/charts/truck-rings.ts'
import { loadDeadlines } from '../../../lib/deadlines.ts'
import {
  type DocumentRow,
  DOCUMENT_COLUMNS,
  requestTooLarge,
  uploadFromForm,
} from '../../../lib/documents.ts'
import { isActiveVehicle, VEHICLE_NOT_ACTIVE_MEANS } from '../../../lib/fleet/active.ts'
import { daysBetween, toUtcMidnight } from '../../../lib/rules/dates.ts'
import { type DeadlineItem, dueLine, SOON_DAYS } from '../../../lib/rules/index.ts'
import {
  canRemove,
  confirmBody,
  confirmTitle,
  refusalFor,
  remindersLine,
  vehicleHistory,
} from '../../../lib/fleet/remove.ts'
import App from '../../../layouts/App.astro'
import {
  anchorByKey,
  anchorsForKind,
  formatDay,
  gvwrReading,
  kindLabel,
  parseAnchorDate,
  parseOptionalInt,
  parseStateCode,
  parseVin,
  parseVinEdit,
  statusLabel,
  statusPillClass,
  textOrNull,
  upperOrNull,
  VEHICLE_KINDS,
  VEHICLE_STATUSES,
  vehicleLabel,
  vinCheckDigitMismatch,
  type VehicleRow,
} from '../../../lib/vehicles.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!
const id = Astro.params.id!

const COLUMNS =
  'id, kind, unit_number, vin, make, model, model_year, gvwr_lbs, plate, plate_state, status, notes'

// RLS decides whether this row is visible; there is no carrier_id filter here
// and there must not be one. A vehicle belonging to another carrier does not
// come back as "forbidden", it simply does not exist as far as this query is
// concerned — which is the same answer a bad id gets, and the right one.
const { data: found } = await supabase.from('vehicles').select(COLUMNS).eq('id', id).maybeSingle()

if (!found) {
  return Astro.redirect(
    '/app/vehicles?error=' + encodeURIComponent('That vehicle is not in your fleet.'),
    303,
  )
}
const vehicle = found as unknown as VehicleRow

const maxYear = new Date().getUTCFullYear() + 2

if (Astro.request.method === 'POST') {
  // Every branch below ends here. 303 and not the 302 Astro.redirect() defaults
  // to: a 302 permits the browser to repeat the POST at the new location, so a
  // refresh after saving dates would append the same compliance records again —
  // and on an append-only table there is no undo for that beyond withdrawing
  // each duplicate by hand.
  const go = (query: string) => Astro.redirect(`/app/vehicles/${vehicle.id}${query}`, 303)
  const fail = (message: string, hash = '') =>
    go(`?error=${encodeURIComponent(message)}${hash}`)

  // BEFORE the body is read, because formData() buffers the whole request. The
  // real size rule is measured on the bytes in checkFile(); this only keeps an
  // enormous post from being pulled into memory first.
  // A document error, not the page's generic one, so it lands beside the file
  // box rather than at the top of the page above the vehicle form.
  const oversized = requestTooLarge(Astro.request)
  if (oversized) return go(`?doc_error=${encodeURIComponent(oversized)}#documents`)

  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  if (intent === 'upload_document') {
    // Shared with the driver page. See src/lib/documents.ts for the storage key,
    // the type sniff and the write order.
    return go(
      `?${await uploadFromForm({
        form,
        supabase,
        carrierId,
        userId: Astro.locals.userId ?? null,
        subjectType: 'vehicle',
        subjectId: vehicle.id,
      })}`,
    )
  }

  if (intent === 'save') {
    const kind = String(form.get('kind') ?? '')
    if (kind !== 'power_unit' && kind !== 'trailer') {
      return fail('Tell us whether this is a power unit or a trailer.')
    }

    const status = String(form.get('status') ?? '')
    if (!VEHICLE_STATUSES.some((s) => s.value === status)) {
      return fail('That is not a status we recognise.')
    }

    // Parsed, not merely uppercased. Editing is where a VIN gets re-typed off a
    // photograph of the door plate, and a character wrong here is a truck CARB
    // and the inspection record will never match — reported on a dashboard that
    // looks complete. It also has to reach `vehicles_vin_unique` in ONE spelling
    // or the duplicate guard is defeated by a space.
    //
    // Edit-aware, though, and that half matters just as much. The rules are
    // newer than some of the rows: VINs already on file fail them, and judging
    // what was POSTED would mean an owner updating a BIT inspection date is
    // refused over a VIN box he never put a cursor in — the whole record locked
    // out of the product by a field he did not touch, with no way through short
    // of inventing a VIN. So an unchanged value goes back exactly as it came out
    // of the column, unnormalised, and only a VIN he actually typed is held to
    // the rules. The amber note under the field is where he hears about the one
    // on file, since a save will never tell him again.
    const vin = parseVinEdit(form.get('vin'), vehicle.vin)
    if (!vin.ok) return fail(vin.message)

    const year = parseOptionalInt(form.get('model_year'), { label: 'Year', min: 1900, max: maxYear })
    if (!year.ok) return fail(year.message)

    // min 1 rather than min 0, deliberately. A blank box is already NULL by the
    // time it gets here, so a 0 arriving at this line was typed — and 0 lb is
    // below every threshold in the catalogue, which would switch off the annual
    // inspection, the BIT cycle, Clean Truck Check and CVRA in one keystroke.
    const gvwr = parseOptionalInt(form.get('gvwr_lbs'), { label: 'GVWR', min: 1, max: 200_000 })
    if (!gvwr.ok) return fail(gvwr.message)

    const plateState = parseStateCode(form.get('plate_state'))
    if (!plateState.ok) return fail(plateState.message)

    // carrier_id is deliberately absent from this update. It is set once, on
    // insert, and the WITH CHECK half of the policy exists precisely to stop a
    // row being moved into another carrier by an UPDATE — so writing it here
    // would be writing the one column this table never changes.
    const { error } = await supabase
      .from('vehicles')
      .update({
        kind,
        status,
        unit_number: textOrNull(form.get('unit_number')),
        vin: vin.value,
        make: textOrNull(form.get('make')),
        model: textOrNull(form.get('model')),
        model_year: year.value,
        gvwr_lbs: gvwr.value,
        plate: upperOrNull(form.get('plate')),
        plate_state: plateState.value,
        notes: textOrNull(form.get('notes')),
      })
      .eq('id', vehicle.id)

    if (error) {
      return fail(
        error.message.includes('vehicles_vin_unique')
          ? 'Another vehicle in your fleet already has that VIN.'
          : error.message,
      )
    }
    return go('?saved=1')
  }

  if (intent === 'save_dates') {
    // What is current comes from the view, never re-derived here. The view
    // settles a genuinely hard question — occurred_on wins, recorded_at only
    // breaks ties — and a second copy of that rule in page code is a second
    // copy to drift.
    const { data: currentRows } = await supabase
      .from('current_compliance_anchors')
      .select('id, anchor_key, occurred_on')
      .eq('subject_type', 'vehicle')
      .eq('subject_id', vehicle.id)

    const current = new Map<string, { id: string; occurred_on: string }>()
    for (const r of currentRows ?? []) {
      current.set(anchorSlot('vehicle', vehicle.id, String(r.anchor_key)), {
        id: String(r.id),
        occurred_on: String(r.occurred_on).slice(0, 10),
      })
    }

    const entries: AnswerEntry[] = []
    for (const anchor of anchorsForKind(vehicle.kind)) {
      const parsed = parseAnchorDate(form.get(`date_${anchor.key}`), anchor.label)
      // Validate the whole form before writing any of it. A partial save would
      // leave the owner looking at a screen where some boxes took and some did
      // not, with one error message to explain it.
      if (!parsed.ok) return fail(parsed.message, '#dates')

      // Blank means "I still do not know", not "remove what you have". There is
      // no DELETE grant on compliance_records and there should not be: a
      // superseded date is the evidence the unit was in order during the period
      // it covered. Taking one back is the explicit Withdraw button below.
      entries.push({
        subject: 'vehicle',
        subjectId: vehicle.id,
        anchorKey: anchor.key,
        on: parsed.value,
      })
    }

    /**
     * THIS SCREEN USED TO INSERT WITHOUT EVER SUPERSEDING.
     *
     * Correcting a fat-fingered 2027 down to 2026 wrote a perfectly good row
     * that `current_compliance_anchors` then ignored — it picks the latest
     * occurred_on, not the latest typed. The page redirected saying "1 date
     * saved" and re-rendered the field still showing 2027. The Withdraw button
     * below was the only way through, and nothing on the screen said so.
     *
     * The driver page had already solved this. Sharing the decision rather than
     * copying it is the point: unchanged values are still skipped, a later date
     * still leaves the old row standing as evidence the unit was in order during
     * the period it covered, and there is now one implementation under test.
     */
    const { supersede, inserts, conflicts } = planAnchorWrites({
      entries,
      current,
      carrierId,
      userId: Astro.locals.userId ?? null,
      recordedAt: new Date().toISOString(),
    })

    // Unreachable from this form — one input per anchor — but a planner that can
    // refuse must not be allowed to refuse silently.
    if (conflicts.length > 0) {
      return fail('You typed two different dates for the same field.', '#dates')
    }

    if (supersede.length > 0) {
      // Permitted by the append-only trigger: it forbids changing the carrier,
      // the subject, the anchor or the date, and superseded_at is none of those.
      const { error } = await supabase
        .from('compliance_records')
        .update({ superseded_at: new Date().toISOString() })
        .in('id', supersede)
      if (error) return fail(error.message, '#dates')
    }

    if (inserts.length > 0) {
      // INSERT, always. Correcting a date is a new row, not an edit of the old
      // one — the database enforces that too, with a trigger that refuses any
      // UPDATE which changes occurred_on.
      const { error } = await supabase.from('compliance_records').insert(inserts)
      if (error) return fail(error.message, '#dates')
    }
    return go(`?dates=${inserts.length}#dates`)
  }

  /**
   * Delete the unit — and refuse whenever there is anything to preserve.
   *
   * CHECKED AGAIN HERE even though the panel below already checked before it
   * drew the button. The ordinary way this fires is a tab left open: the screen
   * was drawn this morning when the row was empty, and a document was uploaded
   * against it at noon. The button was enabled. The answer is still no.
   *
   * A refusal goes back to the panel rather than to a generic error, because the
   * panel is where the refusal is written out in full — what is on file, why we
   * keep it, and the status change to make instead. See src/lib/fleet/remove.ts.
   */
  if (intent === 'delete') {
    const report = await vehicleHistory(supabase, vehicle.id)
    if (!canRemove(report)) return go('?confirm=delete#delete')

    // No carrier_id filter: RLS already makes another carrier's row invisible to
    // this statement, and 0028_fleet_delete_guard.sql is the backstop under it —
    // the same list of checks, in the database, where a privilege the role
    // actually holds cannot be talked out of by an app that forgot to look.
    const { error } = await supabase.from('vehicles').delete().eq('id', vehicle.id)
    if (error) return go('?confirm=delete#delete')

    return Astro.redirect('/app/vehicles?removed=1', 303)
  }

  if (intent === 'withdraw_date') {
    const recordId = String(form.get('record_id') ?? '')
    if (!recordId) return fail('Nothing to withdraw.', '#history')

    // Supersede, do not delete — and this is the only UPDATE this page makes to
    // a compliance record. It touches superseded_at and nothing else, which is
    // exactly what the append-only trigger permits: the date itself is
    // immutable, the claim that it is still the live one is not.
    //
    // `.is('superseded_at', null)` keeps a double-click from moving the
    // withdrawal time on a row that was already withdrawn.
    const { error } = await supabase
      .from('compliance_records')
      .update({ superseded_at: new Date().toISOString() })
      .eq('id', recordId)
      .is('superseded_at', null)

    if (error) return fail(error.message, '#history')
    return go('?withdrew=1#history')
  }

  return fail('That button did not tell us what to do. Try again.')
}

// --- GET -------------------------------------------------------------------

const [{ data: anchorRows }, { data: historyRows }, { data: documentRows }, allDeadlines] =
  await Promise.all([
  supabase
    .from('current_compliance_anchors')
    .select('id, anchor_key, occurred_on, source')
    .eq('subject_type', 'vehicle')
    .eq('subject_id', vehicle.id),
  supabase
    .from('compliance_records')
    .select('id, anchor_key, occurred_on, source, note, recorded_at, superseded_at')
    .eq('subject_type', 'vehicle')
    .eq('subject_id', vehicle.id)
    .order('occurred_on', { ascending: false })
    .order('recorded_at', { ascending: false }),
  // Both filters matter. RLS keeps this to the carrier; the subject keeps it to
  // this unit. A document id alone never opens anything — see the download route.
  supabase
    .from('documents')
    .select(DOCUMENT_COLUMNS)
    .eq('subject_type', 'vehicle')
    .eq('subject_id', vehicle.id)
    .order('uploaded_at', { ascending: false })
    .limit(200),
  // The rule engine, in the same round as everything else. It is what the
  // dashboard's own ring is drawn from, so the circle in the sidebar and the
  // count on the front page cannot disagree about this unit.
  loadDeadlines(supabase, carrierId),
])

const documents = (documentRows ?? []) as unknown as DocumentRow[]

/**
 * This unit's ring.
 *
 * Gated on ACTIVE because `loadDeadlines` now evaluates active units and nothing
 * else: anything sold, parked or out of service comes back with no items at all,
 * which would draw an empty circle and read as "we know nothing about this
 * truck" rather than "you took it off the fleet". The gate and the loader share
 * one predicate — src/lib/fleet/active.ts — so this cannot drift into drawing a
 * blank ring the day the rule changes.
 *
 * `vehicle.kind` is passed in and is load-bearing. A TRAILER HAS NO ENGINE, so
 * the catalogue gives it two rules — the annual § 396.17 inspection and keeping
 * the report — against seven or more for a power unit, and `truckRing` filters
 * on the kind a second time so a Clean Truck Check or a Form 2290 can never be
 * counted against a thing that cannot owe one. Judged on a power unit's list a
 * trailer in perfect order would sit at 2/9 in red, which is the same mistake
 * as asking it for mileage.
 */
const unitRing = !isActiveVehicle(vehicle)
  ? null
  : truckRing(allDeadlines.filter((i) => i.subjectId === vehicle.id), vehicle.kind, new Date())

// The trailer sentence and the unschedulable count are caveats on the figure,
// not footnotes under it: the shape is read before any prose is.
const ringCaveats = unitRing
  ? [
      COVERAGE_NOTE,
      vehicle.kind === 'trailer' ? TRAILER_NOTE : undefined,
      noScheduleNote(unitRing),
    ].filter((s): s is string => Boolean(s))
  : []

/**
 * THE TIMELINE, AND WHY IT IS IN THE ORDER THE ENGINE HANDS IT OVER.
 *
 * `evaluate` sorts by `compareDeadlines`: past its date first, then the ones we
 * hold no date for, then the dated ones soonest first, then the duties with no
 * schedule anybody can work out. That is the order every other screen in this
 * app reads in, and it is not calendar order — a row nobody has typed a date
 * for has no place on a calendar at all. Re-sorted by date, those rows would
 * fall to the bottom of the list, under the fold, on the one page where he
 * would go to type the date in. So the engine's order stands.
 *
 * `subjectType` is filtered a second time on purpose. A trailer has no engine,
 * so no Clean Truck Check, no Form 2290 and no fuel tax may ever appear on one
 * — the same belt-and-braces `truckRing` does above.
 */
const unitItems = allDeadlines.filter(
  (i) => i.subjectId === vehicle.id && i.subjectType === vehicle.kind,
)

/** The five things a row on the timeline can be. Four are the ring's buckets. */
type Mark = 'act' | 'nodate' | 'soon' | 'ok' | 'read'

const day0 = toUtcMidnight(new Date())

/**
 * Which mark a row gets — `buildHealth`'s buckets, decided in its order.
 *
 * STANDING FIRST, DAYS SECOND, AND BOTH SIDES OF ZERO GUARDED. A NEGATIVE
 * COUNTDOWN IS NOT "COMING UP": a one-time duty done the week the truck was
 * bought comes back `current` with a date behind us, or with no date at all,
 * and `<= 45` is true for the first of those. Bucketing on the number before
 * the standing is how finished work ends up under a heading about the next 45
 * days, which has shipped in this codebase more than once.
 */
function markFor(i: DeadlineItem): Mark {
  const standing = i.status.standing
  if (standing === 'unsupported') return 'read'
  if (standing === 'overdue') return 'act'
  if (standing === 'unknown') return 'nodate'
  // `current` from here, including the finished one-time duties: no next date,
  // so nothing to count down, and they belong with the far end rather than
  // inventing urgency.
  const days = i.daysUntil ?? Number.POSITIVE_INFINITY
  return days >= 0 && days <= SOON_DAYS ? 'soon' : 'ok'
}

const timeline = unitItems.map((item) => ({ item, mark: markFor(item) }))

/**
 * The duties with no schedule are declared, then folded away.
 *
 * They are real — a DVIR is written at the end of a driving day, a CTC-VIS
 * listing is updated within 30 days of a sale — and neither has a cycle anybody
 * can put on a calendar. Left in the main list they are two rows of standing
 * advice sitting among the dates that are actually running, and each carries a
 * paragraph saying why it has no date. Dropped, the count would shrink with no
 * notice. So they keep their own line, which says how many there are, and open
 * on a tap with their reasons in full. Same decision `noScheduleNote` makes for
 * the circle, and the same words.
 */
const onTheClock = timeline.filter((r) => r.mark !== 'read')
const noSchedule = timeline.filter((r) => r.mark === 'read')

const plainDays = (n: number) => `${n} ${n === 1 ? 'day' : 'days'}`

/**
 * How late, counted off the date that has already gone past.
 *
 * `lastDue` and not `daysUntil`. A 90-day cycle whose last inspection was five
 * months ago is `overdue` while `nextDue` — the next occurrence of the cycle —
 * is still ahead of us, so its countdown is a POSITIVE number. Reading days
 * late off that would print "overdue" beside a date in the future. `dueLine`
 * picks the same date for the same reason.
 */
function daysLate(i: DeadlineItem): number {
  const gone = i.status.lastDue ?? i.status.nextDue
  return gone ? daysBetween(gone, day0) : 0
}

function lateWords(i: DeadlineItem): string {
  const late = daysLate(i)
  return late > 0 ? `Overdue ${plainDays(late)}` : 'Overdue'
}

/** The countdown in words. Never "34d" — this is read by people reading a second language. */
function aheadWords(days: number): string {
  if (days === 0) return 'Due today'
  if (days === 1) return 'Due tomorrow'
  return `Due in ${plainDays(days)}`
}

const countdownOf = (r: { item: DeadlineItem }) => r.item.daysUntil ?? Number.POSITIVE_INFINITY

const overdueRows = timeline.filter((r) => r.mark === 'act')
// Dated, ahead of us, and known to be a real next occurrence rather than a
// finished one-time duty: the only rows that can carry a countdown.
const aheadRows = timeline.filter(
  (r) => (r.mark === 'soon' || r.mark === 'ok') && r.item.status.nextDue && countdownOf(r) >= 0,
)
const missingDates = timeline.filter((r) => r.mark === 'nodate').length

const worstLate = overdueRows.length
  ? overdueRows.reduce((worst, r) => (daysLate(r.item) > daysLate(worst.item) ? r : worst))
  : null
const nextAhead = aheadRows.length
  ? aheadRows.reduce((soonest, r) => (countdownOf(r) < countdownOf(soonest) ? r : soonest))
  : null

/**
 * THE ONE LINE AT THE TOP OF THE PAGE.
 *
 * What the owner opened the truck to find out, in type big enough to read from
 * a phone on a dashboard mount, before he has scrolled anything. The rule's own
 * title and the date sit under it so the number can be taken apart.
 *
 * Past its date beats a countdown, and a countdown beats everything else. The
 * dates we do NOT hold are not folded into this number and are not hidden
 * either: they print on their own grey line underneath, every time there is one,
 * because "we have no date" is a state of its own and never a quiet kind of
 * fine.
 */
const headline: { tone: Mark; label: string; big: string; what: string; when: string } | null =
  worstLate
    ? {
        tone: 'act',
        label: 'Next deadline',
        big: lateWords(worstLate.item),
        what: worstLate.item.rule.title,
        when: dueLine(worstLate.item),
      }
    : nextAhead
      ? {
          tone: countdownOf(nextAhead) <= SOON_DAYS ? 'soon' : 'ok',
          label: 'Next deadline',
          big: aheadWords(countdownOf(nextAhead)),
          what: nextAhead.item.rule.title,
          when: formatDay(nextAhead.item.status.nextDue?.toISOString()),
        }
      : missingDates > 0
        ? {
            // Grey gets the big number too, and it is a COUNT — the one thing
            // on this page he can act on when nothing else has a date behind
            // it. The label changes with it: a heading reading "Next deadline"
            // over a number that is not one is a heading arguing with itself.
            tone: 'nodate',
            label: 'What we are waiting on',
            big: `${missingDates} ${missingDates === 1 ? 'date' : 'dates'} not on file`,
            what: 'We cannot tell you what is next until you put a date in.',
            when: '',
          }
        : onTheClock.length > 0
          ? {
              tone: 'ok',
              label: 'Next deadline',
              big: 'Nothing is due',
              what: 'Every date we track for this unit is in. Nothing is counting down.',
              when: '',
            }
          : null

/**
 * How each mark is drawn and what it is called.
 *
 * Colour is never the only carrier: every row prints the word as well, because
 * roughly one man in twelve cannot separate the red from the amber, and this is
 * read on a phone, in a yard, in the sun. Grey is an OUTLINE rather than a fill
 * — a filled grey dot still looks like a measurement, and the whole point of
 * that row is that there is nothing to measure yet.
 */
const MARK_STYLE: Record<Mark, { dot: string; pill: string; edge: string; big: string }> = {
  act: {
    dot: 'bg-red-500 text-white',
    pill: 'bg-red-100 text-red-700',
    edge: 'border-l-red-500',
    big: 'text-red-700',
  },
  nodate: {
    dot: 'border border-dashed border-ink-300 text-ink-500',
    pill: 'bg-ink-100 text-ink-500',
    edge: 'border-l-ink-300',
    big: 'text-ink-500',
  },
  soon: {
    dot: 'bg-amber-500 text-white',
    pill: 'bg-amber-100 text-amber-800',
    edge: 'border-l-amber-500',
    big: 'text-amber-800',
  },
  ok: {
    dot: 'bg-emerald-500 text-white',
    pill: 'bg-emerald-100 text-emerald-800',
    edge: 'border-l-emerald-500',
    big: 'text-emerald-800',
  },
  read: {
    dot: 'bg-brand-500 text-white',
    pill: 'bg-brand-500/10 text-brand-700',
    edge: 'border-l-brand-500',
    big: 'text-brand-700',
  },
}

/** The word on the pill. `act` says how late it is, so it is built per row. */
const MARK_WORD: Record<Mark, string> = {
  act: 'Overdue',
  nodate: 'Missing a date',
  soon: 'Due soon',
  ok: 'On file',
  read: 'Check yourself',
}

/**
 * The glyph inside the dot: a flag, a clock, a tick, an upright bar for "read
 * this". Grey has none — it is a dashed, empty outline, because there is
 * nothing in it yet and a symbol would suggest there was.
 */
const MARK_ICON: Record<Mark, string> = {
  act: 'M5.4 3v10M5.4 4h5.6l-1.2 1.8L11 7.6H5.4z',
  nodate: '',
  soon: 'M12.8 8a4.8 4.8 0 1 1-9.6 0 4.8 4.8 0 0 1 9.6 0M8 5.3V8l1.9 1.2',
  ok: 'M4.6 8.3 7 10.7l4.4-5',
  read: 'M8 7.3v3.5M8 5.2v.6',
}

/**
 * The line beside the pill.
 *
 * `dueLine` does the work — it is the same sentence the dashboard prints, and
 * it already keeps apart the three things that look alike: a finished one-time
 * duty ("done · nothing more due"), a date we can compute with no record that
 * the last cycle was ever done, and a date nobody has typed at all.
 *
 * The one row that gets better than `dueLine` can give is the row with no date
 * at all: it names THE BOX TO TYPE IT IN, which is the next thing he needs and
 * one tap below. A duty with no schedule never reaches here — it prints its own
 * reason in the list further down, because `dueLine` would call it "no date
 * yet", which is addressed to the owner and invents a job that is not his.
 */
function detailOf(i: DeadlineItem, mark: Mark): string {
  if (mark === 'nodate' && !i.status.nextDue) {
    const key = i.status.answerKey ?? i.status.needs?.[0]
    const box = key ? anchorByKey(key) : undefined
    if (box) return `Add: ${box.label}`
  }
  return dueLine(i)
}

/** anchor_key -> the date in force, and the row it came from. */
const current = new Map<string, { on: string; id: string }>()
for (const r of anchorRows ?? []) {
  current.set(String(r.anchor_key), { on: String(r.occurred_on).slice(0, 10), id: String(r.id) })
}

interface HistoryRow {
  id: string
  anchor_key: string
  occurred_on: string
  source: string
  note: string | null
  recorded_at: string
  superseded_at: string | null
}
const history = (historyRows ?? []) as unknown as HistoryRow[]

const anchors = anchorsForKind(vehicle.kind)
const federal = anchors.filter((a) => a.jurisdiction === 'federal')
const california = anchors.filter((a) => a.jurisdiction === 'CA')

const params = Astro.url.searchParams
const error = params.get('error')
const added = params.get('added') === '1'
const saved = params.get('saved') === '1'
const withdrew = params.get('withdrew') === '1'
const dates = params.get('dates')
const datesCount = dates === null ? null : Number(dates)

/**
 * The delete panel, opened by a plain link.
 *
 * TWO STEPS, NO JAVASCRIPT. A destructive button that fires on one press is a
 * truck deleted by a thumb on a phone in a yard, and `confirm()` is not on the
 * table — nothing in this app runs a line of client script. So the first press
 * is a GET that opens a panel naming the unit, and the second is a POST with an
 * intent, exactly like every other write on this page.
 *
 * The counting only happens when the panel is open. It is six head queries, and
 * a page nobody is deleting from should not pay for them.
 */
const wantsDelete = params.get('confirm') === 'delete'
const removal = wantsDelete ? await vehicleHistory(supabase, vehicle.id) : null
const refusal = removal ? refusalFor('vehicle', vehicleLabel(vehicle), removal) : null
const alsoGoes = removal ? remindersLine('vehicle', removal) : null

const gvwr = gvwrReading(vehicle.gvwr_lbs)
const weightUnknown = vehicle.gvwr_lbs === null

// Advisory, and deliberately not a save-time refusal — see vinCheckDigitMismatch.
// Position 9 is a checksum over the other sixteen characters, so a mismatch is
// almost always a single character copied wrong off the door plate. Almost. A
// small trailer builder can ship a VIN that fails this arithmetic, and refusing
// to save it would lock a real unit out of the product over its manufacturer's
// mistake. So it is shown, every time the page is opened, and it blocks nothing.
const vinSuspect = vinCheckDigitMismatch(vehicle.vin)

// The other way the VIN on file can be useless: it does not pass `parseVin` at
// all — a half-typed stub, or a 17-character string with an I read off a dirty
// plate. Rows like that predate the rules and parseVinEdit grandfathers them so
// the owner is never blocked on one, which makes this note the ONLY place he
// ever hears about it. Saying nothing would be the worse bug: a VIN that matches
// nothing looks exactly like a VIN that matches, and the dashboard reads as
// complete either way.
const vinUnusable = vehicle.vin !== null && !parseVin(vehicle.vin).ok

// ONE note under the field, never two. The two cases cannot both be true today
// (a VIN that fails `parseVin` has no computable check digit), but two amber
// boxes stacked under a single input would read as two separate problems with
// the truck — so the slot takes the worse of the two and says it once.
const vinNotice = vinUnusable
  ? 'This VIN is not a valid one, so CARB and inspection reports will never match it. Type in the VIN from the door plate. We keep this one until you do.'
  : vinSuspect
    ? 'This VIN fails its own check digit, so one character is probably wrong. Check the door plate. CARB matches Clean Truck Check on the exact VIN, so one wrong character is a truck we never find. We saved it anyway.'
    : null

const field =
  'mt-1 w-full rounded-lg border border-ink-100 bg-white px-3 py-2 text-base outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20'
const card = 'rounded-xl border border-ink-100 bg-white p-5'
const today = new Date().toISOString().slice(0, 10)

/**
 * ONE HEADING SCALE, THREE STEPS, THE SAME ON EVERY SCREEN IN THIS APP.
 *
 *   h2  text-lg font-semibold tracking-tight        — a section of the page
 *   h3  text-sm font-semibold tracking-tight        — a subsection inside a card
 *   h3  text-xs tracking-wide text-ink-500 uppercase — the label on a small card
 *
 * `cardHeading` is the middle one, and it is the size and weight the chart frame
 * already gives its own heading (src/components/charts/Figure.astro), so a chart
 * card and a plain card next to it start the same way.
 *
 * The third is written out in full where it is used rather than kept in a
 * constant here, because it has to stay BYTE-IDENTICAL to the same label on
 * /app/dispatch, /app/settlements and /app/ifta — one string, greppable, on
 * fourteen screens. The small labels on this page were `<div>`s: not headings at
 * all, invisible to the document outline and to a screen reader walking the page
 * by headings, which is how somebody who cannot see the page finds the GVWR
 * block on it. The element changed; the class string did not, so nothing moved.
 */
const cardHeading = 'text-sm font-semibold tracking-tight'

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * The history table is 46rem wide and the window inside this card on a 375px
 * phone is about 299px, so most of every row — Withdraw included — was behind a
 * sideways scroll. Below `sm` every cell becomes a block; from `sm` the same
 * markup is a table again. ONE set of cells, not two. The pattern is written
 * down in src/components/Documents.astro.
 */
/**
 * IS THE VEHICLE RECORD OPEN WHEN THE PAGE LOADS?
 *
 * The same rule, and the same reasoning, as the driver page. Fourteen fields at
 * the top of a page somebody opens to check when the BIT inspection was — a VIN
 * and a plate are typed once and corrected about never, so the form is folded
 * away and what it holds is printed on the summary instead.
 *
 * IT OPENS ON ITS OWN WHENEVER A SAVE WAS REFUSED. Every refusal here comes back
 * through `fail()`, which redirects with `?error=`, and the message prints at the
 * top of the page; a closed form under that message would be a failure with
 * nothing on screen to fix. Keyed off the message rather than off which form
 * produced it — the one version of this that a fifteenth field cannot break.
 */
const recordOpen = error !== null

/**
 * THE DATE BOXES ARE FOLDED AWAY AND THE TIMELINE STANDS IN FRONT OF THEM.
 *
 * Twelve date boxes, each with three lines of help under it, ran to about a
 * thousand pixels of form on a page an owner opens to find out when the next
 * inspection lands. He types those dates a handful of times a year and reads
 * them every week. So the reading is the page now and the typing is one tap
 * behind a `details` — no script, the same way the vehicle record above folds.
 *
 * IT OPENS ON ITS OWN in the three cases where a closed form would be a dead
 * end: a refused save (the message prints at the top and the boxes have to be
 * under it), a save that went through (he is mid-job and usually has another
 * date in his hand), and a truck added a moment ago, whose banner tells him to
 * put his dates in. `?add=1` is the link from the timeline and from the grey
 * line at the top — a query parameter, because nothing here runs script.
 */
const datesOpen = error !== null || added || datesCount !== null || params.get('add') === '1'
// The hash lands on the boxes themselves, not on the section heading above the
// timeline: a link that opens a form and leaves it off the bottom of the screen
// has not opened anything.
const addDatesHref = `/app/vehicles/${vehicle.id}?add=1#add-dates`

const cell = 'block px-4 sm:table-cell sm:py-3'
/** The column name, said on the block that has no column. */
const said = 'text-ink-500 sm:hidden'
---

<App
  title={vehicleLabel(vehicle)}
  subtitle={`${kindLabel(vehicle.kind)} · ${statusLabel(vehicle.status)}`}
>
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}
  {
    added && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Vehicle added. The dates below are what create the deadlines. Put in the ones you have and
        leave the rest.
      </p>
    )
  }
  {saved && <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Saved.</p>}
  {
    withdrew && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Date withdrawn. We keep it in the history, so you can still see what was on file and
        when. The next most recent date is now the one we use.
      </p>
    )
  }
  {
    datesCount !== null &&
      (datesCount > 0 ? (
        <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          <span class="tabular-nums">{datesCount}</span>
          {datesCount === 1 ? ' date' : ' dates'} recorded.
        </p>
      ) : (
        <p class="mb-5 rounded-lg bg-brand-500/[0.08] px-4 py-3 text-sm text-brand-700">
          Nothing changed. Every date you sent was already the one on file.
        </p>
      ))
  }

  {/*
    THE ANSWER, BEFORE ANYTHING IS SCROLLED.

    First in the page body, above the record and above the rail, because it is
    the sentence the truck was opened for. Everything under it — the circle, the
    timeline, the boxes — is the evidence for this one line.

    The grey line is not a footnote to it. A date we do not hold carries the same
    exposure as one that has run out (`STANDING_RANK` in src/lib/rules/index.ts
    puts the two together), so it is never added into the number above it and
    never left off the screen.
  */}
  {
    headline && (
      <section
        class:list={[
          'mb-6 rounded-xl border border-ink-100 border-l-4 bg-white p-5',
          MARK_STYLE[headline.tone].edge,
        ]}
      >
        <h2 class="text-xs tracking-wide text-ink-500 uppercase">{headline.label}</h2>
        <p
          class:list={[
            'mt-1 text-3xl font-semibold tracking-tight sm:text-4xl',
            MARK_STYLE[headline.tone].big,
          ]}
        >
          {headline.big}
        </p>
        <p class="mt-1 max-w-2xl text-sm">
          <span class="font-medium">{headline.what}</span>
          {headline.when && <span class="text-ink-500"> · {headline.when}</span>}
        </p>

        {/* Not printed twice: when the big number above IS the missing count,
            this line would be the same sentence said again in a smaller font. */}
        {missingDates > 0 && headline.tone !== 'nodate' && (
          <p class="mt-3 rounded-lg bg-ink-50 px-3 py-2 text-sm text-ink-700">
            <span class="tabular-nums">{missingDates}</span>
            {missingDates === 1 ? ' date is' : ' dates are'} not on file. We cannot say when{' '}
            {missingDates === 1 ? 'it is' : 'they are'} due until you put{' '}
            {missingDates === 1 ? 'it' : 'them'} in.
            <a href={addDatesHref} class="ml-1 font-medium text-brand-600 hover:underline">
              Put the dates in →
            </a>
          </p>
        )}
        {headline.tone === 'nodate' && (
          <p class="mt-3">
            <a href={addDatesHref} class="text-sm font-medium text-brand-600 hover:underline">
              Put the dates in →
            </a>
          </p>
        )}
      </section>
    )
  }

  {/*
    `items-start`, and it is not decoration.

    A grid stretches its children to the tallest one in the row by default. The
    record card on the left folds shut — a summary and a link, about 200px —
    while the rail on the right runs to three cards. Stretched to match it, the
    card becomes an empty white box most of a screen tall, which reads as a page
    that failed to load rather than as a form somebody closed. The driver page
    carries the same line for the same reason.
  */}
  <div class="grid items-start gap-6 lg:grid-cols-[1fr_minmax(0,20rem)]">
    {/*
      THE RECORD IS FOLDED AWAY, ON `details` ALONE.

      Word for word the treatment the driver page gives its record, because
      these are the same screen with a different noun on it and an owner moves
      between them all morning. No script runs in this app and none is needed:
      `details` opens on a tap and from the keyboard by itself.

      WHAT IS FOLDED AWAY IS THE TYPING, NOT THE ANSWERS. The summary keeps the
      three facts somebody opens a unit for when he is not editing anything —
      the number on the door, the VIN a report has to match, and the plate — so
      the closed card still answers the question the page was opened with.
      Collapsing is only worth doing if nothing he came for disappears;
      otherwise it is hiding data and calling it tidying.

      `open` is decided on the server, so a refused save always comes back with
      the form already open under its own error message. See `recordOpen`.
    */}
    <div class="rounded-xl border border-ink-100 bg-white p-5">
      <details open={recordOpen} class="group">
        <summary
          class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-3 select-none [&::-webkit-details-marker]:hidden"
        >
          <h2 class="text-lg font-semibold tracking-tight">Vehicle record</h2>
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4 shrink-0 text-ink-500 transition-transform group-open:rotate-180"
          >
            <path d="M5 8l5 5 5-5"></path>
          </svg>
          {/* One word, and it goes when the form is open, where the form itself
              says what it is for. */}
          <span class="ml-auto text-sm font-medium text-brand-600 group-open:hidden">Change</span>

          <span class="flex w-full flex-wrap gap-x-6 gap-y-1 text-sm">
            <span class="whitespace-nowrap">
              <span class="text-ink-500">Unit </span>
              {
                vehicle.unit_number ? (
                  <span class="tabular-nums">{vehicle.unit_number}</span>
                ) : (
                  <span class="text-ink-300">not on file</span>
                )
              }
            </span>
            <span class="whitespace-nowrap">
              <span class="text-ink-500">VIN </span>
              {
                vehicle.vin ? (
                  <span class="font-mono uppercase">{vehicle.vin}</span>
                ) : (
                  <span class="text-ink-300">not on file</span>
                )
              }
            </span>
            <span class="whitespace-nowrap">
              <span class="text-ink-500">Plate </span>
              {
                vehicle.plate ? (
                  <span class="uppercase tabular-nums">
                    {vehicle.plate}
                    {vehicle.plate_state && ` ${vehicle.plate_state}`}
                  </span>
                ) : (
                  <span class="text-ink-300">not on file</span>
                )
              }
            </span>
          </span>

          {/*
            The VIN advisory follows the VIN onto the summary, exactly as the
            phone advisory does on the driver page. It used to sit under the
            field, which is behind the fold now — and a VIN that CARB will never
            match is precisely the thing that must not go quiet. The long
            version, with what to do about it, is still under the field.
          */}
          {
            vinNotice && (
              <span class="w-full rounded-md bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">
                This VIN will not match the state’s records.
              </span>
            )
          }
        </summary>

        <form method="POST" class="mt-5 border-t border-ink-100 pt-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Unit number</span>
          <input
            type="text"
            name="unit_number"
            value={vehicle.unit_number ?? ''}
            class={`${field} tabular-nums`}
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium">VIN</span>
          {/*
            maxlength is 24 and not 17 on purpose: the parser strips spaces and
            hyphens, so a hard 17 would silently swallow the tail of a correctly
            typed VIN the moment he chunked it. Over-length is refused in words.
          */}
          <input
            type="text"
            name="vin"
            value={vehicle.vin ?? ''}
            maxlength="24"
            autocapitalize="characters"
            spellcheck="false"
            class={`${field} font-mono uppercase`}
          />
          {
            vinNotice && (
              <span class="mt-1.5 inline-block rounded-md bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">
                {vinNotice}
              </span>
            )
          }
        </label>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <label class="block">
          <span class="text-sm font-medium">Year</span>
          <input
            type="text"
            name="model_year"
            value={vehicle.model_year ?? ''}
            inputmode="numeric"
            class={`${field} tabular-nums`}
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Make</span>
          <input type="text" name="make" value={vehicle.make ?? ''} class={field} />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Model</span>
          <input type="text" name="model" value={vehicle.model ?? ''} class={field} />
        </label>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <label class="block">
          <span class="text-sm font-medium">Plate</span>
          <input
            type="text"
            name="plate"
            value={vehicle.plate ?? ''}
            autocapitalize="characters"
            class={`${field} uppercase tabular-nums`}
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Plate state</span>
          <input
            type="text"
            name="plate_state"
            value={vehicle.plate_state ?? ''}
            maxlength="2"
            autocapitalize="characters"
            placeholder="CA"
            class={`${field} uppercase`}
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium">GVWR</span>
          <div class="mt-1 flex items-center rounded-lg border border-ink-100 focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20">
            <input
              type="text"
              name="gvwr_lbs"
              value={vehicle.gvwr_lbs ?? ''}
              inputmode="numeric"
              placeholder="Unknown"
              class="w-full bg-transparent px-3 py-2 text-base tabular-nums outline-none"
            />
            <span class="pr-3 text-ink-300">lb</span>
          </div>
        </label>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Kind</span>
          <select name="kind" class={field}>
            {
              VEHICLE_KINDS.map((k) => (
                <option value={k.value} selected={k.value === vehicle.kind}>
                  {k.label}
                </option>
              ))
            }
          </select>
          <span class="mt-1 block text-xs text-ink-500">
            Changing this changes which deadlines this unit gets. Dates you already saved stay in
            the history.
          </span>
        </label>
        <label class="block">
          <span class="text-sm font-medium">Status</span>
          <select name="status" class={field}>
            {
              VEHICLE_STATUSES.map((s) => (
                <option value={s.value} selected={s.value === vehicle.status}>
                  {s.label}
                </option>
              ))
            }
          </select>
          {/*
            BOTH CONSEQUENCES, UNDER THE BOX THAT CAUSES THEM. A status that
            quietly switches off the reminders is how a registration expires on
            a truck somebody parked in the app six months ago, and a status that
            quietly keeps charging is how a customer stops trusting the invoice.
            One sentence, from src/lib/fleet/active.ts, shared with /app/billing.
          */}
          <span class="mt-1 block text-xs text-ink-500">{VEHICLE_NOT_ACTIVE_MEANS}</span>
        </label>
      </div>

      <label class="mt-4 block">
        <span class="text-sm font-medium">
          Notes <span class="font-normal text-ink-300">(optional)</span>
        </span>
        <textarea name="notes" rows="2" class={field}>{vehicle.notes ?? ''}</textarea>
      </label>

      <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
        <button
          type="submit"
          name="intent"
          value="save"
          class="rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white transition hover:bg-brand-700"
        >
          Save vehicle
        </button>
      </div>
        </form>
      </details>

      {/*
        OUTSIDE THE FOLD, like the driver page's pair. This is how you leave the
        page, and a way out that only exists once you have opened an edit form is
        not a way out — it was inside the form until now, beside the save button.
      */}
      <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-ink-100 pt-4">
        <a href="#dates" class="text-sm font-medium text-brand-600 hover:underline">
          Compliance dates →
        </a>
        <a href="/app/vehicles" class="text-sm font-medium text-brand-600 hover:underline">
          Back to trucks
        </a>
      </div>
    </div>

    <div class="space-y-4">
      {
        /*
          First in the rail, like the ring on the driver page, because it is the
          one thing on this screen that answers "is there anything wrong with
          this unit" without reading a table. The fraction sits inside the ring
          so the arithmetic is never out of sight, and the sentence under it is
          the actual answer — the circle is only how it is read in a second.

          It says what is on file and what is not, and stops there. A verdict a
          carrier issues about himself is worth nothing to the broker reading
          it, which is why the proof binder refuses to pass judgement either.

          Note for whoever edits this: tests/truck-rings.test.ts scans this file
          for verdict words, comments included. That is why the policy is
          described here rather than quoted — the quotation would fail the test
          that exists to enforce it.

          A sold unit has no ring at all. `unitRing` is null there, because
          judging equipment that left the yard invites fixing a date on a truck
          somebody else owns.
        */
      }
      {
        unitRing && (
          <Figure
            title="What is on file"
            subtitle={ringSubtitle(unitRing)}
            coverage={ringCaveats}
          >
            <Ring ring={unitRing} size={76} centre legend />
            <p class="mt-4 text-sm font-medium">{truckLine(unitRing)}</p>
          </Figure>
        )
      }

      <div class={card}>
        <h3 class="text-xs tracking-wide text-ink-500 uppercase">GVWR</h3>
        <div class={`mt-1 text-3xl font-semibold tabular-nums ${gvwr.className}`}>{gvwr.text}</div>
        {/*
          The one sentence this whole feature turns on. An empty GVWR column is
          not an exemption — the engine reads NULL as unknown and keeps every
          weight-conditional rule switched on. Rendering it as "—" or "n/a" here
          would tell the owner the opposite of what the system believes.
        */}
        <p class="mt-2 text-xs text-ink-500">
          {
            weightUnknown
              ? 'We do not know this truck’s weight. That is not the same as exempt. We treat it as fully regulated until you tell us the weight.'
              : 'We use this to decide which weight rules apply to this truck.'
          }
        </p>
      </div>

      <div class={card}>
        <h3 class="text-xs tracking-wide text-ink-500 uppercase">Status</h3>
        <div class="mt-2">
          <span
            class:list={[
              'rounded-md px-2 py-0.5 text-xs font-medium',
              statusPillClass(vehicle.status),
            ]}
          >
            {statusLabel(vehicle.status)}
          </span>
        </div>
        {/*
          Why the ring above is missing, said where the status is. Without this
          the circle simply is not there and the page looks broken rather than
          switched off.
        */}
        {
          !isActiveVehicle(vehicle) && (
            <p class="mt-3 text-xs text-ink-500">
              This truck is not Active, so we do not watch its dates and you are not charged for
              it. Set it back to Active to start again.
            </p>
          )
        }
        <dl class="mt-4 divide-y divide-ink-100 text-sm">
          <div class="flex justify-between gap-4 py-2">
            <dt class="text-ink-500">Kind</dt>
            <dd class="text-right font-medium">{kindLabel(vehicle.kind)}</dd>
          </div>
          <div class="flex justify-between gap-4 py-2">
            <dt class="text-ink-500">Dates on file</dt>
            <dd class="text-right font-medium tabular-nums">{current.size}</dd>
          </div>
          <div class="flex justify-between gap-4 py-2">
            <dt class="text-ink-500">Dates we still want</dt>
            <dd class="text-right font-medium tabular-nums">
              {anchors.filter((a) => !current.has(a.key)).length}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <!-- ------------------------------------------------------------- dates -->

  <section id="dates" class="mt-8 scroll-mt-24">
    <h2 class="text-lg font-semibold tracking-tight">Compliance dates</h2>

    {/*
      THE TIMELINE REPLACED THE OPEN FORM THAT USED TO BE HERE.

      The boxes are still one tap away, below. What sat on this page before was
      about a thousand pixels of date fields on a screen an owner opens to find
      out when the next inspection lands — the reading buried under the typing.
      Every row here is one obligation, in the engine's own order, with the mark
      it earned and the date it turns on.

      There is no map on this page and there will not be one. Where a truck has
      BEEN is not a compliance fact, and this is the screen where somebody would
      think to put it. See docs/product/SCOPE.md.
    */}
    {
      timeline.length > 0 && (
        <Figure
          class="mt-3"
          title={`${timeline.length} ${timeline.length === 1 ? 'thing' : 'things'} we track for this ${vehicle.kind === 'trailer' ? 'trailer' : 'truck'}`}
          subtitle="Past its date first, then the dates we do not have, then the soonest."
          coverage={COVERAGE_NOTE}
          action={{ href: addDatesHref, label: 'Put a date in' }}
        >
          <ol>
            {onTheClock.map((r, n) => (
              <li class="relative flex gap-3 pb-4 last:pb-0">
                {/* The spine. Never under the last dot — a line running off the
                    bottom of a list reads as a row that failed to load. */}
                {n < onTheClock.length - 1 && (
                  <span
                    class="absolute top-6 bottom-0 left-[10px] w-px bg-ink-100"
                    aria-hidden="true"
                  />
                )}
                <span
                  class:list={[
                    'relative flex size-[22px] shrink-0 items-center justify-center rounded-full',
                    MARK_STYLE[r.mark].dot,
                  ]}
                  aria-hidden="true"
                >
                  {MARK_ICON[r.mark] && (
                    <svg
                      viewBox="0 0 16 16"
                      class="size-3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={MARK_ICON[r.mark]} />
                    </svg>
                  )}
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium">{r.item.rule.title}</p>
                  <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
                    {/* The word, always, beside the colour. */}
                    <span
                      class:list={[
                        'rounded-md px-1.5 py-0.5 font-medium',
                        MARK_STYLE[r.mark].pill,
                      ]}
                    >
                      {r.mark === 'act' ? lateWords(r.item) : MARK_WORD[r.mark]}
                    </span>
                    <span class="text-ink-500">{detailOf(r.item, r.mark)}</span>
                  </p>
                </div>
              </li>
            ))}
          </ol>

          {/*
            DECLARED, THEN FOLDED — never dropped, and never given a colour off
            the urgency scale. Amber means time and only time; these will still
            be here next year. `details` opens on a tap and from the keyboard on
            its own, which is the whole disclosure mechanism this app has.
          */}
          {noSchedule.length > 0 && (
            <details class="mt-1 border-t border-ink-100 pt-3">
              <summary class="cursor-pointer text-xs text-ink-500 select-none">
                <span class="tabular-nums">{noSchedule.length}</span>
                {noSchedule.length === 1 ? ' more duty has' : ' more duties have'} no date anyone
                can work out
              </summary>
              <ul class="mt-3 space-y-3">
                {noSchedule.map((r) => (
                  <li class="flex gap-3">
                    <span
                      class:list={[
                        'flex size-[22px] shrink-0 items-center justify-center rounded-full',
                        MARK_STYLE.read.dot,
                      ]}
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 16 16"
                        class="size-3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d={MARK_ICON.read} />
                      </svg>
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-medium">{r.item.rule.title}</p>
                      <p class="mt-1 text-xs text-ink-500">{r.item.status.reason}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </Figure>
      )
    }

    <details open={datesOpen} id="add-dates" class="group mt-4 scroll-mt-24">
      <summary
        class="flex cursor-pointer list-none items-center gap-3 rounded-xl border border-ink-100 bg-white p-4 select-none [&::-webkit-details-marker]:hidden"
      >
        <h3 class={cardHeading}>Put a date in, or change one</h3>
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0 text-ink-500 transition-transform group-open:rotate-180"
        >
          <path d="M5 8l5 5 5-5"></path>
        </svg>
        <span class="ml-auto text-sm font-medium text-brand-600 group-open:hidden">
          <span class="tabular-nums">{anchors.length}</span>
          {anchors.length === 1 ? ' box' : ' boxes'}
        </span>
      </summary>

      <form method="POST" class="mt-4 space-y-4">
      <p class="max-w-3xl text-sm text-ink-500">
        Every box below wants the <strong>last time it happened</strong>, not the next time it
        is due. We count forward from the date you type. A date in the future makes us skip
        past the deadline you were trying to tell us about.
      </p>

      {
        weightUnknown && (
          <p class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
            This truck has no GVWR on file, so every weight rule below stays ON. We treat an
            unknown weight as fully regulated, never as exempt. One extra reminder costs you a
            minute. One missed inspection costs you the truck. Fill in the GVWR above and the
            list gets shorter only if the truck really is lighter.
          </p>
        )
      }

      {
        [
          { title: 'Federal', items: federal },
          { title: 'California', items: california },
        ].map(
          (group) =>
            group.items.length > 0 && (
              /* One card per group, the container the driver page gives its own
                 date groups. Both pages were already agreed on the heading; they
                 disagreed about what the heading sat on — a bare block inside one
                 long card here, a card of its own there. */
              <div class={card}>
                <h3 class={cardHeading}>{group.title}</h3>
                <div class="mt-4 space-y-5">
                  {group.items.map((anchor) => {
                    const live = current.get(anchor.key)
                    return (
                      <div class="border-t border-ink-100 pt-4 first:border-t-0 first:pt-0">
                        <label class="block">
                          <span class="text-sm font-medium">{anchor.label}</span>
                          <input
                            type="date"
                            name={`date_${anchor.key}`}
                            value={live?.on ?? ''}
                            max={today}
                            class={`${field} max-w-xs tabular-nums`}
                          />
                        </label>
                        <p class="mt-1.5 text-xs text-ink-500">{anchor.help}</p>
                        <p class="mt-1 text-xs text-ink-300">Used for: {anchor.drives}</p>
                        {anchor.weightNote && (
                          <p class="mt-1 text-xs text-ink-300">{anchor.weightNote}</p>
                        )}
                        {/*
                          Only ever rendered when the weight is MISSING, and it
                          says "stays on". There is deliberately no branch here
                          that turns a NULL GVWR into "does not apply to you".
                        */}
                        {anchor.weightNote && weightUnknown && (
                          <p class="mt-1.5 inline-block rounded-md bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">
                            No GVWR on file, so this one stays on
                          </p>
                        )}
                        {live && (
                          <p class="mt-1.5 text-xs text-emerald-700">
                            On file: {formatDay(live.on)}
                          </p>
                        )}
                      </div>
                    )
                  })}
                </div>
              </div>
            ),
        )
      }

      {/*
        STICKY, like the driver page's. This list runs to a dozen dates on a
        tractor and the save button used to sit under the last of them — so on a
        phone the way to save a date you had just typed at the top was to scroll
        past everything you had not typed.
      */}
      <div
        class="sticky bottom-0 flex flex-wrap items-center gap-3 rounded-xl border border-ink-100 bg-white/95 p-4 backdrop-blur"
      >
        <span class="flex-1 text-sm text-ink-500">
          Saving adds a new entry. Nothing already saved is erased, and a box you leave blank
          changes nothing.
        </span>
        <button
          type="submit"
          name="intent"
          value="save_dates"
          class="rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white transition hover:bg-brand-700"
        >
          Save dates
        </button>
      </div>
      </form>
    </details>
  </section>

  <!-- --------------------------------------------------------- documents -->

  {/*
    Straight after the dates, because they are the two halves of one answer: the
    date says the inspection happened, the file is the report that proves it.
  */}
  <Documents
    subjectType="vehicle"
    subjectId={vehicle.id}
    documents={documents}
    noun="this truck"
  />

  <!-- ----------------------------------------------------------- history -->

  {
    history.length > 0 && (
      <section id="history" class="mt-8 scroll-mt-24">
        <div class={card}>
          <h2 class="text-lg font-semibold tracking-tight">Everything recorded for this unit</h2>
          <p class="mt-1 text-sm text-ink-500">
            We keep old dates instead of replacing them. An old date is the proof this unit was in
            order during the time it covered. The <strong>latest date</strong> is the one we use,
            not the one you typed last. So to move a date to an EARLIER one, withdraw the wrong
            entry first.
          </p>

          <div class="mt-4 overflow-x-auto rounded-xl border border-ink-100">
            <table class="w-full text-sm sm:min-w-[46rem]">
              {/*
                No header line on a phone. Four column names above blocks that
                are not columns explain nothing — each block says what it is in
                its own words instead.
              */}
              <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-500 uppercase sm:table-header-group">
                <tr>
                  <th class="px-4 py-3 font-medium">What</th>
                  <th class="px-4 py-3 font-medium">Date</th>
                  <th class="px-4 py-3 font-medium">Recorded</th>
                  <th class="px-4 py-3 font-medium">Source</th>
                  <th class="px-4 py-3" />
                </tr>
              </thead>
              <tbody class="divide-y divide-ink-100">
                {history.map((r) => {
                  const anchor = anchorByKey(r.anchor_key)
                  const inForce = current.get(r.anchor_key)?.id === r.id
                  const collected = anchors.some((a) => a.key === r.anchor_key)
                  return (
                    /* The block leads with WHAT the date is for, because that is
                       what an owner is looking down this list for. The date and
                       the badge that says whether it is the one in force follow
                       it on the next line. */
                    <tr class="block py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                      <td class={cell}>
                        <span class="font-medium">{anchor?.label ?? r.anchor_key}</span>
                        {/*
                          A date recorded before the kind was changed is not
                          wrong and is not deleted — it is simply not read by any
                          rule that applies to what this unit is now. Saying so
                          beats leaving an unexplained row in the list.
                        */}
                        {!collected && (
                          <span class="mt-0.5 block text-xs text-ink-300">
                            No rule for a {kindLabel(vehicle.kind).toLowerCase()} uses this date
                          </span>
                        )}
                        {r.note && <span class="mt-0.5 block text-xs text-ink-300">{r.note}</span>}
                      </td>
                      <td class={`${cell} mt-1 whitespace-nowrap tabular-nums sm:mt-0`}>
                        <span class:list={[r.superseded_at ? 'text-ink-300 line-through' : '']}>
                          {formatDay(r.occurred_on)}
                        </span>
                        {inForce && (
                          <span class="ml-2 rounded-md bg-emerald-100 px-1.5 py-0.5 text-xs font-medium text-emerald-800">
                            in force
                          </span>
                        )}
                        {r.superseded_at && (
                          <span class="ml-2 rounded-md bg-ink-100 px-1.5 py-0.5 text-xs font-medium text-ink-500">
                            withdrawn
                          </span>
                        )}
                      </td>
                      {/*
                        The date keeps its own `nowrap`; the line it sits on does
                        not. Run together as one unbreakable string this cell was
                        300px inside a 299px card — one pixel of sideways scroll,
                        which is the whole bug in miniature.
                      */}
                      <td
                        class={`${cell} mt-0.5 text-xs text-ink-500 tabular-nums sm:mt-0 sm:text-sm sm:whitespace-nowrap`}
                      >
                        <span class="whitespace-nowrap">
                          <span class={said}>Recorded </span>
                          {formatDay(r.recorded_at)}
                        </span>
                        <span class="sm:hidden">
                          {' · '}
                          {r.source === 'fmcsa'
                            ? 'Federal record'
                            : r.source === 'import'
                              ? 'Import'
                              : 'You'}
                        </span>
                      </td>
                      {/* The source, on its own line from `sm` up and folded
                          into the line above on a phone: two words on a line of
                          their own is a line an owner skips. */}
                      <td class="hidden px-4 text-ink-500 sm:table-cell sm:py-3">
                        {r.source === 'fmcsa' ? 'Federal record' : r.source === 'import' ? 'Import' : 'You'}
                      </td>
                      <td class={`${cell} sm:text-right sm:whitespace-nowrap`}>
                        {!r.superseded_at && (
                          /* Below `sm` this is a full-width bordered tap rather
                             than a bare text link. It used to be off the right
                             edge of the screen entirely. */
                          <form method="POST" class="mt-2 sm:mt-0">
                            <input type="hidden" name="record_id" value={r.id} />
                            <button
                              type="submit"
                              name="intent"
                              value="withdraw_date"
                              class="inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-ink-100 px-3 text-sm font-medium text-red-600 hover:underline sm:min-h-0 sm:w-auto sm:rounded-none sm:border-0 sm:px-0 sm:font-normal"
                            >
                              Withdraw
                            </button>
                          </form>
                        )}
                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }

  <!-- ------------------------------------------------------------ delete -->

  {/*
    LAST ON THE PAGE, AND CLOSED BY DEFAULT.

    This is for one thing only: a unit number typed twice, a VIN that turned out
    to be the tractor already on the list, a row somebody made while learning the
    screen. Anything with history refuses, and the refusal says what to do
    instead — see src/lib/fleet/remove.ts for the list and
    0028_fleet_delete_guard.sql for the same list in the database.
  */}
  <section id="delete" class="mt-8 scroll-mt-24">
    {
      !wantsDelete ? (
        <div class={card}>
          <h2 class="text-lg font-semibold tracking-tight">Delete this truck</h2>
          <p class="mt-1 max-w-2xl text-sm text-ink-500">
            Only for a truck you added by mistake. If you sold it or parked it, change the status
            above instead — that stops the reminders and the charge, and keeps the records.
          </p>
          <a
            href={`/app/vehicles/${vehicle.id}?confirm=delete#delete`}
            class="mt-4 inline-block rounded-lg border border-red-200 px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-50"
          >
            Delete this truck
          </a>
        </div>
      ) : refusal ? (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
          <h2 class="text-lg font-semibold tracking-tight text-amber-900">{refusal.title}</h2>
          {refusal.held.length > 0 && (
            <>
              <p class="mt-2 text-sm text-amber-900">What is on file:</p>
              <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-amber-900">
                {refusal.held.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </>
          )}
          <p class="mt-3 text-sm text-amber-900">{refusal.why}</p>
          {/* The dead end is also the answer. */}
          <p class="mt-2 text-sm font-medium text-amber-900">{refusal.instead}</p>
          <a
            href={`/app/vehicles/${vehicle.id}`}
            class="mt-4 inline-block rounded-lg border border-amber-300 px-4 py-2 text-sm font-medium text-amber-900 transition hover:bg-amber-100"
          >
            Go back
          </a>
        </div>
      ) : (
        <div class="rounded-xl border border-red-200 bg-red-50 p-5">
          {/* The confirmation NAMES THE UNIT. A red button that says only
              "Delete" is a button pressed on the wrong row. */}
          <h2 class="text-lg font-semibold tracking-tight text-red-800">
            {confirmTitle(vehicleLabel(vehicle))}
          </h2>
          <p class="mt-2 text-sm text-red-700">{confirmBody('vehicle')}</p>
          {alsoGoes && <p class="mt-2 text-sm font-medium text-red-700">{alsoGoes}</p>}
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <form method="POST">
              <button
                type="submit"
                name="intent"
                value="delete"
                class="rounded-lg bg-red-600 px-5 py-2.5 font-medium text-white transition hover:bg-red-700"
              >
                Yes, delete {vehicleLabel(vehicle)}
              </button>
            </form>
            <a
              href={`/app/vehicles/${vehicle.id}`}
              class="rounded-lg border border-red-200 px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-100"
            >
              Keep it
            </a>
          </div>
        </div>
      )
    }
  </section>
</App>
