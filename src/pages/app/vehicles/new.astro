---
/**
 * Add a vehicle.
 *
 * Only `kind` is required, and that is a deliberate choice rather than laziness
 * about validation. The owner is standing in a yard with a phone; he knows the
 * unit number, he may have to walk to the door to read the VIN, and the GVWR is
 * on a plate inside the frame rail. A form that demands all three now is a form
 * he fills with plausible guesses, and a guessed GVWR is worse than no GVWR —
 * NULL keeps every weight rule switched on, while a made-up 26,000 turns some of
 * them off.
 *
 * `kind` is the exception because it is not a fact about the truck so much as a
 * routing decision: § 396.17 gives a tractor and its trailer separate clocks and
 * separate paperwork, so the answer decides which deadlines this record ever
 * gets. There is no safe default for that.
 */
import App from '../../../layouts/App.astro'
import { flashText } from '../../../lib/flash.ts'
import {
  parseOptionalInt,
  parseStateCode,
  parseVin,
  textOrNull,
  upperOrNull,
  VEHICLE_KINDS,
} from '../../../lib/vehicles.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

/** The fields worth handing back after a rejected save. */
const CARRY = [
  'kind',
  'unit_number',
  'vin',
  'model_year',
  'make',
  'model',
  'gvwr_lbs',
  'plate',
  'plate_state',
] as const

const maxYear = new Date().getUTCFullYear() + 2

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  /**
   * Was this form opened from /app/setup?
   *
   * If it was, a good save goes back there instead of to the new vehicle, so
   * the owner filling in a seven-truck roster lands on the page with the
   * counts and the next button on it. If it was NOT — and it usually is not,
   * because the Trucks list links here too — nothing below changes at all.
   *
   * Compared against the one literal we ever send. The marker is a switch, not
   * a destination: reading a path out of the form and redirecting to it would
   * turn every "Add vehicle" button into an open redirect.
   */
  const fromSetup = String(form.get('from') ?? '') === 'setup'

  /**
   * Back to the form with the message AND with what he typed.
   *
   * A 303 throws the request body away, so without this every rejected save —
   * one duplicate VIN, one mistyped year — costs the owner all nine fields
   * again. They ride in the query string, which is also what makes the error
   * page survive a refresh.
   *
   * The setup marker rides along for the same reason the fields do: a mistyped
   * year must not quietly cost him the way back.
   */
  const reject = (message: string) => {
    const next = new URLSearchParams({ error: message })
    for (const key of CARRY) {
      const v = String(form.get(key) ?? '').trim()
      if (v) next.set(key, v)
    }
    if (fromSetup) next.set('from', 'setup')
    return Astro.redirect(`/app/vehicles/new?${next.toString()}`, 303)
  }

  if (intent !== 'create') {
    return reject('That button did not tell us what to do. Try again.')
  }

  const kind = String(form.get('kind') ?? '')
  if (kind !== 'power_unit' && kind !== 'trailer') {
    return reject('Tell us whether this is a power unit or a trailer.')
  }

  // Parsed rather than merely uppercased, and parsed BEFORE the insert. Two
  // things ride on it: CARB matches Clean Truck Check on this string, so a VIN
  // wrong by one character is a truck whose state record we never find; and
  // `vehicles_vin_unique` below compares strings, so a VIN typed in chunks with
  // spaces slips past the duplicate guard that is the only thing stopping the
  // same tractor being added twice.
  const vin = parseVin(form.get('vin'))
  if (!vin.ok) return reject(vin.message)

  const year = parseOptionalInt(form.get('model_year'), {
    label: 'Year',
    min: 1900,
    max: maxYear,
  })
  if (!year.ok) return reject(year.message)

  // min 1, not min 0. A blank box has already come back as NULL by this point,
  // so a 0 reaching here was typed — and 0 lb sits under every threshold in the
  // catalogue and would exempt the truck from all of them.
  const gvwr = parseOptionalInt(form.get('gvwr_lbs'), {
    label: 'GVWR',
    min: 1,
    max: 200_000,
  })
  if (!gvwr.ok) return reject(gvwr.message)

  const plateState = parseStateCode(form.get('plate_state'))
  if (!plateState.ok) return reject(plateState.message)

  const { data, error } = await supabase
    .from('vehicles')
    .insert({
      // Set explicitly, and this is the one column RLS will not fill in for us.
      // The policy CHECKS carrier_id — it rejects a row belonging to someone
      // else — but it does not supply one, and the column is NOT NULL with no
      // default, so leaving it out fails the insert outright.
      carrier_id: carrierId,
      kind,
      unit_number: textOrNull(form.get('unit_number')),
      vin: vin.value,
      make: textOrNull(form.get('make')),
      model: textOrNull(form.get('model')),
      model_year: year.value,
      gvwr_lbs: gvwr.value,
      plate: upperOrNull(form.get('plate')),
      plate_state: plateState.value,
    })
    .select('id')
    .single()

  if (error || !data) {
    // vehicles_vin_unique is a PARTIAL unique index: same carrier, VIN present,
    // not sold. Postgres reports it as a bare constraint name, which means
    // nothing to an owner — and the useful thing to say is not "constraint
    // violated" but "you already have this truck".
    const raw = error?.message ?? 'The vehicle was not saved.'
    // The one collision a person actually causes gets its own sentence. Every
    // other database message is for an operator, not for the person at the
    // desk: it names columns and constraints, so it goes to the log, not the
    // page.
    if (!raw.includes('vehicles_vin_unique')) console.error('vehicle insert failed:', raw)
    const message = raw.includes('vehicles_vin_unique')
      ? 'That VIN is already on a vehicle in your fleet. Find it from the list instead of adding it twice.'
      : 'The vehicle was not saved. Wait a moment and try again.'
    return reject(message)
  }

  // 303, spelled out. Astro.redirect() defaults to 302, and a 302 lets the
  // browser repeat the POST when the owner refreshes or presses back — which
  // here adds the same truck a second time. 303 tells it to GET instead.
  //
  // Straight to the new record rather than back to the list: the dates are the
  // reason he is here, and they live on the next screen.
  //
  // UNLESS he came from /app/setup, where the reason he is here is the count.
  // A fleet of seven trucks is not typed in one sitting, and dropping him on
  // truck one's detail page left him with no route back to the page that knows
  // how many are still missing — so he had to retype the URL to add truck two.
  return Astro.redirect(
    fromSetup ? '/app/setup?added=truck' : `/app/vehicles/${data.id}?added=1`,
    303,
  )
}

// --- GET: render, prefilled from whatever a rejected save handed back --------

const params = Astro.url.searchParams
// Only honoured when the request came from our own 303. See src/lib/flash.ts.
const error = flashText(Astro.url, Astro.request)
const prior = (key: string) => params.get(key) ?? ''
const priorKind = prior('kind')
// Read as a yes/no and re-emitted below as a literal, never echoed. A value
// copied out of the query string and into a hidden field is a value anybody
// can put in this form.
const fromSetup = params.get('from') === 'setup'

// The shared field classes carry the border, the 46px height, the 16px type and
// the one focus ring — see src/styles/global.css. `mt-1` is the only thing left
// for a page to say, and it is spacing rather than construction.
const field = 'field-input mt-1'
---

<App title="Add a vehicle" subtitle="Put in what you know. Everything except the first question can wait.">
  <div class="max-w-2xl">
    {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}

    <form method="POST" class="rounded-xl border border-ink-100 bg-white p-5">
      {/* The marker, carried in the body rather than left to the action URL, so
          it survives however this form is submitted. */}
      {fromSetup && <input type="hidden" name="from" value="setup" />}
      <fieldset>
        <legend class="field-label">
          What is it? <span class="text-red-600">*</span>
        </legend>
        <p class="field-hint">
          This decides which deadlines this record gets. A tractor and its trailer are inspected
          separately and each keeps its own paperwork, so add them as two vehicles.
        </p>
        <div class="mt-2 grid gap-3 sm:grid-cols-2">
          {
            VEHICLE_KINDS.map((k) => (
              <label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-lg border border-ink-100 p-3 transition hover:bg-ink-50">
                <input
                  type="radio"
                  name="kind"
                  value={k.value}
                  required
                  checked={priorKind === k.value}
                  class="mt-0.5"
                />
                <span>
                  <span class="block text-sm font-medium">{k.label}</span>
                  <span class="mt-0.5 block text-sm text-ink-500">{k.hint}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="field-label">
            Unit number <span class="font-normal text-ink-500">(optional)</span>
          </span>
          <input
            type="text"
            name="unit_number"
            value={prior('unit_number')}
            placeholder="e.g. 12"
            class={`${field} tabular-nums`}
          />
          <span class="field-hint block">
            What you call it in the yard. If you leave it blank, we show the VIN instead.
          </span>
        </label>

        <label class="block">
          <span class="field-label">
            VIN <span class="font-normal text-ink-500">(optional)</span>
          </span>
          {/*
            maxlength is 24 and not 17 on purpose. The parser strips spaces and
            hyphens, which is exactly how a VIN gets typed off a door plate in
            chunks — and a hard 17 would silently swallow the last characters of
            a correctly-typed VIN the moment he put a space in it. Over-length is
            refused with a sentence instead.
          */}
          <input
            type="text"
            name="vin"
            value={prior('vin')}
            maxlength="24"
            autocapitalize="characters"
            spellcheck="false"
            placeholder="17 characters"
            class={`${field} font-mono uppercase`}
          />
          <span class="field-hint block">
            CARB uses the VIN to set your Clean Truck Check months, so it is worth a walk to the
            door. Spaces and dashes are fine. We take them out.
          </span>
        </label>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <label class="block">
          <span class="field-label">Year</span>
          <input
            type="text"
            name="model_year"
            value={prior('model_year')}
            inputmode="numeric"
            maxlength="4"
            placeholder="e.g. 2018"
            class={`${field} tabular-nums`}
          />
        </label>
        <label class="block">
          <span class="field-label">Make</span>
          <input
            type="text"
            name="make"
            value={prior('make')}
            placeholder="e.g. Freightliner"
            class={field}
          />
        </label>
        <label class="block">
          <span class="field-label">Model</span>
          <input
            type="text"
            name="model"
            value={prior('model')}
            placeholder="e.g. Cascadia"
            class={field}
          />
        </label>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <label class="block">
          <span class="field-label">Plate</span>
          <input
            type="text"
            name="plate"
            value={prior('plate')}
            autocapitalize="characters"
            class={`${field} uppercase tabular-nums`}
          />
        </label>
        <label class="block">
          <span class="field-label">Plate state</span>
          <input
            type="text"
            name="plate_state"
            value={prior('plate_state')}
            maxlength="2"
            autocapitalize="characters"
            placeholder="CA"
            class={`${field} uppercase`}
          />
        </label>
        <label class="block">
          <span class="field-label">GVWR</span>
          <div class="field-affix mt-1">
            <input
              type="text"
              name="gvwr_lbs"
              value={prior('gvwr_lbs')}
              inputmode="numeric"
              placeholder="80,000"
              class="field-affix-input tabular-nums"
            />
            <span class="pr-3 text-ink-500">lb</span>
          </div>
        </label>
      </div>

      {/*
        Said here, on the way in, and not only on the detail page. The owner who
        is about to leave this blank is exactly the person who needs to know that
        blank is not the same as exempt.
      */}
      <p class="mt-3 rounded-lg bg-champagne-50 px-4 py-3 text-sm text-brand-700">
        Leave the GVWR blank if you do not know it. Blank means unknown. We treat a truck of
        unknown weight as fully regulated, so you will see every weight-based deadline until you
        fill it in. Do not guess: a wrong weight can switch off a real deadline.
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
        <button type="submit" name="intent" value="create" class="btn btn-primary">
          Add vehicle
        </button>
        {/* The way out goes back where he came in. Tertiary, not a second
            Primary and not a bare line of blue text: it is a 44px target. */}
        <a
          href={fromSetup ? '/app/setup' : '/app/vehicles'}
          class="btn btn-tertiary"
        >
          {fromSetup ? 'Back to setup' : 'Back to trucks'}
        </a>
      </div>
    </form>
  </div>
</App>
