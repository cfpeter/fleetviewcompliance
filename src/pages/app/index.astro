            ) : (
              <a
                href={dashboardHref(t.view)}
                aria-current={on ? 'page' : undefined}
                aria-label={label}
                class:list={[
                  tileBase,
                  // The bucket tint OR the selected pill, never both: one box
                  // cannot carry two fills, and a utility background would win
                  // over the component class anyway.
                  on ? [tileOn, 'border-brand-600'] : [t.box, 'hover:shadow-sm'],
                ]}
              >
                {body}
              </a>
            )
          })
        }
      </nav>
    </div>

    {/*
      ================================================ who cannot work today ===

      ABOVE THE GREY BOX, because it outranks it. A date nobody has typed is a
      question; a driver who cannot be dispatched is a truck not moving this
      morning. Red, and the first thing under the numbers.

      One sentence and a way to act on it. No count of dollars, no "estimated
