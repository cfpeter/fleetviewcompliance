    */}
    {
      blockedDrivers > 0 && (
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <span class="min-w-0 flex-1">
            <strong class="font-semibold tabular-nums">
              {blockedDrivers} {blockedDrivers === 1 ? 'driver cannot' : 'drivers cannot'} be
