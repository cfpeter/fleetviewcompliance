---
/**
 * The dashboard. One list, soonest first — with one filter laid over it.
 *
 * The ordering is the product: overdue and unknown sit together at the top,
 * because a medical card whose date we have never been given carries the same
 * exposure as one that expired. Anything else buries the rows that matter.
 *
 * The filter does not touch that. It only hides sections. A carrier with 46
 * tracked items has an Overdue section, then a 37-row "we need a date from you"
 * section, and only then "coming up in the next 45 days" — which on a phone is
 * a section that does not exist, because nobody scrolls that far while standing
 * next to a truck. So the four stat tiles became the control: they already name
 * the exact subsets, they are already at the top, and they are already the
 * reason he opens the page.
 *
 * Tiles are plain links carrying `?show=`, not buttons wired to a script. The
 * filtered view is then shareable ("look at the overdue one"), the back button
 * walks back through the filters he tried, and the page keeps working on one
 * bar of signal — same reasoning as the segmented control on /app/vehicles.
 */
import Donut from '../../components/charts/Donut.astro'
import Figure from '../../components/charts/Figure.astro'
import App from '../../layouts/App.astro'
import Flash from '../../components/ui/Flash.astro'
import { flashText } from '../../lib/flash.ts'
import {
  buildHealth,
  donutSlices,
  healthHeadline,
  missingLine,
} from '../../lib/charts/health.ts'
import { TONES } from '../../lib/charts/tones.ts'
import {
  capSection,
  DASHBOARD_SECTIONS,
  dashboardHref,
  emptyFilterState,
  parseDashboardView,
  showsSection,
  viewNoun,
} from '../../lib/dashboard.ts'
import { anchorSlot, planAnchorWrites } from '../../lib/anchors/plan.ts'
import {
  buildDateEditor,
  type DateSubject,
  findSubject,
  isBatchStamp,
  longDate,
  maxFor,
  readTypedDates,
  rowsSettledBy,
  savedHeadline,
  subjectHrefFor,
} from '../../lib/dashboard-dates.ts'
import DateSubjectActions from '../../components/DateSubjectActions.astro'
import {
  type ActionSubject,
  blockedDriverIds,
  buildActionIndex,
} from '../../lib/dashboard-actions.ts'
import { loadDeadlines } from '../../lib/deadlines.ts'
import { askDriver, askDrivers, bulkAskLine } from '../../lib/driver-link/ask-action.ts'
import { type Reach, reachFor } from '../../lib/driver-link/deliver.ts'
import { ANYTHING_ASK, asksForAnswerKeys } from '../../lib/driver-link/asks.ts'
import {
  type ChaseState,
  chaseState,
  newestPerDriver,
  type OutstandingLink,
} from '../../lib/driver-link/outstanding.ts'
import { remindMeFields } from '../../lib/dashboard-remind.ts'
import { ACTIVE_DRIVER_STATUS } from '../../lib/fleet/active.ts'
import { DEFAULT_EXPIRY_HOURS } from '../../lib/driver-link/link.ts'
import { eligibility, isBlocked } from '../../lib/dispatch/eligibility.ts'
import { carrierCeiling, exposure } from '../../lib/rules/exposure.ts'
import { effectiveLabel, money, penaltyAmount, RECORDKEEPING } from '../../lib/rules/penalties.ts'
import {
  REMINDER_ORIGIN,
  REMINDER_ORIGIN_NOTE,
  loadReminders,
  type ReminderItem,
} from '../../lib/reminders.ts'
import { setupNudge } from '../../lib/roster.ts'
import {
  readRowDates,
  rowAnswers,
  rowField,
  rowMax,
  rowPrompt,
} from '../../lib/dashboard-rows.ts'
import { resolveAnchor } from '../../lib/rules/anchors.ts'
import { SOON_DAYS, dueLine, standingPill } from '../../lib/rules/index.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

// An unrecognised ?show= reads as "everything" rather than as an empty page.
// See src/lib/dashboard.ts — an owner who opens his compliance dashboard and
// finds nothing on it does not think "bad URL", he thinks his data is gone.
const view = parseDashboardView(Astro.url.searchParams.get('show'))

// No .eq('carrier_id', ...) below. RLS already scopes both of these to the
// signed-in user's carrier; repeating the filter here would say in code that we
// do not quite trust the policy.
const [{ data: carrier }, items, reminders, truckCount, driverCount] = await Promise.all([
  supabase.from('carriers').select('legal_name, dot_number').eq('id', carrierId).single(),
  loadDeadlines(supabase, carrierId),
  // The owner's own list, on the same screen as the law's — because he has one
  // morning, not two. They are kept in a SEPARATE array all the way to the
  // markup rather than merged into `items`: a DeadlineItem carries a citation
  // and a link to the regulation, a reminder carries neither, and the only way
  // to put a reminder in that array is to invent the one thing it must never
  // have. See the note above the reminder rows below.
  loadReminders(supabase, null),
  /**
   * How big the roster is, for the one nudge back to /app/setup.
   *
   * TWO HEAD COUNTS, AND NOTHING FROM FMCSA. The federal targets this page
   * would need to say "3 of 7" are not on the `carriers` table — /app/setup
   * fetches them live from the census — and a dashboard that waits on a federal
   * data service before it paints is a dashboard that hangs when that service
   * does. So the trigger is local: an empty truck list, or an empty driver
   * list. See `setupNudge`.
   *
   * NOT derived from `items`, which this page already has. A vehicle whose GVWR
   * puts it under the CMV threshold answers `not_applicable` to every rule and
   * is dropped before it reaches that array, so counting subjects there would
   * report a yard with three light trucks in it as empty.
   *
   * Same filters as /app/setup uses, so the two pages can never disagree about
   * whether the roster is empty. No .eq('carrier_id', ...) for the reason given
   * above: RLS scopes both tables already.
   */
  supabase
    .from('vehicles')
    .select('id', { count: 'exact', head: true })
    .eq('kind', 'power_unit')
    .eq('status', 'active'),
  supabase.from('drivers').select('id', { count: 'exact', head: true }).eq('status', 'active'),
])

/**
 * The same `unknown` rows, reshaped into questions a person can answer.
 *
 * Built from `items` — the array the tiles, the list and the runway are all
 * built from — because a second query here would be a second answer to "what is
 * missing", and the two would disagree the first time a rule changed.
 */
const editor = buildDateEditor(items.filter((i) => i.status.standing === 'unknown'))
const focus = findSubject(editor, Astro.url.searchParams.get('s'))

/**
 * EVERY subject the dashboard has a row about, whatever its standing.
 *
 * `editor` above is deliberately narrower — it is a form for typing dates
 * nobody knows. The card ACTIONS must not be: a driver whose medical card
 * expired eight days ago is the man most worth texting, and he is not in
 * `editor` at all. Building the actions on `editor` made the SERVER believe
 * "can be texted" meant "is missing a date", and it answered every intent for
 * such a driver with "that driver is not on this list any more".
 */
const actionIndex = buildActionIndex(items, carrierId)

/** Who cannot be dispatched today. Computed before the POST block because both
 *  the banner and the handler behind its button need the same list. */
const blocked = blockedDriverIds(items, (d) => isBlocked(eligibility(d)))

/**
 * HOW WE WOULD REACH EACH DRIVER, for the action menu on his card.
 *
 * Only on the `?show=unknown` screen, because that is the only screen with the
 * menu on it, and this is a second query on a page that already makes five.
 * `reachFor` is the same function the driver's own page and the send itself
 * use, so what the menu OFFERS and what the send actually DOES cannot drift —
 * a menu saying "Text him" over a driver with no number is a menu that teaches
 * him not to believe the menu.
 *
 * No .eq('carrier_id', ...): RLS scopes it, as it does the five above.
 */
/**
 * NOT GATED ON THE VIEW ANY MORE. Both of the lookups below were `view ===
 * 'unknown'`, so on every other screen they were empty maps — and a menu
 * rendered from an empty map says "no number and no email on file" over a
 * driver whose number we hold, which is the one thing
 * src/components/DateSubjectActions.astro says it must never do.
 */
const hasDrivers = [...actionIndex.values()].some((x) => x.type === 'driver')

const driverReach = new Map<string, { firstName: string | null; phone: string | null; reach: Reach }>()
if (hasDrivers) {
  const { data } = await supabase
    .from('drivers')
    .select('id, first_name, phone, email')
    .eq('status', 'active')
  for (const d of data ?? []) {
    driverReach.set(d.id, {
      firstName: d.first_name ?? null,
      phone: d.phone ?? null,
      reach: reachFor(d),
    })
  }
}

/** What the driver is called in a menu item, when we know. "the driver" is not
 *  a name, and it is better than a blank or a surname nobody uses out loud. */
const firstNameOf = (subjectId: string) => driverReach.get(subjectId)?.firstName?.trim() || null

/**
 * THE LINKS ALREADY OUT, so the card can say "you asked him on Tuesday".
 *
 * `driver_links.opened_at` has been written since 0034 and read by nothing, so
 * "Ask him" appeared in identical words over a driver asked this morning and
 * one never asked at all. See src/lib/driver-link/outstanding.ts for the four
 * states and why they are four.
 *
 * `used_at is null` and `revoked_at is null` only: a link he has already
 * answered is finished, and the dates it carried are either on his record or
 * in the review queue on his own page. Expired ones are KEPT — an expired link
 * is exactly the thing the owner needs told about, and the sentence says so.
 *
 * No .eq('carrier_id', ...): RLS scopes it, as it does every read on this page.
 */
const chaseByDriver = new Map<string, ChaseState>()
if (hasDrivers) {
  const { data } = await supabase
    .from('driver_links')
    .select('driver_id, created_at, opened_at, expires_at, channel')
    .is('used_at', null)
    .is('revoked_at', null)
    .order('created_at', { ascending: false })
    .limit(200)

  const rows: OutstandingLink[] = (data ?? []).map((r) => ({
    driverId: r.driver_id,
    createdAt: new Date(r.created_at),
    openedAt: r.opened_at ? new Date(r.opened_at) : null,
    expiresAt: new Date(r.expires_at),
    channel: r.channel ?? null,
  }))
  const now = new Date()
  for (const [driverId, link] of newestPerDriver(rows)) {
    chaseByDriver.set(driverId, chaseState(link, now))
  }
}

/**
 * Which drivers can be asked for what, over a list of subjects.
 *
 * Used by the single card and by "Ask everyone", so the two cannot disagree
 * about who is askable — the bulk press must reach exactly the drivers whose
 * own cards show the button, or the counts it reports back are about a
 * different list than the one he is looking at.
 *
 * A driver with nothing askable is DROPPED, not returned with an empty list.
 * His missing dates are things the carrier performs; counting him as a failure
 * would tell an owner whose list is all annual MVRs that the feature is broken.
 */
const askTargetsFor = (subjects: readonly ActionSubject[]) =>
  subjects
    .filter((x) => x.type === 'driver')
    .map((x) => {
      const dated = asksForAnswerKeys(x.needKeys)
      // EVERY DRIVER CAN BE TEXTED. Where none of his missing dates is one of
      // the six federal papers, the link carries the dateless seventh ask
      // (0042) and the page he opens is the free upload box — "send the office
      // whatever they asked you for". The owner's reason for texting a driver
      // is not confined to the six, and the button used to be.
      return { driverId: x.id, asks: dated.length > 0 ? dated : [ANYTHING_ASK] }
    })

/**
 * THE FORMS EVERY CARD ACTION SUBMITS, one per intent.
 *
 * A form may not be nested inside another, and the focused date editor is one
 * big form — so the buttons live in the menus and point at these with `form=`.
 * The button is still the submitter, so its `name`/`value` (the subject id)
 * reaches the server; the intent rides as a hidden input, which is why there is
 * one form per intent rather than one shared between them.
 */
const ACTION_FORMS = {
  askBlocked: 'act-ask-blocked',
  ask: 'act-ask-driver',
  remind: 'act-remind-later',
  retire: 'act-retire-driver',
  askAll: 'act-ask-all',
} as const

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const todayIso = new Date().toISOString().slice(0, 10)

/**
 * The box on each row, by field name — built from `items` and NOT from the rows
 * currently on screen.
 *
 * Two jobs, one map. The markup asks it whether this row gets a box; the save
 * handler asks it what a posted field means. Building it from every item rather
 * than from the filtered view is what lets a save work when the form was
 * submitted from a filtered dashboard, and it costs nothing: `items` is already
 * scoped to this carrier by RLS, so every target in here is one of his own
 * records.
 *
 * A posted field that is not in this map is not refused — it is never looked
 * at. See the note on `rowAnswers`.
 */
const answerable = rowAnswers(items, carrierId)

/**
 * The dashboard now takes writes, and every branch ends in a 303.
 *
 * Posting to the page itself rather than to an API route keeps the whole thing
 * working with no JavaScript, and the redirect means a refresh after saving
 * cannot write the same dates twice.
 */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')
  const to = (query: string) => Astro.redirect(`/app?${query}`, 303)
  /**
   * BACK TO THE VIEW HE PRESSED FROM, not always to the date editor.
   *
   * This used to hard-code `show=unknown`, which was right while every action
   * lived on that one screen and wrong the moment one did not: pressing "Text
   * Marco" from the Overdue list would 303 him into a filtered view he never
   * asked for — and then say nothing, because every receipt below is drawn
   * only on the view that produced it. He would press a button, lose his
   * place, and be told nothing, on the screen whose whole job is trust.
   *
   * `&s=` still rides along, but only on the view that has a focused subject.
   */
  const here = (extra: string) => {
    const base = view === 'all' ? '' : `show=${view}`
    const subject = view === 'unknown' && focus ? `&s=${encodeURIComponent(focus.id)}` : ''
    return `${base}${subject}${base || subject ? extra : extra.replace(/^&/, '')}`
  }
  const fail = (message: string) => to(here(`&error=${encodeURIComponent(message)}`))

  /**
   * A row save can be made from any view, so its answer goes back to the view
   * he was standing on. `here()` above always says `show=unknown` because the
   * date editor lives there; sending a man who saved a date from the Overdue
   * list to the date editor would be answering a question he did not ask.
   */
  const keepView = (extra: string) => (view === 'all' ? extra : `show=${view}&${extra}`)
  const rowFail = (message: string, at = '') =>
    to(`${keepView(`error=${encodeURIComponent(message)}`)}${at}`)

  /**
   * A date typed on a deadline row, straight from the list.
   *
   * ONE FORM, EVERY ROW. Each box carries `form="row-dates"`, so a person can
   * type three dates in three sections and press Save once — the alternative
   * was a form per row, and on a page with no JavaScript that is one full page
   * load per date.
   *
   * WHAT IS TRUSTED OUT OF THE BODY: nothing but the field NAME, and only far
   * enough to look it up in `answerable`, which was built here from this
   * carrier's own rows. Which anchor key a date is filed under, which table it
   * lands in and which record it belongs to are all decided on this side. A
   * posted anchor key would be an owner filing any date under any key on any
   * record he can see — including `hire_date`, which outranks the driver's own
   * column forever.
   */
  if (intent === 'save_row_dates') {
    /**
     * BACK TO THE ROW HE WAS LOOKING AT, on EVERY exit.
     *
     * The owner's words: "I saved the overdue and it refreshed and it scrolled
     * down, this is something very very annoying." A POST always ends in a
     * fresh document and a fresh document starts at the top; the fragment is
     * what HTML gives us instead, and it costs no script.
     *
     * Computed here rather than at the one `return` that first had it, because
     * the exits that are NOT the happy path are the ones where losing his place
     * hurts most: a refusal he has to act on, and a blank submit he has to go
     * back and correct. Both used to drop him at the top of a 10,000px page.
     *
     * Checked against the catalogue rather than pasted through: this ends up in
     * a Location header, and an unchecked value out of the body has no business
     * there.
     */
    const pressed = String(form.get('from') ?? '')
    const at = (DASHBOARD_SECTIONS as readonly string[]).includes(pressed)
      ? `#section-${pressed}`
      : ''

    const typed = readRowDates(answerable, (field) => form.get(field) as string | null, todayIso)
    if (!typed.ok) return rowFail(typed.message, at)
    if (typed.typed.length === 0) return to(`${keepView('rows=0')}${at}`)

    const anchors = typed.typed.filter((t) => t.answer.target.via === 'anchor')
    const columns = typed.typed.filter((t) => t.answer.target.via === 'column')

    const recordedAt = new Date().toISOString()
    let written = 0

    if (anchors.length > 0) {
      // Every record these dates touch, in one query. The filter is on
      // `subject_id` alone and the map is keyed on all three parts, so a row
      // belonging to some other subject type with the same id — which cannot
      // happen, but nothing here depends on that — simply never matches a slot.
      const subjectIds = [
        ...new Set(anchors.map((t) => (t.answer.target as { subjectId: string }).subjectId)),
      ]
      const { data: currentRows, error: readError } = await supabase
        .from('current_compliance_anchors')
        .select('id, anchor_key, occurred_on, subject_type, subject_id')
        .in('subject_id', subjectIds)
      if (readError) return rowFail(readError.message)

      const current = new Map(
        (currentRows ?? []).map((r) => [
          anchorSlot(
            String(r.subject_type) as 'carrier' | 'driver' | 'vehicle',
            String(r.subject_id),
            String(r.anchor_key),
          ),
          { id: String(r.id), occurred_on: String(r.occurred_on).slice(0, 10) },
        ]),
      )

      const { supersede, inserts, conflicts } = planAnchorWrites({
        entries: anchors.map((t) => {
          const target = t.answer.target as {
            subject: 'carrier' | 'driver' | 'vehicle'
            subjectId: string
            anchorKey: string
          }
          return {
            subject: target.subject,
            subjectId: target.subjectId,
            anchorKey: target.anchorKey,
            on: t.on,
          }
        }),
        current,
        carrierId,
        userId: Astro.locals.userId ?? null,
        recordedAt,
      })

      // One box per row and one row per (rule, record), so two boxes cannot
      // name one slot — but a planner that can refuse must never refuse
      // silently.
      if (conflicts.length > 0) {
        return rowFail('You typed two different dates for the same thing.')
      }

      if (supersede.length > 0) {
        // Superseded, never deleted. The old row stays as the record of what was
        // believed and when.
        const { error } = await supabase
          .from('compliance_records')
          .update({ superseded_at: recordedAt })
          .in('id', supersede)
        if (error) return rowFail(error.message)
      }
      if (inserts.length > 0) {
        const { error } = await supabase.from('compliance_records').insert(inserts)
        if (error) return rowFail(error.message)
      }
      written += inserts.length
    }

    // The CDL expiry, and today nothing else: its home is a column on the
    // driver, and a compliance record under that key would outrank the column
    // silently. See COLUMN_TARGETS in src/lib/dashboard-rows.ts.
    for (const t of columns) {
      const target = t.answer.target as { table: 'drivers'; column: 'cdl_expires_on'; id: string }
      const { error } = await supabase
        .from(target.table)
        .update({ [target.column]: t.on })
        .eq('id', target.id)
      if (error) return rowFail(error.message)
      written += 1
    }

    /**
     * BACK TO THE ROW HE WAS LOOKING AT, not to the top of the page.
     *
     * The owner's words: "I saved the overdue and it refreshed and it scrolled
     * down, this is something very very annoying." A POST always ends in a
     * fresh document, and a fresh document starts at the top. The fragment is
     * what HTML gives us instead — the same mechanism the settings page uses to
     * put focus on a refusal — and it costs no script.
     *
     * Checked against the catalogue rather than pasted through: the fragment is
     * part of the Location header we send, and an unchecked value out of the
     * body has no business there.
     */
    return to(`${keepView(`rows=${written}`)}${at}`)
  }

  if (intent === 'withdraw_date') {
    const recordId = String(form.get('record_id') ?? '')
    // A malformed id would reach Postgres as a failed uuid cast and put
    // "invalid input syntax for type uuid" across the top of his dashboard.
    if (!UUID.test(recordId)) return to(here(''))

    // Superseded, never deleted — the row stays as a record of what was believed
    // and when, and the next most recent date takes over. RLS scopes this to his
    // own carrier, and `is('superseded_at', null)` makes a double-tap a no-op
    // rather than a second, later withdrawal stamp.
    const { error } = await supabase
      .from('compliance_records')
      .update({ superseded_at: new Date().toISOString() })
      .eq('id', recordId)
      .is('superseded_at', null)
    if (error) return fail(error.message)
    return to(here('&withdrawn=1'))
  }

  /**
   * ASK THE DRIVER FOR THE DATES THIS SCREEN IS ALREADY SHOWING.
   *
   * The owner is looking at a card that says "Driver · 3 dates missing". Making
   * him open the driver's page and tick the same three boxes is asking him to
   * copy a list off his own screen. So the asks are DERIVED HERE, from the
   * editor this page already built, and the body carries one thing: which
   * driver.
   *
   * NOTHING ABOUT WHAT TO ASK FOR IS TRUSTED OUT OF THE BODY — the same rule
   * `save_row_dates` above follows, and for a stronger reason. A posted ask key
   * would be an owner choosing what a driver's phone is allowed to write into,
   * and the one key that must never be on that list is the 49 CFR 40.307(g)
   * return-to-duty date. `asksForAnswerKeys` can only ever return the six in
   * the catalogue, and the SQL function checks the whitelist again.
   */
  if (intent === 'ask_driver_dates') {
    const driverId = String(form.get('driver_id') ?? '')
    if (!UUID.test(driverId)) return to(here(''))

    // The subject must be one THIS page built for THIS carrier. A driver id
    // that is not on the screen is not a driver he is being shown, and the
    // lookup is what makes that true rather than the RLS underneath it.
    const subject = actionIndex.get(driverId)
    if (subject?.type !== 'driver') return fail('That driver is not on this list any more. Reload the page.')

    // Same rule as the bulk button above: his dated papers when he owes any,
    // and otherwise the dateless ask, so the button always works.
    const dated = asksForAnswerKeys(subject.needKeys)
    const asks = dated.length > 0 ? dated : [ANYTHING_ASK]

    const asked = await askDriver({
      supabase,
      carrierId,
      driverId,
      asks,
      hours: DEFAULT_EXPIRY_HOURS,
      userId: Astro.locals.userId ?? null,
      origin: Astro.url.origin,
    })
    if (!asked.ok) return fail(asked.message)

    // The outcome is a CODE and the driver is his id, both already on this
    // screen. Neither the token nor a phone number goes in the address bar:
    // the link, when there is nowhere to send it, is shown on the driver's own
    // page, which sets no-store.
    return to(here(`&asked=${asked.outcome}&who=${encodeURIComponent(driverId)}`))
  }

  /**
   * THE SAME ERRAND FOR EVERY DRIVER ON THE SCREEN.
   *
   * On a roster of twelve, pressing the same button twelve times is the work
   * this product is supposed to remove. Every driver gets asked for HIS OWN
   * missing dates — not one shared list — because the whole reason the single
   * button is one press is that the screen already knows who is short of what.
   *
   * Drivers with nothing askable are left out silently rather than counted as
   * failures: an owner whose whole list is annual MVRs would otherwise read
   * "8 could not be asked" and conclude the feature is broken.
   */
  if (intent === 'ask_all_drivers') {
    const targets = askTargetsFor([...actionIndex.values()])
    if (targets.length === 0) return fail('No drivers on this list to ask.')

    const result = await askDrivers({
      supabase,
      carrierId,
      hours: DEFAULT_EXPIRY_HOURS,
      userId: Astro.locals.userId ?? null,
      origin: Astro.url.origin,
      targets,
    })

    // Five counts, all small integers, all already visible on this screen as
    // rows. Nothing here names a person or an address.
    return to(
      here(
        `&bulk=${result.sms}.${result.email}.${result.none}.${result.failed}` +
          `.${result.refused}.${result.overCap}`,
      ),
    )
  }

  /**
   * TEXT THE DRIVERS WHO CANNOT BE DISPATCHED.
   *
   * The banner has named them since it was written and offered a link to the
   * dispatch board — a screen where he can look at the problem again. These are
   * the most urgent people in the product: their medical card or licence has
   * RUN OUT, which is the one thing that stops a man driving today, and it is
   * also exactly what a driver can fix from his own phone in a minute.
   *
   * The set is computed here, from `items`, by the same function the banner
   * counts — never posted. A list of driver ids in the body would be an owner
   * choosing who counts as blocked.
   */
  if (intent === 'ask_blocked_drivers') {
    const targets = askTargetsFor(
      blocked.map((id) => actionIndex.get(id)).filter((x) => x !== undefined),
    )
    if (targets.length === 0) return fail('Nobody is blocked right now.')

    const result = await askDrivers({
      supabase,
      carrierId,
      hours: DEFAULT_EXPIRY_HOURS,
      userId: Astro.locals.userId ?? null,
      origin: Astro.url.origin,
      targets,
    })
    return to(
      here(
        `&bulk=${result.sms}.${result.email}.${result.none}.${result.failed}` +
          `.${result.refused}.${result.overCap}`,
      ),
    )
  }

  /**
   * "NOT NOW. REMIND ME IN A WEEK."
   *
   * The honest third answer to a missing date, and the one the screen had no
   * button for. See src/lib/dashboard-remind.ts for what the row says and why
   * it carries the date names in its note.
   */
  if (intent === 'remind_me_later') {
    const subjectId = String(form.get('subject_id') ?? '')
    if (!UUID.test(subjectId)) return to(here(''))
    const subject = actionIndex.get(subjectId)
    if (!subject) return fail('That row is not on this list any more. Reload the page.')

    // carrier_id is SET on insert, never filtered on: RLS checks the value but
    // does not fill it in, so a row without it fails the WITH CHECK half of the
    // policy and reads as a permissions error about the owner's own list.
    const { error } = await supabase.from('reminders').insert({
      carrier_id: carrierId,
      created_by: Astro.locals.userId ?? null,
      ...remindMeFields(subject, new Date()),
    })
    if (error) return fail('We could not save that reminder. Try again.')
    return to(here('&remind=1'))
  }

  /**
   * "HE DOES NOT WORK HERE ANY MORE."
   *
   * A card for somebody who left counts against the owner every morning for
   * ever, and the only cure was to know that a driver has a status and that it
   * lives three screens away.
   *
   * INACTIVE, NEVER TERMINATED, and never a delete. 'terminated' is a statement
   * about how the employment ended and is not ours to make from a dashboard
   * card; a delete would take his medical card and his MVR with him, which is
   * the federal retention problem 0028 exists to refuse. Inactive is reversible
   * from his own page, which is where the full choice already lives, and the
   * receipt below links straight to it.
   */
  if (intent === 'retire_driver') {
    const driverId = String(form.get('driver_id') ?? '')
    if (!UUID.test(driverId)) return to(here(''))
    const subject = actionIndex.get(driverId)
    if (subject?.type !== 'driver') return fail('That driver is not on this list any more. Reload the page.')

    const { data, error } = await supabase
      .from('drivers')
      .update({ status: 'inactive' })
      .eq('id', driverId)
      .eq('status', ACTIVE_DRIVER_STATUS)
      .select('id')
    if (error) return fail('We could not change that driver. Try again.')
    // An UPDATE matching nothing is not an error in Postgres, so without this
    // the page reports a cheerful receipt for a driver somebody else moved in
    // another tab.
    if (!data || data.length === 0) return to(here(''))
    return to(here(`&retired=1&who=${encodeURIComponent(driverId)}`))
  }

  if (intent === 'save_unknown_dates') {
    // No subject in the URL means a stale form or a hand-edited one. Back to the
    // list rather than an error: there is nothing for him to fix.
    if (!focus) return to('show=unknown')

    // Reads ONLY the questions this subject actually has. A `date_hire_date`
    // posted by hand is not rejected, it is never looked at — the only version
    // of that defence with no list to keep up to date.
    const typed = readTypedDates(focus, (field) => form.get(field) as string | null, todayIso)
    if (!typed.ok) return fail(typed.message)

    if (typed.typed.length === 0) return to(here('&dates=0'))

    const { data: currentRows } = await supabase
      .from('current_compliance_anchors')
      .select('id, anchor_key, occurred_on')
      .eq('subject_type', focus.recordSubject)
      .eq('subject_id', focus.id)

    const current = new Map(
      (currentRows ?? []).map((r) => [
        anchorSlot(focus.recordSubject, focus.id, String(r.anchor_key)),
        { id: String(r.id), occurred_on: String(r.occurred_on).slice(0, 10) },
      ]),
    )

    // One stamp for the whole batch, and it is load-bearing rather than tidy:
    // the receipt below finds exactly the rows this submit wrote by querying it
    // back. The view's ordering does not use `recorded_at` at all any more — it
    // orders on `seq` since migration 0007 — so sharing it costs nothing.
    const recordedAt = new Date().toISOString()

    const { supersede, inserts, conflicts } = planAnchorWrites({
      entries: typed.typed.map((t) => ({
        subject: focus.recordSubject,
        subjectId: focus.id,
        anchorKey: t.question.answerKey,
        on: t.on,
      })),
      current,
      carrierId,
      userId: Astro.locals.userId ?? null,
      recordedAt,
    })

    // One input per question, so this is unreachable from the form — but a
    // planner that can refuse must never be allowed to refuse silently.
    if (conflicts.length > 0) {
      return fail('You typed two different dates for the same question.')
    }

    if (supersede.length > 0) {
      const { error } = await supabase
        .from('compliance_records')
        .update({ superseded_at: recordedAt })
        .in('id', supersede)
      if (error) return fail(error.message)
    }

    if (inserts.length > 0) {
      const { error } = await supabase.from('compliance_records').insert(inserts)
      if (error) return fail(error.message)
    }

    const cleared = rowsSettledBy(
      focus,
      typed.typed.map((t) => t.question.answerKey),
    )
    // The overdue count BEFORE this save travels with the redirect.
    //
    // Answering honestly can move a row to Overdue instead of off the list — he
    // tells us he last filed in July and the return that came due in August is
    // now visibly late. That is the date doing its job, but unexplained it reads
    // as punishment for answering, which is the one lesson this screen must
    // never teach.
    const overdueBefore = items.filter((i) => i.status.standing === 'overdue').length
    return to(
      here(
        `&dates=${inserts.length}&cleared=${cleared}&od=${overdueBefore}` +
          `&at=${encodeURIComponent(recordedAt)}`,
      ),
    )
  }

  return to(here(''))
}

const overdue = items.filter((i) => i.status.standing === 'overdue')
const unknown = items.filter((i) => i.status.standing === 'unknown')
/**
 * Due soon means a date AHEAD of us, inside the window.
 *
 * `daysUntil` is NEGATIVE for a one-time obligation that has been satisfied —
 * a pre-employment Clearinghouse query run when the driver was hired comes back
 * `current` with something like -2040. The old test was `<= SOON_DAYS`, which
 * -2040 passes, so twenty things finished years ago sat under a tile reading
 * "Due in 45 days". The reminder filter below already had this right; the
 * deadline filter did not.
 *
 * Written once and used for both arms so they stay exhaustive: every `current`
 * item is in exactly one of them, and a change here cannot put an item in
 * neither or in both.
 */
const dueSoon = (days: number | undefined) => {
  const d = days ?? Number.POSITIVE_INFINITY
  return d >= 0 && d <= SOON_DAYS
}
const soon = items.filter((i) => i.status.standing === 'current' && dueSoon(i.daysUntil))
const later = items.filter((i) => i.status.standing === 'current' && !dueSoon(i.daysUntil))
const manual = items.filter((i) => i.status.standing === 'unsupported')

/**
 * The reminders, in the same buckets, on the same day boundary.
 *
 * A reminder is only ever overdue or current — the owner typed the date, so
 * there is nothing to be unsure about — which is why there is no reminder half
 * to the `unknown` bucket and why the "Missing a date" tile does not move.
 */
const reminderOverdue = reminders.filter((r) => r.status.standing === 'overdue')
const reminderSoon = reminders.filter((r) => r.daysUntil >= 0 && r.daysUntil <= SOON_DAYS)
const reminderLater = reminders.filter((r) => r.daysUntil > SOON_DAYS)

// The date line moved to `dueLine` in src/lib/rules/index.ts, next to
// `standingPill`. It lived here as two helpers and one ternary, which is how an
// `unknown` row came to print "in 45 days" under a "Not sure" pill while the
// tile above it read "Due in 45 days: 0" — a decision this page cannot test.

const subjectHref = (t: string, id: string | null) =>
  t === 'driver' ? `/app/drivers/${id}` :
  // A carrier subject is the COMPANY, so it goes to the company group of
  // Settings rather than to the first tab, which is about the person.
  t === 'power_unit' || t === 'trailer' ? `/app/vehicles/${id}` : '/app/settings?tab=company'

/**
 * The word under a subject's name in a row: the word the nav uses ("truck"),
 * not the column name ("power unit"). The reminder rows further down already
 * said "truck" and "your company" for the same records, and the "Start with"
 * list above them says "Truck" — one page, one word for one thing.
 */
const subjectWord = (t: string) =>
  t === 'power_unit'
    ? 'truck'
    : t === 'trailer'
      ? 'trailer'
      : t === 'driver'
        ? 'driver'
        : t === 'carrier'
          ? 'your company'
          : t.replaceAll('_', ' ')

// `reminders` rides along on each section rather than being merged into `items`.
// The two lists are ranked the same way and read on the same screen, and they
// are still two lists: one is a rule somebody else wrote, one is a line this
// owner typed.
const sections = [
  { key: 'overdue', title: 'Overdue', items: overdue, reminders: reminderOverdue, tone: 'border-red-200 bg-red-50/40' },
  { key: 'unknown', title: 'We need a date from you', items: unknown, reminders: [] as ReminderItem[], tone: 'border-ink-100 bg-white' },
  { key: 'soon', title: `Coming up in the next ${SOON_DAYS} days`, items: soon, reminders: reminderSoon, tone: 'border-amber-200 bg-amber-50/40' },
] as const

// Filtering is a `.filter` over the SAME array, in the same order, every time.
// Not a per-view list of sections: the moment the order is written out by hand
// per view, "unknown ranks with overdue" becomes a thing a future edit can undo
// on the page while the engine still reports it correctly, and nothing throws.
const visible = sections.filter((s) => showsSection(view, s.key))

// The TRUE totals of what this view covers, and it stays that way. This is the
// number in "Showing only what is overdue. 15 of 171 items", and it is what
// decides whether the filtered empty state fires — neither of which has anything
// to do with how many rows the resting page chooses to draw. Derived from the
// capped lists below, a section trimmed to ten would start describing itself as
// ten, and a view whose rows were all trimmed away would render the "Nothing is
// overdue" reassurance over a list that is not empty.
const shownCount = visible.reduce((n, s) => n + s.items.length + s.reminders.length, 0)

/**
 * The resting page shows the top of each section, not all of it.
 *
 * Unfiltered, this page drew every row it had: 15,494px on a desktop, one
 * section 11,084px of it. Everything worth reading was in the first screen and
 * everything after it was a wall — so each section now stops at
 * `SECTION_ROW_CAP` and hands over to the view its own stat tile already points
 * at. `capSection` is where the rules live, and the rules that matter are that
 * the tail is the safe end to cut, that the link counts the whole section, and
 * that a FILTERED view is never capped — it is what the link leads to.
 *
 * No second mechanism, and no script. The link is `?show=`, the same parameter
 * the tiles use, so the page ships the same zero bytes of JavaScript it did.
 */
const lists = visible.map((s) => ({
  ...s,
  shown: capSection(s.key, view, s.items, s.reminders),
}))

// Tile counts come off the WHOLE set, never off the filtered one. The counts are
// the reason he opens the page at all — a tile that reads "0 overdue" merely
// because he is standing inside the "Missing a date" filter would be a lie told
// by the one number he checks first, and he would stop believing the other three.
//
// THE COUNTS INCLUDE REMINDERS, and they have to. The tile is the first number
// he reads and the section under it is the list he acts on; a tile that counted
// only regulations while the Overdue section showed four rows would be the one
// number on this page he checks first, disagreeing with the rows directly below
// it. He would stop believing the other three.
const trackedCount = items.length + reminders.length

/**
 * The four buckets, counted once, for the ring AND for the tiles.
 *
 * THE TILES ARE NOW THE RING'S LEGEND, which is why they are derived from
 * `buildHealth` rather than hand-assembled here. A ring and a row of counters
 * showing the same four numbers from two different pieces of arithmetic is two
 * answers to one question, and the first time a bucket rule changed only one of
 * them would move — on the screen whose entire job is trust.
 *
 * REMINDERS ARE COUNTED, unlike on the runway below. The runway is drawn from
 * the rules alone and says so, because a shape that counted the owner's own
 * errands as regulations would make a quiet November look busy for a reason no
 * regulation is responsible for. The ring is not making that claim: it is the
 * mix of what is on this screen, the tiles are the ring's legend, and a tile
 * that counted only regulations while the section under it listed reminders too
 * would be the number he checks first disagreeing with the rows beneath it.
 */
const health = buildHealth([
  ...items.map((i) => ({ standing: i.status.standing, daysUntil: i.daysUntil })),
  ...reminders.map((r) => ({ standing: r.status.standing, daysUntil: r.daysUntil })),
])

/**
 * The tiles: four big numbers, three of them a filter.
 *
 * 'On track' is deliberately NOT a link. There is no `?show=` view behind it
 * because there is nothing on the other side to do — that is the whole meaning
 * of the green arc — and a fourth tappable tile that led to a list he does not
 * need to read would be the one control on this page that wastes a tap. It is
 * still a tile: the colour rule needs a number and a word beside every slice,
 * and green is a slice.
 *
 * The old fourth tile, 'All items', is gone. It was the way back out of a
 * filter, and the way back out is now the link in the figure header plus the
 * sentence under these tiles — so the four tiles map exactly onto the four arcs
 * and nothing in the row means something the ring does not.
 */
const TILE_STYLE: Record<string, { box: string; labelClass: string; countClass: string }> = {
  overdue: {
    box: 'border-red-200 bg-red-50/40',
    labelClass: 'text-red-700',
    countClass: 'text-red-700',
  },
  // Grey, not white. It is the colour of the arc, and 'Not sure' in
  // `standingPill` is already grey — the tile has to look like the pill on the
  // row it filters to. Never green, never blank: a missing date is not a pass.
  unknown: {
    box: 'border-ink-200 bg-ink-50',
    // ink-700, not ink-500. The label is 12px and it sits on a tint, and both
    // of those put it under the floor in src/styles/global.css.
    labelClass: 'text-ink-700',
    countClass: 'text-ink-900',
  },
  soon: {
    box: 'border-amber-200 bg-amber-50/40',
    labelClass: 'text-amber-800',
    countClass: 'text-amber-800',
  },
  ontrack: {
    box: 'border-emerald-200 bg-emerald-50/40',
    labelClass: 'text-emerald-800',
    countClass: 'text-emerald-800',
  },
}

const tiles = health.buckets.map((b) => ({
  key: b.key,
  view: b.view,
  label: b.label,
  count: b.count,
  swatch: TONES[b.tone].swatch,
  ...TILE_STYLE[b.key],
}))

// A row, not a stacked card. Stacked, four tiles are ~400px of nothing on a
// phone and there is no room left beside them for the ring; as rows the whole
// block — ring and all four numbers — fits in about 190px, which is less than
// the old tiles took on their own.
//
// `min-h-11` is the 44px thumb floor. Three of these four are filters and they
// are tapped standing next to a truck.
const tileBase = 'flex min-h-11 items-center gap-2 rounded-lg border px-2.5 py-2 transition'
/**
 * The selected filter, as the app's one selected metaphor: a filled tinted
 * pill, the same `.is-current` the nav and every other filter row uses.
 *
 * It replaces a dark 2px ring, which was a second vocabulary for "this one is
 * on" and read as an error outline on a bad screen in daylight. The pill
 * replaces the tile's own bucket tint rather than sitting on top of it — two
 * fills cannot share one box — and nothing is lost by that: the swatch, the
 * coloured count, the word and the "Showing" line under it all stay, so the
 * tile still says which arc it belongs to four ways over.
 */
const tileOn = 'is-current'

/** The ring is a chart, so it obeys the chart rule: never on a filtered view. */
const showRing = view === 'all' && health.total > 0

/**
 * The ghost ring: the outline, drawn when there is nothing in it yet.
 *
 * A carrier on his first morning got four tiles reading 0 and an empty space
 * where the ring goes, which reads as a screen that failed to load rather than
 * as a fleet nobody has entered yet. `Donut` already draws its own grey track
 * for this, so the shape costs nothing: the hole holds a real 0 with the words
 * 'nothing tracked' under it, in ink rather than green, because nothing tracked
 * is not the same finding as nothing wrong.
 */
const showGhostRing = view === 'all' && health.total === 0
const ringDrawn = showRing || showGhostRing

/**
 * The grey line: the one an owner has to read as "we are missing 119 dates from
 * you". It sits directly under the ring, in its own box, because the count used
 * to be inside the headline and is not any more — and a number that leaves the
 * headline has to land somewhere louder than a tile, or it has quietly been
 * softened.
 */
const healthMissing = ringDrawn ? missingLine(health, 'owner') : null

/**
 * HOW MANY DRIVERS CANNOT BE DISPATCHED RIGHT NOW.
 *
 * The first number on this page that is about money, and it is deliberately not
 * a money number. The owner asked for "the total price of the unpaid
 * compliance" — what a missed date is going to cost him. Run against this
 * carrier, a penalty total answers **zero**: all four of its overdue rows carry
 * no dollar figure, because the catalogue does not invent one. The medical
 * certificate's own consequence line says why — an expired card is "the loss of
 * the licence privilege, not a paperwork fine". A screen that printed "$0 at
 * risk" over two expired medical cards would be telling him he is fine on the
 * one morning he is not, which is the single most damaging thing this product
 * can do. See docs/product/BACKLOG.md § P1.
 *
 * So the number that goes in first is the one that is true today: a parked
 * driver. It is the real cost of these four rows, it needs no legal research,
 * and it cannot be wrong about a regulation because it is not a claim about
 * one — it is a claim about this fleet.
 *
 * THE ANSWER COMES FROM THE SHARED ENGINE, never from a rule code matched here.
 * `eligibility()` is what the assignment screen refuses a driver with, so a
 * dashboard that counted blocks its own way could tell him one driver is parked
 * on this screen and let him assign a load on the next. `BLOCKING_RULE_CODES`
 * lives in that file precisely so the decision is made once.
 *
 * Counted off the UNFILTERED items, so tapping a tile does not change it: the
 * number of drivers who cannot work today is not a property of which rows he is
 * looking at.
 *
 * BLOCKS ONLY, NOT WARNINGS. `eligibility()` blocks on overdue and warns on
 * unknown, and the reason is written out in that file: on day one every date is
 * unknown, and blocking on unknown would make the product unusable at the exact
 * moment a carrier is deciding whether to trust it. The grey count is already
 * on this page, in its own box, saying what not knowing costs.
 */
const driverItems = new Map<string, { label: string; items: typeof items }>()
for (const i of items) {
  if (i.subjectType !== 'driver' || !i.subjectId) continue
  const row = driverItems.get(i.subjectId) ?? { label: i.subjectLabel, items: [] }
  row.items.push(i)
  driverItems.set(i.subjectId, row)
}
/**
 * THE IDS, not only the count.
 *
 * The banner has always known exactly who cannot be dispatched and thrown the
 * names away, keeping a number and a link to a screen where he can look at the
 * problem again. These are the drivers most worth texting in the whole product
 * — the two non-conditional asks in the catalogue are the medical card and the
 * licence, which is precisely what `eligibility()` blocks on — so the banner
 * now carries the action instead of a signpost to one.
 */
const blockedDrivers = blocked.length

/**
 * THE CEILING. What the unanswered dates could cost him, at the very most.
 *
 * The owner's ask, finally answerable now that the amounts are data: "add the
 * total price of the unpaid compliance". The arithmetic and every rule about
 * what may be counted live in src/lib/rules/exposure.ts; this page only decides
 * how to say it.
 *
 * AND THE WORDS ARE MOST OF THE WORK. Three things have to be true of the
 * sentence or the figure is worse than no figure at all:
 *
 *   - "The most they can fine you", never "you will pay". Appendix B maximums
 *     are not forecasts; what is billed turns on discretion and settlement and
 *     is routinely a fraction. A product that overstates once is a product that
 *     gets checked, and this audience checks.
 *   - The rows with no figure are printed beside it, every time. Most of this
 *     catalogue carries no line-item penalty, so a fleet can be in real trouble
 *     with almost nothing to sum — and "$0" over two expired medical cards is
 *     the one sentence this product must never write.
 *   - The amounts carry their date. The research is explicit that DOT appears
 *     to have skipped the January 2026 cycle, so these are simultaneously
 *     current and the stalest they have been.
 *
 * Counted off the UNFILTERED items, like the parked-driver count above it: what
 * he is exposed to does not change because he tapped a tile. Reminders are NOT
 * in it — his own errands are not regulations and carry no penalty.
 */
const fleetExposure = exposure(
  items.map((i) => ({ standing: i.status.standing, penalty: i.rule.penalty })),
)
const exposureAtRisk = fleetExposure.counted + fleetExposure.unpriced

// On a filtered view the frame keeps a one-line subtitle: it is what holds the
// "Show everything" link in the corner clear of the tiles under it.
const healthSubtitle = !showRing
  ? view !== 'all'
    ? 'Tap a box to change the list.'
    : undefined
  : health.total === health.onTrack
    ? `All ${health.total} we track have a date and are still ahead of you.`
    : health.needsAttention > 0
      ? // Says what the number IS. "2 need attention" over a grey line saying
        // 14 are not OK read as a contradiction. Both are right; the word that
        // makes them so is the clock: attention means overdue or due soon, and
        // the dates nobody has typed are counted on their own, just below.
        `Overdue or due soon, out of ${health.total} we track. Tap a box to see the list.`
      : `Out of ${health.total} we track. Tap a box to see the list.`

// Same rule as the runway's: what the shape does NOT cover, attached to the
// figure rather than dropped in a footnote, because the shape is read whole and
// in about a second, before any prose on the page is.
const healthCoverage =
  showRing && health.unschedulable > 0
    ? `${health.unschedulable} more have no due date we can work out. They are in the list below.`
    : undefined


const params = Astro.url.searchParams
const errorMessage = flashText(Astro.url, Astro.request)
const savedCount = params.has('dates') ? Number(params.get('dates')) : null
const clearedCount = params.has('cleared') ? Number(params.get('cleared')) : null
const withdrawn = params.get('withdrawn') === '1'
/**
 * Dates saved from the rows themselves, on whichever view he was standing on.
 *
 * Separate from `?dates=`, which belongs to the date editor and is only ever
 * read on `show=unknown`. One receipt read on two surfaces would put "4 dates
 * saved" across the top of a page where nothing had been.
 */
const rowsSaved = params.has('rows') ? Number(params.get('rows')) : null
const batchStamp = params.get('at')

/**
 * WHAT HAPPENED WHEN HE ASKED THE DRIVER, read back as a sentence.
 *
 * A code in the URL and never the sentence itself, for the same reason the
 * driver's own page does it that way: the alternative puts a phone number in
 * the address bar and in browser history. `who` is the driver id, which is
 * already what `?s=` carries, and the name is looked up from the page.
 *
 * 'failed' is not an error state and is not printed in red. The link is minted
 * and valid; what did not happen is the send — `TWILIO_*` stays unset until the
 * 10DLC campaign is live — and the honest next step is his own phone.
 */
const ASKED_OUTCOMES = ['sms', 'email', 'none', 'failed'] as const
const askedOutcome = ASKED_OUTCOMES.find((o) => o === params.get('asked')) ?? null
const askedWho = askedOutcome ? firstNameOf(String(params.get('who') ?? '')) : null
const askedLine = ((): string | null => {
  if (!askedOutcome) return null
  const who = askedWho ?? 'the driver'
  if (askedOutcome === 'sms') return `Sent to ${who} by text. The dates land here when they answer.`
  if (askedOutcome === 'email') return `Sent to ${who} by email. The dates land here when they answer.`
  if (askedOutcome === 'none') {
    return `No mobile number and no email for ${who}. The link is on their page — open it and send it however you already reach them.`
  }
  return `The link is ready but we could not send it just now. Open ${who}’s page to copy it.`
})()

/**
 * The bulk receipt: six counts, as six digits in one parameter.
 *
 * Counts rather than a sentence, for the same reason `asked=` is a code — a
 * sentence in the address bar is a sentence anybody can rewrite, and this one
 * would be read as something the app did. Every number here is already on
 * screen as a row, so none of it is a fact the URL is leaking.
 */
const bulkResult = ((): ReturnType<typeof bulkAskLine> | null => {
  const raw = params.get('bulk')
  if (!raw) return null
  const n = raw.split('.').map((x) => Number.parseInt(x, 10))
  if (n.length !== 6 || n.some((x) => !Number.isInteger(x) || x < 0 || x > 9999)) return null
  const [sms, email, none, failed, refused, overCap] = n
  return bulkAskLine({ sms, email, none, failed, refused, overCap })
})()

const reminded = params.get('remind') === '1'

/** Who "Ask everyone" would actually reach. The same function the handler uses,
 *  so the number on the button is the number that gets a message. */
const bulkTargets = askTargetsFor([...actionIndex.values()])

/** Who was taken off the list, so the receipt can offer the way back. */
const retiredId = params.get('retired') === '1' ? String(params.get('who') ?? '') : null
const retiredName = retiredId ? (firstNameOf(retiredId) ?? 'That driver') : null

/**
 * The receipt: the rows this submit just wrote, read back in words.
 *
 * Found by the batch's shared `recorded_at`, which is why the handler stamps one
 * for the whole insert. Nothing about a record id travels through the URL.
 *
 * This is the typo net. `October 3, 2027` in long form is how he catches the
 * 2027 he meant as 2026, at the one moment he still remembers what he intended —
 * and the Withdraw button beside it supersedes the row rather than deleting it,
 * so the correction is itself part of the record.
 */
// A rise in the red tile across the save, which only this page can explain.
const overdueBeforeSave = params.has('od') ? Number(params.get('od')) : null
const overdueRose =
  overdueBeforeSave !== null && Number.isFinite(overdueBeforeSave) && overdue.length > overdueBeforeSave

const receipt: { id: string; label: string; on: string }[] = []
if (view === 'unknown' && focus && savedCount && savedCount > 0 && isBatchStamp(batchStamp)) {
  const { data } = await supabase
    .from('compliance_records')
    .select('id, anchor_key, occurred_on')
    .eq('recorded_at', batchStamp)
    .is('superseded_at', null)

  for (const row of data ?? []) {
    const key = String(row.anchor_key)
    // Resolved from the REGISTRY, not from the questions on screen. The question
    // is gone by the time the receipt renders — answering it is what took it off
    // the list — so a lookup through `focus.questions` falls through to the raw
    // key and prints `ca_ifta_quarterly_return` at the exact moment he is meant
    // to be checking he typed the right year against the right thing.
    receipt.push({
      id: String(row.id),
      label: resolveAnchor(key)?.label ?? key,
      on: longDate(String(row.occurred_on)),
    })
  }
}

// `min-h-11`: an input is a tap target too, and at py-2 this box was 42px on
// the one screen in the app that is nothing but boxes to tap.
const dateField =
  'mt-1 min-h-11 w-full max-w-xs rounded-lg border border-ink-100 bg-white px-3 py-2 text-base tabular-nums outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20'

/**
 * ONE HEADING SCALE, TWO STEPS.
 *
 * `h2 text-base font-semibold` names a section of the page; this names anything a
 * level below, at the same size and weight the chart frame already gives its own
 * heading (src/components/charts/Figure.astro). It replaces a 12px grey
 * uppercase treatment that did not match either of the other two on the page.
 */
const cardHeading = 'card-heading'

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * This table is 48rem wide and the window on a 375px phone is about 341px, so
 * over half of every row was behind a sideways scroll — the due date and the
 * citation among it, on the one screen this product exists to show. Below `sm`
 * every cell becomes a block; from `sm` the same markup is a table again. ONE
 * set of cells, not two — and one set for both kinds of row, so a reminder and
 * a regulation cannot drift apart. The pattern is written down in
 * src/components/Documents.astro.
 */
const cell = 'block px-4 sm:table-cell sm:py-3'

/**
 * The pill on a "Coming up" row. `standingPill` knows nothing about the 45-day
 * window — due soon is not a standing — so these rows wore the green "Current"
 * pill inside an amber section, under an amber tile reading "Due in 45 days",
 * beside a truck page that calls the same date "Due soon" in amber. One state,
 * one colour: amber here too, with the word the tile and the truck page use.
 */
const SOON_PILL = { label: 'Due soon', className: 'badge badge-warning' }

const emptyFiltered = shownCount === 0 && view !== 'all' ? emptyFilterState(view) : null

/**
 * The one link back to /app/setup, and it is a door rather than a signpost.
 *
 * Nothing in the app linked to that page once a carrier existed — the
 * middleware sends people there only when they have no carrier — so an owner
 * who added one truck and stopped had no way back to the page that knows how
 * many are still missing, short of retyping the URL. The words and the rule are
 * in `setupNudge`; the short version is that it appears while a list is empty
 * and disappears for good once both have something on them.
 *
 * A count we could not read is not a count of zero. If either query failed,
 * this page says nothing about the roster rather than telling an owner with six
 * trucks that he has none.
 */
const nudge =
  truckCount.count === null || driverCount.count === null
    ? null
    : setupNudge(truckCount.count, driverCount.count)
const backOut = 'btn btn-secondary'
---

{/*
  `live` — the date boxes in the sections save without reloading the page.

  The owner asked for this page by name, and it is the page the whole product
  is for: he works down the list typing dates into the sections, and a reload
  after each save threw him back to the top of a list he was halfway through.
  Nothing on the server changed; every intent still posts here and still 303s,
  so with no JavaScript it behaves exactly as it did.
*/}
<App
  live
  title={carrier?.legal_name ?? 'Dashboard'}
  subtitle={carrier?.dot_number ? `USDOT ${carrier.dot_number}` : undefined}
>
  {/*
    Above the tiles, because four tiles reading 0 are not the thing to fix —
    the empty list under them is, and this is the page that fixes it. It is a
    real link, not a dismissible banner: there is nothing to dismiss, since it
    goes away by itself the moment the roster stops being empty.
  */}
  {/*
    THE ANSWER TO THE SAVE HE JUST MADE, above everything.

    A date typed on a row can be saved from any view, so neither of these can
    live where the date editor's receipt lives — that one is only ever drawn on
    `show=unknown`, and a refusal rendered on a screen he is not looking at is a
    save that failed in silence.
  */}
  {
    errorMessage && view !== 'unknown' && (
      <p
        role="alert"
        tabindex="-1"
        class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"
      >
        {errorMessage}
      </p>
    )
  }
  {
    rowsSaved !== null && Number.isFinite(rowsSaved) && (
      <Flash tone={rowsSaved > 0 ? 'ok' : 'note'} class="mb-4">
        {rowsSaved > 0
          ? /* The count is the number of DATES, and the sentence says so. Rows
               can move by more than that — one periodic inspection settles two
               rules — and a number that does not match what he watched change
               is a number he stops trusting. */
            `${rowsSaved} ${rowsSaved === 1 ? 'date' : 'dates'} saved. The list below is already using ${rowsSaved === 1 ? 'it' : 'them'}.`
          : 'Nothing was typed in, so nothing changed.'}
      </Flash>
    )
  }

  {
    nudge && (
      <div class="mb-4 rounded-xl border border-brand-500/30 bg-champagne-50 p-4 sm:flex sm:items-center sm:gap-4">
        <div class="sm:flex-1">
          <p class="font-medium">Finish setting up your fleet</p>
          <p class="mt-1 text-sm text-ink-700">{nudge}</p>
        </div>
        <a
          href="/app/setup"
          class="btn btn-primary mt-3 w-full sm:mt-0 sm:w-auto sm:shrink-0"
        >
          Go to setup
        </a>
      </div>
    )
  }

  {/*
    ===================================================== where he stands now ===

    ONE element, answering ONE question: how much of this fleet is a problem
    right now. The ring is the shape and the tiles are the numbers, and they are
    inside the same frame because they are two halves of one answer rather than
    two answers — four overdue is a crisis in a fleet of nine and a Tuesday in a
    fleet of four hundred, which is a proportion and is invisible in a row of
    counts; and a proportion with no counts beside it is a picture nobody can
    act on. So the ring carries exactly one number and the tiles carry the four.

    The tiles ARE the ring's legend. Same four buckets, same order, same colours,
    a swatch on each, and the words and the numbers printed either way — colour
    is never the only thing tying a tile to its arc.
  */}
  <Figure
    title={healthHeadline(health)}
    subtitle={healthSubtitle}
    coverage={healthCoverage}
    action={view !== 'all' ? { href: '/app', label: 'Show everything' } : undefined}
  >
    {/*
      THE RING IS BACK, AND THE SENTENCE UNDER IT IS NOT.

      Taking it off the page was the wrong cut. The owner's words: "the charts
      are simple, you should have some charts to show the owner." He is right
      about which half was the problem — three stacked cards and three
      paragraphs of prose were the weight on this screen, not the one shape
      that says how much of the fleet is a problem in about a second. A row of
      counts cannot say that: four overdue is a crisis in a fleet of nine and a
      Tuesday in a fleet of four hundred, and that is a proportion.

      What stays cut is the arithmetic sentence that used to sit under it. Its
      job was to stop the centre number reading as a score by showing the
      addition — and the four tiles ARE the addition, in a row, always beside
      it, each with its swatch and its word and its number. The sentence was a
      second copy of what the tiles already say.
    */}
    <div class="flex items-center gap-3 sm:gap-6">
      {
        ringDrawn && (
          <Donut
            slices={donutSlices(health)}
            centre={health.needsAttention}
            centreNote={showGhostRing ? 'nothing tracked' : `of ${health.total}`}
            centreTone={
              /* Green ONLY when there is genuinely nothing outstanding. A zero
                 in the hole over 119 grey arcs is still a zero he has to read
                 correctly, and greening it would make "no date on file" look
                 like a pass at the largest type size on the page. */
              showRing && health.needsAttention === 0 && health.missing === 0
                ? 'clear'
                : 'attention'
            }
          />
        )
      }

      <nav
        aria-label="Filter the list"
        class:list={[
          'grid min-w-0 flex-1 gap-2',
          // Beside the ring: two on a tablet, all four in a row on a wide
