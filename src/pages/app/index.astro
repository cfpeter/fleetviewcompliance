---
/**
 * The dashboard. One list, soonest first — with one filter laid over it.
 *
 * The ordering is the product: overdue and unknown sit together at the top,
 * because a medical card whose date we have never been given carries the same
 * exposure as one that expired. Anything else buries the rows that matter.
 *
 * The filter does not touch that. It only hides sections. A carrier with 46
 * tracked items has an Overdue section, then a 37-row "we need a date from you"
 * section, and only then "coming up in the next 45 days" — which on a phone is
 * a section that does not exist, because nobody scrolls that far while standing
 * next to a truck. So the four stat tiles became the control: they already name
 * the exact subsets, they are already at the top, and they are already the
 * reason he opens the page.
 *
 * Tiles are plain links carrying `?show=`, not buttons wired to a script. The
 * filtered view is then shareable ("look at the overdue one"), the back button
 * walks back through the filters he tried, and the page keeps working on one
 * bar of signal — same reasoning as the segmented control on /app/vehicles.
 */
import Donut from '../../components/charts/Donut.astro'
import Figure from '../../components/charts/Figure.astro'
import Runway from '../../components/charts/Runway.astro'
import App from '../../layouts/App.astro'
import {
  buildHealth,
  donutSlices,
  healthHeadline,
  healthMath,
  type HealthInput,
  type HealthKey,
  missingLine,
  openCount,
  openParts,
} from '../../lib/charts/health.ts'
import { buildRunway, weekRangeLabel } from '../../lib/charts/runway.ts'
import { TONES } from '../../lib/charts/tones.ts'
import {
  capSection,
  dashboardHref,
  emptyFilterState,
  parseDashboardView,
  showsSection,
  viewNoun,
} from '../../lib/dashboard.ts'
import { anchorSlot, planAnchorWrites } from '../../lib/anchors/plan.ts'
import {
  buildDateEditor,
  findSubject,
  isBatchStamp,
  longDate,
  maxFor,
  readTypedDates,
  rowsSettledBy,
  savedHeadline,
  subjectHrefFor,
} from '../../lib/dashboard-dates.ts'
import { loadDeadlines } from '../../lib/deadlines.ts'
import {
  REMINDER_ORIGIN,
  REMINDER_ORIGIN_NOTE,
  loadReminders,
  type ReminderItem,
} from '../../lib/reminders.ts'
import { setupNudge } from '../../lib/roster.ts'
import { resolveAnchor } from '../../lib/rules/anchors.ts'
import { SOON_DAYS, dueLine, standingPill } from '../../lib/rules/index.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

// An unrecognised ?show= reads as "everything" rather than as an empty page.
// See src/lib/dashboard.ts — an owner who opens his compliance dashboard and
// finds nothing on it does not think "bad URL", he thinks his data is gone.
const view = parseDashboardView(Astro.url.searchParams.get('show'))

// No .eq('carrier_id', ...) below. RLS already scopes both of these to the
// signed-in user's carrier; repeating the filter here would say in code that we
// do not quite trust the policy.
const [{ data: carrier }, items, reminders, truckCount, driverCount] = await Promise.all([
  supabase.from('carriers').select('legal_name, dot_number').eq('id', carrierId).single(),
  loadDeadlines(supabase, carrierId),
  // The owner's own list, on the same screen as the law's — because he has one
  // morning, not two. They are kept in a SEPARATE array all the way to the
  // markup rather than merged into `items`: a DeadlineItem carries a citation
  // and a link to the regulation, a reminder carries neither, and the only way
  // to put a reminder in that array is to invent the one thing it must never
  // have. See the note above the reminder rows below.
  loadReminders(supabase, null),
  /**
   * How big the roster is, for the one nudge back to /app/setup.
   *
   * TWO HEAD COUNTS, AND NOTHING FROM FMCSA. The federal targets this page
   * would need to say "3 of 7" are not on the `carriers` table — /app/setup
   * fetches them live from the census — and a dashboard that waits on a federal
   * data service before it paints is a dashboard that hangs when that service
   * does. So the trigger is local: an empty truck list, or an empty driver
   * list. See `setupNudge`.
   *
   * NOT derived from `items`, which this page already has. A vehicle whose GVWR
   * puts it under the CMV threshold answers `not_applicable` to every rule and
   * is dropped before it reaches that array, so counting subjects there would
   * report a yard with three light trucks in it as empty.
   *
   * Same filters as /app/setup uses, so the two pages can never disagree about
   * whether the roster is empty. No .eq('carrier_id', ...) for the reason given
   * above: RLS scopes both tables already.
   */
  supabase
    .from('vehicles')
    .select('id', { count: 'exact', head: true })
    .eq('kind', 'power_unit')
    .eq('status', 'active'),
  supabase.from('drivers').select('id', { count: 'exact', head: true }).eq('status', 'active'),
])

/**
 * The same `unknown` rows, reshaped into questions a person can answer.
 *
 * Built from `items` — the array the tiles, the list and the runway are all
 * built from — because a second query here would be a second answer to "what is
 * missing", and the two would disagree the first time a rule changed.
 */
const editor = buildDateEditor(items.filter((i) => i.status.standing === 'unknown'))
const focus = findSubject(editor, Astro.url.searchParams.get('s'))

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const todayIso = new Date().toISOString().slice(0, 10)

/**
 * The dashboard now takes writes, and every branch ends in a 303.
 *
 * Posting to the page itself rather than to an API route keeps the whole thing
 * working with no JavaScript, and the redirect means a refresh after saving
 * cannot write the same dates twice.
 */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')
  const to = (query: string) => Astro.redirect(`/app?${query}`, 303)
  const here = (extra: string) =>
    `show=unknown${focus ? `&s=${encodeURIComponent(focus.id)}` : ''}${extra}`
  const fail = (message: string) => to(here(`&error=${encodeURIComponent(message)}`))

  if (intent === 'withdraw_date') {
    const recordId = String(form.get('record_id') ?? '')
    // A malformed id would reach Postgres as a failed uuid cast and put
    // "invalid input syntax for type uuid" across the top of his dashboard.
    if (!UUID.test(recordId)) return to(here(''))

    // Superseded, never deleted — the row stays as a record of what was believed
    // and when, and the next most recent date takes over. RLS scopes this to his
    // own carrier, and `is('superseded_at', null)` makes a double-tap a no-op
    // rather than a second, later withdrawal stamp.
    const { error } = await supabase
      .from('compliance_records')
      .update({ superseded_at: new Date().toISOString() })
      .eq('id', recordId)
      .is('superseded_at', null)
    if (error) return fail(error.message)
    return to(here('&withdrawn=1'))
  }

  if (intent === 'save_unknown_dates') {
    // No subject in the URL means a stale form or a hand-edited one. Back to the
    // list rather than an error: there is nothing for him to fix.
    if (!focus) return to('show=unknown')

    // Reads ONLY the questions this subject actually has. A `date_hire_date`
    // posted by hand is not rejected, it is never looked at — the only version
    // of that defence with no list to keep up to date.
    const typed = readTypedDates(focus, (field) => form.get(field) as string | null, todayIso)
    if (!typed.ok) return fail(typed.message)

    if (typed.typed.length === 0) return to(here('&dates=0'))

    const { data: currentRows } = await supabase
      .from('current_compliance_anchors')
      .select('id, anchor_key, occurred_on')
      .eq('subject_type', focus.recordSubject)
      .eq('subject_id', focus.id)

    const current = new Map(
      (currentRows ?? []).map((r) => [
        anchorSlot(focus.recordSubject, focus.id, String(r.anchor_key)),
        { id: String(r.id), occurred_on: String(r.occurred_on).slice(0, 10) },
      ]),
    )

    // One stamp for the whole batch, and it is load-bearing rather than tidy:
    // the receipt below finds exactly the rows this submit wrote by querying it
    // back. The view's ordering does not use `recorded_at` at all any more — it
    // orders on `seq` since migration 0007 — so sharing it costs nothing.
    const recordedAt = new Date().toISOString()

    const { supersede, inserts, conflicts } = planAnchorWrites({
      entries: typed.typed.map((t) => ({
        subject: focus.recordSubject,
        subjectId: focus.id,
        anchorKey: t.question.answerKey,
        on: t.on,
      })),
      current,
      carrierId,
      userId: Astro.locals.userId ?? null,
      recordedAt,
    })

    // One input per question, so this is unreachable from the form — but a
    // planner that can refuse must never be allowed to refuse silently.
    if (conflicts.length > 0) {
      return fail('You typed two different dates for the same question.')
    }

    if (supersede.length > 0) {
      const { error } = await supabase
        .from('compliance_records')
        .update({ superseded_at: recordedAt })
        .in('id', supersede)
      if (error) return fail(error.message)
    }

    if (inserts.length > 0) {
      const { error } = await supabase.from('compliance_records').insert(inserts)
      if (error) return fail(error.message)
    }

    const cleared = rowsSettledBy(
      focus,
      typed.typed.map((t) => t.question.answerKey),
    )
    // The overdue count BEFORE this save travels with the redirect.
    //
    // Answering honestly can move a row to Overdue instead of off the list — he
    // tells us he last filed in July and the return that came due in August is
    // now visibly late. That is the date doing its job, but unexplained it reads
    // as punishment for answering, which is the one lesson this screen must
    // never teach.
    const overdueBefore = items.filter((i) => i.status.standing === 'overdue').length
    return to(
      here(
        `&dates=${inserts.length}&cleared=${cleared}&od=${overdueBefore}` +
          `&at=${encodeURIComponent(recordedAt)}`,
      ),
    )
  }

  return to(here(''))
}

const overdue = items.filter((i) => i.status.standing === 'overdue')
const unknown = items.filter((i) => i.status.standing === 'unknown')
/**
 * Due soon means a date AHEAD of us, inside the window.
 *
 * `daysUntil` is NEGATIVE for a one-time obligation that has been satisfied —
 * a pre-employment Clearinghouse query run when the driver was hired comes back
 * `current` with something like -2040. The old test was `<= SOON_DAYS`, which
 * -2040 passes, so twenty things finished years ago sat under a tile reading
 * "Due in 45 days". The reminder filter below already had this right; the
 * deadline filter did not.
 *
 * Written once and used for both arms so they stay exhaustive: every `current`
 * item is in exactly one of them, and a change here cannot put an item in
 * neither or in both.
 */
const dueSoon = (days: number | undefined) => {
  const d = days ?? Number.POSITIVE_INFINITY
  return d >= 0 && d <= SOON_DAYS
}
const soon = items.filter((i) => i.status.standing === 'current' && dueSoon(i.daysUntil))
const later = items.filter((i) => i.status.standing === 'current' && !dueSoon(i.daysUntil))
const manual = items.filter((i) => i.status.standing === 'unsupported')

/**
 * The reminders, in the same buckets, on the same day boundary.
 *
 * A reminder is only ever overdue or current — the owner typed the date, so
 * there is nothing to be unsure about — which is why there is no reminder half
 * to the `unknown` bucket and why the "Missing a date" tile does not move.
 */
const reminderOverdue = reminders.filter((r) => r.status.standing === 'overdue')
const reminderSoon = reminders.filter((r) => r.daysUntil >= 0 && r.daysUntil <= SOON_DAYS)
const reminderLater = reminders.filter((r) => r.daysUntil > SOON_DAYS)

// The date line moved to `dueLine` in src/lib/rules/index.ts, next to
// `standingPill`. It lived here as two helpers and one ternary, which is how an
// `unknown` row came to print "in 45 days" under a "Not sure" pill while the
// tile above it read "Due in 45 days: 0" — a decision this page cannot test.

const subjectHref = (t: string, id: string | null) =>
  t === 'driver' ? `/app/drivers/${id}` :
  t === 'power_unit' || t === 'trailer' ? `/app/vehicles/${id}` : '/app/settings'

// `reminders` rides along on each section rather than being merged into `items`.
// The two lists are ranked the same way and read on the same screen, and they
// are still two lists: one is a rule somebody else wrote, one is a line this
// owner typed.
const sections = [
  { key: 'overdue', title: 'Overdue', items: overdue, reminders: reminderOverdue, tone: 'border-red-200 bg-red-50/40' },
  { key: 'unknown', title: 'We need a date from you', items: unknown, reminders: [] as ReminderItem[], tone: 'border-ink-100 bg-white' },
  { key: 'soon', title: `Coming up in the next ${SOON_DAYS} days`, items: soon, reminders: reminderSoon, tone: 'border-amber-200 bg-amber-50/40' },
] as const

// Filtering is a `.filter` over the SAME array, in the same order, every time.
// Not a per-view list of sections: the moment the order is written out by hand
// per view, "unknown ranks with overdue" becomes a thing a future edit can undo
// on the page while the engine still reports it correctly, and nothing throws.
const visible = sections.filter((s) => showsSection(view, s.key))

// The TRUE totals of what this view covers, and it stays that way. This is the
// number in "Showing only what is overdue. 15 of 171 items", and it is what
// decides whether the filtered empty state fires — neither of which has anything
// to do with how many rows the resting page chooses to draw. Derived from the
// capped lists below, a section trimmed to ten would start describing itself as
// ten, and a view whose rows were all trimmed away would render the "Nothing is
// overdue" reassurance over a list that is not empty.
const shownCount = visible.reduce((n, s) => n + s.items.length + s.reminders.length, 0)

/**
 * The resting page shows the top of each section, not all of it.
 *
 * Unfiltered, this page drew every row it had: 15,494px on a desktop, one
 * section 11,084px of it. Everything worth reading was in the first screen and
 * everything after it was a wall — so each section now stops at
 * `SECTION_ROW_CAP` and hands over to the view its own stat tile already points
 * at. `capSection` is where the rules live, and the rules that matter are that
 * the tail is the safe end to cut, that the link counts the whole section, and
 * that a FILTERED view is never capped — it is what the link leads to.
 *
 * No second mechanism, and no script. The link is `?show=`, the same parameter
 * the tiles use, so the page ships the same zero bytes of JavaScript it did.
 */
const lists = visible.map((s) => ({
  ...s,
  shown: capSection(s.key, view, s.items, s.reminders),
}))

// Tile counts come off the WHOLE set, never off the filtered one. The counts are
// the reason he opens the page at all — a tile that reads "0 overdue" merely
// because he is standing inside the "Missing a date" filter would be a lie told
// by the one number he checks first, and he would stop believing the other three.
//
// THE COUNTS INCLUDE REMINDERS, and they have to. The tile is the first number
// he reads and the section under it is the list he acts on; a tile that counted
// only regulations while the Overdue section showed four rows would be the one
// number on this page he checks first, disagreeing with the rows directly below
// it. He would stop believing the other three.
const trackedCount = items.length + reminders.length

/**
 * The four buckets, counted once, for the ring AND for the tiles.
 *
 * THE TILES ARE NOW THE RING'S LEGEND, which is why they are derived from
 * `buildHealth` rather than hand-assembled here. A ring and a row of counters
 * showing the same four numbers from two different pieces of arithmetic is two
 * answers to one question, and the first time a bucket rule changed only one of
 * them would move — on the screen whose entire job is trust.
 *
 * REMINDERS ARE COUNTED, unlike on the runway below. The runway is drawn from
 * the rules alone and says so, because a shape that counted the owner's own
 * errands as regulations would make a quiet November look busy for a reason no
 * regulation is responsible for. The ring is not making that claim: it is the
 * mix of what is on this screen, the tiles are the ring's legend, and a tile
 * that counted only regulations while the section under it listed reminders too
 * would be the number he checks first disagreeing with the rows beneath it.
 */
const health = buildHealth([
  ...items.map((i) => ({ standing: i.status.standing, daysUntil: i.daysUntil })),
  ...reminders.map((r) => ({ standing: r.status.standing, daysUntil: r.daysUntil })),
])

/**
 * The tiles: four big numbers, three of them a filter.
 *
 * 'On track' is deliberately NOT a link. There is no `?show=` view behind it
 * because there is nothing on the other side to do — that is the whole meaning
 * of the green arc — and a fourth tappable tile that led to a list he does not
 * need to read would be the one control on this page that wastes a tap. It is
 * still a tile: the colour rule needs a number and a word beside every slice,
 * and green is a slice.
 *
 * The old fourth tile, 'All items', is gone. It was the way back out of a
 * filter, and the way back out is now the link in the figure header plus the
 * sentence under these tiles — so the four tiles map exactly onto the four arcs
 * and nothing in the row means something the ring does not.
 */
const TILE_STYLE: Record<string, { box: string; labelClass: string; countClass: string }> = {
  overdue: {
    box: 'border-red-200 bg-red-50/40',
    labelClass: 'text-red-700',
    countClass: 'text-red-700',
  },
  // Grey, not white. It is the colour of the arc, and 'Not sure' in
  // `standingPill` is already grey — the tile has to look like the pill on the
  // row it filters to. Never green, never blank: a missing date is not a pass.
  unknown: {
    box: 'border-ink-200 bg-ink-50',
    // ink-700, not ink-500. The label is 12px and it sits on a tint, and both
    // of those put it under the floor in src/styles/global.css.
    labelClass: 'text-ink-700',
    countClass: 'text-ink-900',
  },
  soon: {
    box: 'border-amber-200 bg-amber-50/40',
    labelClass: 'text-amber-800',
    countClass: 'text-amber-800',
  },
  ontrack: {
    box: 'border-emerald-200 bg-emerald-50/40',
    labelClass: 'text-emerald-800',
    countClass: 'text-emerald-800',
  },
}

const tiles = health.buckets.map((b) => ({
  key: b.key,
  view: b.view,
  label: b.label,
  count: b.count,
  swatch: TONES[b.tone].swatch,
  ...TILE_STYLE[b.key],
}))

// A row, not a stacked card. Stacked, four tiles are ~400px of nothing on a
// phone and there is no room left beside them for the ring; as rows the whole
// block — ring and all four numbers — fits in about 190px, which is less than
// the old tiles took on their own.
//
// `min-h-11` is the 44px thumb floor. Three of these four are filters and they
// are tapped standing next to a truck.
const tileBase = 'flex min-h-11 items-center gap-2 rounded-lg border px-2.5 py-2 transition'
/**
 * The selected filter, as the app's one selected metaphor: a filled tinted
 * pill, the same `.is-current` the nav and every other filter row uses.
 *
 * It replaces a dark 2px ring, which was a second vocabulary for "this one is
 * on" and read as an error outline on a bad screen in daylight. The pill
 * replaces the tile's own bucket tint rather than sitting on top of it — two
 * fills cannot share one box — and nothing is lost by that: the swatch, the
 * coloured count, the word and the "Showing" line under it all stay, so the
 * tile still says which arc it belongs to four ways over.
 */
const tileOn = 'is-current'

/** The ring is a chart, so it obeys the chart rule: never on a filtered view. */
const showRing = view === 'all' && health.total > 0

/**
 * The ghost ring: the outline, drawn when there is nothing in it yet.
 *
 * A carrier on his first morning got four tiles reading 0 and an empty space
 * where the ring goes, which reads as a screen that failed to load rather than
 * as a fleet nobody has entered yet. `Donut` already draws its own grey track
 * for this, so the shape costs nothing: the hole holds a real 0 with the words
 * 'nothing tracked' under it, in ink rather than green, because nothing tracked
 * is not the same finding as nothing wrong. The one thing to do about it is the
 * button further down the page, and there is only ever one of those.
 */
const showGhostRing = view === 'all' && health.total === 0
const ringDrawn = showRing || showGhostRing

/**
 * The sentence under the ring, and it is the reason the centre number is
 * allowed to exist. "22 need attention" with nothing beside it is a score, and
 * a score is a thing a broker quotes back at a carrier who then cannot take it
 * apart. `healthMath` prints the addition — and then adds the missing dates and
 * the on-track items back on to reach the total, so the number in the hole
 * being smaller than the coloured part of the ring is stated rather than left
 * for him to notice.
 *
 * Built in src/lib/charts/health.ts, not here, and the proof page prints the
 * SAME string. Two hand-written versions of this sentence is how the owner's
 * screen and the broker's screen come to disagree about one carrier.
 */
const healthArithmetic = healthMath(health)

/**
 * The grey line: the one an owner has to read as "we are missing 119 dates from
 * you". It sits directly under the ring and above the arithmetic, in its own
 * box, because the count used to be inside the headline and is not any more —
 * and a number that leaves the headline has to land somewhere louder than a
 * tile, or it has quietly been softened.
 */
const healthMissing = ringDrawn ? missingLine(health, 'owner') : null

const healthSubtitle = !showRing
  ? undefined
  : health.total === health.onTrack
    ? `All ${health.total} we track have a date and are still ahead of you.`
    : `Out of ${health.total} we track. Tap a box to see the list.`

// Same rule as the runway's: what the shape does NOT cover, attached to the
// figure rather than dropped in a footnote, because the shape is read whole and
// in about a second, before any prose on the page is.
const healthCoverage =
  showRing && health.unschedulable > 0
    ? `${health.unschedulable} more have no due date we can work out. They are in the list below.`
    : undefined

/**
 * The next quarter drawn as a shape.
 *
 * The list below answers "what is wrong". It cannot answer the question the
 * owner asks in the same breath — "and when does the next pile land" — because
 * that answer is a shape, and a list sorted by date is a shape you can only see
 * by reading forty rows and holding them in your head. Four renewals landing in
 * the same week in November is a bad week whether or not any one of them is
 * alarming alone, and it is invisible until it is drawn.
 *
 * Built from `items`, the same array the list and the tiles are built from, so
 * the chart and the rows under it cannot drift apart.
 */
const runway = buildRunway(
  // Mapped, not passed straight through: `buildRunway` takes a standing and a
  // date, and knows nothing about DeadlineItem. Keeping it that way is what
  // lets the runway be tested against hand-built fixtures instead of a fleet.
  items.map((i) => ({ standing: i.status.standing, nextDue: i.status.nextDue })),
  new Date(),
)

// What the timeline cannot show. `Figure` renders this in amber above the fold
// of the chart rather than as a footnote, because the shape is taken in whole,
// in about a second, before any prose on the page is read.
const runwayCoverage =
  [
    // Terse on purpose. Written out in full this ran to five lines on a phone
    // and pushed the list — the thing he came for — most of a screen further
    // down, which is the regression the dashboard filter was added to fix. The
    // left block already carries the count; this only has to say why it is not
    // on the timeline.
    runway.undated > 0 &&
      `${runway.undated} have no date yet. They are counted on the left, not on the chart.`,
    runway.unschedulable > 0 &&
      `${runway.unschedulable} more have no schedule we can work out. They are in the list below.`,
    // The timeline is drawn from the RULES. Saying so is the honest half of
    // showing both lists in one table underneath: a shape that counted the
    // owner's own errands as deadlines would make a quiet November look busy
    // for a reason no regulation is responsible for.
    reminders.length > 0 && 'Your own reminders are not on this timeline. They are in the list below.',
  ]
    .filter(Boolean)
    .join(' ') || undefined

/**
 * The timeline's heading says which week, not what the chart is called.
 *
 * It read "The next 13 weeks", which names the shape and leaves the owner to
 * find the answer inside it. The question he is asking is which week is going
 * to hurt, so the heading answers that and the sentence under the bars carries
 * the count. `peak` is null when no week holds more than one item — one item in
 * one week is not a heavy week, it is a Tuesday — so that case says so plainly
 * instead of pointing at a column.
 */
const runwayTitle = runway.peak
  ? `Your heaviest week is ${weekRangeLabel(runway.peak)}`
  : runway.scheduled > 0
    ? 'No week ahead has more than one deadline'
    : `Nothing is due in the next ${runway.horizonWeeks} weeks`

/* ====================================================== who to start with ===
 *
 * The tables below answer "what is wrong", one row per rule. They cannot answer
 * the question he asks next — who do I call first — because that answer is a
 * driver or a truck, and one driver's five problems can sit in three different
 * sections, ten rows apart. Working that out by reading is how an owner loses a
 * morning.
 *
 * So the SAME items are counted one more way, per record, and the five records
 * carrying the most are printed in order. Nothing new is decided here: the
 * buckets come from `buildHealth`, the function the ring and the tiles are
 * built from, so a row here cannot disagree with the numbers at the top of the
 * page. It is also what keeps the days arithmetic in one place — a one-time
 * obligation already satisfied reports something like -2040 days and is on
 * track, not due soon, and this page is not allowed to decide that twice.
 *
 * REMINDERS ARE COUNTED, for the same reason the tiles count them: this list
 * ranks the work in front of him, and an overdue insurance renewal on a truck
 * is work in front of him. The runway leaves them out because a shape drawn
 * from the rules cannot also be a shape drawn from his errands; a count of work
 * per record has no such problem.
 */
const NEEDS_CAP = 5

/** The records with a page of their own to open, and what to call each one. */
const recordNoun = (type: string): string | null =>
  type === 'driver'
    ? 'Driver'
    : type === 'power_unit'
      ? 'Truck'
      : type === 'trailer'
        ? 'Trailer'
        : null

interface NeedsRecord {
  label: string
  noun: string
  href: string
  inputs: HealthInput[]
}

const needsBy = new Map<string, NeedsRecord>()

/**
 * Everything that is not one driver or one truck: the carrier's own filings,
 * and the reminders he wrote against the whole company.
 *
 * Counted, never dropped. A pile he can see in the list below and cannot find
 * here is a list he stops believing.
 */
const companyInputs: HealthInput[] = []

const addNeed = (key: string, label: string, noun: string, href: string, input: HealthInput) => {
  const row = needsBy.get(key) ?? { label, noun, href, inputs: [] as HealthInput[] }
  row.inputs.push(input)
  needsBy.set(key, row)
}

for (const i of items) {
  const input: HealthInput = { standing: i.status.standing, daysUntil: i.daysUntil }
  const noun = recordNoun(i.subjectType)
  if (!noun || !i.subjectId) {
    companyInputs.push(input)
    continue
  }
  addNeed(
    `${i.subjectType === 'driver' ? 'driver' : 'vehicle'}:${i.subjectId}`,
    i.subjectLabel,
    noun,
    subjectHref(i.subjectType, i.subjectId),
    input,
  )
}

for (const r of reminders) {
  const input: HealthInput = { standing: r.status.standing, daysUntil: r.daysUntil }
  if (!r.subject.id || !r.subject.href) {
    companyInputs.push(input)
    continue
  }
  // A reminder does not say whether the vehicle is a truck or a trailer, so it
  // uses the word the rest of this page uses for one. When the rules have
  // already named the record, that name is the one kept and this is never read.
  addNeed(
    `${r.subject.kind}:${r.subject.id}`,
    r.subject.label,
    r.subject.kind === 'driver' ? 'Driver' : 'Truck',
    r.subject.href,
    input,
  )
}

const needsRows = [...needsBy.values()]
  .map((row) => {
    const rowHealth = buildHealth(row.inputs)
    const count = (key: HealthKey) => rowHealth.buckets.find((b) => b.key === key)?.count ?? 0
    return {
      ...row,
      /**
       * `openParts`, NOT `attentionParts`, and the difference is the whole
       * point of this list. The ring's centre number is overdue plus due soon;
       * this list answers a different question — who do I open first — and a
       * driver with nine blank dates and nothing overdue is top of it. Ranked
       * on `attentionParts` he would score zero and drop off the page
       * entirely, which is the grey bucket being hidden by the back door.
       *
       * Same three buckets, same order and same words as the tiles above, so
       * the breakdown beside the number is the number taken apart rather than
       * a second opinion about it.
       */
      parts: openParts(rowHealth),
      attention: openCount(rowHealth),
      overdue: count('overdue'),
      missing: count('unknown'),
      soon: count('soon'),
    }
  })
  .filter((r) => r.attention > 0)
  // Overdue first: an expired document is a fact, a missing date is a question.
  // Missing breaks the tie, and it is the tie that gets broken on the day a
  // carrier signs up — nothing is overdue yet, so the ranking is entirely about
  // who has the most dates nobody has typed in. Same ordering as STANDING_RANK
  // in src/lib/rules/index.ts, applied to counts instead of to rows.
  .sort(
    (a, b) =>
      b.overdue - a.overdue ||
      b.missing - a.missing ||
      b.soon - a.soon ||
      a.label.localeCompare(b.label),
  )

const needsTop = needsRows.slice(0, NEEDS_CAP)
const needsRest = needsRows.length - needsTop.length
// Counted the same way the rows above are — everything not on track, grey
// included — so the "and your company has N of its own" line is measured on the
// same ruler as the list it is attached to.
const companyNeeds = openCount(buildHealth(companyInputs))

/** A ranking across the whole fleet, so it obeys the chart rule: resting view only. */
const showNeeds = view === 'all' && needsTop.length > 0

// The heading names the record, because the name IS the answer to "who first".
const needsTitle = needsTop.length > 0 ? `Start with ${needsTop[0].label}` : ''
const needsSubtitle =
  needsRows.length > NEEDS_CAP
    ? `The ${NEEDS_CAP} with the most to fix. Tap one to open it.`
    : needsRows.length === 1
      ? 'This is the only one with something to fix. Tap it to open it.'
      : `All ${needsRows.length} that have something to fix. Tap one to open it.`

const needsMoreParts: string[] = []
if (needsRest > 0) {
  needsMoreParts.push(`${needsRest} more ${needsRest === 1 ? 'is' : 'are'} not on this list.`)
}
if (companyNeeds > 0) {
  needsMoreParts.push(`Your company has ${companyNeeds} of its own.`)
}
const needsMore =
  needsMoreParts.length > 0 ? `${needsMoreParts.join(' ')} They are in the list below.` : null

const params = Astro.url.searchParams
const errorMessage = params.get('error')
const savedCount = params.has('dates') ? Number(params.get('dates')) : null
const clearedCount = params.has('cleared') ? Number(params.get('cleared')) : null
const withdrawn = params.get('withdrawn') === '1'
const batchStamp = params.get('at')

/**
 * The receipt: the rows this submit just wrote, read back in words.
 *
 * Found by the batch's shared `recorded_at`, which is why the handler stamps one
 * for the whole insert. Nothing about a record id travels through the URL.
 *
 * This is the typo net. `October 3, 2027` in long form is how he catches the
 * 2027 he meant as 2026, at the one moment he still remembers what he intended —
 * and the Withdraw button beside it supersedes the row rather than deleting it,
 * so the correction is itself part of the record.
 */
// A rise in the red tile across the save, which only this page can explain.
const overdueBeforeSave = params.has('od') ? Number(params.get('od')) : null
const overdueRose =
  overdueBeforeSave !== null && Number.isFinite(overdueBeforeSave) && overdue.length > overdueBeforeSave

const receipt: { id: string; label: string; on: string }[] = []
if (view === 'unknown' && focus && savedCount && savedCount > 0 && isBatchStamp(batchStamp)) {
  const { data } = await supabase
    .from('compliance_records')
    .select('id, anchor_key, occurred_on')
    .eq('recorded_at', batchStamp)
    .is('superseded_at', null)

  for (const row of data ?? []) {
    const key = String(row.anchor_key)
    // Resolved from the REGISTRY, not from the questions on screen. The question
    // is gone by the time the receipt renders — answering it is what took it off
    // the list — so a lookup through `focus.questions` falls through to the raw
    // key and prints `ca_ifta_quarterly_return` at the exact moment he is meant
    // to be checking he typed the right year against the right thing.
    receipt.push({
      id: String(row.id),
      label: resolveAnchor(key)?.label ?? key,
      on: longDate(String(row.occurred_on)),
    })
  }
}

// `min-h-11`: an input is a tap target too, and at py-2 this box was 42px on
// the one screen in the app that is nothing but boxes to tap.
const dateField =
  'mt-1 min-h-11 w-full max-w-xs rounded-lg border border-ink-100 bg-white px-3 py-2 text-base tabular-nums outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20'

/**
 * ONE HEADING SCALE, TWO STEPS.
 *
 * `h2 text-lg font-semibold` names a section of the page; this names anything a
 * level below, at the same size and weight the chart frame already gives its own
 * heading (src/components/charts/Figure.astro). It replaces a 12px grey
 * uppercase treatment that did not match either of the other two on the page.
 */
const cardHeading = 'text-sm font-semibold tracking-tight'

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * This table is 48rem wide and the window on a 375px phone is about 341px, so
 * over half of every row was behind a sideways scroll — the due date and the
 * citation among it, on the one screen this product exists to show. Below `sm`
 * every cell becomes a block; from `sm` the same markup is a table again. ONE
 * set of cells, not two — and one set for both kinds of row, so a reminder and
 * a regulation cannot drift apart. The pattern is written down in
 * src/components/Documents.astro.
 */
const cell = 'block px-4 sm:table-cell sm:py-3'

const emptyFiltered = shownCount === 0 && view !== 'all' ? emptyFilterState(view) : null

/**
 * The one link back to /app/setup, and it is a door rather than a signpost.
 *
 * Nothing in the app linked to that page once a carrier existed — the
 * middleware sends people there only when they have no carrier — so an owner
 * who added one truck and stopped had no way back to the page that knows how
 * many are still missing, short of retyping the URL. The words and the rule are
 * in `setupNudge`; the short version is that it appears while a list is empty
 * and disappears for good once both have something on them.
 *
 * A count we could not read is not a count of zero. If either query failed,
 * this page says nothing about the roster rather than telling an owner with six
 * trucks that he has none.
 */
const nudge =
  truckCount.count === null || driverCount.count === null
    ? null
    : setupNudge(truckCount.count, driverCount.count)
const backOut = 'btn btn-secondary'
---

<App
  title={carrier?.legal_name ?? 'Dashboard'}
  subtitle={carrier?.dot_number ? `USDOT ${carrier.dot_number}` : undefined}
>
  {/*
    Above the tiles, because four tiles reading 0 are not the thing to fix —
    the empty list under them is, and this is the page that fixes it. It is a
    real link, not a dismissible banner: there is nothing to dismiss, since it
    goes away by itself the moment the roster stops being empty.
  */}
  {
    nudge && (
      <div class="mb-4 rounded-xl border border-brand-500/30 bg-brand-500/[0.06] p-4 sm:flex sm:items-center sm:gap-4">
        <div class="sm:flex-1">
          <p class="font-medium">Finish setting up your fleet</p>
          <p class="mt-1 text-sm text-ink-700">{nudge}</p>
        </div>
        <a
          href="/app/setup"
          class="btn btn-primary mt-3 w-full sm:mt-0 sm:w-auto sm:shrink-0"
        >
          Go to setup
        </a>
      </div>
    )
  }

  {/*
    ===================================================== where he stands now ===

    ONE element, answering ONE question: how much of this fleet is a problem
    right now. The ring is the shape and the tiles are the numbers, and they are
    inside the same frame because they are two halves of one answer rather than
    two answers — four overdue is a crisis in a fleet of nine and a Tuesday in a
    fleet of four hundred, which is a proportion and is invisible in a row of
    counts; and a proportion with no counts beside it is a picture nobody can
    act on. So the ring carries exactly one number and the tiles carry the four.

    The tiles ARE the ring's legend. Same four buckets, same order, same colours,
    a swatch on each, and the words and the numbers printed either way — colour
    is never the only thing tying a tile to its arc.
  */}
  <Figure
    title={healthHeadline(health)}
    subtitle={healthSubtitle}
    coverage={healthCoverage}
    action={view !== 'all' ? { href: '/app', label: 'Show everything' } : undefined}
  >
    <div class="flex items-center gap-3 sm:gap-6">
      {
        ringDrawn && (
          <Donut
            slices={donutSlices(health)}
            centre={health.needsAttention}
            centreNote={showGhostRing ? 'nothing tracked' : `of ${health.total}`}
            centreTone={
              /* Green ONLY when there is genuinely nothing outstanding. A zero
                 in the hole over 119 grey arcs is still a zero he has to read
                 correctly, and greening it would make "no date on file" look
                 like a pass at the largest type size on the page. */
              showRing && health.needsAttention === 0 && health.missing === 0
                ? 'clear'
                : 'attention'
            }
          />
        )
      }

      <nav
        aria-label="Filter the list"
        class:list={[
          'grid min-w-0 flex-1 gap-2',
          // Beside the ring: one column on a phone, two on a tablet, all four
          // in a row on a wide screen, where two would leave each tile a third
          // of a metre of empty space to the right of its own label.
          // With no ring — a filtered view — it takes the whole width back.
          ringDrawn ? 'sm:grid-cols-2 sm:gap-3 lg:grid-cols-4' : 'grid-cols-2 sm:grid-cols-4 sm:gap-3',
        ]}
      >
        {
          tiles.map((t) => {
            const on = t.view !== null && view === t.view
            // The aria-label is spelled out because the visible tile is a swatch
            // and two stacked <span>s: read straight off the DOM the link
            // announces as "4 Overdue Show these", and in some readers as a link
            // with no name at all — a filter whose state a screen-reader user
            // cannot hear.
            const label = `${t.label}: ${t.count}. ${on ? 'Showing' : 'Show'} these.`
            const body = (
              <>
                <span
                  class:list={[
                    // min-w, not w. A fixed 2rem box fits "17" and not "148", and the
                    // third digit spilled straight across the swatch and the label.
                    // A fleet's missing-date count reaching three figures is the
                    // normal case on the day someone signs up, not an edge case.
                    'min-w-8 shrink-0 text-right text-xl leading-none font-semibold tabular-nums sm:text-2xl',
                    t.countClass,
                  ]}
                >
                  {t.count}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-center gap-1.5">
                    <span
                      class:list={['h-2 w-2 shrink-0 rounded-full', t.swatch]}
                      aria-hidden="true"
                    />
                    {/* Wraps, never truncates. Two-up on a 375px phone the
                        label had about 85px and "Missing a date" needs 82, so
                        `truncate` cut it to "Missing a ..." on exactly the
                        device this is read on — and the word beside the number
                        is the half of the tile that colour is not allowed to
                        carry alone. A second line costs 14px; a lost word costs
                        the rule. */}
                    <span class:list={['block text-xs leading-tight', t.labelClass]}>
                      {t.label}
                    </span>
                  </span>
                  {/*
                    A second, non-colour signal for which tile is on. The dark
                    ring does the work for most people, but "selected" carried by
                    an outline alone is the kind of state that disappears in
                    sunlight on a cracked phone screen in a yard — which is
                    precisely where this gets read.

                    On track says what it is instead: nothing to open.
                  */}
                  <span
                    class:list={[
                      // 11px, not 10px, and ink-700 rather than ink-300: this
                      // is the line that says which filter is on, and it was
                      // set at 1.85:1 on a tile read in daylight.
                      'mt-0.5 block text-[11px] leading-tight',
                      t.view === null
                        ? 'text-emerald-800'
                        : on
                          ? 'font-semibold text-brand-700'
                          : 'text-ink-700',
                    ]}
                  >
                    {t.view === null ? 'Nothing to do' : on ? 'Showing' : 'Show these'}
                  </span>
                </span>
              </>
            )

            // Green is not a link. There is no filtered view behind it because
            // there is nothing on the other side to act on, and a tap that lands
            // on a list he does not need to read is a tap this page wasted.
            return t.view === null ? (
              <div class:list={[tileBase, t.box]}>{body}</div>
            ) : (
              <a
                href={dashboardHref(t.view)}
                aria-current={on ? 'page' : undefined}
                aria-label={label}
                class:list={[
                  tileBase,
                  // The bucket tint OR the selected pill, never both: one box
                  // cannot carry two fills, and a utility background would win
                  // over the component class anyway.
                  on ? [tileOn, 'border-brand-600'] : [t.box, 'hover:shadow-sm'],
                ]}
              >
                {body}
              </a>
            )
          })
        }
      </nav>
    </div>

    {/*
      ================================================== the dates we are owed ===

      THE GREY COUNT, IN ITS OWN BOX, IN WORDS.

      It used to be inside the headline — "141 need attention", of which 119
      were items nobody had typed a date for. Taking it out of that number is
      the fix; leaving it as a tile and an arc would have been the softening.
      So it gets a line of its own, immediately under the ring, saying what it
      actually is: dates we are waiting on from him.

      Ink on a grey tint, which is the colour of the arc and of the tile and of
      the 'Not sure' pill on the rows it leads to. Never green, never amber:
      this is not good news and it is not a clock running down. It is a
      question, and the link is where he answers it.
    */}
    {
      healthMissing && (
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-ink-200 bg-ink-50 px-4 py-3 text-sm text-ink-700">
          <span class="min-w-0 flex-1 tabular-nums">{healthMissing}</span>
          <a href="/app?show=unknown" class="link inline-flex min-h-11 shrink-0 items-center font-medium">
            Fill these in →
          </a>
        </p>
      )
    }

    {/*
      The arithmetic behind the number in the middle of the ring, and then the
      running total that puts it back together with the grey and the green to
      reach everything we track. It is not a summary of the chart — it IS the
      chart, for a reader who cannot see colour, is holding the phone in the
      sun, or is being read the page aloud. And it is what stops the centre
      number being a score: he can see what it is made of, and he can see that
      nothing was left out, without tapping anything.

      One string, built in src/lib/charts/health.ts, printed identically on the
      page a broker opens.
    */}
    {showRing && <p class="mt-3 text-sm tabular-nums text-ink-700">{healthArithmetic}</p>}
  </Figure>

  {
    view !== 'all' && (
      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm tabular-nums text-ink-500">
        {/* One sentence, one tap out. The count is repeated here rather than left
            on the tile alone because this line is what he reads after the page
            moves under him — the tiles are above his thumb, this is under it. */}
        <span>Showing only <span class="font-medium text-ink-900">{viewNoun(view)}</span>. {shownCount} of {trackedCount} items.</span>
        <a href="/app" class="link inline-flex min-h-11 items-center font-medium">Show everything</a>
      </p>
    )
  }

  {/*
    Unfiltered only.
    
    The filter exists because a 46-row list was unreachable on a phone; putting
    a 200px chart above a filtered result would push the rows he just asked for
    back down and undo the fix. On the resting view it is the first thing he
    sees, which is where it belongs — it is the only element on this page that
    answers a question about NEXT month.
  */}
  {
    items.length > 0 && view === 'all' && (
      <Figure
        class="mt-6"
        title={runwayTitle}
        subtitle={`One bar for each of the next ${runway.horizonWeeks} weeks. A taller bar is a heavier week. Amber is due inside ${runway.soonDays} days, green is later.`}
        coverage={runwayCoverage}
      >
        <Runway runway={runway} overdueHref="/app?show=overdue" undatedHref="/app?show=unknown" />
      </Figure>
    )
  }

  {/*
    ====================================================== who to start with ===

    One question, one ranked list: who do I call first. The rows are RECORDS,
    not rules — the tables further down are already the rule-by-rule view, and
    nothing else on this page groups a driver's problems together.

    The big number is the count of the WORST thing that record has — 4, in red,
    for four overdue — and never a total of the three buckets added together. A
    total would be a score: one number standing for unlike things, arrived at by
    arithmetic the reader cannot see. It would also destroy the order of the
    list, since the rows are ranked on overdue first and a mixed total does not
    descend down the column. The line under the name carries every bucket this
    record has, in words, so nothing the number leaves out is hidden.

    Every count carries a dot AND a word AND a number, so colour is never the
    only signal — and grey is a count like the others. A date nobody has typed
    in is never folded into the green, on this list or anywhere else.
  */}
  {
    showNeeds && (
      <Figure class="mt-6" title={needsTitle} subtitle={needsSubtitle}>
        <ul class="space-y-2">
          {needsTop.map((r) => {
            // Rank order, so the first part is the worst thing this record has:
            // overdue, then a missing date, then due soon. The big number IS
            // that part — its count and its colour — which is what keeps the
            // column of numbers reading in the order the rows are sorted in.
            const worst = r.parts[0]
            // The row spelled out for a reader who is being read the page. On
            // screen it is a number, a name and three dots; announced off the
            // DOM that is a string of digits, so the label says the sentence.
            const spoken = r.parts.map((p) => `${p.count} ${p.label.toLowerCase()}`).join(', ')
            return (
              <li>
                <a
                  href={r.href}
                  aria-label={`${r.label}, ${r.noun.toLowerCase()}. ${spoken}.`}
                  class="flex items-center gap-3 rounded-lg border border-ink-100 bg-white px-3 py-2.5 transition hover:bg-ink-50"
                >
                  <span
                    class:list={[
                      // min-w, not w, for the same reason as the tiles: a
                      // three-figure count is the normal case on the day
                      // somebody signs up, not an edge case.
                      'min-w-8 shrink-0 text-right text-xl leading-none font-semibold tabular-nums',
                      TILE_STYLE[worst.key].countClass,
                    ]}
                  >
                    {worst.count}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium">{r.label}</span>
                    <span class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-ink-700 tabular-nums">
                      <span>{r.noun}</span>
                      {r.parts.map((p) => (
                        <span class="flex items-center gap-1">
                          <span
                            class:list={['h-1.5 w-1.5 shrink-0 rounded-full', TONES[p.tone].swatch]}
                            aria-hidden="true"
                          />
                          {p.count} {p.label.toLowerCase()}
                        </span>
                      ))}
                    </span>
                  </span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="size-5 shrink-0 text-ink-300"
                    aria-hidden="true"
                  >
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </li>
            )
          })}
        </ul>

        {/* What the five rows leave out, said out loud rather than trimmed
            away quietly. Same rule as the row cap on the sections below. */}
        {needsMore && <p class="mt-3 text-xs text-ink-700 tabular-nums">{needsMore}</p>}
      </Figure>
    )
  }

  {/*
    `!nudge` so the page asks once. An empty roster already has the banner at
    the top of the screen saying the same thing with a better destination, and
    two boxes asking for a truck is how a page teaches somebody to read neither.
  */}
  {
    trackedCount === 0 && view === 'all' && !nudge && (
      <div class="mt-6 rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
        <p class="font-medium">Nothing here yet</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          Add a driver or a truck. Their deadlines will show up here.
        </p>
        <a
          href="/app/drivers/new"
          class="btn btn-primary mt-4"
        >
          Add a driver →
        </a>
      </div>
    )
  }

  {/*
    An empty filtered list gets its own sentence per filter. "Nothing to show"
    would be the wrong reading twice over: filtered to Overdue and finding
    nothing is the best news this app can give him, and filtered to Missing a
    date and finding nothing means every row on the page is a real answer. One
    generic empty state makes the good outcome look identical to a broken query.
  */}
  {
    emptyFiltered && (
      <div class="mt-4 rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
        <p class="font-medium">{emptyFiltered.title}</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">{emptyFiltered.body}</p>
        <a href="/app" class:list={['mt-4', backOut]}>
          Show everything
        </a>
      </div>
    )
  }

  {/* ===================================================== the date editor ===

      `?show=unknown` stops being a table and becomes a work surface.

      An input on each table row was the obvious answer and is unusable here. On
      a phone the list is now a stack of blocks rather than a row of columns, so
      a fifth cell would be a fifth line under every one of 171 rows, and the
      `help` sentence — the only thing standing between him and a date typed in
      the wrong direction — still has nowhere to go. (The original reason was
      worse: the table was `min-w-[48rem]` inside a sideways scroller, and the
      input sat about 500px off the right edge of a 375px screen.)

      So: one card per driver, truck and the carrier record, and `&s=` opens one.
      Same doctrine as the tiles, one level down — shareable, back-button walks
      the subjects he tried, and it bounds the page to a single subject instead of
      shipping 600 date inputs over one bar of signal.
  */}

  {
    view === 'unknown' && errorMessage && (
      <p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{errorMessage}</p>
    )
  }

  {
    view === 'unknown' && withdrawn && (
      <p class="mt-4 rounded-lg bg-brand-500/[0.08] px-4 py-3 text-sm text-brand-700">
        Date withdrawn. We keep it in the history, so you can still see what was on file and
        when. The next most recent date is now the one we use.
      </p>
    )
  }

  {/* The receipt is a SIBLING of the editor form below, never nested — a form
      inside a form is invalid HTML and the inner one is silently dropped. */}
  {
    view === 'unknown' && savedCount !== null && (
      <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50/60 p-4">
        <p class="text-sm font-medium text-emerald-800">
          {savedHeadline(savedCount, clearedCount ?? savedCount)}
        </p>
        {overdueRose && (
          <p class="mt-1 text-xs text-emerald-900">
            One of these dates is already past, so it moved to{' '}
            <strong class="font-medium">Overdue</strong> instead of leaving this list. It was
            already late. We could not see it until you gave us the date.
          </p>
        )}
        {receipt.length > 0 && (
          <>
            <p class="mt-1 text-xs text-emerald-900">
              Check these dates now. A wrong year is easy to miss later.
            </p>
            <ul class="mt-3 divide-y divide-emerald-200/70 border-t border-emerald-200/70">
              {receipt.map((r) => (
                <li class="flex items-center gap-3 py-2">
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm">{r.label}</span>
                    <span class="block text-xs tabular-nums text-emerald-900">{r.on}</span>
                  </span>
                  <form method="POST" class="shrink-0">
                    <input type="hidden" name="record_id" value={r.id} />
                    <button
                      type="submit"
                      name="intent"
                      value="withdraw_date"
                      class="btn btn-secondary btn-sm"
                    >
                      Withdraw
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    )
  }

  {/* ---------------------------------------------------------- list state */}
  {
    view === 'unknown' && !focus && editor.subjectCount > 0 && (
      <section class="mt-8">
        <h2 class="text-lg font-semibold tracking-tight">
          We need a date from you
          <span class="ml-2 text-sm font-normal text-ink-500 tabular-nums">{unknown.length}</span>
        </h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-500">
          These are not OK. Without the date, your risk is the same as if it had already expired.
          That is why they sit with the overdue ones. Open one record, type what you know, and
          leave the rest for later.
        </p>

        {editor.groups.map((g) => (
          <>
            <h3 class:list={['mt-5', cardHeading]}>{g.title}</h3>
            <div class="mt-2 space-y-2">
              {g.subjects.map((subject) => (
                <a
                  href={subjectHrefFor(subject.id)}
                  class="flex items-center gap-3 rounded-xl border border-ink-100 bg-white p-4 transition hover:bg-ink-50"
                >
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium">{subject.label}</span>
                    <span class="mt-0.5 block text-xs text-ink-700 tabular-nums">
                      {subject.noun} · {subject.questionCount}{' '}
                      {subject.questionCount === 1 ? 'date' : 'dates'} missing
                    </span>
                  </span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="size-5 shrink-0 text-ink-300"
                    aria-hidden="true"
                  >
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ))}
            </div>
          </>
        ))}

        {editor.unrecordable > 0 && (
          /* Said out loud rather than quietly dropped. A row he can see on the
             dashboard and cannot find here is a list he stops believing. */
          <p class="mt-5 text-xs text-ink-700 tabular-nums">
            {editor.unrecordable} more are about people or places we cannot save a date for yet,
            so they are not on this screen.
          </p>
        )}
      </section>
    )
  }

  {/* ------------------------------------------------------- focused state */}
  {
    view === 'unknown' && focus && (
      <form method="POST" class="mt-8">
        <h2 class="text-lg font-semibold tracking-tight">
          {focus.label}
          <span class="ml-2 text-sm font-normal text-ink-500 tabular-nums">
            {focus.noun} · {focus.questionCount} missing
          </span>
        </h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-500">
          Type what you have in front of you. Leave the rest for later. A blank box changes
          nothing.
        </p>

        <div class="mt-3 rounded-xl border border-ink-100 bg-white">
          <div class="flex items-center gap-3 border-b border-ink-100 px-5 py-3">
            <span class="min-w-0 flex-1 text-xs text-ink-700 tabular-nums">
              {focus.rowCount} {focus.rowCount === 1 ? 'row' : 'rows'} on the dashboard, from{' '}
              {focus.questionCount} {focus.questionCount === 1 ? 'date' : 'dates'}
            </span>
            <a
              href="/app?show=unknown"
              class="btn btn-secondary btn-sm shrink-0"
            >
              Back to all {editor.subjectCount}
            </a>
          </div>

          <div class="space-y-5 p-5">
            {focus.asked.map((q) => (
              <div>
              {q.writable ? (
                <label class="block">
                  <span class="block text-sm font-medium">{q.label}</span>
                  <input
                    type="date"
                    name={q.field}
                    min="1900-01-01"
                    max={maxFor(q, todayIso)}
                    class={dateField}
                  />
                </label>
              ) : (
                /* Never an input.
                   `hire_date` and `cdl_expires` live on the driver's own row, and
                   deadlines.ts projects them in with `if (a[anchorKey]) continue` —
                   so a compliance record SILENTLY OUTRANKS the column. A typo typed
                   here would override a correct hire date forever, move five federal
                   rules onto wrong dates, and leave his own page still showing the
                   right one. `dot_number` is not a date at all. */
                <div class="rounded-lg border border-brand-500/25 bg-brand-500/[0.05] px-4 py-3">
                  <p class="text-sm font-medium">{q.label}</p>
                  <p class="mt-0.5 text-xs text-ink-700">
                    This date lives on {q.elsewhere?.where ?? 'another screen'}, not here. We keep
                    one answer for it, not two.
                  </p>
                  {q.elsewhere?.href && (
                    <a
                      href={q.elsewhere.href}
                      class="btn btn-secondary btn-sm mt-2"
                    >
                      Open it →
                    </a>
                  )}
                </div>
              )}

              {q.writable && (
                <p class="mt-1.5 text-xs text-ink-700">
                  <strong class="font-medium text-ink-700">
                    {q.kind === 'last_done' ? 'Last done.' : 'Expires.'}
                  </strong>{' '}
                  {q.help}
                </p>
              )}

              {/* Which rows this one date takes off the dashboard. Never hidden:
                  a row he saw on the list and cannot find here is a list he
                  stops believing. */}
              <p class="mt-1 text-xs text-ink-700">
                {q.settles.length > 1 && `This date answers ${q.settles.length} rules: `}
                {q.settles.map((r, n) => (
                  <>
                    {n > 0 && ' · '}
                    <a
                      href={r.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link inline-flex min-h-11 items-center"
                    >
                      {r.title === q.label ? r.citation : r.title}
                    </a>
                  </>
                ))}
              </p>
              </div>
            ))}

            {focus.onlyIfItApplies.length > 0 && (
              /* Behind a disclosure because these are blank for almost every
                 carrier, and listing the Skill Performance Evaluation expiry as
                 an outstanding item for every driver — when well under 1% hold
                 one — teaches him to ignore the whole list.

                 A closed <details> still submits what is inside it. That is the
                 behaviour we want after a save, but it is not what anyone
                 expects, so the summary says the count and never hides a filled
                 box silently. */
              <details class="border-t border-ink-100 pt-4">
                <summary class="flex min-h-11 cursor-pointer items-center text-sm font-medium text-ink-700 underline underline-offset-2 select-none">
                  {focus.onlyIfItApplies.length} more that only apply in some cases
                </summary>
                <div class="mt-4 space-y-5">
                  {focus.onlyIfItApplies.map((q) => (
                    <div>
              {q.writable ? (
                <label class="block">
                  <span class="block text-sm font-medium">{q.label}</span>
                  <input
                    type="date"
                    name={q.field}
                    min="1900-01-01"
                    max={maxFor(q, todayIso)}
                    class={dateField}
                  />
                </label>
              ) : (
                /* Never an input.
                   `hire_date` and `cdl_expires` live on the driver's own row, and
                   deadlines.ts projects them in with `if (a[anchorKey]) continue` —
                   so a compliance record SILENTLY OUTRANKS the column. A typo typed
                   here would override a correct hire date forever, move five federal
                   rules onto wrong dates, and leave his own page still showing the
                   right one. `dot_number` is not a date at all. */
                <div class="rounded-lg border border-brand-500/25 bg-brand-500/[0.05] px-4 py-3">
                  <p class="text-sm font-medium">{q.label}</p>
                  <p class="mt-0.5 text-xs text-ink-700">
                    This date lives on {q.elsewhere?.where ?? 'another screen'}, not here. We keep
                    one answer for it, not two.
                  </p>
                  {q.elsewhere?.href && (
                    <a
                      href={q.elsewhere.href}
                      class="btn btn-secondary btn-sm mt-2"
                    >
                      Open it →
                    </a>
                  )}
                </div>
              )}

              {q.writable && (
                <p class="mt-1.5 text-xs text-ink-700">
                  <strong class="font-medium text-ink-700">
                    {q.kind === 'last_done' ? 'Last done.' : 'Expires.'}
                  </strong>{' '}
                  {q.help}
                </p>
              )}

              {/* Which rows this one date takes off the dashboard. Never hidden:
                  a row he saw on the list and cannot find here is a list he
                  stops believing. */}
              <p class="mt-1 text-xs text-ink-700">
                {q.settles.length > 1 && `This date answers ${q.settles.length} rules: `}
                {q.settles.map((r, n) => (
                  <>
                    {n > 0 && ' · '}
                    <a
                      href={r.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link inline-flex min-h-11 items-center"
                    >
                      {r.title === q.label ? r.citation : r.title}
                    </a>
                  </>
                ))}
              </p>
                    </div>
                  ))}
                </div>
              </details>
            )}
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3 rounded-xl border border-ink-100 bg-white p-4">
          <span class="flex-1 text-sm text-ink-500">
            A blank box changes nothing. Saving adds a new entry. Nothing already saved is
            erased.
          </span>
          <button
            type="submit"
            name="intent"
            value="save_unknown_dates"
            class="btn btn-primary"
          >
            Save these dates
          </button>
        </div>
      </form>
    )
  }

  {
    view !== 'unknown' &&
    lists.map(
      (s) =>
        s.shown.total > 0 && (
          <section class="mt-8">
            <h2 class="text-lg font-semibold tracking-tight">
              {s.title}
              {/* The WHOLE section, always — never the number of rows drawn
                  below. Ten rows under a heading that says 119 is a page
                  showing you the top of a list; ten rows under a heading that
                  says 10 is a page that has lost 109 of your deadlines. */}
              <span class="ml-2 text-sm font-normal text-ink-500 tabular-nums">
                {s.shown.total}
              </span>
            </h2>

            {s.key === 'unknown' && (
              <p class="mt-1 text-sm text-ink-500">
                These are not OK. Without the date, your risk is the same as if it had already
                expired. That is why they sit with the overdue ones, not at the bottom. The date
                on these rows is the next one on the schedule, not a confirmed deadline, so we do
                not count them in "Due in {SOON_DAYS} days".{' '}
                {/* The bridge. This table is for reading; the editor behind this
                    link is for answering, and without a way across, the reading
                    view is the only one he ever finds. */}
                <a href="/app?show=unknown" class="link inline-flex min-h-11 items-center font-medium">
                  Fill these in →
                </a>
              </p>
            )}

            {s.shown.reminders.length > 0 && (
              /* Said above the table, every time reminders appear in one.
                 Colour alone is not allowed to carry this: the badge in the
                 last column says the word, and this line says what the word
                 means. Short, because it is read on a phone.

                 Keyed off the SHOWN reminders, not off the section's. A cap
                 that trimmed every reminder out of the table would otherwise
                 leave a line explaining a badge that is not on screen. */
              <p class="mt-1 text-sm text-ink-500">
                {REMINDER_ORIGIN_NOTE}{' '}
                <a href="/app/reminders" class="link inline-flex min-h-11 items-center font-medium">
                  My reminders →
                </a>
              </p>
            )}

            <div class={`mt-3 overflow-x-auto rounded-xl border ${s.tone}`}>
              <table class="w-full text-sm sm:min-w-[48rem]">
                {/*
                  No header line on a phone. Four column names above blocks that
                  are not columns explain nothing — each block says what it is in
                  its own words instead.
                */}
                <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
                  <tr>
                    <th class="px-4 py-3 font-medium">What</th>
                    <th class="px-4 py-3 font-medium">Who or what</th>
                    <th class="px-4 py-3 font-medium">Due</th>
                    <th class="px-4 py-3 font-medium">Rule</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                  {s.shown.items.map((i) => {
                    const pill = standingPill(i.status.standing)
                    return (
                      /* The block leads with WHAT is due. The section heading
                         above it has already said which bucket every row in it
                         is in, so the pill is not the thing the phone reader is
                         scanning this list for — the name of the thing is. */
                      <tr class="block py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                        <td class={cell}>
                          <div class="font-medium">{i.rule.title}</div>
                          {i.status.standing === 'unknown' && i.status.needs && (
                            <div class="mt-0.5 text-xs text-ink-700">
                              We need: {i.status.needs.join(', ').replaceAll('_', ' ')}
                            </div>
                          )}
                        </td>
                        <td class={`${cell} mt-1 sm:mt-0`}>
                          {i.subjectId ? (
                            <a
                              href={subjectHref(i.subjectType, i.subjectId)}
                              class="link-row"
                            >
                              {i.subjectLabel}
                            </a>
                          ) : (
                            <span>{i.subjectLabel}</span>
                          )}
                          <span class="text-xs text-ink-700 sm:block">
                            <span class="sm:hidden"> · </span>
                            {i.subjectType.replaceAll('_', ' ')}
                          </span>
                        </td>
                        <td class={`${cell} mt-1.5 whitespace-nowrap sm:mt-0`}>
                          <span class:list={['rounded-md px-2 py-0.5 text-xs font-medium', pill.className]}>
                            {pill.label}
                          </span>
                          {/* A countdown here is a promise of slack, so only a
                              `current` row gets one. See `dueLine`. */}
                          <span class="ml-2 tabular-nums sm:mt-1 sm:ml-0 sm:block">{dueLine(i)}</span>
                        </td>
                        <td class={`${cell} mt-1.5 text-xs text-ink-700 sm:mt-0`}>
                          <a
                            href={i.rule.sourceUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link inline-flex min-h-11 items-center"
                          >
                            {i.rule.citation}
                          </a>
                        </td>
                      </tr>
                    )
                  })}

                  {/* ------------------------------------ the owner's own rows

                      In the SAME table, under the same heading, ranked in the
                      same bucket — because he has one morning and one list to
                      work through, and a second table further down the page is
                      a table nobody scrolls to on a phone.

                      Told apart three ways, none of them new vocabulary and none
                      of them colour alone:

                        1. The last column. Every regulation prints a CFR or CVC
                           citation there, linked to the text of the law. These
                           print the words "Your reminder" and link to nothing,
                           because there is nothing to look up. That column is
                           where an owner already looks to find out what the rule
                           is, so it is where the answer "there is no rule"
                           belongs.
                        2. The tint, in the same brand blue the page already uses
                           for "this one is yours to judge" — the `unsupported`
                           pill and the "You have to check these yourself" block.
                        3. The sentence above the table, which says what the
                           badge means in words.

                      The standing pill and the date line are NOT changed. Late
                      is late whoever set the date, and a second vocabulary for
                      time would be the thing that actually confuses him.

                      Last within the bucket, deliberately. When a federal
                      deadline and an errand are both overdue, the one that stops
                      a truck is the one to read first.
                  */}
                  {s.shown.reminders.map((r) => {
                    const pill = standingPill(r.status.standing)
                    return (
                      <tr class="block bg-brand-500/[0.05] py-3 hover:bg-brand-500/[0.09] sm:table-row sm:py-0">
                        <td class={cell}>
                          <div class="font-medium">{r.title}</div>
                          {r.note && (
                            <div class="mt-0.5 max-w-sm text-xs text-ink-700">{r.note}</div>
                          )}
                        </td>
                        <td class={`${cell} mt-1 sm:mt-0`}>
                          {r.subject.href ? (
                            <a
                              href={r.subject.href}
                              class="link-row"
                            >
                              {r.subject.label}
                            </a>
                          ) : (
                            <span>{r.subject.label}</span>
                          )}
                          {/* The words the nav uses — "Trucks", "Drivers" — not
                              the column names. */}
                          <span class="text-xs text-ink-700 sm:block">
                            <span class="sm:hidden"> · </span>
                            {r.subject.kind === 'carrier'
                              ? 'your company'
                              : r.subject.kind === 'vehicle'
                                ? 'truck'
                                : 'driver'}
                          </span>
                        </td>
                        <td class={`${cell} mt-1.5 whitespace-nowrap sm:mt-0`}>
                          <span
                            class:list={['rounded-md px-2 py-0.5 text-xs font-medium', pill.className]}
                          >
                            {pill.label}
                          </span>
                          <span class="ml-2 tabular-nums sm:mt-1 sm:ml-0 sm:block">{dueLine(r)}</span>
                        </td>
                        <td class={`${cell} mt-1.5 text-xs sm:mt-0`}>
                          {/* No link. Nothing to look up IS the fact. */}
                          <span
                            class:list={[
                              'rounded-md px-2 py-0.5 font-medium',
                              REMINDER_ORIGIN.className,
                            ]}
                          >
                            {REMINDER_ORIGIN.label}
                          </span>
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>

            {/*
              The rest of the section, one tap away.

              OUTSIDE the table, not in a last row of it. On a phone it belongs
              to the whole section rather than to a row, and from `sm` up the
              table is `min-w-[48rem]` inside `overflow-x-auto` — a link placed
              in there would sit off the right edge on a narrow screen, findable
              only by somebody who already knew it was there, which is nobody.

              The destination is `?show=` — the same URL the stat tile at the
              top of the page already points at. No second way of saying "show
              me the overdue ones", and no script: this is a link.
            */}
            {s.shown.more && (
              <p class="mt-3 text-sm">
                <a
                  href={s.shown.more.href}
                  class="link inline-flex min-h-11 items-center font-medium"
                >
                  {s.shown.more.label}
                </a>
              </p>
            )}
          </section>
        ),
    )
  }

  {/*
    The two trailing blocks belong to the unfiltered page only. A filter names an
    exact subset; leaving "you have to check these yourself" sitting under a
    heading that says Overdue would put rows on screen that are not overdue,
    which is the one thing a filter must never do.
  */}
  {
    view === 'all' && manual.length > 0 && (
      <section class="mt-8">
        <h2 class="text-lg font-semibold tracking-tight">You have to check these yourself</h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-500">
          These are real duties, but we cannot put a date on them. Some are ongoing duties with no
          deadline. For the rest, the schedule depends on something no public record holds. We
          list them here instead of making up a date.
        </p>
        {/*
          Blue, where the section above it is amber, and the separation is the
          point. These two sat adjacent in the same colour while meaning opposite
          things: one is a clock running down on a specific document, the other is
          a standing duty with no clock at all that will read exactly the same
          next year. Sharing amber made the permanent thing look urgent and, far
          worse, made the urgent thing look permanent.
        */}
        <ul class="mt-3 space-y-2">
          {manual.map((i) => (
            <li class="rounded-lg border border-brand-500/25 bg-brand-500/[0.05] px-4 py-3 text-sm">
              <span class="font-medium">{i.rule.title}</span>
              <span class="text-ink-700"> · {i.subjectLabel}</span>
              {i.status.reason && <div class="mt-0.5 text-xs text-ink-700">{i.status.reason}</div>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    view === 'all' && later.length > 0 && (
      <p class="mt-8 text-sm text-ink-500 tabular-nums">
        {later.length} more are up to date and not due for a while.
      </p>
    )
  }

  {/* The way in, on the resting view only. A carrier with no reminders never
      finds a feature he has not been told exists, and the sentence says what
      the thing is for rather than naming it. */}
  {
    view === 'all' && (
      <p class="mt-3 flex flex-wrap items-center gap-2 text-sm text-ink-500">
        <span class="tabular-nums">
          {reminders.length === 0
            ? 'You can add your own reminders: insurance, truck payment, appointments.'
            : reminderLater.length > 0
              ? `${reminderLater.length} of your own reminders are further out.`
              : 'Your own reminders are in the list above.'}
        </span>
        <a href="/app/reminders" class="link inline-flex min-h-11 items-center font-medium">
          My reminders →
        </a>
      </p>
    )
  }
</App>
