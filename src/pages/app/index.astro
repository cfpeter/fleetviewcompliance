          ringDrawn ? 'sm:grid-cols-2 sm:gap-3 lg:grid-cols-4' : 'grid-cols-2 sm:grid-cols-4 sm:gap-3',
        ]}
      >
        {
          tiles.map((t) => {
            const on = t.view !== null && view === t.view
            // The aria-label is spelled out because the visible tile is a swatch
            // and two stacked <span>s: read straight off the DOM the link
            // announces as "4 Overdue Show these", and in some readers as a link
            // with no name at all — a filter whose state a screen-reader user
            // cannot hear.
            const label = `${t.label}: ${t.count}. ${on ? 'Showing' : 'Show'} these.`
            const body = (
              <>
                <span
                  class:list={[
                    // min-w, not w. A fixed 2rem box fits "17" and not "148", and the
                    // third digit spilled straight across the swatch and the label.
                    // A fleet's missing-date count reaching three figures is the
                    // normal case on the day someone signs up, not an edge case.
                    'min-w-8 shrink-0 text-right text-xl leading-none font-semibold tabular-nums sm:text-2xl',
                    t.countClass,
                  ]}
                >
                  {t.count}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-center gap-1.5">
                    <span
                      class:list={['h-2 w-2 shrink-0 rounded-full', t.swatch]}
                      aria-hidden="true"
                    />
                    {/* Wraps, never truncates. Two-up on a 375px phone the
                        label had about 85px and "Missing a date" needs 82, so
                        `truncate` cut it to "Missing a ..." on exactly the
