          <span class="min-w-0 flex-1 tabular-nums">{healthMissing}</span>
          <a href="/app?show=unknown" class="link inline-flex min-h-11 shrink-0 items-center font-medium">
            Fill these in →
          </a>
        </p>
      )
    }

    {/*
      ========================================================= what it costs ===

      LAST IN THE CARD, AND THAT IS THE ARGUMENT, NOT AN AFTERTHOUGHT. Above it
      are the two facts he can act on: who cannot work, and what we still need
