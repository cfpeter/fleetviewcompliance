---
/**
 * Creating and managing proof links.
 *
 * A link is an unauthenticated credential handed to a stranger, so two things
 * are non-negotiable here: the token is unguessable (see lib/proof/token.ts),
 * and every link expires. There is no "never" option, because a statement about
 * a moment should not still be answering questions next year.
 *
 * SHOWN ONCE. Since 0026 the database holds sha256(token), not the token, so
 * after the request that creates a link there is nothing on this server that
 * can produce its address again. That is the point of the change and it is a
 * real cost to the owner: the list below can no longer print working URLs, only
 * say what each link is and whether it has been opened. The create path
 * therefore renders its response instead of redirecting — a redirect could only
 * carry the token in a URL, which is the leak this was fixing — and the page
 * says in plain words that the link is shown one time.
 */
import Figure from '../../components/charts/Figure.astro'
import App from '../../layouts/App.astro'
import { TONES } from '../../lib/charts/tones.ts'
import { hashProofToken, newProofToken } from '../../lib/proof/token.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!
const userId = Astro.locals.userId!

const notice = Astro.url.searchParams.get('created')
const error = Astro.url.searchParams.get('error')

/**
 * The origin of THIS request, never PUBLIC_SITE_URL.
 *
 * Vite inlines `import.meta.env.*` at build time, so that value is a constant
 * baked into the bundle: the dev deployment printed a production address under
 * every link, and the broker who was sent one got a 404 on a link that works
 * perfectly on the host it was made on. A link whose whole purpose is to be
 * copied has to resolve where it was copied from, and a build-time constant is
 * a standing lie the moment there is more than one deployment.
 *
 * Both production routes are custom domains on this Worker (apex and www, see
 * wrangler.jsonc), so the host the owner is looking at is always a host the
 * recipient can reach. See login.astro, which learned this for auth redirects.
 */
const base = Astro.url.origin

/** The one and only place a token is ever readable after it is minted. */
let createdUrl: string | null = null

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')
  const back = (q: string) => Astro.redirect(`/app/proof?${q}`, 303)

  if (intent === 'create') {
    const scope = String(form.get('scope') ?? 'carrier_summary')
    const subjectId = String(form.get('subject_id') ?? '').trim() || null
    const days = Number(form.get('days') ?? 30)

    if (scope === 'driver_file' && !subjectId) {
      return back('error=' + encodeURIComponent('Choose which driver the link is for.'))
    }
    // Clamped rather than trusted: a hand-edited form must not mint a link that
    // outlives the conversation it was made for.
    const validDays = Number.isFinite(days) && days > 0 && days <= 365 ? days : 30
    const expires = new Date(Date.now() + validDays * 86_400_000)

    // Minted here, stored as a digest, and held in this variable for the render
    // below. Nothing writes it anywhere else.
    const token = newProofToken()
    const { error: e } = await supabase.from('share_links').insert({
      carrier_id: carrierId,
      token_hash: await hashProofToken(token),
      scope,
      subject_id: scope === 'driver_file' ? subjectId : null,
      label: String(form.get('label') ?? '').trim() || null,
      recipient: String(form.get('recipient') ?? '').trim() || null,
      expires_at: expires.toISOString(),
      created_by: userId,
    })
    if (e) return back('error=' + encodeURIComponent(e.message))

    // Falls through to the render rather than redirecting: this response is the
    // only chance the owner gets to copy the address, and a 303 could only hand
    // it over in a URL — browser history, access logs, Referer headers.
    createdUrl = `${base}/proof/${token}`
    Astro.response.headers.set('Cache-Control', 'no-store')
  }

  if (intent === 'revoke') {
    const id = String(form.get('id') ?? '')
    // Revoked, never deleted. "Did we ever send this to that broker" is the
    // question, and a deleted row cannot answer it.
    const { error: e } = await supabase
      .from('share_links')
      .update({ revoked_at: new Date().toISOString() })
      .eq('id', id)
    return e ? back('error=' + encodeURIComponent(e.message)) : back('created=revoked')
  }

  // Not an `else`: a successful create deliberately falls out of this block
  // without redirecting, so it must not be mistaken for an unknown intent.
  if (!createdUrl) return back('error=' + encodeURIComponent('We did not understand that button. Try again.'))
}

const [{ data: links }, { data: drivers }] = await Promise.all([
  // Columns named rather than '*': there is no reason for token_hash to travel
  // to a browser, and a list that cannot print addresses does not need it.
  supabase
    .from('share_links')
    .select(
      'id, scope, subject_id, label, recipient, expires_at, revoked_at, view_count, last_viewed_at, created_at',
    )
    .order('created_at', { ascending: false }),
  supabase.from('drivers').select('id, first_name, last_name').eq('status', 'active'),
])

const now = Date.now()
const isLive = (l: { revoked_at: string | null; expires_at: string }) =>
  !l.revoked_at && new Date(l.expires_at).getTime() > now

type LinkRow = NonNullable<typeof links>[number]

/**
 * Working links, SOONEST TO STOP WORKING FIRST.
 *
 * Newest first was the order the query came back in, and it answers a question
 * nobody asks. The owner's question about this list is "which one am I about to
 * lose" — a broker who opens a dead link sees the same blank page as a stranger,
 * and the owner finds out about it from the broker. Ordering by the end date
 * puts that link at the top of the list on the day it matters.
 *
 * Only the WORKING list is re-ordered. The list below it is finished business
 * and is ordered by when each one stopped, most recent first.
 */
const live = ([...(links ?? [])] as LinkRow[])
  .filter(isLive)
  .sort((a, b) => new Date(a.expires_at).getTime() - new Date(b.expires_at).getTime())

const endedAt = (l: LinkRow) => new Date(l.revoked_at ?? l.expires_at).getTime()
const dead = ([...(links ?? [])] as LinkRow[])
  .filter((l) => !isLive(l))
  .sort((a, b) => endedAt(b) - endedAt(a))

const DAY = 86_400_000

/**
 * Days until it stops working.
 *
 * ROUNDED DOWN, and clamped at zero. Rounding down is the only direction that
 * cannot promise time the owner does not have: three hours left reads "today",
 * not "in 1 day". Rounding up would have printed "1 day" over a link that dies
 * before lunch, and the whole reason this number is on the card is so he can
 * send a fresh link before a broker finds a dead one.
 *
 * The clamp is a guard on the other side of zero. `live` already excludes
 * anything past its date, so a negative can only come from a clock a few seconds
 * out of step — but unguarded it would print "in -1 days" and draw the bar
 * backwards.
 */
const daysLeft = (l: LinkRow) =>
  Math.max(0, Math.floor((new Date(l.expires_at).getTime() - now) / DAY))

const stopsIn = (l: LinkRow) => {
  const d = daysLeft(l)
  if (d <= 0) return 'Stops working today'
  if (d === 1) return 'Stops working tomorrow'
  return `Stops working in ${d} days`
}

/**
 * How much of this link's own life is left, 0-100.
 *
 * Measured against the span the owner chose — created to expires — not against
 * a fixed window, so a 7-day link and a 90-day link both start full and both
 * empty at the same moment they stop working. The bar is the shape; the number
 * of days is printed above it in words, because the bar alone cannot say whether
 * a quarter of a bar is three days or three weeks.
 *
 * Deliberately NOT coloured red or amber. In this app those two colours mean an
 * obligation is overdue or close to its date, and a link running out is neither
 * — borrowing the colour here would spend it on something that is not a
 * deadline, on the same screen as the deadlines.
 */
const lifeLeft = (l: LinkRow) => {
  const start = new Date(l.created_at).getTime()
  const end = new Date(l.expires_at).getTime()
  const span = end - start
  if (!Number.isFinite(span) || span <= 0) return 0
  return Math.min(100, Math.max(0, ((end - now) / span) * 100))
}

const openedWord = (n: number) => (n === 1 ? 'time opened' : 'times opened')

const field =
  'mt-1 w-full rounded-lg border border-ink-100 bg-white px-3 py-2.5 text-base outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20'
const card = 'rounded-xl border border-ink-100 bg-white p-5'
const when = (v: string) =>
  new Date(v).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
const driverName = (id: string | null) => {
  const d = (drivers ?? []).find((x) => x.id === id)
  return d ? `${d.first_name} ${d.last_name}`.trim() : '—'
}
---

<App title="Proof links" subtitle="Share a dated record with a broker or an insurance company.">
  {notice && (
    <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      {notice === 'revoked' ? 'Link turned off. It stopped working right away.' : 'Link created.'}
    </p>
  )}
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}

  {/*
    The only time this address is ever on screen. Short sentences, because the
    consequence is real: close this page without copying and the link is gone.
  */}
  {createdUrl && (
    <div class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-5">
      <p class="font-medium text-emerald-900">Your link is ready. Copy it now.</p>
      {/*
        A select-all click handler used to sit on this input. It was the only
        script left on the page, and this app ships none — see the note at the
        top of layouts/Public.astro. `autofocus` puts the cursor in the box
        without running anything, and the line under it says what to do next in
        words, which is also what a reader on a phone needs: a tap there opens a
        cursor, not a selection, script or no script.
      */}
      <input
        readonly
        autofocus
        value={createdUrl}
        aria-label="Your new proof link"
        class="mt-3 w-full rounded-lg border border-emerald-300 bg-white px-3 py-2 font-mono text-xs"
      />
      <p class="mt-3 text-sm text-emerald-900">
        Press and hold the box, choose Select all, then Copy.
      </p>
      <p class="mt-2 text-sm text-emerald-900">
        We show this link one time. We do not keep a copy of it. If you lose it, make a new link.
      </p>
    </div>
  )}

  <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr]">
    <form method="POST" class={card}>
      <h2 class="text-lg font-semibold tracking-tight">New link</h2>

      <label class="mt-4 block">
        <span class="text-sm font-medium">What it shows</span>
        <select name="scope" class={field}>
          <option value="carrier_summary">The whole fleet: authority, size, dated checks</option>
          <option value="driver_file">One driver's qualification file</option>
        </select>
      </label>

      <label class="mt-4 block">
        <span class="text-sm font-medium">
          Which driver <span class="font-normal text-ink-300">(only for a driver file)</span>
        </span>
        <select name="subject_id" class={field}>
          <option value="">—</option>
          {(drivers ?? []).map((d) => (
            <option value={d.id}>{`${d.first_name} ${d.last_name}`.trim()}</option>
          ))}
        </select>
      </label>

      <label class="mt-4 block">
        <span class="text-sm font-medium">Who is it for</span>
        <input name="recipient" placeholder="e.g. Acme Logistics" class={field} />
      </label>

      <label class="mt-4 block">
        <span class="text-sm font-medium">Label <span class="font-normal text-ink-300">(optional)</span></span>
        <input name="label" placeholder="e.g. insurance renewal" class={field} />
      </label>

      <label class="mt-4 block">
        <span class="text-sm font-medium">Stops working after</span>
        <select name="days" class={field}>
          <option value="7">7 days</option>
          <option value="30" selected>30 days</option>
          <option value="90">90 days</option>
        </select>
        <span class="mt-1 block text-xs text-ink-500">
          Every link expires. A record from today should not still be answering questions next year.
        </span>
      </label>

      <button
        type="submit"
        name="intent"
        value="create"
        class="mt-5 w-full rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white transition hover:bg-brand-700"
      >
        Create the link
      </button>
    </form>

    <div>
      {/*
        A card each, and the open count is the big number on it.

        The owner makes a link because somebody asked him for one, and then the
        thing he wants to know is whether they actually read it. That fact was
        already on this page — it was the fourth item in a grey run-on line of
        11px text, read by nobody. It is now the first thing on the card, in the
        size the rest of the app gives a number that answers a question.

        The countdown bar under it answers the other one. See `lifeLeft` for why
        the bar is blue and not amber.
      */}
      <Figure
        title={
          live.length === 0
            ? 'No links are working'
            : `${live.length} ${live.length === 1 ? 'link is' : 'links are'} working`
        }
        subtitle={live.length === 0 ? undefined : 'The one that stops working first is at the top.'}
        coverage={
          live.length === 0
            ? undefined
            : 'We count every time the page is opened. The same person opening it twice counts twice, and we cannot tell you who opened it.'
        }
      >
        {live.length === 0 ? (
          <p class="rounded-xl border border-dashed border-ink-100 p-8 text-center text-sm text-ink-500">
            No links are working right now. A link you make shows here.
          </p>
        ) : (
          <ul class="space-y-3">
            {live.map((l) => (
              <li class="rounded-xl border border-ink-100 p-4">
                <div class="flex items-start gap-4">
                  {/*
                    Grey when it is zero, and still printed. "Nobody opened it"
                    is the answer he came for as often as "three people did", so
                    the zero is never hidden — it is just not dressed up as a
                    result.
                  */}
                  <div class="w-14 shrink-0 text-center">
                    <div
                      class:list={[
                        'text-3xl leading-none font-semibold tabular-nums',
                        l.view_count > 0 ? 'text-ink-900' : 'text-ink-300',
                      ]}
                    >
                      {l.view_count}
                    </div>
                    <div class="mt-1 text-[11px] leading-tight text-ink-500">
                      {openedWord(l.view_count)}
                    </div>
                  </div>

                  <div class="min-w-0 flex-1">
                    <p class="font-medium">
                      {l.label ||
                        (l.scope === 'driver_file' ? driverName(l.subject_id) : 'Fleet summary')}
                    </p>
                    <p class="mt-1 text-xs text-ink-500">
                      {l.scope === 'driver_file'
                        ? `Driver file · ${driverName(l.subject_id)}`
                        : 'Fleet summary'}
                      {l.recipient && <> · for {l.recipient}</>}
                    </p>
                    <p class="mt-0.5 text-xs text-ink-500 tabular-nums">
                      {l.last_viewed_at ? (
                        <>Last opened {when(l.last_viewed_at)}</>
                      ) : (
                        <>Nobody has opened it yet</>
                      )}
                    </p>
                  </div>
                </div>

                {/* The countdown. Words above the bar, because the bar cannot
                    say whether a quarter of it is three days or three weeks. */}
                <div class="mt-3">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 text-xs">
                    <span class="font-medium tabular-nums">{stopsIn(l)}</span>
                    <span class="text-ink-500 tabular-nums">{when(l.expires_at)}</span>
                  </div>
                  <div
                    class:list={['mt-1.5 h-2 overflow-hidden rounded-full', TONES.brand.track]}
                    aria-hidden="true"
                  >
                    <div
                      class:list={['h-full rounded-full', TONES.brand.bar]}
                      style={`width:${lifeLeft(l)}%;min-width:2px`}
                    />
                  </div>
                </div>

                {/*
                  There used to be a selectable input with the address in it. It
                  cannot be here any more: the database holds sha256(token), so
                  the server cannot rebuild this link. Saying that plainly is the
                  honest version — a "Copy link" button that produced anything at
                  all would mean the token was still stored somewhere.
                */}
                <p class="mt-3 rounded-lg bg-ink-50 px-3 py-2 text-xs text-ink-500">
                  The link is not shown here. We show a link one time only, when you make it. If you
                  lost it, turn this one off and make a new link.
                </p>

                {/* A bordered button, not a text link. It is the only control on
                    the card and it is pressed with a thumb, so it gets a target
                    a thumb can hit. */}
                <form method="POST" class="mt-3">
                  <input type="hidden" name="id" value={l.id} />
                  <button
                    type="submit"
                    name="intent"
                    value="revoke"
                    class="rounded-lg border border-red-200 px-4 py-3 text-sm leading-tight font-medium text-red-700 transition hover:bg-red-50"
                  >
                    Turn off this link
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </Figure>

      {dead.length > 0 && (
        <>
          <h2 class="mt-8 text-lg font-semibold tracking-tight">No longer working</h2>
          <ul class="mt-3 space-y-2">
            {dead.map((l) => (
              <li class="rounded-lg border border-ink-100 bg-ink-50/60 px-4 py-3 text-sm">
                <span class="font-medium">
                  {l.label || (l.scope === 'driver_file' ? driverName(l.subject_id) : 'Fleet summary')}
                </span>
                <span class="text-ink-500">
                  {' '}— {l.revoked_at ? `turned off ${when(l.revoked_at)}` : `expired ${when(l.expires_at)}`}
                  {l.recipient && <> · was for {l.recipient}</>}
                  {' '}· opened <span class="tabular-nums">{l.view_count}</span>{' '}
                  {l.view_count === 1 ? 'time' : 'times'}
                </span>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </div>
</App>
