---
/**
 * One load: the paperwork, where the truck is, where the money is, and what
 * went wrong.
 *
 * FOUR FORMS, FOUR INTENTS, AND THEY DO NOT OVERLAP.
 *
 * `save_load` writes the record and touches neither status column. `set_status`
 * writes `status` and nothing else. `set_billing` writes `billing` and nothing
 * else. `set_exception` writes `exception` and nothing else. That separation is
 * the entire design of 0009_loads.sql expressed as four buttons, and it buys two
 * things that are easy to lose:
 *
 *  1. A load can be delivered and not ready to invoice at the same time, because
 *     nothing here advances one column from the other. That is the normal state
 *     of a delivered load whose POD has not been scanned yet, not an error.
 *  2. The big form cannot silently roll the status back. She opens the load at
 *     9am, the driver rings at 11 and someone else moves it to Delivered, she
 *     saves her half-finished edit at noon — and because `save_load` never
 *     carries a status field, the delivery survives.
 *
 * Every exit is a 303. A replayed POST on this page would not just duplicate a
 * row, it would re-apply a status the dispatcher has since moved on from.
 */
import Bars from '../../../components/charts/Bars.astro'
import Figure from '../../../components/charts/Figure.astro'
import App from '../../../layouts/App.astro'
import {
  BILLING_STATUSES,
  EQUIPMENT_TYPES,
  LOAD_EXCEPTIONS,
  LOAD_STATUSES,
  billingPillClass,
  billingStatusLabel,
  centsToInput,
  exceptionLabel,
  exceptionPillClass,
  formatCents,
  isBillingStatus,
  isLoadException,
  isLoadStatus,
  laneFromStops,
  loadLabel,
  loadStatusLabel,
  matchCustomerName,
  parseMoneyToCents,
  parseOptionalInt,
  statusPillClass,
  textOrNull,
  totalRateCents,
} from '../../../lib/loads.ts'
import {
  type SettlementCategory,
  settlementStatusLabel,
  settlementTotals,
} from '../../../lib/settlements/compute.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!
const id = Astro.params.id ?? ''

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

function back(params: string): Response {
  return Astro.redirect(`/app/loads/${id}${params ? `?${params}` : ''}`, 303)
}

function fail(message: string): Response {
  // The fragment is the whole focus mechanism on a page that runs no script:
  // the browser scrolls to the error box and, because it carries tabindex="-1",
  // hands it the focus too. See src/components/ui/ErrorSummary.astro.
  return back(`error=${encodeURIComponent(message)}#form-errors`)
}

type NumberColumn = 'load_number' | 'broker_reference'

interface DuplicateHit {
  id: string
  /** What that load is called on screen — its own number, or the broker's. */
  name: string
  column: NumberColumn
  /** The number she typed, echoed back so the message names it. */
  value: string
}

/**
 * Another load in this carrier's account already carrying one of the two
 * numbers this save is about to write.
 *
 * The same check the create form runs, for the same reason: neither column has
 * a unique index, so an edit can put a second TEST-BRKR-003 on the board just
 * as easily as a new load can. The difference here is `.neq('id', id)` — a load
 * is not its own duplicate, and without that line every save of an unchanged
 * broker reference would refuse itself.
 *
 * No .eq('carrier_id', ...): RLS already scopes the read, so another carrier's
 * matching number is invisible and cannot block this save. `.eq` rather than
 * `.ilike`: ilike would read % and _ inside a reference as wildcards and refuse
 * a number nobody else is using.
 */
async function findDuplicate(
  loadNumber: string | null,
  brokerReference: string | null,
): Promise<{ ok: true; hit: DuplicateHit | null } | { ok: false; message: string }> {
  const pairs: [NumberColumn, string | null][] = [
    ['load_number', loadNumber],
    ['broker_reference', brokerReference],
  ]
  for (const [column, value] of pairs) {
    if (!value) continue
    const { data, error } = await supabase
      .from('loads')
      .select('id, load_number, broker_reference')
      .eq(column, value)
      .neq('id', id)
      .limit(1)
    if (error) return { ok: false, message: error.message }
    const row = data?.[0]
    if (row) return { ok: true, hit: { id: row.id, name: loadLabel(row), column, value } }
  }
  return { ok: true, hit: null }
}

/** Back to the board, for every case where this load is not ours to show. */
function toBoard(message: string): Response {
  return Astro.redirect(`/app/loads?error=${encodeURIComponent(message)}`, 303)
}

const NOT_YOURS = 'That load is not in your account.'

// A hand-edited URL like /app/loads/abc is not a missing row, it is a failed
// uuid cast — Postgres raises, and without this check the dispatcher gets
// "invalid input syntax for type uuid" across the top of her screen. Checked
// here rather than swallowing the error later, so a REAL database failure still
// reaches her as a real database failure instead of "no such load".
if (!UUID.test(id)) return toBoard(NOT_YOURS)

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  /**
   * An UPDATE that matches nothing is not an error in Postgres, and RLS makes
   * another carrier's load match nothing. Without checking the returned rows,
   * every one of these handlers would report a cheerful "Saved." for a load that
   * does not exist. `.select('id')` is what makes the difference visible.
   */
  async function patch(values: Record<string, unknown>): Promise<Response | null> {
    const { data, error } = await supabase
      .from('loads')
      .update(values)
      // No carrier_id in the filter and none in the patch. RLS makes another
      // carrier's load invisible to this statement, so the worst an edited URL
      // achieves is matching zero rows — and leaving carrier_id out of the patch
      // is what stops anyone moving a load into a different tenancy.
      .eq('id', id)
      .select('id')
    if (error) return fail(error.message)
    if (!data || data.length === 0) return toBoard(NOT_YOURS)
    return null
  }

  if (intent === 'set_status') {
    const requested = String(form.get('status') ?? '')
    // Guarded rather than passed through: an unrecognised value reaches Postgres
    // as `invalid input value for enum load_status`, which is a 500 in place of
    // a status change.
    if (!isLoadStatus(requested)) return fail('That status is not one we know. Pick one from the list.')

    /**
     * ONLY `status`. Not `billing`, not `exception`.
     *
     * The tempting line — "when it goes to pod_received, set billing to
     * ready_to_invoice" — is the bug this schema exists to prevent. It is right
     * about four loads in five and wrong about the ones that matter: the load
     * still missing a lumper receipt, the one the broker wants a scale ticket
     * for, the one already invoiced early against a signed BOL. Each of those
     * gets quietly reset by a helpful rule, and what she sees afterwards is an
     * invoice list that does not match the money.
     *
     * Clearing the exception here is equally wrong: a load moving from
     * at_shipper to loaded is still the load that sat there four hours, and the
     * detention claim is still owed.
     */
    const failed = await patch({ status: requested })
    if (failed) return failed
    return back(`status=${encodeURIComponent(requested)}`)
  }

  if (intent === 'set_billing') {
    const requested = String(form.get('billing') ?? '')
    if (!isBillingStatus(requested)) {
      return fail('That billing status is not one we know. Pick one from the list.')
    }
    // Only `billing`. Moving the money does not move the truck: a load can be
    // invoiced off a signed BOL while it is still in_transit on the next leg.
    const failed = await patch({ billing: requested })
    if (failed) return failed
    return back(`billing=${encodeURIComponent(requested)}`)
  }

  if (intent === 'set_exception') {
    const requested = String(form.get('exception') ?? '')
    // '' is the "no exception" option and means NULL, which is a real answer —
    // the detention was resolved — and the only way to clear one.
    if (requested !== '' && !isLoadException(requested)) {
      return fail('That exception is not one we know. Pick one from the list.')
    }
    /**
     * The exception is recorded ALONGSIDE the status, never instead of it.
     *
     * There is deliberately no `status` in this patch. A detained load is still
     * at_shipper; a broken-down load is still in_transit. Overwriting the status
     * with the exception is how a dispatcher loses the answer to "where is my
     * truck" at the exact moment she needs it to make a phone call.
     */
    const failed = await patch({ exception: requested === '' ? null : requested })
    if (failed) return failed
    return back(`exception=${encodeURIComponent(requested || 'none')}`)
  }

  if (intent === 'save_load') {
    /**
     * Defence in depth against a half-submitted form.
     *
     * The record form is the only thing on this page that carries
     * `broker_reference`, and a submission without it would otherwise be read as
     * "set every one of these fields to blank" — wiping a rate confirmation in
     * one click. This is not theoretical: a disabled submit button is excluded
     * from form data, which is exactly what a busy-state script does.
     */
    if (!form.has('broker_reference')) {
      return fail('This form did not send the load fields. Nothing was changed. Try again.')
    }

    const loadNumber = textOrNull(form.get('load_number'))
    const brokerReference = textOrNull(form.get('broker_reference'))
    if (!loadNumber && !brokerReference) {
      return fail(
        'Keep at least one of the two numbers: your load number or the broker reference. Without one of them you cannot find this load again.',
      )
    }

    /**
     * THE SAME NUMBER TWICE, REFUSED HERE TOO.
     *
     * Checking only the create form would leave the back door open: retyping a
     * broker reference on this page puts two loads under one number exactly as
     * a second create does, and the cost is the same one — the broker rings
     * about TEST-BRKR-003, the search box returns two rows, and which one gets
     * the rate and the stops is a coin toss.
     */
    const duplicate = await findDuplicate(loadNumber, brokerReference)
    if (!duplicate.ok) return fail(duplicate.message)
    if (duplicate.hit) {
      const { hit } = duplicate
      return back(
        `error=${encodeURIComponent(
          `${hit.column === 'load_number' ? 'Load number' : 'Broker reference'} ${hit.value} is already on another load. Two loads with the same number cannot be told apart. Nothing was changed here. Use a different number, or open that load and work on it.`,
        )}&dup=${hit.id}&dup_name=${encodeURIComponent(hit.name)}#form-errors`,
      )
    }

    const weight = parseOptionalInt(form.get('weight_lbs'), {
      label: 'Weight',
      min: 1,
      max: 250_000,
    })
    if (!weight.ok) return fail(weight.message)

    const pieces = parseOptionalInt(form.get('pieces'), { label: 'Pieces', min: 1, max: 100_000 })
    if (!pieces.ok) return fail(pieces.message)

    // Reefer loads run below zero, so the minimum here is genuinely negative.
    // A -20°F setpoint typed into a field that refuses it is a field she stops
    // using, and the setpoint then lives only in the driver's head.
    const temperature = parseOptionalInt(form.get('temperature_f'), {
      label: 'Temperature',
      min: -60,
      max: 120,
    })
    if (!temperature.ok) return fail(temperature.message)

    // 0 free hours is a real term and must survive; blank means the rate
    // confirmation did not say, which is a different fact and stays NULL.
    const freePickup = parseOptionalInt(form.get('free_hours_pickup'), {
      label: 'Free hours at pickup',
      min: 0,
      max: 72,
    })
    if (!freePickup.ok) return fail(freePickup.message)

    const freeDelivery = parseOptionalInt(form.get('free_hours_delivery'), {
      label: 'Free hours at delivery',
      min: 0,
      max: 72,
    })
    if (!freeDelivery.ok) return fail(freeDelivery.message)

    const linehaul = parseMoneyToCents(form.get('linehaul'), { label: 'Linehaul rate' })
    if (!linehaul.ok) return fail(linehaul.message)

    const fuel = parseMoneyToCents(form.get('fuel_surcharge'), { label: 'Fuel surcharge' })
    if (!fuel.ok) return fail(fuel.message)

    // Negative allowed here alone: a lumper or an advance comes off the rate
    // confirmation as a deduction, and a total that cannot go down never matches
    // the cheque.
    const accessorials = parseMoneyToCents(form.get('accessorials'), {
      label: 'Accessorials',
      allowNegative: true,
    })
    if (!accessorials.ok) return fail(accessorials.message)

    const detentionRate = parseMoneyToCents(form.get('detention_rate'), { label: 'Detention rate' })
    if (!detentionRate.ok) return fail(detentionRate.message)

    /**
     * Pre-approval is THREE answers, not a checkbox, and that is the difference
     * between a paid detention claim and an unpaid one.
     *
     * NULL is "the rate confirmation has not been read that far". FALSE is "it
     * says nothing is needed — just sit and bill". TRUE is "call before the free
     * hours expire or none of it is billable". A checkbox can only say TRUE or
     * FALSE, and its unticked state would assert the middle answer on every load
     * anyone typed in a hurry, which is the assertion that costs the money.
     */
    const preapprovalRaw = String(form.get('detention_requires_preapproval') ?? '')
    const preapproval =
      preapprovalRaw === 'yes' ? true : preapprovalRaw === 'no' ? false : null

    // The customer, resolved the same way the create form resolves it: an
    // existing record wins, a typed name is matched before it is inserted.
    let customerId: string | null = null
    const chosen = String(form.get('customer_id') ?? '').trim()
    const typedName = textOrNull(form.get('customer_name'))

    if (chosen) {
      if (!UUID.test(chosen)) return fail('We could not read that customer. Pick it again.')
      customerId = chosen
    } else if (typedName) {
      const { data: existing, error: lookupError } = await supabase
        .from('customers')
        .select('id, name')
      if (lookupError) return fail(lookupError.message)

      const hit = matchCustomerName(existing, typedName)
      if (hit) {
        customerId = hit
      } else {
        const { data: created, error: createError } = await supabase
          .from('customers')
          // carrier_id explicitly. RLS checks the column but does not supply it,
          // and it is NOT NULL with no default.
          .insert({ carrier_id: carrierId, name: typedName })
          .select('id')
          .single()
        if (createError || !created) {
          return fail(createError?.message ?? 'We could not save that customer.')
        }
        customerId = created.id
      }
    }

    const failed = await patch({
      load_number: loadNumber,
      broker_reference: brokerReference,
      customer_id: customerId,
      equipment_type: textOrNull(form.get('equipment_type')),
      commodity: textOrNull(form.get('commodity')),
      weight_lbs: weight.value,
      pieces: pieces.value,
      temperature_f: temperature.value,
      // `form.has`, not a ternary on `form.get`: an unticked checkbox is absent
      // from the form data entirely, and both of these columns are NOT NULL
      // DEFAULT false — so unticked genuinely is false here, unlike the
      // pre-approval question below, where absence means "not stated".
      hazmat: form.has('hazmat'),
      linehaul_cents: linehaul.value,
      fuel_surcharge_cents: fuel.value,
      accessorials_cents: accessorials.value,
      free_hours_pickup: freePickup.value,
      free_hours_delivery: freeDelivery.value,
      detention_rate_cents: detentionRate.value,
      detention_requires_preapproval: preapproval,
      factored: form.has('factored'),
      notes: textOrNull(form.get('notes')),
      // No `status`, no `billing`, no `exception`. See the file header.
    })
    if (failed) return failed
    return back('saved=1')
  }

  // An unrecognised intent is a bug or a crafted post; either way it must not
  // fall through and render as though this were a GET.
  return back('')
}

// --- GET ---------------------------------------------------------------------

const { data: load, error: loadError } = await supabase
  .from('loads')
  .select(
    'id, load_number, broker_reference, customer_id, status, exception, billing, linehaul_cents, fuel_surcharge_cents, accessorials_cents, equipment_type, commodity, weight_lbs, pieces, temperature_f, hazmat, free_hours_pickup, free_hours_delivery, detention_rate_cents, detention_requires_preapproval, factored, notes, created_at',
  )
  .eq('id', id)
  .maybeSingle()

if (loadError) return toBoard(loadError.message)
// maybeSingle() returns null both for "no such id" and for "belongs to another
// carrier", because RLS makes the second one look exactly like the first. That
// is the point: this page cannot be used to find out whether a load exists
// somewhere else on the platform.
if (!load) return toBoard(NOT_YOURS)

const [{ data: stopRows }, { data: customerRows }, { data: payRows }] = await Promise.all([
  supabase
    .from('load_stops')
    .select('id, sequence, stop_type, company_name, city, state')
    .eq('load_id', id)
    .order('sequence', { ascending: true }),
  supabase.from('customers').select('id, name').order('name', { ascending: true }),
  // Every settlement line anybody has written against THIS load. 0016 makes
  // `load_id` nullable because escrow and the ELD fee belong to a period rather
  // than to a trip, so the lines that come back here are the ones somebody
  // deliberately attached to this load and nothing else.
  supabase
    .from('settlement_lines')
    .select('id, category, kind, description, amount_cents, settlements ( id, status )')
    .eq('load_id', id),
])

const stops = (stopRows ?? []) as {
  id: string
  sequence: number
  stop_type: string
  company_name: string | null
  city: string | null
  state: string | null
}[]
const customers = (customerRows ?? []) as { id: string; name: string | null }[]

const lane = laneFromStops(stops)
const total = totalRateCents(load)

/**
 * WHAT THIS LOAD KEPT, AND WHY THAT WORD IS NOT "PROFIT".
 *
 * One question, asked about every load ever run: did it make money. The two
 * numbers needed to start answering it are already on this page in two different
 * places — the rate is in the card below, the driver pay is on a settlement
 * screen somewhere else — and holding one of them in your head while you go and
 * find the other is why nobody checks.
 *
 * So: the rate, the pay written against this load, and the difference. The
 * difference is called KEPT and never profit, and the caveat under the chart
 * says the rest out loud. Fuel is not in this app. Nor is the truck payment, the
 * insurance, the tyres, the tolls the driver did not expense, or an hour of the
 * owner's Saturday. A number labelled "profit" that leaves all of that out is a
 * number an owner will quote to a broker, and to his accountant, and be wrong
 * both times.
 *
 * VOID SETTLEMENTS ARE LEFT OUT and counted separately. A cancelled statement is
 * kept by 0016 on purpose — "a settlement that vanishes is a settlement the
 * driver swears he was promised" — but its lines were never paid, and adding
 * them here would charge this load for money that never left.
 *
 * The sum is a plain integer addition with no sign flipping, because 0016 stores
 * advances and deductions negative and enforces it with a CHECK. That is the
 * whole reason `settlementTotals` exists and it is used here rather than
 * re-added by hand.
 */
interface PayLineRow {
  id: string
  category: string
  kind: string
  description: string | null
  amount_cents: number
  /** PostgREST hands a to-one embed back as an object or a one-element array. */
  settlements: { id: string; status: string } | { id: string; status: string }[] | null
}

const payLines = (payRows ?? []) as unknown as PayLineRow[]

function settlementOf(line: PayLineRow): { id: string; status: string } | null {
  const value = line.settlements
  if (!value) return null
  return (Array.isArray(value) ? value[0] : value) ?? null
}

const livePayLines = payLines.filter((l) => settlementOf(l)?.status !== 'void')
const voidPayLines = payLines.length - livePayLines.length
const unpaidPayLines = livePayLines.filter((l) => settlementOf(l)?.status !== 'paid').length

const payTotals = settlementTotals(
  livePayLines.map((l) => ({
    category: l.category as SettlementCategory,
    amountCents: l.amount_cents,
  })),
)

/**
 * NULL, not zero, when nothing is attached.
 *
 * A load nobody has settled yet and a load settled for nothing are different
 * facts, and only one of them means "the driver was paid nothing". Drawn as the
 * absence it is, the same rule the rate itself follows two cards down.
 */
const driverPayCents = livePayLines.length > 0 ? payTotals.netCents : null
const keptCents = total !== null && driverPayCents !== null ? total - driverPayCents : null

// One row per settlement the lines came off, so the owner can go and read the
// statement the number came from rather than take it on trust.
const paySettlements = [
  ...new Map(
    livePayLines
      .map((l) => settlementOf(l))
      .filter((s): s is { id: string; status: string } => s !== null)
      .map((s) => [s.id, s]),
  ).values(),
]

const lineWord = (n: number) => (n === 1 ? 'line' : 'lines')

const profitBars = [
  { label: 'Rate you billed', value: total, display: formatCents(total) },
  {
    label: 'Paid to the driver',
    value: driverPayCents,
    display: driverPayCents === null ? 'nothing written down' : formatCents(driverPayCents),
    note:
      livePayLines.length > 0
        ? `${livePayLines.length} pay ${lineWord(livePayLines.length)} on this load.`
        : undefined,
  },
  {
    label: 'Kept after driver pay',
    value: keptCents,
    display: keptCents === null ? 'we cannot say yet' : formatCents(keptCents),
    // The one place a colour is spent here, and it is spent on the only fact
    // that needs acting on: this load paid out more than it billed.
    tone: keptCents !== null && keptCents < 0 ? ('overdue' as const) : undefined,
  },
]

// Passed in rather than left to the component. The rate is the whole of this
// chart, so it has to draw as the whole width — a rounded-up nice ceiling would
// leave the top bar short of the edge and invite the reading that something else
// is missing. When the pay is larger than the rate, the pay sets the width.
const profitMax = Math.max(total ?? 0, driverPayCents ?? 0)

const profitTitle =
  keptCents === null
    ? 'Not enough written down yet to say what this load kept'
    : keptCents < 0
      ? `This load paid out ${formatCents(Math.abs(keptCents))} more than it billed`
      : `Kept after driver pay: ${formatCents(keptCents)}`

const profitCoverage = [
  'This is the rate minus the driver pay. It is NOT profit. Fuel, tolls, insurance, the truck payment, repairs and your own time all still come out of this.',
  total === null && 'This load has no rate typed yet, so there is nothing to take the pay off.',
  driverPayCents === null &&
    'No pay line points at this load, so no driver pay is counted. That does not mean nobody was paid.',
  unpaidPayLines > 0 &&
    `${unpaidPayLines} pay ${lineWord(unpaidPayLines)} here sit on a settlement that is not paid yet, so this can still change.`,
  voidPayLines > 0 &&
    `${voidPayLines} pay ${lineWord(voidPayLines)} on a cancelled settlement are left out.`,
].filter((c): c is string => typeof c === 'string')

const params = Astro.url.searchParams
const error = params.get('error')
/**
 * The load a refused save is pointing at.
 *
 * The id is checked against the uuid shape before it becomes an href. It came
 * off the address bar, and an address bar is a place anybody can type.
 */
const dupId = params.get('dup') ?? ''
const duplicateHref = UUID.test(dupId) ? `/app/loads/${dupId}` : null
const duplicateName = (params.get('dup_name') ?? '').trim()
const added = params.get('added') === '1'
const saved = params.get('saved') === '1'
const statusMoved = params.get('status')
const billingMoved = params.get('billing')
const exceptionMoved = params.get('exception')

const card = 'rounded-xl border border-ink-100 bg-white p-5'
/**
 * The shared field construction from src/styles/global.css, not a local copy.
 *
 * The local one was 40px tall and drew its border in ink-100, which is 1.2:1
 * against white — a box a reader in a cab in daylight cannot see the edge of.
 * `.field-input` is 46px, so every box on this page clears the 44px target.
 */
const field = 'field-input mt-1'
const moneyWrap = 'field-affix mt-1'
const moneyInput = 'field-affix-input tabular-nums'
/**
 * The three sidebar setters.
 *
 * Secondary, not the dark button this used to be. Inside /app the action colour
 * is brand blue and a dark fill reads as a second Primary competing with "Save
 * load" three inches to the left; dark is marketing chrome. `.btn` is 44px, so
 * these also stop being 30px targets on a phone.
 */
const smallButton = 'btn btn-secondary btn-sm mt-3 w-full'

/** The subtitle says the lane when we know it, and says so plainly when we do not. */
const subtitle = lane.origin
  ? `${lane.origin} → ${lane.destination ?? 'no delivery stop yet'}`
  : 'No stops yet'
---

<App title={loadLabel(load)} subtitle={subtitle}>
  {
    /* The shared error box: role="alert" for a reader already on the page,
       tabindex="-1" so the 303's #form-errors gives it the focus, and — when a
       save was refused for a repeated number — the link to the load that
       already holds it. */
    error && (
      <div id="form-errors" role="alert" tabindex="-1" class="error-summary mb-5">
        <p class="font-semibold">
          <span aria-hidden="true">⚠</span> Fix this before saving
        </p>
        <p class="mt-1.5">{error}</p>
        {duplicateHref && (
          <p class="mt-2">
            <a href={duplicateHref} class="font-semibold">
              Open {duplicateName ? `load ${duplicateName}` : 'that load'}
            </a>
          </p>
        )}
      </div>
    )
  }
  {
    added && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Load added. Its status is Booked and its billing is Not ready. You move each of those on
        its own.
      </p>
    )
  }
  {saved && <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Saved.</p>}
  {
    statusMoved && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Status moved to {loadStatusLabel(statusMoved)}. The billing did not change.
      </p>
    )
  }
  {
    billingMoved && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Billing moved to {billingStatusLabel(billingMoved)}. The load status is still{' '}
        {loadStatusLabel(load.status)}.
      </p>
    )
  }
  {
    exceptionMoved &&
      (exceptionMoved === 'none' ? (
        <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          Exception cleared. The load is still {loadStatusLabel(load.status)}.
        </p>
      ) : (
        <p class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
          Marked as {exceptionLabel(exceptionMoved)}. The load status is still{' '}
          {loadStatusLabel(load.status)}. An exception sits next to the status. It does not replace
          it.
        </p>
      ))
  }

  {
    /* The broker's reference, at the top, in full. It is the number she is
       holding, and the header above shows our load number when we have one —
       so without this line the load she came here to check is identified by a
       number that appears nowhere on her desk. */
  }
  <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="flex items-baseline gap-2">
      <span class="text-xs tracking-wide text-ink-700 uppercase">Broker ref</span>
      <span class="text-lg font-semibold tracking-tight tabular-nums">
        {load.broker_reference ?? <span class="font-normal text-ink-500">not on file</span>}
      </span>
    </div>
    {
      /* `statusPillClass` and its two siblings already return `badge badge-*`
         from global.css. Nothing is added to them: the local pill classes this
         used to carry were a second badge shape on top of the shared one. */
    }
    <div class="flex flex-wrap items-center gap-1">
      <span class={statusPillClass(load.status)}>{loadStatusLabel(load.status)}</span>
      {
        load.exception && (
          <span class={exceptionPillClass(load.exception)}>{exceptionLabel(load.exception)}</span>
        )
      }
      <span class={billingPillClass(load.billing)}>{billingStatusLabel(load.billing)}</span>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_minmax(0,22rem)]">
    <form method="POST" class="space-y-4">
      <div class={card}>
        <h2 class="text-lg font-semibold tracking-tight">Load numbers</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="field-label">Broker reference</span>
            <input
              type="text"
              name="broker_reference"
              value={load.broker_reference ?? ''}
              class={`${field} tabular-nums`}
            />
          </label>
          <label class="block">
            <span class="field-label">
              Load number <span class="font-normal text-ink-500">(ours)</span>
            </span>
            <input
              type="text"
              name="load_number"
              value={load.load_number ?? ''}
              class={`${field} tabular-nums`}
            />
          </label>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="field-label">Customer</span>
            <select name="customer_id" class={field}>
              <option value="">—</option>
              {
                customers.map((c) => (
                  <option value={c.id} selected={load.customer_id === c.id}>
                    {c.name}
                  </option>
                ))
              }
            </select>
          </label>
          <label class="block">
            <span class="field-label">…or type a new one</span>
            <input type="text" name="customer_name" placeholder="e.g. TQL" class={field} />
            <span class="field-hint block">
              We use this only if you leave the list above blank. If the name is already on the
              list, we use that customer.
            </span>
          </label>
        </div>
      </div>

      <div class={card}>
        <h2 class="text-lg font-semibold tracking-tight">Freight</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="field-label">Equipment</span>
            <input
              type="text"
              name="equipment_type"
              value={load.equipment_type ?? ''}
              list="equipment-types"
              class={field}
            />
            <datalist id="equipment-types">
              {EQUIPMENT_TYPES.map((t) => <option value={t}></option>)}
            </datalist>
          </label>
          <label class="block">
            <span class="field-label">Commodity</span>
            <input type="text" name="commodity" value={load.commodity ?? ''} class={field} />
          </label>
          <label class="block">
            <span class="field-label">Weight (lb)</span>
            <input
              type="text"
              inputmode="numeric"
              name="weight_lbs"
              value={load.weight_lbs ?? ''}
              class={`${field} tabular-nums`}
            />
          </label>
          <label class="block">
            <span class="field-label">Pieces</span>
            <input
              type="text"
              inputmode="numeric"
              name="pieces"
              value={load.pieces ?? ''}
              class={`${field} tabular-nums`}
            />
          </label>
          <label class="block">
            <span class="field-label">
              Temperature (°F) <span class="font-normal text-ink-500">(reefer)</span>
            </span>
            <input
              type="text"
              inputmode="numeric"
              name="temperature_f"
              value={load.temperature_f ?? ''}
              class={`${field} tabular-nums`}
            />
          </label>
          <label class="check-row items-start py-2 sm:mt-7">
            <input
              type="checkbox"
              name="hazmat"
              value="1"
              checked={load.hazmat === true}
              class="mt-0.5"
            />
            <span>
              <span class="field-label">Hazmat</span>
              <span class="field-hint block">
                A placarded load has its own inspection and paperwork rules, at any weight.
              </span>
            </span>
          </label>
        </div>
      </div>

      <div class={card}>
        <h2 class="text-lg font-semibold tracking-tight">Rate</h2>
        <p class="mt-1 text-sm text-ink-500">
          Enter dollars. We keep the cents. What you type here is what the invoice says.
        </p>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <label class="block">
            <span class="field-label">Linehaul</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500" aria-hidden="true">$</span>
              <input
                type="text"
                name="linehaul"
                value={centsToInput(load.linehaul_cents)}
                inputmode="decimal"
                class={moneyInput}
              />
            </div>
          </label>
          <label class="block">
            <span class="field-label">Fuel surcharge</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500" aria-hidden="true">$</span>
              <input
                type="text"
                name="fuel_surcharge"
                value={centsToInput(load.fuel_surcharge_cents)}
                inputmode="decimal"
                class={moneyInput}
              />
            </div>
          </label>
          <label class="block">
            <span class="field-label">Accessorials</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500" aria-hidden="true">$</span>
              <input
                type="text"
                name="accessorials"
                value={centsToInput(load.accessorials_cents)}
                inputmode="decimal"
                class={moneyInput}
              />
            </div>
            <span class="field-hint block">
              On a load, money taken off goes in as a negative, like -150.00. Money the broker adds
              goes in as a plain positive number.
            </span>
          </label>
        </div>

        <label class="check-row mt-4 items-start py-2">
          <input
            type="checkbox"
            name="factored"
            value="1"
            checked={load.factored === true}
            class="mt-0.5"
          />
          <span>
            <span class="field-label">Factored</span>
            <span class="field-hint block">
              This invoice goes to the factoring company, not to the broker.
            </span>
          </span>
        </label>
      </div>

      <div class={card}>
        <h2 class="text-lg font-semibold tracking-tight">Detention terms</h2>
        <p class="mt-1 text-sm text-ink-500">
          Copy these numbers from the rate confirmation. They decide whether you can bill a long
          wait at a dock.
        </p>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <label class="block">
            <span class="field-label">Free hours at pickup</span>
            <input
              type="text"
              inputmode="numeric"
              name="free_hours_pickup"
              value={load.free_hours_pickup ?? ''}
              class={`${field} tabular-nums`}
            />
          </label>
          <label class="block">
            <span class="field-label">Free hours at delivery</span>
            <input
              type="text"
              inputmode="numeric"
              name="free_hours_delivery"
              value={load.free_hours_delivery ?? ''}
              class={`${field} tabular-nums`}
            />
          </label>
          <label class="block">
            <span class="field-label">Detention rate (per hour)</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500" aria-hidden="true">$</span>
              <input
                type="text"
                name="detention_rate"
                value={centsToInput(load.detention_rate_cents)}
                inputmode="decimal"
                class={moneyInput}
              />
            </div>
          </label>
        </div>

        <label class="mt-4 block">
          <span class="field-label">Does the broker have to pre-approve detention?</span>
          {
            /* Three answers, not a checkbox. "Not stated" is the honest default
               for a load typed in a hurry, and it is NOT the same as "no" — the
               difference is whether the driver has to phone before the free
               hours run out, which is the difference between a paid claim and
               an unpaid one. */
          }
          <select name="detention_requires_preapproval" class={field}>
            <option value="" selected={load.detention_requires_preapproval === null}>
              Not known yet — check the rate confirmation
            </option>
            <option value="yes" selected={load.detention_requires_preapproval === true}>
              Yes — the driver must call before the free hours run out
            </option>
            <option value="no" selected={load.detention_requires_preapproval === false}>
              No — detention counts without a call
            </option>
          </select>
        </label>
      </div>

      <div class={card}>
        <h2 class="text-lg font-semibold tracking-tight">Notes</h2>
        <textarea name="notes" rows="4" class={field}>{load.notes ?? ''}</textarea>
        <p class="mt-1 text-sm text-ink-700">
          Anything with no box above: a gate code, who signed, what the broker promised on the
          phone.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
        {/* The one Primary on this page. The three setters in the column
            beside it are Secondary — see `smallButton`. */}
        <button type="submit" name="intent" value="save_load" class="btn btn-primary">
          Save load
        </button>
        {/* ml-0: .link-back pulls itself left by 12px so it can line up under a
            heading, and this one is the second thing in a row. */}
        <a href="/app/loads" class="link-back ml-0">
          <span aria-hidden="true">←</span> Back to loads
        </a>
        <span class="text-sm text-ink-700">
          This form does not change the status, the billing or the exception.
        </span>
      </div>
    </form>

    <div class="space-y-4">
      {
        /* THREE SEPARATE FORMS, on purpose.
           Three <select>s inside one form with one Save button would post all
           three columns on every press, which quietly re-asserts two values she
           did not look at — and re-asserting a stale status is how a delivery
           gets undone. One button, one column. */
      }
      <form method="POST" class={card}>
        <div class="text-xs tracking-wide text-ink-700 uppercase">Where the truck is</div>
        <select name="status" class={field}>
          {
            LOAD_STATUSES.map((s) => (
              <option value={s.value} selected={load.status === s.value}>
                {s.label}
              </option>
            ))
          }
        </select>
        <button type="submit" name="intent" value="set_status" class={smallButton}>
          Move status
        </button>
        <p class="mt-2 text-sm text-ink-700">
          Moving this never changes the billing. A delivered load that is not ready to invoice is
          normal. It means the POD has not come in yet.
        </p>
      </form>

      <form method="POST" class={card}>
        <div class="text-xs tracking-wide text-ink-700 uppercase">Exception</div>
        <select name="exception" class={field}>
          <option value="" selected={!load.exception}>No exception</option>
          {
            LOAD_EXCEPTIONS.map((e) => (
              <option value={e.value} selected={load.exception === e.value}>
                {e.label}
              </option>
            ))
          }
        </select>
        <button type="submit" name="intent" value="set_exception" class={smallButton}>
          Record exception
        </button>
        <p class="mt-2 text-sm text-ink-700">
          An exception sits next to the status. It does not replace it. A detained load is still at
          the shipper, and that is where the truck is.
        </p>
        {
          load.exception === 'detained' && (
            <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
              {load.detention_requires_preapproval === true
                ? 'This broker needs pre-approval. You can only bill this wait if the driver called before the free hours ran out.'
                : load.detention_requires_preapproval === null
                  ? 'Nobody has said whether this broker needs pre-approval. Check the rate confirmation before the free hours run out. After that it is too late to ask.'
                  : 'This broker needs no pre-approval. Detention starts when the free hours end.'}
            </p>
          )
        }
      </form>

      <form method="POST" class={card}>
        <div class="text-xs tracking-wide text-ink-700 uppercase">Where the money is</div>
        <select name="billing" class={field}>
          {
            BILLING_STATUSES.map((b) => (
              <option value={b.value} selected={load.billing === b.value}>
                {b.label}
              </option>
            ))
          }
        </select>
        <button type="submit" name="intent" value="set_billing" class={smallButton}>
          Move billing
        </button>
        <p class="mt-2 text-sm text-ink-700">
          This is separate from where the truck is. You can invoice against a signed BOL while the
          truck is still on the road.
        </p>
      </form>

      {
        /*
          THE RATE, AND THE THREE NUMBERS THAT MAKE IT.

          What this card used to do, and why it read as $225 short. The heading
          figure is linehaul + fuel + accessorials. Underneath it were FOUR
          lines, and the fourth was the detention rate — which is dollars PER
          HOUR and is not in the total at all. Anyone adding the printed lines
          got a different number from the one printed above them, and the load
          this was reported on is the one whose fuel surcharge is $225.00, so
          the gap looked like a lost fuel surcharge rather than a line that was
          never a part.

          Now the three parts are a list that visibly adds up: three lines, a
          rule, and the same total again on the bottom line. The detention rate
          has moved below that rule, under a heading of its own, labelled as an
          hourly rate and as not part of the total. Nothing about the arithmetic
          changed — `totalRateCents` was always exactly these three — only what
          the card claims its own number is made of.
        */
      }
      <div class={card}>
        <div class="text-xs tracking-wide text-ink-700 uppercase">Rate</div>
        <div class="mt-1 text-3xl font-semibold tabular-nums">{formatCents(total)}</div>
        <dl class="mt-3 divide-y divide-ink-100 text-sm">
          <div class="flex justify-between gap-4 py-2">
            <dt class="text-ink-700">Linehaul</dt>
            <dd class="text-right tabular-nums">{formatCents(load.linehaul_cents)}</dd>
          </div>
          <div class="flex justify-between gap-4 py-2">
            <dt class="text-ink-700">Fuel surcharge</dt>
            <dd class="text-right tabular-nums">{formatCents(load.fuel_surcharge_cents)}</dd>
          </div>
          <div class="flex justify-between gap-4 py-2">
            <dt class="text-ink-700">Accessorials</dt>
            <dd class="text-right tabular-nums">{formatCents(load.accessorials_cents)}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t-2 border-ink-100 py-2">
            <dt class="font-medium">These three added up</dt>
            <dd class="text-right font-semibold tabular-nums">{formatCents(total)}</dd>
          </div>
        </dl>
        <p class="mt-2 text-sm text-ink-700">
          A dash means nobody has typed that number yet. A dash is not $0.00. The total adds only
          the numbers that are typed, so a dash adds nothing to it.
        </p>

        <div class="mt-4 border-t border-ink-100 pt-3">
          <div class="text-xs tracking-wide text-ink-700 uppercase">Detention rate</div>
          <div class="mt-1 text-lg font-semibold tabular-nums">
            {load.detention_rate_cents === null ? (
              <span class="font-normal text-ink-500">Not on file</span>
            ) : (
              `${formatCents(load.detention_rate_cents)} an hour`
            )}
          </div>
          <p class="mt-1 text-sm text-ink-700">
            This is a price per hour of waiting, not money on this load. It is not in the total
            above. What a wait is worth is worked out from the arrival and departure times on the
            stops.
          </p>
        </div>
      </div>

      {
        /* Directly under the rate, because it is the same money one step on.
           Three bars on one scale: the rate is the full width, the driver pay
           is the part that went out, and what is left is the third bar. The
           empty part of the pay bar IS the third bar, which is why the two sit
           together rather than on separate charts. */
      }
      <Figure
        title={profitTitle}
        subtitle="The rate on this load, minus the driver pay written against it."
        coverage={profitCoverage}
      >
        <Bars
          items={profitBars}
          max={profitMax > 0 ? profitMax : undefined}
          emptyMessage="Nothing is typed in for this load yet."
        />
        {
          paySettlements.length > 0 && (
            <ul class="mt-4 space-y-1 border-t border-ink-100 pt-3 text-sm">
              {paySettlements.map((s) => (
                <li class="flex flex-wrap items-center gap-x-2">
                  {/* .link is underlined at rest, and the 44px box around it is
                      what makes it a target on a phone. */}
                  <a href={`/app/settlements/${s.id}`} class="link inline-flex min-h-11 items-center">
                    Read the settlement this pay came off
                  </a>
                  <span class="text-ink-700">— {settlementStatusLabel(s.status)}</span>
                </li>
              ))}
            </ul>
          )
        }
      </Figure>

      {
        /*
          THE STOPS CONTROL IS A BUTTON, not a line of blue text.

          Both of these were 20px text links, which is why an audit read "Add a
          stop" as missing: it was on the screen and invisible. Without stops
          this load has no lane, and with no arrival and departure times there is
          no detention clock — so the money the broker owes for a four-hour wait
          cannot be worked out at all. That is a control worth 44px.

          Secondary, not Primary: the one Primary on this page is "Save load".
        */
      }
      <div class={card}>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="text-xs tracking-wide text-ink-700 uppercase">Stops</div>
          {
            stops.length > 0 && (
              <a href={`/app/loads/${id}/stops`} class="btn btn-tertiary btn-sm -mr-3">
                Edit stops
              </a>
            )
          }
        </div>
        {
          stops.length === 0 ? (
            <>
              <p class="mt-2 text-sm text-ink-700">
                No stops yet. Without stops this load has no lane, and no clock to measure a wait
                at a dock. You cannot bill detention without that clock.
              </p>
              <a href={`/app/loads/${id}/stops`} class="btn btn-secondary mt-3 w-full">
                Add a stop
              </a>
            </>
          ) : (
            <ol class="mt-2 divide-y divide-ink-100 text-sm">
              {stops.map((s) => (
                <li class="flex items-baseline justify-between gap-3 py-2">
                  <span class="min-w-0">
                    <span class="tabular-nums text-ink-700">{s.sequence}</span>{' '}
                    <span class="font-medium">
                      {[s.city, s.state].filter(Boolean).join(', ') || s.company_name || '—'}
                    </span>
                    {s.company_name && [s.city, s.state].filter(Boolean).length > 0 && (
                      <span class="block text-xs text-ink-700">{s.company_name}</span>
                    )}
                  </span>
                  <span class="shrink-0 text-xs text-ink-700">{s.stop_type}</span>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </div>
  </div>
</App>
