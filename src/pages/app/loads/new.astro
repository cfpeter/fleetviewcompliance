---
/**
 * Add a load.
 *
 * NOTHING is required except that the load can be identified — either our load
 * number or the broker's reference. That is the whole validation, and it is a
 * decision rather than an omission: this form is filled in while a broker is
 * still on the phone, off a rate confirmation that is frequently a photo of a
 * fax. A required commodity or a required weight is a field she types "x" into,
 * and an invented weight is worse than a blank one because it looks answered.
 *
 * Status and billing are not on this form at all. The table defaults them to
 * 'booked' and 'not_ready', which are the two true statements about a load that
 * has just been typed in, and they are moved SEPARATELY afterwards on the load's
 * own page. Offering them here as one "stage" dropdown is the exact mistake
 * 0009_loads.sql was written to avoid.
 */
import App from '../../../layouts/App.astro'
import { flashText } from '../../../lib/flash.ts'
import {
  EQUIPMENT_TYPES,
  loadLabel,
  matchCustomerName,
  parseMoneyToCents,
  parseOptionalInt,
  textOrNull,
} from '../../../lib/loads.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

/**
 * The fields worth handing back after a rejected save.
 *
 * A 303 throws the request body away, so without this one mistyped rate costs
 * her the entire rate confirmation again — fourteen fields — while the broker
 * waits. They ride in the query string, which is also what makes the error page
 * survive a refresh. Nothing personal goes in here; these are commercial fields
 * off a document that was emailed in clear text in the first place.
 */
const CARRY = [
  'load_number',
  'broker_reference',
  'customer_id',
  'customer_name',
  'equipment_type',
  'commodity',
  'weight_lbs',
  'pieces',
  'linehaul',
  'fuel_surcharge',
  'accessorials',
  'free_hours_pickup',
  'free_hours_delivery',
  'detention_rate',
] as const

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

/** The load a rejected save points at, so the reader can go and read it. */
interface Duplicate {
  id: string
  /** What that load is called on screen — its own number, or the broker's. */
  name: string
}

type NumberColumn = 'load_number' | 'broker_reference'

interface DuplicateHit extends Duplicate {
  column: NumberColumn
  /** The number she typed, echoed back so the message names it. */
  value: string
}

/**
 * A load in this carrier's account already carrying one of the two numbers.
 *
 * Two queries rather than one `or=` filter. PostgREST parses an `or=` string as
 * SYNTAX, so a comma or a bracket inside a broker reference becomes extra
 * filters and a 400 instead of a check — see `referenceSearchFilter` in
 * lib/loads.ts, which strips those characters precisely because of it. A value
 * handed to `.eq()` is escaped by the client and stays the value she typed.
 */
async function findDuplicate(
  loadNumber: string | null,
  brokerReference: string | null,
  excludeId?: string,
): Promise<{ ok: true; hit: DuplicateHit | null } | { ok: false; message: string }> {
  const pairs: [NumberColumn, string | null][] = [
    ['load_number', loadNumber],
    ['broker_reference', brokerReference],
  ]
  for (const [column, value] of pairs) {
    if (!value) continue
    let q = supabase.from('loads').select('id, load_number, broker_reference').eq(column, value)
    // The load being edited is not its own duplicate.
    if (excludeId) q = q.neq('id', excludeId)
    const { data, error } = await q.limit(1)
    if (error) return { ok: false, message: error.message }
    const row = data?.[0]
    if (row) return { ok: true, hit: { id: row.id, name: loadLabel(row), column, value } }
  }
  return { ok: true, hit: null }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  const reject = (message: string, duplicate?: Duplicate) => {
    const next = new URLSearchParams({ error: message })
    for (const key of CARRY) {
      const v = String(form.get(key) ?? '').trim()
      if (v) next.set(key, v)
    }
    // Checkboxes are absent when unticked, so this is only ever set when she
    // ticked it — which is the state worth preserving across a rejection.
    if (form.get('detention_requires_preapproval')) next.set('preapproval', '1')
    if (duplicate) {
      next.set('dup', duplicate.id)
      next.set('dup_name', duplicate.name)
    }
    // The fragment is the whole focus mechanism on a page that runs no script:
    // the browser scrolls to the box and, because it carries tabindex="-1",
    // hands it the focus too. See src/components/ui/ErrorSummary.astro.
    return Astro.redirect(`/app/loads/new?${next.toString()}#form-errors`, 303)
  }

  if (intent !== 'create') {
    // An unrecognised intent is a bug or a crafted post; either way it must not
    // fall through and render the form as though this were a GET.
    return reject('That button did not say what to do. Try again.')
  }

  const loadNumber = textOrNull(form.get('load_number'))
  const brokerReference = textOrNull(form.get('broker_reference'))

  /**
   * The one rule. A load with neither number is a row she can never find again:
   * the search box on the board covers exactly these two columns, because they
   * are the two numbers that exist on paper.
   */
  if (!loadNumber && !brokerReference) {
    return reject(
      'Enter a load number or a broker reference. You can fill in everything else later. Without one of these two numbers you cannot find this load again.',
    )
  }

  /**
   * THE SAME NUMBER TWICE, CAUGHT BEFORE THE ROW EXISTS.
   *
   * Neither column has a unique index, so two loads can carry one broker
   * reference — and two do, today. What that costs is the thing the two numbers
   * are for: the broker rings about TEST-BRKR-003, the search box returns two
   * rows, and the one she opens is a coin toss. Rates, stops and pay then get
   * typed onto whichever copy she opened that day.
   *
   * Checked here, before the insert, because afterwards the only cure is a
   * delete — and a delete takes the stops and the pay lines with it.
   *
   * No .eq('carrier_id', ...): RLS already scopes every read to the signed-in
   * carrier, so another carrier's TEST-BRKR-003 is invisible to this query and
   * cannot block her save.
   *
   * `.eq` and not `.ilike`: ilike reads % and _ inside a reference as wildcards,
   * which would refuse a number nobody else is using. A wrong refusal, while a
   * broker waits on the phone, is worse than a second copy she can merge later.
   */
  const duplicate = await findDuplicate(loadNumber, brokerReference)
  if (!duplicate.ok) return reject(duplicate.message)
  if (duplicate.hit) {
    const { hit } = duplicate
    return reject(
      `${hit.column === 'load_number' ? 'Load number' : 'Broker reference'} ${hit.value} is already on another load. Two loads with the same number cannot be told apart. Change the number here, or open that load and work on it.`,
      { id: hit.id, name: hit.name },
    )
  }

  const weight = parseOptionalInt(form.get('weight_lbs'), {
    label: 'Weight',
    // min 1, not 0: a blank box is already NULL by now, so a 0 here was typed,
    // and a zero-pound load is not a fact anyone means.
    min: 1,
    max: 250_000,
  })
  if (!weight.ok) return reject(weight.message)

  const pieces = parseOptionalInt(form.get('pieces'), { label: 'Pieces', min: 1, max: 100_000 })
  if (!pieces.ok) return reject(pieces.message)

  /**
   * Free hours allow 0, and the difference between 0 and blank is real money.
   *
   * Blank means the rate confirmation did not say, so we cannot start a
   * detention clock at all. Zero means the broker granted no free time and the
   * clock starts on arrival — a term worth having, and one that would be thrown
   * away if this shared the "0 is a typo" rule the weight field uses.
   */
  const freePickup = parseOptionalInt(form.get('free_hours_pickup'), {
    label: 'Free hours at pickup',
    min: 0,
    max: 72,
  })
  if (!freePickup.ok) return reject(freePickup.message)

  const freeDelivery = parseOptionalInt(form.get('free_hours_delivery'), {
    label: 'Free hours at delivery',
    min: 0,
    max: 72,
  })
  if (!freeDelivery.ok) return reject(freeDelivery.message)

  const linehaul = parseMoneyToCents(form.get('linehaul'), { label: 'Linehaul rate' })
  if (!linehaul.ok) return reject(linehaul.message)

  const fuel = parseMoneyToCents(form.get('fuel_surcharge'), { label: 'Fuel surcharge' })
  if (!fuel.ok) return reject(fuel.message)

  // Negative allowed here and nowhere else: a lumper, an advance or a fuel
  // advance fee comes off the rate confirmation as a deduction, and a total that
  // cannot go down is a total that never matches the cheque.
  const accessorials = parseMoneyToCents(form.get('accessorials'), {
    label: 'Accessorials',
    allowNegative: true,
  })
  if (!accessorials.ok) return reject(accessorials.message)

  const detentionRate = parseMoneyToCents(form.get('detention_rate'), {
    label: 'Detention rate',
  })
  if (!detentionRate.ok) return reject(detentionRate.message)

  /**
   * The customer: an existing one, or a name typed straight onto the load.
   *
   * The free-text fallback is not a convenience. A broker she has never hauled
   * for is the single most common case on a load-board booking, and sending her
   * away to a Customers screen to create a record first is how the load she is
   * holding gets written on a sticky note instead.
   */
  let customerId: string | null = null
  const chosen = String(form.get('customer_id') ?? '').trim()
  const typedName = textOrNull(form.get('customer_name'))

  if (chosen) {
    // The dropdown wins over the free-text box when both are filled — she picked
    // a record deliberately, and the text box is usually just left over from
    // typing before she spotted the customer in the list.
    if (!UUID.test(chosen)) return reject('We could not read that customer. Pick it again.')
    // The id must be one of OUR customers. The foreign key alone does not say
    // so: a foreign-key check runs as the table owner and ignores RLS, so a
    // pasted id from another carrier's book was accepted and the load recorded
    // that carrier's broker as ours. This read goes through RLS, so somebody
    // else's customer simply is not there.
    const { data: ours, error: ownError } = await supabase
      .from('customers')
      .select('id')
      .eq('id', chosen)
      .maybeSingle()
    if (ownError) return reject('We could not check that customer. Try again.')
    if (!ours) return reject('That customer is not in your book. Pick one from the list.')
    customerId = chosen
  } else if (typedName) {
    // Match an existing customer BEFORE inserting. Without this, every
    // hand-typed load creates another customer row and the list becomes four
    // spellings of TQL — at which point "what did we haul for them this
    // quarter" stops being answerable, quietly. The matching rule itself lives
    // in lib/loads.ts, where it can be tested.
    const { data: existing, error: lookupError } = await supabase
      .from('customers')
      .select('id, name')
    if (lookupError) return reject(lookupError.message)

    const hit = matchCustomerName(existing, typedName)
    if (hit) {
      customerId = hit
    } else {
      const { data: created, error: createError } = await supabase
        .from('customers')
        // carrier_id explicitly, here as on every insert in this section. RLS
        // CHECKS the column — a row naming another carrier is rejected — but it
        // does not SUPPLY it, and the column is NOT NULL with no default.
        .insert({ carrier_id: carrierId, name: typedName })
        .select('id')
        .single()
      if (createError || !created) {
        return reject(createError?.message ?? 'We could not save that customer.')
      }
      customerId = created.id
    }
  }

  const { data, error } = await supabase
    .from('loads')
    .insert({
      carrier_id: carrierId,
      load_number: loadNumber,
      broker_reference: brokerReference,
      customer_id: customerId,
      equipment_type: textOrNull(form.get('equipment_type')),
      commodity: textOrNull(form.get('commodity')),
      weight_lbs: weight.value,
      pieces: pieces.value,
      linehaul_cents: linehaul.value,
      fuel_surcharge_cents: fuel.value,
      accessorials_cents: accessorials.value,
      free_hours_pickup: freePickup.value,
      free_hours_delivery: freeDelivery.value,
      detention_rate_cents: detentionRate.value,
      /**
       * TRUE or NULL — never FALSE from this form.
       *
       * The column is nullable on purpose. An unticked box here cannot tell
       * "the rate confirmation says no pre-approval is needed" apart from "I
       * have not read that far yet", and writing FALSE asserts the first. That
       * assertion is the one that loses a detention claim: the driver sits four
       * hours, nobody calls the broker because the screen said it was not
       * required, and the invoice is refused. NULL says we do not know, the
       * load page says so in words, and the tri-state control there is where a
       * definite "not required" gets recorded.
       */
      detention_requires_preapproval: form.has('detention_requires_preapproval') ? true : null,
    })
    .select('id')
    .single()

  if (error || !data) {
    // Postgres words are for an operator, not for the person at the desk.
    if (error) console.error('load insert failed:', error.message)
    return reject('We could not save this load. Wait a moment and try again.')
  }

  // 303, spelled out. Astro.redirect() defaults to 302, and a 302 lets the
  // browser repeat the POST on a refresh or a back — which here books the same
  // load twice, under the same broker reference, with nothing on screen saying
  // so. 303 turns the follow-up request into a GET.
  //
  // Straight to the load rather than back to the board: the next thing in her
  // hand is the stop detail and the status the driver just gave her.
  return Astro.redirect(`/app/loads/${data.id}?added=1`, 303)
}

// --- GET: render, prefilled from whatever a rejected save handed back --------

const params = Astro.url.searchParams
// Only honoured when the request came from our own 303. See src/lib/flash.ts.
const error = flashText(Astro.url, Astro.request)
const prior = (key: string): string => params.get(key) ?? ''

/**
 * The load a refused save is pointing at.
 *
 * The id is checked against the uuid shape before it becomes an href. It came
 * off the address bar, and an address bar is a place anybody can type.
 */
const dupId = params.get('dup') ?? ''
const duplicateHref = UUID.test(dupId) ? `/app/loads/${dupId}` : null
const duplicateName = (flashText(Astro.url, Astro.request, 'dup_name') ?? '').trim()

// The customer list for the dropdown. RLS scopes it to this carrier; no
// .eq('carrier_id', ...) belongs here.
const { data: customerRows } = await supabase
  .from('customers')
  .select('id, name')
  .order('name', { ascending: true })
const customers = (customerRows ?? []) as { id: string; name: string | null }[]

/**
 * The shared field construction from src/styles/global.css, not a local copy.
 *
 * The local one was 40px tall and drew its border in ink-100, which is 1.2:1
 * against white — a box a reader in a cab in daylight cannot see the edge of.
 * `.field-input` is 46px, so every box on this form clears the 44px target, and
 * its border is ink-500.
 */
const field = 'field-input mt-1'
const moneyWrap = 'field-affix mt-1'
const moneyInput = 'field-affix-input tabular-nums'
const card = 'card'
---

<App
  title="Add a load"
  subtitle="You only need the broker&#8217;s reference number to start. Add the rest later."
>
  <div class="max-w-3xl">
    {
      /* The shared error box: role="alert" for a reader already on the page,
         tabindex="-1" so the 303's #form-errors gives it the focus, and the
         link to the load that already holds the number — the one thing she
         needs next and cannot get from a sentence. */
      error && (
        <div id="form-errors" role="alert" tabindex="-1" class="error-summary mb-5">
          <p class="font-semibold">
            <span aria-hidden="true">⚠</span> Fix this before saving
          </p>
          <p class="mt-1.5">{error}</p>
          {duplicateHref && (
            <p class="mt-2">
              {/* The one thing she needs next and cannot get from a sentence, so
                  it is a 44px target rather than a line of text to aim at. It
                  keeps the red of the box — `.error-summary a` in global.css —
                  because the box reads as one thing and the underline is what
                  says this is a link. */}
              <a href={duplicateHref} class="inline-flex min-h-11 items-center font-semibold">
                Open {duplicateName ? `load ${duplicateName}` : 'that load'}
              </a>
            </p>
          )}
        </div>
      )
    }

    <form method="POST" class="space-y-4">
      <div class={card}>
        <h2 class="font-medium tracking-tight">Load numbers</h2>
        <p class="mt-1 text-sm text-ink-500">
          Enter at least one of these two. They are the only way to find this load again.
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            /* The broker's number is FIRST and autofocused. It is the number
               printed on the sheet in front of her; ours often does not exist
               yet. Putting it second, in grey, is how a field that matters more
               than any other on this form gets skipped. */
          }
          <label class="block">
            <span class="field-label">Broker reference</span>
            <input
              type="text"
              name="broker_reference"
              value={prior('broker_reference')}
              autofocus
              placeholder="From the rate confirmation"
              class={`${field} tabular-nums`}
            />
            <span class="field-hint block">
              The broker's own number for this load. Search by this number when the broker calls.
            </span>
          </label>

          <label class="block">
            <span class="field-label">
              Load number <span class="font-normal text-ink-500">(ours)</span>
            </span>
            <input
              type="text"
              name="load_number"
              value={prior('load_number')}
              class={`${field} tabular-nums`}
            />
            <span class="field-hint block">
              Your own number, if you use one. Leave it blank if you do not.
            </span>
          </label>
        </div>
      </div>

      <div class={card}>
        <h2 class="font-medium tracking-tight">Customer</h2>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="field-label">Existing customer</span>
            <select name="customer_id" class={field}>
              <option value="">—</option>
              {
                customers.map((c) => (
                  <option value={c.id} selected={prior('customer_id') === c.id}>
                    {c.name}
                  </option>
                ))
              }
            </select>
          </label>

          <label class="block">
            <span class="field-label">…or type a new one</span>
            <input
              type="text"
              name="customer_name"
              value={prior('customer_name')}
              placeholder="e.g. TQL"
              class={field}
            />
            <span class="field-hint block">
              We save this as a customer you can use again. If the name is already on the list, we
              use that one instead of making a second one. If you also pick from the list, the list
              wins.
            </span>
          </label>
        </div>
      </div>

      <div class={card}>
        <h2 class="font-medium tracking-tight">Freight</h2>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="field-label">Equipment</span>
            {
              /* A datalist suggests without constraining, and it is plain HTML
                 with no script behind it. A closed <select> guarantees a wrong
                 box the first time a conestoga turns up, and the wrong box gets
                 picked rather than left blank — which looks authoritative. */
            }
            <input
              type="text"
              name="equipment_type"
              value={prior('equipment_type')}
              list="equipment-types"
              placeholder="e.g. Dry van 53"
              class={field}
            />
            <datalist id="equipment-types">
              {EQUIPMENT_TYPES.map((t) => <option value={t}></option>)}
            </datalist>
          </label>

          <label class="block">
            <span class="field-label">Commodity</span>
            <input
              type="text"
              name="commodity"
              value={prior('commodity')}
              placeholder="What is on the truck"
              class={field}
            />
          </label>

          <label class="block">
            <span class="field-label">Weight (lb)</span>
            <input
              type="text"
              inputmode="numeric"
              name="weight_lbs"
              value={prior('weight_lbs')}
              placeholder="e.g. 42000"
              class={`${field} tabular-nums`}
            />
          </label>

          <label class="block">
            <span class="field-label">Pieces</span>
            <input
              type="text"
              inputmode="numeric"
              name="pieces"
              value={prior('pieces')}
              placeholder="e.g. 24 pallets"
              class={`${field} tabular-nums`}
            />
          </label>
        </div>
      </div>

      <div class={card}>
        <h2 class="font-medium tracking-tight">Rate</h2>
        <p class="mt-1 text-sm text-ink-500">
          Enter dollars. We keep the cents. What you type here is what the invoice says.
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <label class="block">
            <span class="field-label">Linehaul</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500">$</span>
              <input
                type="text"
                name="linehaul"
                value={prior('linehaul')}
                inputmode="decimal"
                placeholder="1850.00"
                class={moneyInput}
              />
            </div>
          </label>

          <label class="block">
            <span class="field-label">Fuel surcharge</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500">$</span>
              <input
                type="text"
                name="fuel_surcharge"
                value={prior('fuel_surcharge')}
                inputmode="decimal"
                class={moneyInput}
              />
            </div>
          </label>

          <label class="block">
            <span class="field-label">Accessorials</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500">$</span>
              <input
                type="text"
                name="accessorials"
                value={prior('accessorials')}
                inputmode="decimal"
                class={moneyInput}
              />
            </div>
            <span class="field-hint block">
              On a load, money taken off goes in as a negative. A lumper or a fuel advance looks
              like -150.00. Money the broker adds goes in as a plain positive number.
            </span>
          </label>
        </div>
      </div>

      <div class={card}>
        <h2 class="font-medium tracking-tight">Detention terms</h2>
        <p class="mt-1 text-sm text-ink-500">
          Copy these numbers from the rate confirmation. They decide whether you can bill a long
          wait at a dock.
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <label class="block">
            <span class="field-label">Free hours at pickup</span>
            <input
              type="text"
              inputmode="numeric"
              name="free_hours_pickup"
              value={prior('free_hours_pickup')}
              placeholder="e.g. 2"
              class={`${field} tabular-nums`}
            />
          </label>

          <label class="block">
            <span class="field-label">Free hours at delivery</span>
            <input
              type="text"
              inputmode="numeric"
              name="free_hours_delivery"
              value={prior('free_hours_delivery')}
              placeholder="e.g. 2"
              class={`${field} tabular-nums`}
            />
          </label>

          <label class="block">
            <span class="field-label">Detention rate (per hour)</span>
            <div class={moneyWrap}>
              <span class="pl-3 text-ink-500">$</span>
              <input
                type="text"
                name="detention_rate"
                value={prior('detention_rate')}
                inputmode="decimal"
                placeholder="50.00"
                class={moneyInput}
              />
            </div>
          </label>
        </div>

        {/* .check-row is the 44px tap target the whole row shares, so the box
            and its sentence are one control. The 20px box itself comes from
            global.css, which sizes every checkbox in the app. */}
        <label class="check-row mt-4 items-start py-2">
          <input
            type="checkbox"
            name="detention_requires_preapproval"
            value="1"
            checked={params.get('preapproval') === '1'}
            class="mt-0.5"
          />
          <span>
            <span class="field-label">The broker must pre-approve detention</span>
            <span class="field-hint block">
              Tick this if the driver must call the broker before the free hours run out. If he
              does not call, you cannot bill the wait, however long he sits. If you leave it
              unticked we record "not known yet". We do not record "not needed". You set a clear
              "not needed" on the load page.
            </span>
          </span>
        </label>
      </div>

      <div class="flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
        {/* The one Primary on this page. Everything else here is a link. */}
        <button type="submit" name="intent" value="create" class="btn btn-primary">
          Add load
        </button>
        {/* ml-0: .link-back pulls itself left by 12px so it can line up under a
            heading, and this one is the second thing in a row. */}
        <a href="/app/loads" class="link-back ml-0">
          <span aria-hidden="true">←</span> Back to loads
        </a>
      </div>
    </form>
  </div>
</App>
