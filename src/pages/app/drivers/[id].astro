---
/**
 * One driver: the record, and the dates the rule engine reads.
 *
 * Two forms, two intents, one page. Both end in a 303 so a refresh cannot
 * replay either of them — and on this page a replayed POST would not just
 * duplicate a row, it would append a second compliance record for a date that
 * never changed.
 */
import Columns from '../../../components/charts/Columns.astro'
import Figure from '../../../components/charts/Figure.astro'
import Ring from '../../../components/charts/Ring.astro'
import Documents from '../../../components/Documents.astro'
import App from '../../../layouts/App.astro'
import {
  type DocumentRow,
  DOCUMENT_COLUMNS,
  requestTooLarge,
  uploadFromForm,
} from '../../../lib/documents.ts'
import {
  driverYearToDate,
  monthsEnding,
  netForDisplay,
  paidCoverage,
  paidSettlements,
  payByMonth,
} from '../../../lib/charts/pay.ts'
import { dqRing, driverLine } from '../../../lib/charts/dq-rings.ts'
import {
  CHECK_TONES,
  buildDriverChecklist,
  checklistLine,
} from '../../../lib/charts/driver-status.ts'
import { ceilingFor, compactMoney } from '../../../lib/charts/scale.ts'
import { loadDeadlines } from '../../../lib/deadlines.ts'
import { assembleDqf } from '../../../lib/proof/dqf.ts'
import {
  DRIVER_STATUSES,
  US_STATE_CODES,
  formDate,
  formText,
  formatDate,
  fullName,
  isDriverStatus,
  statusLabel,
  statusPillClass,
  todayInCalifornia,
} from '../../../lib/drivers.ts'
import { DRIVER_NOT_ACTIVE_MEANS, isActiveDriver } from '../../../lib/fleet/active.ts'
import {
  canRemove,
  confirmBody,
  confirmTitle,
  driverHistory,
  refusalFor,
  remindersLine,
} from '../../../lib/fleet/remove.ts'
import { formatCents } from '../../../lib/loads.ts'
import { formatPhone, parsePhoneEdit, toE164 } from '../../../lib/phone.ts'
import { anchorSlot, planAnchorWrites } from '../../../lib/anchors/plan.ts'
import {
  readUnboxedDates,
  UNBOXED_HEADING,
  UNBOXED_LEAD,
  unboxedQuestions,
  unboxedSlots,
} from '../../../lib/anchors/unboxed.ts'
import { answerLink, resolveAnchor } from '../../../lib/rules/anchors.ts'
import { answerKeyFor } from '../../../lib/rules/answer.ts'
import { DRIVER_ANCHORS, DRIVER_ANCHOR_GROUPS } from '../../../lib/rules/driver-anchors.ts'
import {
  type SettlementCategory,
  settlementStatusLabel,
  settlementStatusPillClass,
} from '../../../lib/settlements/compute.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!
const userId = Astro.locals.userId!
const id = Astro.params.id ?? ''

interface AnchorRow {
  id: string
  anchor_key: string
  occurred_on: string
}

/** One entry in the log — every date ever recorded, withdrawn ones included. */
interface HistoryRow {
  id: string
  anchor_key: string
  occurred_on: string
  source: string
  note: string | null
  recorded_at: string
  superseded_at: string | null
}

/**
 * The current date for each anchor, from the view that already does the picking.
 *
 * Reading `compliance_records` directly here would mean re-implementing "latest
 * wins" in the page, and the view's tie-break is not obvious enough to get right
 * twice: it orders by occurred_on first and only then by recorded_at, because a
 * correction typed today about last March is still about last March.
 */
async function loadCurrentAnchors(): Promise<Map<string, AnchorRow>> {
  const { data } = await supabase
    .from('current_compliance_anchors')
    .select('id, anchor_key, occurred_on')
    .eq('subject_type', 'driver')
    .eq('subject_id', id)
  const rows = (data ?? []) as AnchorRow[]
  // Keyed by SLOT, not by anchor key, because `planAnchorWrites` is shared with
  // the dashboard, where one submit spans the whole fleet. Keyed by anchor
  // alone there, every truck collapses into a single slot.
  return new Map(rows.map((r) => [anchorSlot('driver', id, r.anchor_key), r]))
}

function back(params: string): Response {
  return Astro.redirect(`/app/drivers/${id}${params ? `?${params}` : ''}`, 303)
}

function fail(message: string, hash = ''): Response {
  return back(`error=${encodeURIComponent(message)}${hash}`)
}

/** Back to the roster, for every case where this driver is not ours to show. */
function toRoster(message: string): Response {
  return Astro.redirect(`/app/drivers?error=${encodeURIComponent(message)}`, 303)
}

const NOT_YOURS = 'That driver is not in your fleet.'

// A hand-edited URL like /app/drivers/abc is not a missing row, it is a failed
// uuid cast — Postgres raises, and without this check the office manager gets
// "invalid input syntax for type uuid" across the top of her screen. Checked
// here rather than swallowing the error later, so a REAL database failure still
// reaches her as a real database failure instead of "no such driver".
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) {
  return toRoster(NOT_YOURS)
}

if (Astro.request.method === 'POST') {
  // BEFORE the body is read. formData() pulls the whole request into memory, so
  // an enormous upload has to be refused by its declared length or it is a dead
  // Worker instead of a message she can act on. The real limit is measured on
  // the bytes later; this only stops us buffering them.
  //
  // Answered as a DOCUMENT error rather than the page's generic one, so the
  // sentence lands beside the file box she was using instead of at the top of a
  // long page, where it reads as a complaint about something else entirely.
  const oversized = requestTooLarge(Astro.request)
  if (oversized) return back(`doc_error=${encodeURIComponent(oversized)}#documents`)

  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  if (intent === 'upload_document') {
    // Everything — the type sniff, the key, the R2 put, the row, the supersede —
    // is in src/lib/documents.ts, shared with the vehicle page.
    return back(
      await uploadFromForm({
        form,
        supabase,
        carrierId,
        userId,
        subjectType: 'driver',
        subjectId: id,
      }),
    )
  }

  if (intent === 'save_driver') {
    const first = formText(form, 'first_name')
    const last = formText(form, 'last_name')
    if (!first || !last) return fail('A driver needs a first name and a last name.')

    // The stored phone, read here rather than taken from `driver` below: the
    // page load runs AFTER this block, so on a POST there is no row in scope
    // yet. One column, and no carrier filter — RLS already scopes it, so a
    // driver that is not ours comes back null and the phone falls through to the
    // strict rule. Nothing is decided by that null: the UPDATE further down is
    // still the one place that answers "is this driver yours", and it answers it
    // by matching zero rows.
    const { data: current } = await supabase
      .from('drivers')
      .select('phone')
      .eq('id', id)
      .maybeSingle()

    // Same rule as the add form for anything TYPED here: this column is where an
    // SMS reminder is delivered, so an undialable value is a driver who is never
    // told, on a record that reads as though we have his number. Blank stays
    // allowed — the phone can follow the paperwork like everything else.
    //
    // What is different on an edit form is the value that was already there.
    // Every phone on this fleet predates the rule, and this handler refuses the
    // WHOLE submit on a bad phone — so the strict parser turns an owner opening
    // this page to type a medical card date into an owner who cannot save it,
    // over a field she never touched and cannot tell is the one being refused.
    // Nobody must ever be blocked on a field they did not edit, and refusing the
    // legacy row buys nothing today: SMS is not switched on yet, so there is no
    // message being sent into the void while it sits there. It is grandfathered
    // through untouched and the advisory beside the field is what asks for it.
    // Change it to something we still cannot dial and it is refused as before.
    const phone = parsePhoneEdit(form.get('phone'), current?.phone, 'Phone')
    if (!phone.ok) return fail(phone.message)

    const requestedStatus = String(form.get('status') ?? '')
    const status = isDriverStatus(requestedStatus) ? requestedStatus : 'active'

    const { data, error } = await supabase
      .from('drivers')
      .update({
        first_name: first,
        last_name: last,
        phone: phone.value,
        email: formText(form, 'email'),
        cdl_number: formText(form, 'cdl_number'),
        cdl_state: formText(form, 'cdl_state'),
        cdl_expires_on: formDate(form, 'cdl_expires_on'),
        hired_on: formDate(form, 'hired_on'),
        date_of_birth: formDate(form, 'date_of_birth'),
        status,
      })
      // No carrier_id in the filter and none in the patch. RLS makes another
      // carrier's driver invisible to this statement, so the worst an edited URL
      // achieves is matching zero rows — and leaving carrier_id out of the patch
      // is what stops anyone moving a driver into a different tenancy.
      .eq('id', id)
      .select('id')

    if (error) return fail(error.message)
    // An UPDATE that matches nothing is not an error in Postgres, so without
    // this the page would report a cheerful "Saved." for a driver that does not
    // exist or belongs to somebody else.
    if (!data || data.length === 0) return toRoster(NOT_YOURS)
    return back('saved=1')
  }

  /**
   * Delete the driver — and refuse whenever there is anything to preserve.
   *
   * THE REFUSAL IS THE NORMAL OUTCOME HERE, not the exception. A driver row is
   * the spine of a qualification file, and 49 CFR 391.51(c) requires that file
   * be kept for as long as he is employed plus three years. `documents` and
   * `compliance_records` have no DELETE grant and no foreign key to this table,
   * so a delete would not even fail loudly — it would succeed and leave his
   * medical card pointing at an id that no longer names anybody.
   *
   * What gets through is the row with nothing behind it: the driver somebody
   * typed twice. Checked again on POST because a tab left open all morning is
   * the ordinary way a stale "yes, it is empty" reaches this handler.
   */
  if (intent === 'delete') {
    const report = await driverHistory(supabase, id)
    if (!canRemove(report)) return back('confirm=delete#delete')

    // RLS makes another carrier's driver invisible to this statement, and
    // 0028_fleet_delete_guard.sql carries the same checks in the database — the
    // grant to DELETE has been on this table since 0002, so an app-side check on
    // its own is a suggestion.
    const { error } = await supabase.from('drivers').delete().eq('id', id)
    if (error) return back('confirm=delete#delete')

    return Astro.redirect('/app/drivers?removed=1', 303)
  }

  if (intent === 'save_dates') {
    const current = await loadCurrentAnchors()
    const recorded_at = new Date().toISOString()

    /**
     * The supersede-then-insert decision now lives in src/lib/anchors/plan.ts.
     *
     * It was written here first and is shared because the dashboard collects the
     * same dates, and the half that is easy to get wrong is not the insert — it
     * is the supersede that has to happen first. A second hand-copied
     * implementation of "a correction to an EARLIER date must supersede, a LATER
     * one must not" is a bug nobody would see: the screen keeps showing the old
     * date, she retypes it, and the table fills with corrections that never take.
     */
    /*
      THE DATES `DRIVER_ANCHORS` HAS NO BOX FOR.

      Twelve driver anchors are facts about the man: when his card expires, when
      the MVR came back. The engine also asks when a JOB was last done — the DQF
      opened, the road test passed, the previous employers investigated — and
      files that under the rule's own code, which no driver anchor spells. Those
      rows sat in the checklist above saying a date was missing with nothing on
      this page to type into.

      Read from the SAME function that draws them (src/lib/anchors/unboxed.ts),
      so what may be posted and what is on screen are one list. It is a pure
      function of the rule catalogue, so it costs no query here.
    */
    const extra = readUnboxedDates(
      unboxedSlots('driver', DRIVER_ANCHORS.map((a) => a.key)),
      (field) => form.get(field) as string | null,
      new Date().toISOString().slice(0, 10),
    )
    if (!extra.ok) return fail(extra.message)

    const { supersede, inserts, conflicts } = planAnchorWrites({
      entries: [
        ...DRIVER_ANCHORS.map((anchor) => ({
          subject: 'driver' as const,
          subjectId: id,
          anchorKey: anchor.key,
          // A blank box is left alone rather than treated as "delete this date".
          // These records are the evidence a driver was qualified during the
          // period they covered, and an accidental tab through an empty field
          // must never be the thing that removes one.
          on: formDate(form, `date_${anchor.key}`),
        })),
        ...extra.typed.map((t) => ({
          subject: 'driver' as const,
          subjectId: id,
          anchorKey: t.key,
          on: t.on,
        })),
      ],
      current,
      carrierId,
      userId,
      recordedAt: recorded_at,
    })

    // Unreachable from this form — one input per anchor — but the planner can
    // refuse, and swallowing that would mean a save that silently wrote nothing.
    if (conflicts.length > 0) return fail('You typed two different dates for the same field.')

    if (supersede.length > 0) {
      const { error } = await supabase
        .from('compliance_records')
        .update({ superseded_at: recorded_at })
        .in('id', supersede)
      if (error) return fail(error.message)
    }

    if (inserts.length > 0) {
      // INSERT, never UPDATE. A superseded date is not stale data to overwrite:
      // it is the evidence the driver was qualified during the period it
      // covered, and 49 CFR 391.51(c) says we keep the file for as long as he is
      // employed plus three years. The database agrees — a trigger rejects any
      // UPDATE that changes the date — so an UPDATE here would fail loudly
      // rather than quietly lose the history, which is the one mercy in it.
      const { error } = await supabase.from('compliance_records').insert(inserts)
      if (error) return fail(error.message)
    }

    return back(`dates=${inserts.length}`)
  }

  /**
   * Withdraw one recorded date.
   *
   * The same write the truck page makes, for the same reason: typing a NEWER
   * date over an old one is the ordinary correction and `save_dates` already
   * handles it, but a date typed wrong in the OTHER direction cannot be fixed
   * that way. The latest date wins, so an entry recorded as 2027 when it should
   * have been 2017 can only be got rid of by withdrawing it. Without this the
   * driver page had no way back from a typo — the truck page has had one all
   * along, which is exactly the kind of split this page is being brought out of.
   */
  if (intent === 'withdraw_date') {
    const recordId = String(form.get('record_id') ?? '')
    if (!recordId) return fail('Nothing to withdraw.', '#history')

    // Supersede, do not delete, and touch `superseded_at` and nothing else —
    // that is all the append-only trigger permits. The date is immutable; the
    // claim that it is still the live one is not. `.is('superseded_at', null)`
    // keeps a double-click from moving the withdrawal time on a row that was
    // already withdrawn.
    const { error } = await supabase
      .from('compliance_records')
      .update({ superseded_at: new Date().toISOString() })
      .eq('id', recordId)
      .is('superseded_at', null)

    if (error) return fail(error.message, '#history')
    return back('withdrew=1#history')
  }

  return back('')
}

const { data: driver, error: loadError } = await supabase
  .from('drivers')
  .select(
    'id, first_name, last_name, phone, email, cdl_number, cdl_state, cdl_expires_on, hired_on, date_of_birth, status, source, created_at',
  )
  .eq('id', id)
  .maybeSingle()

if (loadError) return toRoster(loadError.message)
// maybeSingle() returns null both for "no such id" and for "belongs to another
// carrier", because RLS makes the second one look exactly like the first. That
// is the point: this page cannot be used to find out whether a driver exists
// somewhere else on the platform.
if (!driver) return toRoster(NOT_YOURS)

/**
 * HIS PAY, ON HIS PAGE.
 *
 * This page held the whole driver record and said nothing at all about money,
 * so the answer to "what have I paid Mike this year" lived only in a list of
 * every settlement for every driver, filtered by hand. Charts go on the page
 * that owns the data, and a driver's pay is as much his record as his medical
 * card is.
 *
 * Everything below is drawn from settlements marked PAID, one row per revision
 * chain — see src/lib/charts/pay.ts for why `superseded_at` is not the filter
 * and why a draft is never in a bar.
 */
interface SettlementLineRow {
  category: SettlementCategory
  amount_cents: number
}

interface DriverSettlementRow {
  id: string
  period_start: string
  period_end: string
  status: string
  revision: number
  superseded_at: string | null
  net_cents: number | null
  paid_on: string | null
  /** Embedded so an open settlement's total is its lines rather than a stored guess. */
  settlement_lines: SettlementLineRow[] | null
}

// Alongside the anchors rather than after them. Both are reads of the same
// driver and neither depends on the other; run in series they are two round
// trips to add one section to the page.
//
// No .eq('carrier_id', …): RLS scopes this to the signed-in user's carrier, and
// the driver has already been proven to belong to it by the load above. Bounded
// by a row count rather than by a date, because a settlement can be marked paid
// months after the period it covers and a date floor would drop it out of the
// chart with nothing on screen to say so.
//
// The documents join the same round of reads. RLS scopes them to this carrier,
// and the subject filter is what makes them THIS driver's — a document id is
// never enough on its own, here or on the download route.
const [
  current,
  { data: historyRows },
  { data: settlementData },
  { data: documentData },
  allDeadlines,
] = await Promise.all([
  loadCurrentAnchors(),
  // Every date ever recorded for this driver, not just the ones in force. The
  // withdrawn ones are the point: an old medical card is the proof he was
  // qualified while it ran, so nothing here is ever deleted.
  supabase
    .from('compliance_records')
    .select('id, anchor_key, occurred_on, source, note, recorded_at, superseded_at')
    .eq('subject_type', 'driver')
    .eq('subject_id', id)
    .order('occurred_on', { ascending: false })
    .order('recorded_at', { ascending: false }),
  supabase
    .from('settlements')
    .select(
      'id, period_start, period_end, status, revision, superseded_at, net_cents, paid_on, settlement_lines ( category, amount_cents )',
    )
    .eq('driver_id', id)
    .order('period_start', { ascending: false })
    .order('revision', { ascending: false })
    .limit(400),
  supabase
    .from('documents')
    .select(DOCUMENT_COLUMNS)
    .eq('subject_type', 'driver')
    .eq('subject_id', id)
    .order('uploaded_at', { ascending: false })
    .limit(200),
  // The rule engine, in the same round as everything else. It is the first of
  // the three calls the printed qualification file makes, and this page makes
  // them in the same order for the same reason: the ring in the sidebar must
  // count what the binder counts, or it is a false assurance on the one
  // document somebody asks for when they are checking up on you.
  loadDeadlines(supabase, carrierId),
])

const documents = (documentData ?? []) as unknown as DocumentRow[]
const history = (historyRows ?? []) as unknown as HistoryRow[]

/**
 * The label for a recorded date.
 *
 * Every driver anchor applies to every driver, so unlike the truck page there is
 * no "no rule uses this date any more" case to explain — a truck changes kind
 * and its old dates stop being read, a driver does not. The fallback is the raw
 * key, for a row written by an import under a name this build does not know.
 *
 * `unboxedSlotByKey` is the second lookup, and it is not optional now that this
 * page collects rule-code dates: written under the anchor list alone, a road
 * test date typed in the form below would appear in the history as
 * `road_test_or_equivalent`, which reads as a row nobody put there. It is
 * declared further down, beside the questions it describes, and this runs when
 * the page renders rather than when it is read.
 */
const driverAnchorLabel = (key: string) =>
  DRIVER_ANCHORS.find((a) => a.key === key)?.label ?? unboxedSlotByKey.get(key)?.label ?? key

/**
 * The qualification ring.
 *
 * Gated on the active roster because `loadDeadlines` evaluates active drivers
 * and nobody else: a terminated driver comes back with no items at all, and no
 * items scores as eight things not on file. A red ring on a man who left last
 * year teaches the owner to ignore the colour on the forty he still employs.
 *
 * The gate is the shared predicate, so it cannot drift from the loader.
 */
const observedAt = new Date()
const driverItems = allDeadlines.filter((i) => i.subjectId === id)

const dqf = isActiveDriver(driver) ? dqRing(assembleDqf({ items: driverItems }), observedAt) : null

/**
 * THE CHECKLIST: everything with a deadline on this driver, worst first.
 *
 * Same gate as the ring, and the same reason. `loadDeadlines` evaluates active
 * drivers and nobody else, so a terminated driver comes back with no items at
 * all — and an empty list would print "Nothing needs you today" over a man
 * nobody is watching, which is the most reassuring sentence in the app shown in
 * the one case where it is not true. No checklist is drawn for him instead, and
 * the Record card beside it says why in the same words the truck page uses.
 *
 * The rows, the tones and the day counts are all derived in
 * src/lib/charts/driver-status.ts — including the two ways "overdue by N days"
 * comes out backwards, which is worth reading before touching any of this.
 */
const checklist = isActiveDriver(driver) ? buildDriverChecklist(driverItems, observedAt) : null

// Only the anchors a normal driver is expected to have. The exemption dates are
// blank for almost everyone, and counting them here would report every driver in
// the fleet as four dates short forever, which trains her to ignore the number.
// SLOT KEY, NOT THE BARE ANCHOR KEY. `loadCurrentAnchors` keys this Map by
// `anchorSlot('driver', id, key)`; looking it up by `a.key` alone never matches,
// so every date read as missing and "Dates not recorded" showed the full count
// for a driver whose file was complete. The date inputs below were fixed for
// this once and this line was missed — the two must move together, and the
// types cannot catch it because both keys are strings.
const missingAnchors = DRIVER_ANCHORS.filter(
  (a) => a.expected === 'always' && !current.has(anchorSlot('driver', id, a.key)),
)

/**
 * THE BOXES `DRIVER_ANCHORS` HAS NO ENTRY FOR.
 *
 * Twelve driver anchors, and the checklist above asks for more than twelve
 * things. A `computed` rule — the DQF being opened, the road test, the
 * pre-employment Clearinghouse query, the previous-employer investigation —
 * files its last completion under its OWN CODE (see `answerKeyFor`), and no
 * driver anchor spells a rule code. So those rows named a missing date and had
 * no box on this page: four of them on a driver with a hire date on file, and
 * the hazmat one on every driver.
 *
 * Built here, after `current`, because a box has to show what it already holds.
 * The words come from the same registry the dashboard reads, so the two screens
 * ask one question rather than two that can drift apart.
 */
const unboxed = unboxedQuestions({
  subject: 'driver',
  boxed: DRIVER_ANCHORS.map((a) => a.key),
  rows: driverItems,
  onFile: (key) => current.get(anchorSlot('driver', id, key))?.occurred_on ?? '',
})
const unboxedByKey = new Map(unboxed.map((q) => [q.key, q]))

/**
 * How many of the dates we expect from every driver are still blank.
 *
 * The rule-code questions are counted here too. Counting only the twelve
 * anchors, this said "every date we expect from a driver is recorded" over a
 * checklist that named four rows with no date — one screen answering the same
 * question two ways, which teaches her that one of the two is not worth reading.
 */
const missing = [
  ...missingAnchors.map((a) => a.key),
  ...unboxed.filter((q) => q.expected === 'always' && q.on === '').map((q) => q.key),
]
/** Every key a driver rule could ask for, drawn or not. The history reads it. */
const unboxedSlotByKey = new Map(
  unboxedSlots('driver', DRIVER_ANCHORS.map((a) => a.key)).map((s) => [s.key, s]),
)

/**
 * The `compliance_records.anchor_key` behind each checklist row.
 *
 * A `ChecklistRow` carries the RULE CODE, and the two are only sometimes the
 * same string: `medical_certificate_general` is answered under
 * `medical_certificate_expires`, `dqf_maintained` under `dqf_maintained`. Read
 * off the engine's own rows rather than worked out again here — a screen that
 * guesses this stores a date perfectly and leaves the rule reporting "no date"
 * forever, with nothing on screen looking broken.
 *
 * `answerKeyFor` is the fallback and it matters: compute.ts sets `answerKey` on
 * the two UNKNOWN branches and on neither overdue one, so an EXPIRED licence —
 * the single most enforcement-visible document in the industry — comes back
 * without one. Read only off `status`, that row would lose its way into the
 * record. The same expression the truck page uses, for the same reason.
 */
const answerKeyByRule = new Map(
  driverItems.map((i) => [i.rule.code, i.status.answerKey ?? answerKeyFor(i.rule)]),
)

const settlements = (settlementData ?? []) as unknown as DriverSettlementRow[]
const today = todayInCalifornia()

const pay = paidSettlements(
  settlements.map((s) => ({
    id: s.id,
    driverId: id,
    periodStart: s.period_start,
    periodEnd: s.period_end,
    status: s.status,
    revision: s.revision,
    supersededAt: s.superseded_at,
    netCents: s.net_cents,
    paidOn: s.paid_on,
  })),
)

// Six months, not twelve. Half a year of weekly settlements is enough to show
// the shape of his pay, and on a page that is mostly a form the chart has to
// earn its height twice over.
const payWindow = monthsEnding(today, 6)
const monthly = payByMonth(pay.rows, payWindow.from, payWindow.to)
const monthlyCeiling = ceilingFor(monthly.values)
const payYear = Number(today.slice(0, 4))
const ytd = driverYearToDate(pay.rows, [id], today)[0]
const payCoverage = paidCoverage(pay)
// The trailing month is short by whatever is left of it, every load, all month
// — and a chart that always ends on a runt column reads as this driver's pay
// collapsing. That is now carried by the column itself (`inProgress`: faded,
// open top edge, announced as "so far"), where it is read at the same moment
// the shape is, rather than by a sentence underneath that is read second.
const monthCoverage = payCoverage
const hasPaid = pay.rows.length > 0

// The most recent handful, exact to the cent, under the chart. The chart is a
// shape; a figure he might dispute is never read off one.
const recent = settlements.slice(0, 6).map((s) => ({
  ...s,
  net: netForDisplay(
    s.status,
    s.net_cents,
    (s.settlement_lines ?? []).map((l) => ({
      category: l.category,
      amountCents: l.amount_cents,
    })),
  ),
}))

const params = Astro.url.searchParams
const error = params.get('error')
const added = params.get('added') === '1'
const saved = params.get('saved') === '1'
const withdrew = params.get('withdrew') === '1'
const datesSaved = params.has('dates') ? Number(params.get('dates')) : null

/**
 * The delete panel, opened by a plain link.
 *
 * TWO STEPS, NO JAVASCRIPT. Nothing in this app runs client script, so
 * `confirm()` is not available and would not be wanted: the first press is a GET
 * that opens a panel naming the driver, the second is a POST with an intent,
 * exactly like every other write on this page.
 *
 * The counting only happens when the panel is open — six head queries that a
 * page nobody is deleting from should not pay for.
 */
const wantsDelete = params.get('confirm') === 'delete'
const removal = wantsDelete ? await driverHistory(supabase, id) : null
const refusal = removal ? refusalFor('driver', fullName(driver), removal) : null
const alsoGoes = removal ? remindersLine('driver', removal) : null

// Advisory, and deliberately not a save-time refusal — see parsePhoneEdit. The
// save now lets a legacy number through so nobody is blocked on a field they did
// not touch, and the cost of that mercy is a number that sits there looking
// answered. It is not: a reminder queued against it is a deadline the driver is
// never told about. Shown every time the page is opened so the one person who
// can find the real number is the one being asked, and it blocks nothing.
// Keyed off what the box SHOWS, not off the column: '' is supposed to reach
// Postgres as NULL and a row written before that rule still holds one, and an
// advisory pointing at a visibly empty field is a warning nobody can act on.
const phoneUndialable = formatPhone(driver.phone) !== '' && toE164(driver.phone) === null

const card = 'rounded-xl border border-ink-100 bg-white p-5'
/*
  There is no `field` string on this page any more. Every box wears
  `.field-input` from global.css — 44px tall, a border at ink-500 rather than the
  ink-100 that vanished on a phone in daylight, and the one focus ring the whole
  app shares. Labels and help lines are `.field-label` and `.field-hint` for the
  same reason: one construction, corrected in one place.
*/

/**
 * ONE HEADING SCALE, THREE STEPS, THE SAME ON EVERY SCREEN IN THIS APP.
 *
 *   h2  text-lg font-semibold tracking-tight        — a section of the page
 *   h3  text-sm font-semibold tracking-tight        — a subsection inside a card
 *   h3  text-xs tracking-wide text-ink-500 uppercase — the label on a small card
 *
 * `cardHeading` is the middle one, and it is the size and weight the chart frame
 * already gives its own heading (src/components/charts/Figure.astro), so the
 * ring card and the table card beside it start the same way.
 *
 * The third is written out in full where it is used rather than kept in a
 * constant here, because it has to stay BYTE-IDENTICAL to the same label on
 * /app/dispatch, /app/settlements and /app/ifta — one string, greppable, on
 * fourteen screens. The small labels on this page were `<div>`s: not headings at
 * all, invisible to the document outline and to anybody moving through this page
 * by headings, which is how a screen-reader user finds the count of dates that
 * are missing. The element changed; the class string did not, so nothing moved.
 */
const cardHeading = 'text-sm font-semibold tracking-tight'

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * Identical to the truck page, and for the identical reason: the history table
 * is wider than the card it sits in on a 375px screen, so below `sm` every cell
 * becomes a block and from `sm` the same markup is a table again. ONE set of
 * cells, not two. The pattern is written down in src/components/Documents.astro.
 */
const cell = 'block px-4 sm:table-cell sm:py-3'
/** The column name, said on the block that has no column. */
const said = 'text-ink-500 sm:hidden'

/**
 * IS THE DRIVER RECORD OPEN WHEN THE PAGE LOADS?
 *
 * Twelve fields, 1,077px tall, at the top of a page the office opens to look at
 * a medical card date. The names, the licence number and the date of birth are
 * typed once and corrected about once a year, so the form is folded away and
 * what it holds is printed on the summary instead — see the markup below.
 *
 * IT OPENS ON ITS OWN WHENEVER A SAVE WAS REFUSED, and that is the whole of the
 * rule: every refusal on this page comes back through `fail()`, which redirects
 * with `?error=`, and the message prints at the top of the page. A closed form
 * under that message would be a failure with nothing on screen to fix. Keyed off
 * the message rather than off which form produced it, deliberately — it is the
 * one version of this that cannot be broken by adding a thirteenth field or a
 * new way to refuse one.
 */
const recordOpen = error !== null || params.get('edit') === 'record'

/**
 * IS THE DATE FORM OPEN WHEN THE PAGE LOADS?
 *
 * Twelve date boxes with a sentence of help under each one, measured at 2,220px
 * of a 5,618px page on a phone — two fifths of everything, on a page an owner
 * opens to READ where a driver stands. So the boxes fold away and the checklist
 * above them prints the state of every one of those dates in words, which is
 * what he came for.
 *
 * NOTHING IS BURIED BY THIS. The section stays exactly where it was, directly
 * under the record, and every line in the checklist that needs a date links
 * straight to the box that answers it — `?edit=dates#date_<anchor>` opens this
 * fold on the server and lands the browser on that label. A medical card date
 * that used to be 4,076px down the page is now one tap from the top of it.
 *
 * It opens on its own whenever the next thing he does is certainly the form: a
 * refused save (which prints its message above and must have something to
 * correct), a save that just went through, or a link that asked for it.
 */
const datesOpen = error !== null || datesSaved !== null || params.get('edit') === 'dates'

/**
 * The history is every date ever recorded, withdrawn ones included — a log that
 * grows for as long as the driver is employed, and is read when a date looks
 * wrong rather than on the way past. Folded, and open whenever a withdrawal has
 * just happened or a withdrawal was refused, because both of those redirect
 * here with something to see.
 */
const historyOpen = withdrew || error !== null

/** The summary line on each fold: a chevron that turns, drawn once. */
const chevron = 'size-4 shrink-0 text-ink-500 transition-transform group-open:rotate-180'
/**
 * A fold's summary row. `list-none` because the default triangle is not ours.
 *
 * `min-h-11` because the summary IS the control — the whole row opens and closes
 * the fold — and a control a thumb has to hit is 44px tall whatever its text
 * happens to measure.
 */
const summaryRow =
  'flex min-h-11 cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-2 select-none [&::-webkit-details-marker]:hidden'

/**
 * Where a checklist row sends him to answer it.
 *
 * FIVE OF TWELVE GREY ROWS USED TO LAND NOWHERE, and a grey row he cannot
 * answer is the whole complaint. They came in two kinds and they need two
 * different answers:
 *
 *   1. The key is a RULE CODE — the DQF opened, the road test, the previous
 *      employers, the hire-time MVR. Those have boxes in the date form now (see
 *      `unboxed`), under the same `date_<key>` id every other box uses, so the
 *      existing link shape carries them with no special case.
 *   2. The key is on the DENY-LIST — `hire_date` and `cdl_expires`. Those must
 *      never become a compliance record: deadlines.ts projects both out of the
 *      driver's own columns with `if (a[anchorKey]) continue`, so a record
 *      SILENTLY OUTRANKS the column, and a typo would move five federal rules
 *      onto wrong dates while his own page went on showing the right one. The
 *      registry already says where each one really lives; when that is this very
 *      page, the useful link is the one that OPENS THE RECORD FOLD rather than a
 *      link back to where he is standing.
 *
 * `null` survives for a key in neither group, and a row with no link still has
 * no link rather than a button that lands nowhere. tests/unboxed-dates.test.ts
 * is what keeps that case unreachable.
 */
function answerHref(row: { code: string; anchorKey?: string }): string | null {
  // `box` and the fragment name the same field, and both are needed: the
  // fragment scrolls the browser to it, and the parameter is the half the
  // SERVER can read — a fragment never leaves the browser, so without it a
  // field inside a folded group would be linked to and still not be on screen.
  const toBox = (key: string) => `/app/drivers/${id}?edit=dates&box=${key}#date_${key}`
  const record = `/app/drivers/${id}?edit=record#record`

  if (row.anchorKey) return toBox(row.anchorKey)

  const key = answerKeyByRule.get(row.code)
  if (!key) return null
  if (unboxedByKey.has(key)) return toBox(key)

  const entry = resolveAnchor(key)
  if (entry?.answeredElsewhere) {
    const href = answerLink(entry, id)
    // `answerLink` points AWAY from the screen the row is on. For a driver
    // column it points at this page, which as a link is a tap that changes
    // nothing — so it becomes the parameter that opens the record instead.
    return href === `/app/drivers/${id}` ? record : href
  }
  return null
}

/** Which date box a link asked for, so the group holding it is not folded. */
const wantedBox = params.get('box')

/**
 * The four status icons, drawn as paths so they cost nothing and print.
 *
 * COLOUR IS NEVER THE ONLY CARRIER. Each icon sits beside a pill that says the
 * same thing in words, because roughly one man in twelve cannot separate the
 * red mark from the amber one, and this is read on a phone, in a yard.
 */
const ICONS = {
  act: 'M6 6l8 8M14 6l-8 8',
  soon: 'M10 5.5v5M10 14.2v.3',
  nodate: 'M7.6 7.6a2.4 2.4 0 1 1 2.9 2.35c-.3.1-.5.4-.5.75v.8M10 14.2v.3',
  ok: 'M5.5 10.5l3 3 6-7',
  read: 'M10 9v5.5M10 5.7v.3',
} as const
---

<App
  title={fullName(driver)}
  subtitle={driver.hired_on ? `Hired ${formatDate(driver.hired_on)}` : 'No hire date on file'}
>
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}
  {
    added && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Driver added. Fill in the dates you have. The rest can wait for the paperwork.
      </p>
    )
  }
  {saved && <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Saved.</p>}
  {
    withdrew && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Date withdrawn. We keep it in the history, so you can still see what was on file and
        when. The next most recent date is now the one we use.
      </p>
    )
  }
  {
    datesSaved !== null &&
      (datesSaved > 0 ? (
        <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          <span class="tabular-nums">{datesSaved}</span>
          {datesSaved === 1 ? ' date recorded.' : ' dates recorded.'}
        </p>
      ) : (
        <p class="mb-5 rounded-lg bg-brand-500/[0.08] px-4 py-3 text-sm text-brand-700">
          Nothing changed, so nothing was recorded.
        </p>
      ))
  }

  {/*
    TWO BLOCKS, AND THE LIST IS IN THE LEFT ONE. That is the whole layout, and
    it is why this page has no placement rules on it while the truck page does.

    The left column is the record and then the checklist; the rail is the ring.
    Measured at 1440px: the left column runs about 1,100px and the rail about
    300. A rail that ENDS above long content is what every page with a sidebar
    looks like — the space beside it is open at the bottom and reads as margin.
    The shape that reads as broken is the other way round, a short column beside
    a long rail, which walls a rectangle of blank page in on three sides. The
    truck page had exactly that: its record folded to 220px, its rail ran to
    700, and its timeline waited below the grid instead of filling the column.
    The owner's words for it: "i dont like this gap open space empty space".
    That page now puts its timeline where this page puts its checklist, so the
    two are the same shape again. Nothing here had to move.

    `items-start`, and it is not decoration. A grid stretches its children to
    the tallest one in the row by default, and on a driver whose file is in
    order the rail is the taller side — the record card would stretch into an
    empty white box most of a screen tall, which reads as a page that failed to
    load rather than as a form somebody closed. Each column is its own height.
  */}
  <div class="grid items-start gap-6 lg:grid-cols-[1fr_minmax(0,20rem)]">
    {/*
      THE RECORD IS FOLDED AWAY, ON `details` ALONE.

      No script runs in this app and none is needed: `details` opens on a tap and
      from the keyboard by itself, the same way the phone menu in
      src/layouts/App.astro and the upload form in src/components/Documents.astro
      already do.

      WHAT IS FOLDED AWAY IS THE TYPING, NOT THE ANSWERS. The summary keeps the
      three facts somebody opens a driver for when he is not editing anything —
      the number to ring him on, his licence number, and the day that licence
      runs out — so the closed card still answers the question the page was
      opened with. Collapsing is only worth doing if nothing he came for
      disappears; otherwise it is hiding data and calling it tidying.

      `open` is decided on the server, so a refused save always comes back with
      the form already open under its own error message. See `recordOpen`.
    */}
    {/*
      The left column is the record and then the checklist, in that order, and
      the order is measured rather than chosen. The closed record is about 180px
      and holds the three facts somebody opens a driver page for — the number to
      ring him on, his licence number, and the day that licence runs out — so
      the checklist starts within the first screen on a phone and the phone
      number is not pushed under it.
    */}
    <div class="space-y-4">
    <div id="record" class="rounded-xl border border-ink-100 bg-white p-5">
      <details open={recordOpen} class="group">
        <summary
          class="flex min-h-11 cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-3 select-none [&::-webkit-details-marker]:hidden"
        >
          <h2 class="text-lg font-semibold tracking-tight">Driver record</h2>
          {/* The status, beside his name rather than in a card on the other
              side of the screen. "Is he still one of mine" is the first thing
              read about a driver, and it decides whether anything else on this
              page is being watched at all. */}
          {/* `statusPillClass` already returns a `badge badge-*` pair, so the
              utilities that used to sit beside it were quietly overriding the
              shared badge — the same status is now the same shape and the same
              colour here as it is on the roster. */}
          <span class={statusPillClass(driver.status)}>{statusLabel(driver.status)}</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4 shrink-0 text-ink-500 transition-transform group-open:rotate-180"
          >
            <path d="M5 8l5 5 5-5"></path>
          </svg>
          {/* One word, and it goes when the form is open, where the form itself
              says what it is for. */}
          <span class="ml-auto text-sm font-medium text-brand-700 group-open:hidden">Change</span>

          <span class="flex w-full flex-wrap gap-x-6 gap-y-1 text-sm">
            <span class="whitespace-nowrap">
              <span class="text-ink-500">Phone </span>
              {
                formatPhone(driver.phone) ? (
                  <span class="tabular-nums">{formatPhone(driver.phone)}</span>
                ) : (
                  <span class="text-ink-500">not on file</span>
                )
              }
            </span>
            <span class="whitespace-nowrap">
              <span class="text-ink-500">CDL </span>
              {
                driver.cdl_number ? (
                  <span class="tabular-nums">
                    {driver.cdl_number}
                    {driver.cdl_state && ` ${driver.cdl_state}`}
                  </span>
                ) : (
                  <span class="text-ink-500">not on file</span>
                )
              }
            </span>
            <span class="whitespace-nowrap">
              <span class="text-ink-500">CDL expires </span>
              {
                driver.cdl_expires_on ? (
                  <span class="tabular-nums">{formatDate(driver.cdl_expires_on)}</span>
                ) : (
                  <span class="text-ink-500">not on file</span>
                )
              }
            </span>
          </span>

          {/*
            The phone advisory follows the phone onto the summary. It used to sit
            under the field, which is behind the fold now — and a number we
            cannot text is exactly the thing that must not go quiet. The long
            version, with what to do about it, is still under the field.
          */}
          {
            phoneUndialable && (
              <span class="badge badge-warning">We cannot text this number.</span>
            )
          }

          {/*
            Why there is no checklist and no ring on this page, said where the
            status is — the same sentence in the same place as the truck page.
            Both are drawn only for a driver on the active list, because the
            engine only looks at those, and a page where two blocks simply are
            not there reads as broken rather than as switched off.
          */}
          {
            !isActiveDriver(driver) && (
              <span class="w-full text-xs text-ink-700">
                {DRIVER_NOT_ACTIVE_MEANS} Set him back to Active to start again.
              </span>
            )
          }
        </summary>

        <form method="POST" class="mt-5 space-y-4 border-t border-ink-100 pt-5">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="field-label">
                First name <span class="text-red-600">*</span>
              </span>
              <input
                type="text"
                name="first_name"
                value={driver.first_name}
                required
                class="field-input mt-1"
              />
            </label>
            <label class="block">
              <span class="field-label">
                Last name <span class="text-red-600">*</span>
              </span>
              <input
                type="text"
                name="last_name"
                value={driver.last_name}
                required
                class="field-input mt-1"
              />
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="field-label">Phone</span>
              {/*
                Shown the way a person reads it, stored as E.164. The two are
                deliberately different: '+18183340168' is what a provider needs and
                what makes two spellings of one number compare equal, and it is also
                what nobody recognises as their own driver's line at a glance.
              */}
              <input
                type="tel"
                name="phone"
                value={formatPhone(driver.phone)}
                placeholder="(818) 334-0168"
                class="field-input mt-1 tabular-nums"
              />
              {/* A sentence, so not a badge: `.badge` never wraps, and this one
                  runs to two lines on a phone. amber-900 on amber-100 is the
                  darker pair, for text on a tint. */}
              {
                phoneUndialable && (
                  <span class="mt-1.5 block rounded-lg bg-amber-100 px-3 py-2 text-sm text-amber-900">
                    We cannot text this number. Reminders for this driver have nowhere to go. We
                    saved it anyway.
                  </span>
                )
              }
            </label>
            <label class="block">
              <span class="field-label">Email</span>
              <input type="email" name="email" value={driver.email ?? ''} class="field-input mt-1" />
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="field-label">CDL number</span>
              <input
                type="text"
                name="cdl_number"
                value={driver.cdl_number ?? ''}
                class="field-input mt-1 tabular-nums"
              />
            </label>
            <label class="block">
              <span class="field-label">CDL state</span>
              <select name="cdl_state" class="field-input mt-1">
                <option value="">—</option>
                {
                  US_STATE_CODES.map((code) => (
                    <option value={code} selected={driver.cdl_state === code}>
                      {code}
                    </option>
                  ))
                }
              </select>
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="field-label">CDL expires</span>
              <input
                type="date"
                name="cdl_expires_on"
                value={driver.cdl_expires_on ?? ''}
                class="field-input mt-1 tabular-nums"
              />
            </label>
            <label class="block">
              <span class="field-label">Hire date</span>
              <input
                type="date"
                name="hired_on"
                value={driver.hired_on ?? ''}
                max={today}
                class="field-input mt-1 tabular-nums"
              />
              <span class="field-hint block">
                Five federal deadlines are counted from this day, so do not leave it blank.
              </span>
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="field-label">Date of birth</span>
              <input
                type="date"
                name="date_of_birth"
                value={driver.date_of_birth ?? ''}
                max={today}
                class="field-input mt-1 tabular-nums"
              />
            </label>
            <label class="block">
              <span class="field-label">Status</span>
              <select name="status" class="field-input mt-1">
                {
                  DRIVER_STATUSES.map((s) => (
                    <option value={s.value} selected={driver.status === s.value}>
                      {s.label}
                    </option>
                  ))
                }
              </select>
              {/*
                One sentence, from src/lib/fleet/active.ts, shared with the truck
                page and /app/billing. It has to say the consequence out loud: a
                status that quietly switches off the reminders is how a medical card
                expires on a man somebody marked inactive and then re-hired.
              */}
              <span class="field-hint block">
                {DRIVER_NOT_ACTIVE_MEANS} His records stay on file.
              </span>
            </label>
          </div>

          <div class="flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
            <button type="submit" name="intent" value="save_driver" class="btn btn-primary">
              Save driver
            </button>
          </div>

          {/*
            Where the row came from, at the foot of the form. These are facts
            about the record rather than about the driver — nobody opens a
            driver to find out which day the row was typed — so they no longer
            take a card of their own in the rail.
          */}
          <p class="text-xs text-ink-700 tabular-nums">
            Added {formatDate(String(driver.created_at).slice(0, 10))} · from {driver.source}
          </p>
        </form>
      </details>

      {/*
        The two links are OUTSIDE the fold. They are how you leave this page, and
        a way out that only exists once you have opened an edit form is not a way
        out. The qualification file matters twice over here: for a driver who is
        not active there is no ring card in the rail, so this is the only link to
        it on the screen.
      */}
      {/* Tertiary buttons, not 20px lines of text: these are how you leave the
          page and they are hit with a thumb. gap-3 keeps 12px between them, so
          neither is a mis-tap on the other. */}
      <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
        <a href={`/app/drivers/${id}/file`} class="btn btn-tertiary btn-sm -ml-3">
          Qualification file →
        </a>
        <a href="/app/drivers" class="btn btn-tertiary btn-sm">Back to drivers</a>
      </div>
    </div>

    {/*
      WHAT NEEDS HIM, AT THE TOP, IN WORDS.

      One row per obligation the engine tracked for this driver, worst first:
      a large icon, the thing itself, and a pill saying how long — "overdue 12
      days", "in 29 days", "no date on file". Colour, icon and words on every
      row, never colour on its own.

      THE RED, AMBER AND GREY ROWS ARE NEVER FOLDED. A gap an owner has to open
      something to find is a gap he does not know about, and "we have no date"
      is a state of its own, not an absence to tidy away. Only the rows with
      nothing to do on them go behind the fold, and the fold says how many.

      Each row that can be answered links to the box that answers it, which is
      what lets the date form below fold up without burying anything.
    */}
    {
      checklist && (
        <section id="needs" class="rounded-xl border border-ink-100 bg-white p-5">
          <h2 class="text-lg font-semibold tracking-tight">What this driver needs</h2>
          {/* The answer, in a sentence, before any shape or colour is read. */}
          <p class="mt-1 text-sm font-medium">{checklistLine(checklist)}</p>
          {checklist.counts.nodate > 0 && (
            <p class="mt-1 text-sm text-ink-500">
              A missing date is not a safe date. Until you record it, we list this driver as
              missing data, next to the overdue ones.
            </p>
          )}

          {checklist.needs.length > 0 && (
            <ul class="mt-4 divide-y divide-ink-100 border-t border-ink-100 text-sm">
              {checklist.needs.map((row) => {
                const href = answerHref(row)
                /*
                  THE WHOLE ROW IS THE TAP, not a link on the end of it.

                  An "Add the date →" link beside the words wrapped onto a line
                  of its own on a 375px screen and took 44px with it — on twelve
                  rows that was 528px of arrows. The row is already taller than
                  a thumb, so the row IS the target, and the chevron says so.
                */
                const Row = href ? 'a' : 'div'
                return (
                  <li>
                    <Row
                      href={href ?? undefined}
                      class:list={[
                        'flex min-h-11 items-start gap-3 py-2.5',
                        href && '-mx-2 rounded-lg px-2 hover:bg-ink-50/60',
                      ]}
                    >
                      <span
                        class:list={[
                          'flex size-7 shrink-0 items-center justify-center rounded-full',
                          CHECK_TONES[row.tone].icon,
                        ]}
                        aria-hidden="true"
                      >
                        <svg
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-4"
                        >
                          <path d={ICONS[row.tone]} />
                        </svg>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                          <span class="font-medium">{row.title}</span>
                          <span class:list={['badge', CHECK_TONES[row.tone].pill]}>
                            {row.text}
                          </span>
                        </span>
                        {/* Only where there is a date in it. See `hasDate`. */}
                        {row.hasDate && (
                          <span class="mt-0.5 block text-xs text-ink-700 tabular-nums">
                            {row.due}
                          </span>
                        )}
                      </span>
                      {href && (
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="mt-1 size-4 shrink-0 text-ink-500"
                        >
                          <path d="M8 5l5 5-5 5" />
                        </svg>
                      )}
                    </Row>
                  </li>
                )
              })}
            </ul>
          )}

          {checklist.settled.length > 0 && (
            /* Denser on purpose, and not the same row twice: these are the ones
               with nothing to do on them, so they carry the name and the pill
               and no date line and no link. */
            <details class="group mt-4 border-t border-ink-100 pt-4">
              <summary class={summaryRow}>
                <h3 class={cardHeading}>
                  <span class="tabular-nums">{checklist.settled.length}</span>
                  {checklist.settled.length === 1 ? ' more item' : ' more items'}, nothing to do
                </h3>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={chevron}
                >
                  <path d="M5 8l5 5 5-5" />
                </svg>
              </summary>
              <ul class="mt-2 divide-y divide-ink-100">
                {checklist.settled.map((row) => (
                  <li class="flex flex-wrap items-center gap-x-2 gap-y-1 py-2 text-sm">
                    <span
                      class:list={[
                        'flex size-5 shrink-0 items-center justify-center rounded-full',
                        CHECK_TONES[row.tone].icon,
                      ]}
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-3"
                      >
                        <path d={ICONS[row.tone]} />
                      </svg>
                    </span>
                    <span class="min-w-0 flex-1">{row.title}</span>
                    <span class:list={['badge', CHECK_TONES[row.tone].pill]}>{row.text}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </section>
      )
    }
    </div>

    <div class="space-y-4">
      {
        dqf && (
          /*
            The one visual on this page that answers "would this file survive
            somebody asking for it". The sentence under it is the answer; the
            ring is only how it is read in a second. The fraction sits in the
            middle of the ring so the arithmetic behind it is never out of
            sight — a bare score is a number a broker quotes back at you.
          */
          <Figure
            title="Driver qualification file"
            subtitle="The 8 items 49 CFR 391.51(b) asks for"
            coverage="Counted from what you typed in. Nobody here has seen the paper documents."
            action={{ href: `/app/drivers/${id}/file`, label: 'Open the file →' }}
          >
            <Ring ring={dqf} size={76} centre legend />
            <p class="mt-4 text-sm font-medium">{driverLine(dqf)}</p>
          </Figure>
        )
      }

      {/*
        THE "DATES NOT RECORDED" CARD IS GONE FROM HERE, AND NOTHING IT SAID IS.

        It counted the anchors with `expected: 'always'` and no date, and listed
        their labels. The checklist above says the same thing per obligation, in
        the engine's own words, with a link to the box that answers each one —
        and it says it about every tracked date rather than only the anchors.
        Two counts of the same gap, in two columns of one screen, is how an
        owner learns that one of them is not worth reading.

        The count itself lives on: it is the summary of the date form below,
        where the boxes are.
      */}
      {/*
        THE "RECORD" CARD IS GONE FROM HERE TOO, AND FOR A PLAINER REASON.

        It was a 176px card holding three things: the status pill, which belongs
        beside his name and is now on the record summary where it is read first;
        the day the row was created and where it came from, which are facts
        about the database rather than about the driver and now sit at the foot
        of the record form; and the sentence saying why the ring above it is
        missing, which has followed the status pill onto the summary — it has to
        be beside the status, because the status is what caused it.
      */}
    </div>
  </div>

  {/*
    THE DATES COME FIRST, RIGHT UNDER THE RECORD.

    They used to sit at the foot of the page, and the box that says when this
    man's medical certificate runs out was 4,076px down a 6,003px page on a
    phone — five screens, behind a form the owner touches about once a year.
    That is the one date in this product that puts a truck out of service, so it
    is now the first thing under the record, the way it already is on the truck
    page (src/pages/app/vehicles/[id].astro).

    The pay chart and the documents follow it. Both are things the office comes
    to this page to LOOK at; the dates are what it comes to fix.
  */}
  <section id="dates" class="mt-8">
  <div class="rounded-xl border border-ink-100 bg-white p-5">
    <details open={datesOpen} class="group">
      <summary class={summaryRow}>
        <h2 class="text-lg font-semibold tracking-tight">Compliance dates</h2>
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={chevron}
        >
          <path d="M5 8l5 5 5-5"></path>
        </svg>
        <span class="ml-auto text-sm font-medium text-brand-700 group-open:hidden">Change</span>

        {/*
          THE COUNT THE OLD SIDEBAR CARD CARRIED, SAID WHERE THE BOXES ARE.

          A closed fold has to answer the question it is hiding. This one says
          how many of the dates we expect from every driver are still blank —
          the same `missing` count, now beside the form that fills them in
          instead of in a card on the other side of the screen.
        */}
        <span class="w-full text-sm">
          {missing.length > 0 ? (
            /* The count, not the list. The checklist above already names every
               one of these in the rule's own words, with a link to the box —
               printing the labels again here is the same gap said twice on one
               screen, which teaches him that one of the two is not worth
               reading. */
            <span>
              <span class="font-medium tabular-nums">{missing.length}</span>
              {missing.length === 1
                ? ' date we expect from every driver is not recorded.'
                : ' dates we expect from every driver are not recorded.'}
            </span>
          ) : (
            <span class="text-ink-500">Every date we expect from a driver is recorded.</span>
          )}
        </span>
      </summary>

      <form method="POST" class="mt-5 space-y-4 border-t border-ink-100 pt-5">
        <p class="max-w-3xl text-sm text-ink-500">
          These are the dates we count the deadlines from. We save each one as a new entry instead
          of replacing the old one, because an expired medical card is the proof this driver was
          qualified while it ran. A blank box changes nothing. To fix a date, type the new one over
          the old one.
        </p>

        {
          DRIVER_ANCHOR_GROUPS.map((group) => {
            /*
              A GROUP NOBODY HAS TO ANSWER FOLDS ITSELF.

              Every box in "Exemptions and waivers" is blank for almost every
              driver, and the four of them were 614px of a 2,220px form — a
              quarter of the tallest thing on the page, asking about a Skill
              Performance Evaluation certificate that well under 1% of drivers
              hold. A group folds only when EVERY box in it is optional AND
              every one is empty: a date already recorded is never folded away,
              because a date on file is the answer somebody came to read.
            */
            const blankOptional =
              !group.anchors.some((a) => a.key === wantedBox) &&
              group.anchors.every(
                (a) =>
                  a.expected === 'only_if_it_applies' &&
                  !current.has(anchorSlot('driver', id, a.key)),
              )
            return (
              <div class={card}>
                {/* The same heading the truck page gives its date groups. The two
                    pages had two different treatments for one thing — 16px black here,
                    12px grey uppercase there — on screens an owner moves between all
                    morning. */}
                <details open={!blankOptional} class="group/field">
                  <summary class={summaryRow}>
                    <h3 class={cardHeading}>{group.name}</h3>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-4 shrink-0 text-ink-500 transition-transform group-open/field:rotate-180"
                    >
                      <path d="M5 8l5 5 5-5"></path>
                    </svg>
                    {blankOptional && (
                      <span class="ml-auto text-xs text-ink-700">
                        Leave blank unless he holds one
                      </span>
                    )}
                  </summary>
                  <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    {group.anchors.map((anchor) => (
                      /* The id is what "Add the date →" in the checklist lands
                         on, so the box a row asks for is the box he sees. */
                      <label id={`date_${anchor.key}`} class="block">
                        <span class="field-label">{anchor.label}</span>
                        <input
                          type="date"
                          name={`date_${anchor.key}`}
                          value={current.get(anchorSlot('driver', id, anchor.key))?.occurred_on ?? ''}
                          max={anchor.kind === 'last_done' ? today : undefined}
                          class="field-input mt-1 tabular-nums"
                        />
                        <span class="field-hint block">{anchor.help}</span>
                      </label>
                    ))}
                  </div>
                </details>
              </div>
            )
          })
        }

        {/*
          THE ROWS THE TWELVE BOXES ABOVE CANNOT ANSWER.

          These are the questions the engine files under a rule code rather than
          an anchor — "was the road test passed", not "when does his card
          expire". Four of them appear the moment a hire date is on file, and
          before this card they were four rows in the checklist above saying a
          date was missing with nowhere on the page to type it.

          They are in THIS form and not on another screen. The dashboard has
          been able to ask them all along, and sending her there would have been
          a different page, a different save, and no way back to the driver. The
          questions are read out of the same registry the dashboard reads, so
          the two screens ask one question rather than two that can drift.

          A FOLD, ON THE SAME RULE AS THE GROUPS ABOVE: it closes only when
          every box in it is optional AND empty, because a date already recorded
          is the answer somebody came to read, and an outstanding question is
          the reason this card exists.
        */}
        {
          unboxed.length > 0 && (
            <div class={card}>
              {(() => {
                const blankOptional =
                  !unboxed.some((q) => q.key === wantedBox) &&
                  unboxed.every((q) => q.expected === 'only_if_it_applies' && q.on === '')
                return (
                  <details open={!blankOptional} class="group/field">
                    <summary class={summaryRow}>
                      <h3 class={cardHeading}>{UNBOXED_HEADING}</h3>
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-4 shrink-0 text-ink-500 transition-transform group-open/field:rotate-180"
                      >
                        <path d="M5 8l5 5 5-5" />
                      </svg>
                      {blankOptional && (
                        <span class="ml-auto text-xs text-ink-700">
                          Leave blank unless it applies
                        </span>
                      )}
                    </summary>
                    <p class="mt-3 max-w-3xl text-sm text-ink-500">{UNBOXED_LEAD}</p>
                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                      {unboxed.map((q) => (
                        /* The id is what the checklist row above lands on, so
                           the box a row asks for is the box she sees. */
                        <label id={q.domId} class="block">
                          <span class="field-label">{q.label}</span>
                          <input
                            type="date"
                            name={q.field}
                            value={q.on}
                            min="1900-01-01"
                            max={q.kind === 'last_done' ? today : undefined}
                            class="field-input mt-1 tabular-nums"
                          />
                          <span class="field-hint block">{q.help}</span>
                        </label>
                      ))}
                    </div>
                  </details>
                )
              })()}
            </div>
          )
        }

        <div
          class="sticky bottom-0 flex flex-wrap items-center gap-3 rounded-xl border border-ink-100 bg-white/95 p-4 backdrop-blur"
        >
          <span class="flex-1 text-sm text-ink-500">
            Only the boxes you changed are written. Blank boxes are left alone.
          </span>
          <button type="submit" name="intent" value="save_dates" class="btn btn-primary">
            Save dates
          </button>
        </div>
      </form>
    </details>
  </div>
  </section>

  {/*
    Pay, then the papers. This is the other half of what the office opens a
    driver for, and it stays above the documents because a settlement is looked
    at weekly and a filed medical card is looked at when somebody asks for it.
  */}
  <section class="mt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 class="text-lg font-semibold tracking-tight">Pay</h2>
      {/*
        Both links, because until now this page had neither. The rates-and-terms
        page was reachable ONLY from inside a settlement, so the way to check
        what a driver is on was to open a statement for a period he had already
        been paid for.
      */}
      <div class="flex flex-wrap items-center gap-2">
        <a href={`/app/drivers/${id}/pay`} class="btn btn-tertiary btn-sm">Rates and terms →</a>
        <a href={`/app/settlements?driver=${id}`} class="btn btn-tertiary btn-sm">
          All settlements →
        </a>
      </div>
    </div>

    {
      settlements.length === 0 ? (
        <div class="mt-3 rounded-xl border border-dashed border-ink-100 bg-white p-6 text-center">
          <p class="text-sm text-ink-500">
            No settlement has been started for this driver. A settlement is the statement that
            goes with the cheque. It is not payroll, and nothing here withholds tax.
          </p>
          {/* His terms first, then the statement: a settlement built before the
              rate and the mileage basis are on file is a settlement somebody
              types the linehaul into by hand. */}
          <a href={`/app/drivers/${id}/pay`} class="btn btn-secondary btn-sm mt-3">
            Set his rates →
          </a>
        </div>
      ) : (
        <div class:list={['mt-3 grid gap-4', hasPaid && 'lg:grid-cols-2']}>
          {hasPaid && (
            <Figure
              title="Paid, by month"
              subtitle="Settlements marked paid, in the month the money moved"
              coverage={monthCoverage}
            >
              <Columns
                columns={monthly.buckets.map((b, i) => {
                  const v = monthly.values[i]
                  return {
                    label: b.label,
                    value: v,
                    // Full, not compact, and the old comment here was wrong
                    // about its own page. It claimed the cent-exact figures sit
                    // "in the table beside it" — the table beside it is Recent
                    // settlements, which lists INDIVIDUAL statements, not month
                    // totals. So the exact figure for a month appeared nowhere,
                    // and `display` is also the whole of the column's
                    // aria-label: a screen reader said "$14.3k" and stopped.
                    //
                    // This is a man's pay. Rounding it is the one place in this
                    // app where a compact number is least defensible.
                    display: v === null ? '—' : formatCents(v),
                    // The trailing month is the one we are standing in, so it is
                    // short by however much of it is left — every load, all month.
                    inProgress: i === monthly.buckets.length - 1,
                  }
                })}
                max={monthlyCeiling}
                axisLabel={`Full height ${compactMoney(monthlyCeiling)}`}
                emptyMessage="Nothing marked paid in the last six months."
              />
              <p class="mt-3 text-xs text-ink-700">
                {ytd.cents === null
                  ? `Nothing marked paid in ${payYear} yet.`
                  : `${formatCents(ytd.cents)} paid in ${payYear}, across ${ytd.settlements} ${ytd.settlements === 1 ? 'settlement' : 'settlements'}.`}
              </p>
            </Figure>
          )}

          <div class={card}>
            <h3 class={cardHeading}>Recent settlements</h3>
            <table class="mt-3 w-full text-sm">
              <tbody class="divide-y divide-ink-100">
                {recent.map((s) => (
                  /* Dimmed, not hidden, and the same treatment the settlements
                     list gives it: a statement that was replaced is still a
                     statement the driver was handed, and he rings about it. */
                  <tr class:list={[s.superseded_at && 'opacity-60']}>
                    <td class="py-2">
                      {/* .link-row: the record name in a row is a 44px target. */}
                      <a href={`/app/settlements/${s.id}`} class="link-row tabular-nums">
                        {formatDate(s.period_start)} – {formatDate(s.period_end)}
                      </a>
                      {/* `whitespace-nowrap` on the badge because this card is
                          three columns inside 301px on a phone, and without it
                          the badge broke across two lines as "rev" then "3". */}
                      {s.revision > 1 && (
                        <span class="badge badge-neutral ml-2 tabular-nums">rev {s.revision}</span>
                      )}
                      {s.superseded_at && (
                        <span class="block text-xs text-ink-700">
                          Replaced by a later revision
                        </span>
                      )}
                    </td>
                    <td class="py-2">
                      {/* `settlementStatusPillClass` returns a `badge badge-*`
                          pair of its own — one badge construction for the app. */}
                      <span class={settlementStatusPillClass(s.status)}>
                        {settlementStatusLabel(s.status)}
                      </span>
                    </td>
                    {/*
                      Exact cents, always, and labelled with which kind of number
                      it is: a locked settlement shows what was paid, an open one
                      shows what its lines add up to right now and can still move.
                    */}
                    <td class="py-2 text-right whitespace-nowrap">
                      <span class="font-medium tabular-nums">{formatCents(s.net.cents)}</span>
                      <span class="block text-xs text-ink-700">
                        {s.net.frozen ? 'as paid' : 'from the lines'}
                      </span>
                      {s.net.drift && (
                        <span class="badge badge-danger mt-1">does not match its lines</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {settlements.length > recent.length && (
              <p class="mt-3 text-xs text-ink-700">
                The six most recent. The rest are on the settlements list.
              </p>
            )}
          </div>
        </div>
      )
    }
  </section>

  {/*
    The papers, under the dates, the same order the truck page uses: the date
    says the physical happened, the file is the card that proves it.
  */}
  <Documents subjectType="driver" subjectId={id} documents={documents} noun="this driver" />

  <!-- ----------------------------------------------------------- history -->

  {/*
    EVERY DATE EVER RECORDED, AND THE ONLY WAY BACK FROM A TYPO.

    The truck page has had this since it was written; the driver page had
    nothing of the kind, and that was not only a cosmetic split. `save_dates`
    corrects a date by typing a newer one over it, and the LATEST date wins — so
    a medical card entered as 2027 when the card says 2017 could not be fixed on
    this page at all. It can now, the same way it is fixed on a truck: withdraw
    the wrong entry and the next most recent date becomes the live one again.
  */}
  {
    history.length > 0 && (
      <section id="history" class="mt-8">
        <div class={card}>
          {/*
            FOLDED, BECAUSE IT IS A LOG AND IT ONLY GROWS.

            Every date ever recorded, withdrawn ones included — which is right,
            and which means a driver of three years carries a table nobody walks
            past on purpose. It is opened when a date on the page looks wrong,
            so it opens on its own in the two cases where that has just
            happened: a withdrawal went through, or one was refused. The count
            is in the summary, so the closed fold still says how much is in it.
          */}
          <details open={historyOpen} class="group">
            <summary class={summaryRow}>
              <h2 class="text-lg font-semibold tracking-tight">Everything recorded for this driver</h2>
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={chevron}
              >
                <path d="M5 8l5 5 5-5"></path>
              </svg>
              <span class="ml-auto text-sm text-ink-500">
                <span class="tabular-nums">{history.length}</span>
                {history.length === 1 ? ' entry' : ' entries'}
              </span>
            </summary>
          <p class="mt-3 text-sm text-ink-500">
            We keep old dates instead of replacing them. An old date is the proof this driver was
            qualified during the time it covered. The <strong>latest date</strong> is the one we
            use, not the one you typed last. So to move a date to an EARLIER one, withdraw the
            wrong entry first.
          </p>

          <div class="mt-4 overflow-x-auto rounded-xl border border-ink-100">
            <table class="w-full text-sm sm:min-w-[46rem]">
              {/*
                No header line on a phone. Four column names above blocks that
                are not columns explain nothing — each block says what it is in
                its own words instead.
              */}
              <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
                <tr>
                  <th class="px-4 py-3 font-medium">What</th>
                  <th class="px-4 py-3 font-medium">Date</th>
                  <th class="px-4 py-3 font-medium">Recorded</th>
                  <th class="px-4 py-3 font-medium">Source</th>
                  <th class="px-4 py-3" />
                </tr>
              </thead>
              <tbody class="divide-y divide-ink-100">
                {history.map((r) => {
                  /*
                    BY SLOT, NOT BY THE BARE ANCHOR KEY. `current` is keyed by
                    `anchorSlot('driver', id, key)` because the planner it feeds
                    is shared with the dashboard, where one submit spans the
                    whole fleet. Looked up by `r.anchor_key` alone this never
                    matches and not one row is ever badged "in force" — the same
                    trap that once made every date on this page read as missing.
                  */
                  const inForce =
                    current.get(anchorSlot('driver', id, r.anchor_key))?.id === r.id
                  return (
                    /* The block leads with WHAT the date is for, because that is
                       what somebody is looking down this list for. The date and
                       the badge that says whether it is the one in force follow
                       it on the next line. */
                    <tr class="block py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                      <td class={cell}>
                        <span class="font-medium">{driverAnchorLabel(r.anchor_key)}</span>
                        {r.note && <span class="mt-0.5 block text-xs text-ink-700">{r.note}</span>}
                      </td>
                      <td class={`${cell} mt-1 whitespace-nowrap tabular-nums sm:mt-0`}>
                        <span class:list={[r.superseded_at ? 'text-ink-500 line-through' : '']}>
                          {formatDate(r.occurred_on)}
                        </span>
                        {inForce && <span class="badge badge-success ml-2">in force</span>}
                        {r.superseded_at && (
                          <span class="badge badge-neutral ml-2">withdrawn</span>
                        )}
                      </td>
                      {/*
                        The date keeps its own `nowrap`; the line it sits on does
                        not. Run together as one unbreakable string this cell is
                        wider than the card on a phone — one pixel of sideways
                        scroll, which is the whole bug in miniature.
                      */}
                      <td
                        class={`${cell} mt-0.5 text-xs text-ink-700 tabular-nums sm:mt-0 sm:text-sm sm:whitespace-nowrap`}
                      >
                        <span class="whitespace-nowrap">
                          <span class={said}>Recorded </span>
                          {formatDate(String(r.recorded_at).slice(0, 10))}
                        </span>
                        <span class="sm:hidden">
                          {' · '}
                          {r.source === 'fmcsa'
                            ? 'Federal record'
                            : r.source === 'import'
                              ? 'Import'
                              : 'You'}
                        </span>
                      </td>
                      {/* The source, on its own line from `sm` up and folded
                          into the line above on a phone: two words on a line of
                          their own is a line an owner skips. */}
                      <td class="hidden px-4 text-ink-700 sm:table-cell sm:py-3">
                        {r.source === 'fmcsa' ? 'Federal record' : r.source === 'import' ? 'Import' : 'You'}
                      </td>
                      <td class={`${cell} sm:text-right sm:whitespace-nowrap`}>
                        {!r.superseded_at && (
                          /* Below `sm` this is a full-width bordered tap rather
                             than a bare text link. It would otherwise be off the
                             right edge of the screen entirely. */
                          <form method="POST" class="mt-2 sm:mt-0">
                            <input type="hidden" name="record_id" value={r.id} />
                            {/*
                              Red, and red is right here: withdrawing a date is
                              the one destructive thing in this table. It keeps
                              the full 44px on every screen — the desktop rule
                              used to shrink it to a bare line of text.
                            */}
                            <button
                              type="submit"
                              name="intent"
                              value="withdraw_date"
                              class="btn btn-danger-text btn-sm w-full sm:w-auto"
                            >
                              Withdraw
                            </button>
                          </form>
                        )}
                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
          </details>
        </div>
      </section>
    )
  }

  <!-- ------------------------------------------------------------ delete -->

  {/*
    LAST ON THE PAGE, AND CLOSED BY DEFAULT.

    For one thing only: a driver somebody typed twice, or a row made while
    learning the screen. A real driver refuses, and the refusal says what to do
    instead. src/lib/fleet/remove.ts holds the list and the words;
    0028_fleet_delete_guard.sql holds the same list in the database.
  */}
  <section id="delete" class="mt-8">
    {
      !wantsDelete ? (
        <div class={card}>
          <h2 class="text-lg font-semibold tracking-tight">Delete this driver</h2>
          <p class="mt-1 max-w-2xl text-sm text-ink-500">
            Only for a driver you added by mistake. If he left, set his status to Terminated
            above. That takes him off your reminders and keeps his file.
          </p>
          {/*
            NOT RED. This link deletes nothing — it opens the panel that asks.
            Red is kept for the button that actually removes him, two steps on,
            so that when red does appear it still means something.
          */}
          <a href={`/app/drivers/${id}?confirm=delete#delete`} class="btn btn-secondary btn-sm mt-4">
            Delete this driver
          </a>
        </div>
      ) : refusal ? (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
          <h2 class="text-lg font-semibold tracking-tight text-amber-900">{refusal.title}</h2>
          {refusal.held.length > 0 && (
            <>
              <p class="mt-2 text-sm text-amber-900">What is on file:</p>
              <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-amber-900">
                {refusal.held.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </>
          )}
          <p class="mt-3 text-sm text-amber-900">{refusal.why}</p>
          {/* The dead end is also the answer. */}
          <p class="mt-2 text-sm font-medium text-amber-900">{refusal.instead}</p>
          <a href={`/app/drivers/${id}`} class="btn btn-secondary btn-sm mt-4">Go back</a>
        </div>
      ) : (
        <div class="rounded-xl border border-red-200 bg-red-50 p-5">
          {/* The confirmation NAMES THE DRIVER. A red button that says only
              "Delete" is a button pressed on the wrong row. */}
          <h2 class="text-lg font-semibold tracking-tight text-red-800">
            {confirmTitle(fullName(driver))}
          </h2>
          <p class="mt-2 text-sm text-red-700">{confirmBody('driver')}</p>
          {alsoGoes && <p class="mt-2 text-sm font-medium text-red-700">{alsoGoes}</p>}
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <form method="POST">
              {/* The one irreversible button on the page, and the only red one. */}
              <button type="submit" name="intent" value="delete" class="btn btn-danger">
                Yes, delete {fullName(driver)}
              </button>
            </form>
            {/* The way out of a destructive panel is never red. */}
            <a href={`/app/drivers/${id}`} class="btn btn-secondary">Keep him</a>
          </div>
        </div>
      )
    }
  </section>
</App>
