---
/**
 * The customer book: every broker and shipper we haul for.
 *
 * Search is a plain GET parameter, so a filtered view is a URL she can bookmark
 * or text to the owner, and the page works on one bar of signal in a yard.
 * Nothing here runs JavaScript.
 */
import Bars from '../../../components/charts/Bars.astro'
import Figure from '../../../components/charts/Figure.astro'
import {
  type DatedLoad,
  agingSource,
  daysWord,
  receivablesAging,
  receivablesByCustomer,
} from '../../../lib/charts/receivables.ts'
import { type RevenueLoad, topCustomers } from '../../../lib/charts/revenue.ts'
import App from '../../../layouts/App.astro'
import { searchFilter } from '../../../lib/customers.ts'
import { formatCents } from '../../../lib/loads.ts'
import { formatPhone } from '../../../lib/phone.ts'

const supabase = Astro.locals.supabase!

const params = Astro.url.searchParams
const q = (params.get('q') ?? '').trim()

/**
 * The shape we read. Written out rather than inferred, because an untyped
 * Supabase client hands back `any` and a mistyped column then renders as an
 * empty cell — indistinguishable on screen from a field nobody filled in.
 */
interface ListRow {
  id: string
  name: string
  mc_number: string | null
  contact_name: string | null
  phone: string | null
  days_to_pay: number | null
  /** PostgREST's embedded aggregate. Absent entirely on the fallback query. */
  loads?: { count: number }[] | null
}

const COLUMNS = 'id, name, mc_number, contact_name, phone, days_to_pay'
// `loads(count)` counts in Postgres over the foreign key from 0009_loads.sql.
// The alternative — a count query per customer — is forty round trips on a page
// that should be one, and the alternative to THAT (pulling every load row and
// counting in JavaScript) grows without limit as the carrier does.
const COLUMNS_WITH_COUNT = `${COLUMNS}, loads(count)`

// There is no .eq('carrier_id', ...) on this page. RLS already limits every row
// to the signed-in user's carrier, and repeating the check in the query reads as
// though the policy might not hold — which is how somebody eventually "fixes" a
// bug by loosening the policy instead of the query.
function build(select: string) {
  let query = supabase.from('customers').select(select).order('name', { ascending: true })
  const filter = searchFilter(q)
  if (filter) query = query.or(filter)
  return query
}

/**
 * The revenue behind the ranking, asked for only on the resting view.
 *
 * Never over a search result: the chart would rank the three brokers whose
 * names happen to contain the letters she typed, under a heading that says
 * "top customers", which is a different and false claim. Skipping the query
 * entirely rather than hiding the chart also means a search costs no extra
 * round trip.
 *
 * ALL loads, not the last twelve months, and that is deliberate. Concentration
 * is a property of the book as a whole — a broker who was eighty percent of the
 * business until nine months ago is exactly the risk that has just
 * materialised, and a rolling window would hide them the moment they stopped
 * calling. The subtitle says which span this is, because the charts on
 * /app/loads say twelve months and two spans on one product is a thing a reader
 * has to be told rather than left to discover.
 */
const unfiltered = q === ''

// `billing` and `created_at` ride along for the receivables bands below. One
// query, two findings: the ranking reads the money columns and the aging reads
// the billing state and the date. A second request for the same rows would be a
// second population to keep in step, and the two charts would eventually
// disagree.
const LOAD_COLUMNS =
  'customer_id, status, exception, billing, linehaul_cents, fuel_surcharge_cents, accessorials_cents, created_at'
// The two dates 0029_load_invoice_dates.sql adds. Asked for first, because the
// invoice date is the day the receivables clock ACTUALLY starts.
const LOAD_COLUMNS_WITH_DATES = `${LOAD_COLUMNS}, invoiced_on, paid_on`

/**
 * The revenue rows, asked for with the invoice dates and again without them.
 *
 * 0029 IS WRITTEN AND NOT YET APPLIED, so on this database the two columns do
 * not exist and PostgREST answers the first request with "column loads.
 * invoiced_on does not exist" — which would take the ranking, the concentration
 * finding and the whole receivables section off this page over a column that is
 * an improvement rather than a requirement. So it asks again without them and
 * everything ages from the day the load was entered exactly as it did before,
 * with `agingSource` saying so on screen. The same fallback is what makes the
 * day the migration IS applied a silent improvement rather than a deployment.
 *
 * The count is exact, so the ranking can tell whether PostgREST's row cap ate
 * anything. A capped response makes every bar shorter than it should be and,
 * worse, shifts the concentration share — with nothing on the page to say a
 * load was missing.
 */
async function loadRows() {
  if (!unfiltered) return null
  const withDates = await supabase.from('loads').select(LOAD_COLUMNS_WITH_DATES, { count: 'exact' })
  if (!withDates.error) return withDates
  return await supabase.from('loads').select(LOAD_COLUMNS, { count: 'exact' })
}

const [first, { count: totalCount }, revenueResult] = await Promise.all([
  build(COLUMNS_WITH_COUNT),
  // The unfiltered count exists so the empty state can tell the truth. "No
  // customers yet" on a book of thirty, none of whom match the search, sends
  // her to the add form to re-type a broker who is already in here.
  supabase.from('customers').select('*', { count: 'exact', head: true }),
  loadRows(),
])

/**
 * The count is a bonus; the customer book is not.
 *
 * Embedded aggregates are a PostgREST feature a project can have switched off,
 * and if it is, the query above fails outright. Losing the load counts is a
 * shrug. Losing the list — every phone number and payment term she has — because
 * of a decorative column is not, so the fallback re-asks without it and the
 * counts then render as "—" rather than as zero. A zero we did not measure is
 * the same class of lie as a clean bill of health we did not check.
 */
let rows = (first.data ?? []) as unknown as ListRow[]
let error = first.error
let countsAvailable = true

if (first.error) {
  const plain = await build(COLUMNS)
  rows = (plain.data ?? []) as unknown as ListRow[]
  error = plain.error
  countsAvailable = false
}

function loadCountOf(row: ListRow): number | null {
  if (!countsAvailable) return null
  // PostgREST hands the aggregate back as a one-element array, `[{count: 3}]`,
  // and a customer with no loads at all comes back as `[]` on some versions and
  // `[{count: 0}]` on others. Both mean nothing has been hauled for them yet.
  if (!Array.isArray(row.loads)) return 0
  return row.loads[0]?.count ?? 0
}

const notice = params.get('error') ?? (error ? error.message : null)

/**
 * Concentration risk, which an alphabetical list cannot show.
 *
 * This is the one thing on this page that is worth more than the phone numbers.
 * A carrier taking seventy percent of his revenue from one broker is one lost
 * contract from closing, and in a book sorted by name that fact is spread
 * across forty rows and invisible. The bars put it in one shape; the sentence
 * under them says the number out loud, because colour and length are not
 * allowed to be the only carriers of a finding.
 *
 * `rows` is the same array the table below renders, so a customer in one and
 * not the other is impossible.
 */
const revenueFailed = Boolean(revenueResult?.error)
const ranking =
  revenueResult && !revenueResult.error
    ? topCustomers((revenueResult.data ?? []) as unknown as RevenueLoad[], rows)
    : null

const loadWord = (n: number) => (n === 1 ? 'load' : 'loads')

// Loads the response could not carry. See the note on the count above.
const missing = Math.max(
  0,
  (revenueResult?.count ?? revenueResult?.data?.length ?? 0) - (revenueResult?.data?.length ?? 0),
)

/**
 * How a customer's terms read on one line under their bar.
 *
 * "TERMS: NET 30", NOT "PAYS IN 30 DAYS". The old wording read as a measured
 * fact about this broker's behaviour. It is nothing of the kind — it is the
 * sentence on their rate confirmation, which is exactly the thing an owner
 * needs to keep separate from what they actually do. "Net 30" is also what the
 * industry says and what the rate confirmation itself says, so it is the phrase
 * the reader already recognises.
 *
 * NULL and 0 are different facts and get different sentences — 0 is payment on
 * delivery, the best terms in the industry, and NULL is a question nobody has
 * asked them. Collapsed into one number the broker who never answered would sit
 * beside the best payer on the book.
 */
const termsNote = (days: number | null): string => {
  if (days === null) return 'terms not recorded'
  if (days === 0) return 'terms: on delivery'
  return `terms: net ${days}`
}

/**
 * What the bars do not cover.
 *
 * `unattributedCents` is the clause that matters. The share below is computed
 * over revenue we could attribute to somebody, so every load booked without a
 * customer on it makes that percentage larger than the truth. Left unsaid, a
 * carrier with half his loads unattributed would read a 70% concentration that
 * is really 35%.
 */
const rankingCoverage = ranking
  ? [
      'Booked rates on every load on file, not money received.',
      ranking.unattributedLoads > 0 &&
        `${formatCents(ranking.unattributedCents)} across ${ranking.unattributedLoads} ${loadWord(ranking.unattributedLoads)} has no customer on it. That money is in no bar and out of the share below, so the share looks higher than it really is.`,
      ranking.unpricedLoads > 0 &&
        `${ranking.unpricedLoads} ${loadWord(ranking.unpricedLoads)} carry no rate yet and are in nobody's total. A load with no rate is not a $0 load.`,
      ranking.quotedLoads + ranking.cancelledLoads > 0 &&
        `${ranking.quotedLoads + ranking.cancelledLoads} quoted or cancelled ${loadWord(ranking.quotedLoads + ranking.cancelledLoads)} are left out. Neither one is money anyone owes.`,
      missing > 0 &&
        `${missing} ${loadWord(missing)} did not fit in one request. They are in no bar and in no share.`,
    ]
      .filter(Boolean)
      .join(' ')
  : undefined

/**
 * WHAT YOU ARE OWED, AND HOW STALE IT IS.
 *
 * The book says who they are and what they promised. The ranking above says
 * who the work comes from. Neither says the thing an owner loses sleep over —
 * how much is out, and how long it has been out — because that is a sum across
 * every load, cut by age, and it exists nowhere else in this product.
 *
 * Drawn from the SAME rows as the ranking, so the two cannot disagree, and on
 * the resting view only, for the same reason the ranking is: a receivables
 * total drawn from a search result is not a truncated answer, it is a wrong one.
 *
 * THE CLOCK STARTS ON A DAY THIS SCREEN NAMES. A load that carries an invoice
 * date is counted from that date; a load with none is counted from the day it
 * was ENTERED, which is always older than the invoice behind it. `agingSource`
 * writes out which rows are which and how many of each, and it leads the
 * coverage note rather than sitting at the end of it — an owner who reads "more
 * than 90 days" here and repeats it to a broker whose invoice went out three
 * weeks ago has been handed an argument he loses.
 */
const revenueLoads =
  revenueResult && !revenueResult.error
    ? ((revenueResult.data ?? []) as unknown as DatedLoad[])
    : null
const now = new Date()
const aging = revenueLoads ? receivablesAging(revenueLoads, now) : null
const owed = revenueLoads ? receivablesByCustomer(revenueLoads, rows, now) : null

// Only the ones past the chase line, most money first. The rest of the book is
// out on ordinary terms and does not need naming.
const chaseRows =
  aging && owed
    ? owed.rows.filter((r) => (r.oldestDays ?? 0) > aging.chaseAfterDays).slice(0, 5)
    : []

const agingCoverage = aging
  ? [
      agingSource(aging),
      'Only loads marked invoiced, with the factor, or funded. Anything you have not invoiced yet is not on these bars.',
      aging.unpricedLoads > 0 &&
        `${aging.unpricedLoads} ${loadWord(aging.unpricedLoads)} still out carry no rate yet, so the amounts are lower than the real figures. A load with no rate is not a $0 load.`,
      aging.undatedLoads > 0 &&
        `${aging.undatedLoads} ${loadWord(aging.undatedLoads)} still out have no readable date and are in no band.`,
      owed && owed.unattributedLoads > 0 &&
        `${formatCents(owed.unattributedCents)} across ${owed.unattributedLoads} ${loadWord(owed.unattributedLoads)} has no customer on it, so it is on the bars but in nobody's name below.`,
      missing > 0 &&
        `${missing} ${loadWord(missing)} did not fit in one request and are on no bar here.`,
    ]
      .filter(Boolean)
      .join(' ')
  : undefined

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * The book is 52rem wide and the window on a 375px phone is about 341px, so
 * over half of every row — the phone number among it — was behind a sideways
 * scroll. Below `sm` every cell becomes a block; from `sm` the same markup is a
 * table again. ONE set of cells, not two: a second copy of a row is a second
 * place to forget a rule. The pattern is written down in
 * src/components/Documents.astro.
 *
 * THE BLOCKS ARE ORDERED, WHICH IS THE ONE ADDITION TO THAT PATTERN. This book
 * is opened on a phone to ring somebody about a load or a cheque, so the number
 * and the name of the person to ask for come straight under the company — they
 * were fourth and third, with the MC number, which nobody dials, above both.
 * `order-*` needs the row to be a flex column below `sm`; from `sm` it is
 * `table-row` again and the property is ignored, so the desktop table is
 * untouched and the header row still names the columns in their own order.
 */
const cell = 'block px-4 sm:table-cell sm:py-3'
/** The column name, said on the block that has no column. */
const said = 'text-ink-500 sm:hidden'

const topName = ranking?.rows[0]?.name ?? ''
const concentration =
  !ranking || ranking.topShare === null
    ? null
    : ranking.rows.length === 1
      ? `Every dollar you have priced came from ${topName}. One customer is the whole book.`
      : ranking.topShare >= 50
        ? `${topName} is ${ranking.topShare}% of the revenue we can match to a customer. If you lose this one broker, you lose most of the business. Worth knowing before your next rate talk, not after it.`
        : `${topName} is your largest customer, at ${ranking.topShare}% of the revenue we can match to a customer.`
---

<App title="Customers" subtitle="The brokers and shippers you haul for, and how they pay.">
  {notice && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{notice}</p>}

  {/*
    The search box wears .field-input from global.css: the visible border
    (ink-500, not the old invisible ink-100), 16px type so iOS does not zoom the
    page on a tap, and the one global :focus-visible ring. The utilities on it
    only change the shape and make room for the icon.
  */}
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center">
    <form method="GET" class="relative flex-1">
      <svg
        class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-ink-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Search by company name or MC number…"
        aria-label="Search customers"
        class="field-input rounded-xl py-3 pr-4 pl-10"
      />
    </form>
    {/* A link, because it goes somewhere. It wears the Primary button because
        it is the one action on this screen. */}
    <a href="/app/customers/new" class="btn btn-primary shrink-0">Add a customer</a>
  </div>

  {
    !countsAvailable && (
      <p class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
        We could not read the load counts just now, so they show as —. Everything else on this
        page is current.
      </p>
    )
  }

  {
    revenueFailed && (
      <p class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
        We could not read the revenue just now, so the ranking is not on this page. This does not
        mean nobody has paid you. It means we have no answer.
      </p>
    )
  }

  {
    /*
      Above the book, and only on the resting view. The doctrine's rule about
      never charting a filtered list applies twice as hard here: a ranking
      headed "top customers" drawn from a search result is not a truncated
      answer, it is a wrong one.
    */
  }
  {
    ranking && ranking.rows.length > 0 && (
      <Figure
        class="mb-6"
        title="Who the money comes from"
        subtitle="Booked rates across every load on file, largest first"
        coverage={rankingCoverage}
      >
        <Bars
          items={ranking.rows.map((r) => ({
            label: r.name,
            // `null` for a customer whose loads all lack a rate. Bars draws
            // that as a dashed empty slot rather than a zero-width bar, because
            // a broker we have not finished entering must not rank below one we
            // genuinely earn nothing from.
            value: r.cents,
            display: r.cents === null ? 'no rate yet' : formatCents(r.cents),
            note: `${r.countedLoads + r.unpricedLoads} ${loadWord(r.countedLoads + r.unpricedLoads)} · ${termsNote(r.daysToPay)}`,
            href: `/app/customers/${r.id}`,
          }))}
          limit={8}
          moreHref="#customer-book"
        />
        {concentration && (
          /* The finding, written out. A long bar is a shape, and a shape is not
             a number — the sentence is what survives being read on a phone in
             the sun by somebody who cannot separate two similar lengths. */
          <p class="mt-4 border-t border-ink-100 pt-3 text-sm text-ink-700">{concentration}</p>
        )}
        {/* The way out of the chart and into the rows. A Tertiary button rather
            than a 12px line of blue text in the figure header: it is an action,
            it is tapped with a thumb, and 44px is the floor for anything that
            is. */}
        <a href="#customer-book" class="btn btn-tertiary btn-sm mt-2 -ml-3">
          See the whole book <span aria-hidden="true">→</span>
        </a>
      </Figure>
    )
  }

  {
    rows.length === 0 ? (
      (totalCount ?? 0) === 0 ? (
        <div class="rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
          <p class="font-medium">No customers yet</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
            Add the brokers and shippers you book with. A company name is enough to start. The MC
            number and their payment terms can follow the first rate confirmation.
          </p>
          <a href="/app/customers/new" class="btn btn-primary btn-sm mt-4">
            Add a customer <span aria-hidden="true">→</span>
          </a>
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
          <p class="font-medium">Nobody matches that search</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
            You have <span class="tabular-nums">{totalCount}</span> customers on file. None of them
            match “{q}” by name or MC number.
          </p>
          <a href="/app/customers" class="btn btn-secondary btn-sm mt-4">Show everyone</a>
        </div>
      )
    ) : (
      <>
        <p class="mb-3 text-sm text-ink-500">
          <span class="tabular-nums">{rows.length}</span>
          {rows.length === 1 ? ' customer' : ' customers'}
        </p>

        <div id="customer-book" class="overflow-x-auto rounded-xl border border-ink-100 bg-white">
          <table class="w-full text-sm sm:min-w-[52rem]">
            {/*
              No header line on a phone. Six column names above blocks that are
              not columns explain nothing — each block says what it is in its own
              words instead.
            */}
            {/* 12px type, so ink-700 and not ink-500: the floor rises at 12px
                and under, and a column name nobody can read is a table with no
                header at all. */}
            <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
              <tr>
                <th class="px-4 py-3 font-medium">Customer</th>
                <th class="px-4 py-3 font-medium">MC number</th>
                <th class="px-4 py-3 font-medium">Contact</th>
                <th class="px-4 py-3 font-medium">Phone</th>
                {/* "Terms", not "Days to pay". What is in this column is what
                    they AGREED to, not what they have been measured doing. */}
                <th class="px-4 py-3 text-right font-medium">Terms</th>
                <th class="px-4 py-3 text-right font-medium">Loads</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-100">
              {rows.map((c) => (
                /* The block leads with the company name. It is the only thing on
                   this row anybody scans a book of forty brokers for, and it is
                   the link to the rest. */
                <tr class="flex flex-col py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                  {/* .link-row is 44px tall, so the name is a thumb target the
                      whole height of the row rather than a 20px line of text.
                      The <tr> itself is deliberately NOT a link: wrapping a row
                      breaks the table navigation a screen-reader user moves
                      through the book with. */}
                  <td class={`${cell} order-1`}>
                    <a href={`/app/customers/${c.id}`} class="link-row">{c.name}</a>
                  </td>
                  {/* Last on a phone. An MC number is typed into a lookup, not
                      scanned down a book of forty brokers. */}
                  <td class={`${cell} order-6 mt-1 sm:mt-0`}>
                    <span class={said}>MC </span>
                    {c.mc_number ? (
                      <span class="tabular-nums">{c.mc_number}</span>
                    ) : (
                      <span class="text-ink-500">—</span>
                    )}
                  </td>
                  <td class={`${cell} order-3 mt-1 sm:mt-0`}>
                    <span class={said}>Contact </span>
                    {c.contact_name ?? <span class="text-ink-500">—</span>}
                  </td>
                  {/* SECOND ON A PHONE, with the person to ask for right under
                      it. This is the reason the book is opened standing up. */}
                  <td class={`${cell} order-2 mt-1 whitespace-nowrap tabular-nums sm:mt-0`}>
                    {/* Stored as E.164, read as a person reads it. */}
                    <span class={said}>Phone </span>
                    {c.phone ? formatPhone(c.phone) : <span class="text-ink-500">—</span>}
                  </td>
                  {/* Fourth: the money question, and the one an owner asks
                      before he takes the next load from them. */}
                  <td
                    class={`${cell} order-4 mt-1 whitespace-nowrap tabular-nums sm:mt-0 sm:text-right`}
                  >
                    {
                      /* Blank is "they never told us", and it stays blank. A
                         default of 30 here would be a payment term we invented
                         on a screen the owner uses to decide whether he can
                         afford to take the load.

                         "Net 30" and not "30 days": this is the agreed term off
                         a rate confirmation, written the way the rate
                         confirmation writes it, and it must not be read as how
                         fast this broker has been measured paying. 0 is payment
                         on delivery and gets its own words — "Net 0" is not a
                         thing anybody says. */
                    }
                    <span class={said}>Terms </span>
                    {c.days_to_pay === null ? (
                      <span class="text-ink-500">—</span>
                    ) : c.days_to_pay === 0 ? (
                      <span>On delivery</span>
                    ) : (
                      <>
                        <span class="text-ink-500">Net </span>
                        {c.days_to_pay}
                      </>
                    )}
                  </td>
                  <td class={`${cell} order-5 mt-1 tabular-nums sm:mt-0 sm:text-right`}>
                    <span class={said}>Loads </span>
                    {loadCountOf(c) === null ? (
                      <span class="text-ink-500">—</span>
                    ) : loadCountOf(c) === 0 ? (
                      <span class="text-ink-500">0</span>
                    ) : (
                      loadCountOf(c)
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {/*
    BELOW THE BOOK, not above it.

    This page is a work surface: it is opened standing up, to ring a broker
    about a load or a cheque, and the doctrine in docs/charts.md is measured
    rather than preferred — charts above the rows on /app/loads put the first
    row 1,146px down a phone. The ranking already sits on top because it re-sorts
    the book into an answer the book cannot give. This one is a second answer, so
    it waits its turn.
  */}
  {
    /* Only when something is actually out. Four $0.00 bands on a carrier whose
       first load has not been invoiced yet is furniture, and the loads screen
       is where "nothing is invoiced" belongs. */
    aging && aging.waitingLoads + aging.disputedLoads > 0 && (
      <div class="mt-8">
        <Figure
          title="What you are owed, and how long it has sat"
          subtitle="Loads you have invoiced and not been paid for, by how old the load is"
          coverage={aging.waitingLoads > 0 ? agingCoverage : undefined}
        >
          <Bars
            items={
              aging.waitingLoads === 0
                ? []
                : aging.bands.map((b) => ({
                    label: b.label,
                    value: b.value,
                    // Exact cents, never compact money. This is the figure an
                    // owner reads down the phone to a broker.
                    display: b.display,
                    note:
                      b.loads === 0
                        ? 'Nothing this old'
                        : `${b.loads} ${loadWord(b.loads)}${b.unpricedLoads > 0 ? `, ${b.unpricedLoads} with no rate yet` : ''}`,
                    tone: b.tone,
                  }))
            }
            emptyMessage="Nothing is invoiced and waiting right now. Loads you have not invoiced yet are not counted here."
          />

          {aging.waitingLoads > 0 && (
            /* The finding, written out. A long bar is a shape, and a shape is
               not a number — and roughly one man in twelve cannot separate the
               red band from the amber one. */
            <div class="mt-4 space-y-1.5 border-t border-ink-100 pt-3 text-sm text-ink-700">
              <p>
                <span class="font-semibold tabular-nums">{formatCents(aging.totalCents)}</span> is
                invoiced and not paid, across {aging.countedLoads}{' '}
                {loadWord(aging.countedLoads)}
                {aging.oldestDays !== null && (
                  /* "Has been out", not "was entered": some of these rows are
                     now aged from an invoice date and some from the day the
                     load was typed in. The coverage line above says exactly
                     which, in numbers, and this sentence must not contradict
                     it by naming one of the two. */
                  <>
                    . The oldest has been out{' '}
                    <span class="tabular-nums">{daysWord(aging.oldestDays)}</span>
                  </>
                )}
                .
              </p>
              {(aging.chaseLoads > 0 || aging.chaseUnpricedLoads > 0) && (
                <p class="font-medium text-red-700">
                  {aging.chaseLoads > 0 && (
                    <>
                      <span class="tabular-nums">{formatCents(aging.chaseCents)}</span> of it has
                      been out more than{' '}
                      <span class="tabular-nums">{daysWord(aging.chaseAfterDays)}</span>, on{' '}
                      {aging.chaseLoads} {loadWord(aging.chaseLoads)}.{' '}
                    </>
                  )}
                  {aging.chaseUnpricedLoads > 0 && (
                    <>
                      {aging.chaseUnpricedLoads} more {loadWord(aging.chaseUnpricedLoads)} past that
                      line carry no rate, so {aging.chaseUnpricedLoads === 1 ? 'it is' : 'they are'}{' '}
                      in no figure here.{' '}
                    </>
                  )}
                  Ring them today.
                </p>
              )}
              {aging.disputedLoads > 0 && (
                <p class="font-medium text-red-700">
                  Separately, {aging.disputedLoads} {loadWord(aging.disputedLoads)} are short paid
                  or in dispute: <span class="tabular-nums">{formatCents(aging.disputedCents)}</span>
                  . Those are not on the bars above, because waiting will not fix them.
                </p>
              )}
              {aging.unpricedLoads > 0 && (
                <p class="text-ink-700">
                  {aging.unpricedLoads} {loadWord(aging.unpricedLoads)} still out have no rate typed
                  on {aging.unpricedLoads === 1 ? 'it' : 'them'}. Until{' '}
                  {aging.unpricedLoads === 1 ? 'it has' : 'they have'} one, nobody can say what{' '}
                  {aging.unpricedLoads === 1 ? 'it is' : 'they are'} worth — so{' '}
                  {aging.unpricedLoads === 1 ? 'it is' : 'they are'} counted in the band and not in
                  the money.
                </p>
              )}
            </div>
          )}

          {chaseRows.length > 0 && (
            /* WHOSE money it is. A band is a mix of brokers, so the bars cannot
               answer "who do I ring" — this can, and it is the same population
               cut the other way. */
            <div class="mt-4 border-t border-ink-100 pt-3">
              {/* 12px, so ink-700. */}
              <h4 class="text-xs tracking-wide text-ink-700 uppercase">
                Out longest — ring these first
              </h4>
              <ul class="mt-2 divide-y divide-ink-100 text-sm">
                {chaseRows.map((r) => (
                  <li class="flex flex-wrap items-center justify-between gap-x-4 py-1">
                    <a href={`/app/customers/${r.id}`} class="link-row">
                      {r.name}
                    </a>
                    <span class="tabular-nums">
                      <span class="font-medium">{formatCents(r.cents)}</span>
                      <span class="text-ink-500">
                        {' '}
                        · oldest {r.oldestDays === null ? 'not known' : daysWord(r.oldestDays)}
                        {' · '}
                        {/* The AGREED term, said the way the rate confirmation
                            says it. Never "pays in 30 days", which reads as a
                            measurement of this broker rather than a promise
                            from them. */}
                        {r.daysToPay === null
                          ? 'terms not recorded'
                          : r.daysToPay === 0
                            ? 'terms: on delivery'
                            : `terms: net ${r.daysToPay}`}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </Figure>
      </div>
    )
  }
</App>
