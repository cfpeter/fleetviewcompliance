---
/**
 * Add a customer.
 *
 * One required field, and that is a decision rather than an omission. A
 * dispatcher adds the broker while the rate confirmation is on the phone in
 * front of her, and a required field she cannot fill is a field she invents a
 * value for — an invented MC number is worse than a blank one, because the
 * authority check on the detail page will then look up somebody else's docket
 * and report their status as this broker's.
 */
import App from '../../../layouts/App.astro'
import { flashText } from '../../../lib/flash.ts'
import {
  docketOrNull,
  parseDaysToPay,
  parseDotNumber,
  textOrNull,
} from '../../../lib/customers.ts'
import { parsePhone } from '../../../lib/phone.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

/**
 * Every exit from the POST is a 303, and the status code is not decoration.
 * Astro.redirect() defaults to 302, which permits the browser to repeat the POST
 * against the new location — so a refresh re-runs it, the broker is added twice,
 * and nothing on screen says so. Two rows for one broker then split his load
 * history down the middle, which is the failure nobody notices until the
 * quarterly numbers are wrong.
 */
function back(message: string): Response {
  return Astro.redirect(`/app/customers/new?error=${encodeURIComponent(message)}`, 303)
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  if (intent === 'create') {
    const name = textOrNull(form.get('name'))
    // The browser's own `required` blocks this, so reaching it means a hand-made
    // POST. The typed values are deliberately NOT carried back in the query
    // string on the way out: a contact's phone number and a billing address in a
    // URL land in every access log between here and her desk, which is not a
    // trade worth making to repopulate a form the browser was already guarding.
    if (!name) return back('A customer needs a name. Everything else can wait.')

    const dot = parseDotNumber(form.get('dot_number'))
    if (!dot.ok) return back(dot.message)

    const days = parseDaysToPay(form.get('days_to_pay'))
    if (!days.ok) return back(days.message)

    // Blank stays blank — a company name is enough, as the subtitle says. But a
    // number with a word in it is not a number: this is the line she rings when
    // a load is sitting on a dock, and "call cell 818..." stored as typed is a
    // broker she believes she can reach and cannot.
    const phone = parsePhone(form.get('phone'), 'Phone')
    if (!phone.ok) return back(phone.message)

    const { data, error } = await supabase
      .from('customers')
      .insert({
        // carrier_id is set here and nowhere else in this file. RLS CHECKS it on
        // the way in — an insert naming somebody else's carrier is rejected —
        // but it does not SUPPLY it, and the column is NOT NULL, so leaving it
        // out fails the insert rather than defaulting to anything sensible.
        carrier_id: carrierId,
        name,
        mc_number: docketOrNull(form.get('mc_number')),
        dot_number: dot.value,
        contact_name: textOrNull(form.get('contact_name')),
        phone: phone.value,
        email: textOrNull(form.get('email')),
        billing_email: textOrNull(form.get('billing_email')),
        billing_address: textOrNull(form.get('billing_address')),
        days_to_pay: days.value,
        notes: textOrNull(form.get('notes')),
      })
      .select('id')
      .single()

    if (error || !data) {
      // Postgres words are for an operator, not for the person at the desk.
      if (error) console.error('customer insert failed:', error.message)
      return back('That customer could not be saved. Wait a moment and try again.')
    }

    // Straight to the customer rather than back to the list: if she gave us a
    // DOT number, their federal authority status is waiting on that page, and it
    // is the one thing worth reading before the truck rolls.
    return Astro.redirect(`/app/customers/${data.id}?added=1`, 303)
  }

  // An unrecognised intent is a bug or a crafted post; either way it must not
  // fall through and render the form as though it were a GET.
  return Astro.redirect('/app/customers/new', 303)
}

// Read through flashText, never straight off the URL: the sentence is printed
// in our red box, so it is only honoured when the browser says the request
// came from our own 303. See src/lib/flash.ts.
const error = flashText(Astro.url, Astro.request)

/**
 * ONE FIELD CONSTRUCTION, AND IT LIVES IN global.css.
 *
 * This form used to carry its own: `border-ink-100`, which is 1.18:1 against
 * white and therefore a border nobody can see, `py-2` which lands the box at
 * 38px — six pixels under the 44px a thumb needs — and a hand-written
 * `ring-brand-500/20` focus ring at 1.33:1, which fails WCAG 2.2 outright. All
 * three are fixed by not writing them: `.field-input` is the visible ink-500
 * border and 16px type so iOS does not zoom the page on a tap, and the focus
 * ring is the single `:focus-visible` rule in global.css.
 */
const field = 'field-input mt-1'
/** The word "(optional)" beside a label. ink-500 is the floor on white. */
const optional = 'font-normal text-ink-500'
---

<App title="Add a customer" subtitle="A company name is enough to start. The rest can follow the rate con.">
  <div class="max-w-2xl">
    {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}

    <form method="POST" class="space-y-4 rounded-xl border border-ink-100 bg-white p-5">
      <label class="block">
        <span class="field-label">Company name <span class="text-red-600">*</span></span>
        <input type="text" name="name" required autofocus class={field} />
        <span class="field-hint block">
          Use the name on the rate confirmation, not the name the dispatcher says on the phone.
        </span>
      </label>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="field-label">
            MC number <span class={optional}>(optional)</span>
          </span>
          <input
            type="text"
            name="mc_number"
            autocapitalize="characters"
            autocomplete="off"
            maxlength="12"
            placeholder="MC123456"
            class={`${field} tabular-nums`}
          />
          <span class="field-hint block">
            Keep the prefix if there is one. MC, MX and FF are three different kinds of authority.
          </span>
        </label>
        <label class="block">
          <span class="field-label">
            USDOT number <span class={optional}>(optional)</span>
          </span>
          <input
            type="text"
            name="dot_number"
            inputmode="numeric"
            maxlength="12"
            autocomplete="off"
            placeholder="1234567"
            class={`${field} tabular-nums`}
          />
          <span class="field-hint block">
            Worth finding. With this number we can check their operating authority in the public
            federal record every time you open their page.
          </span>
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="field-label">
            Contact name <span class={optional}>(optional)</span>
          </span>
          <input type="text" name="contact_name" class={field} />
        </label>
        <label class="block">
          <span class="field-label">
            Phone <span class={optional}>(optional)</span>
          </span>
          <input
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            name="phone"
            placeholder="(818) 334-0168"
            class={`${field} tabular-nums`}
          />
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="field-label">
            Email <span class={optional}>(optional)</span>
          </span>
          <input type="email" inputmode="email" autocomplete="email" name="email" class={field} />
        </label>
        <label class="block">
          <span class="field-label">
            Billing email <span class={optional}>(optional)</span>
          </span>
          <input
            type="email"
            inputmode="email"
            autocomplete="email"
            name="billing_email"
            class={field}
          />
          <span class="field-hint block">
            Keep this separate from the dispatch email. Invoices sent to the dispatcher do not
            get paid.
          </span>
        </label>
      </div>

      <label class="block">
        <span class="field-label">
          Billing address <span class={optional}>(optional)</span>
        </span>
        <textarea name="billing_address" rows="3" class={field}></textarea>
      </label>

      {/* "Payment terms", not "Days to pay". The number in this box is what
          they AGREED to on the rate confirmation — "net 30" — and the app must
          never present it as how fast they have been measured paying. The two
          are different numbers and the gap between them is the whole reason a
          small carrier cares. */}
      <label class="block">
        <span class="field-label">
          Payment terms <span class={optional}>(optional)</span>
        </span>
        <input
          type="text"
          name="days_to_pay"
          inputmode="numeric"
          placeholder="30"
          class={`${field} tabular-nums`}
        />
        <span class="field-hint block">
          Days from a clean invoice, as agreed. Type 30 for net 30. If you leave it blank, it stays
          blank — we would rather show nothing than guess 30 on the screen you use to decide if you
          can take the load.
        </span>
      </label>

      <label class="block">
        <span class="field-label">
          Notes <span class={optional}>(optional)</span>
        </span>
        <textarea
          name="notes"
          rows="3"
          placeholder="Detention needs pre-approval in writing. Lumper reimbursed with receipt."
          class={field}></textarea>
      </label>

      {/* The shared button pair. Both were hand-rolled here: the submit was a
          one-off brand-600 box that happened to match .btn-primary and would
          not have stayed matching, and "Back to customers" was a 20px line of
          blue text — a link the thumb misses and the eye does not see, because
          it was not underlined until the cursor was already on it. */}
      <div class="flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
        <button type="submit" name="intent" value="create" class="btn btn-primary">
          Add customer
        </button>
        <a href="/app/customers" class="btn btn-tertiary">
          <span aria-hidden="true">←</span> Back to customers
        </a>
      </div>
    </form>
  </div>
</App>
