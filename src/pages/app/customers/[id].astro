---
/**
 * One customer: the record we keep, what the federal file says about them, and
 * the loads we have hauled for them.
 *
 * The federal block is the reason this page is worth opening before a load
 * rather than after. A broker whose operating authority is inactive is a broker
 * whose freight a small carrier should not be moving — and the public record
 * that says so is free, so the only excuse for not checking is that nobody
 * checked. Every branch of it is written to keep one sentence off the screen:
 * "we could not check" must never be rendered as "they look fine".
 */
import Bars from '../../../components/charts/Bars.astro'
import Columns from '../../../components/charts/Columns.astro'
import Figure from '../../../components/charts/Figure.astro'
import Proportion from '../../../components/charts/Proportion.astro'
import App from '../../../layouts/App.astro'
import {
  type DatedLoad,
  agingSource,
  daysWord,
  paySpeed,
  punctualityVerdict,
  receivablesAging,
} from '../../../lib/charts/receivables.ts'
import { billingMix, revenueByMonth, sliceOf } from '../../../lib/charts/revenue.ts'
import { ceilingFor } from '../../../lib/charts/scale.ts'
import { TONES, UNKNOWN_SLOT } from '../../../lib/charts/tones.ts'
import {
  type CustomerLoadRow,
  type CustomerRow,
  authorityPillClass,
  docketOrNull,
  federalCheck,
  formatStamp,
  hasActiveAuthority,
  parseDaysToPay,
  parseDotNumber,
  textOrNull,
} from '../../../lib/customers.ts'
import {
  billingPillClass,
  billingStatusLabel,
  exceptionLabel,
  exceptionPillClass,
  formatCents,
  loadLabel,
  loadStatusLabel,
  statusPillClass,
  totalRateCents,
} from '../../../lib/loads.ts'
import { formatPhone, parsePhoneEdit, toE164 } from '../../../lib/phone.ts'

const supabase = Astro.locals.supabase!
const id = Astro.params.id ?? ''

function back(params: string): Response {
  return Astro.redirect(`/app/customers/${id}${params ? `?${params}` : ''}`, 303)
}

function fail(message: string): Response {
  return back(`error=${encodeURIComponent(message)}`)
}

/** Back to the book, for every case where this customer is not ours to show. */
function toList(message: string): Response {
  return Astro.redirect(`/app/customers?error=${encodeURIComponent(message)}`, 303)
}

const NOT_YOURS = 'That customer is not in your book.'

// A hand-edited URL like /app/customers/abc is not a missing row, it is a failed
// uuid cast — Postgres raises, and without this check she gets "invalid input
// syntax for type uuid" across the top of her screen. Checked here rather than
// swallowing the error later, so a REAL database failure still reaches her as a
// real database failure instead of as "no such customer".
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) {
  return toList(NOT_YOURS)
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  if (intent === 'save_customer') {
    const name = textOrNull(form.get('name'))
    if (!name) return fail('A customer needs a name.')

    const dot = parseDotNumber(form.get('dot_number'))
    if (!dot.ok) return fail(dot.message)

    const days = parseDaysToPay(form.get('days_to_pay'))
    if (!days.ok) return fail(days.message)

    // The stored phone, read here rather than taken from `customer` below: the
    // page load runs AFTER this block, so on a POST there is no row in scope
    // yet. No carrier filter — RLS already scopes it, and a customer that is not
    // ours comes back null without deciding anything, because the UPDATE below
    // is still the one place that answers "is this broker in your book".
    const { data: current } = await supabase
      .from('customers')
      .select('phone')
      .eq('id', id)
      .maybeSingle()

    // Same rule as the add form for anything TYPED here, because two parsers
    // would be two answers to "can we reach this broker?". Blank is still a fine
    // answer; a number with a word in it is not, and storing it is how a
    // dispatcher finds out at the dock that the line she has on file was never
    // dialable.
    //
    // The value that was ALREADY here is the exception. Every phone in the book
    // predates the rule, and this handler refuses the whole submit on a bad
    // phone — so the strict parser turns an owner opening this page to correct
    // the payment terms into an owner who cannot save them, over a field she
    // never touched. Nobody is blocked on a field they did not edit, and
    // refusing the legacy row buys nothing today: SMS is not switched on yet, so
    // nothing is being sent to it while it sits there. Grandfathered through
    // untouched, flagged beside the field; change it to something we still
    // cannot dial and it is refused as before.
    const phone = parsePhoneEdit(form.get('phone'), current?.phone, 'Phone')
    if (!phone.ok) return fail(phone.message)

    const { data, error } = await supabase
      .from('customers')
      .update({
        name,
        mc_number: docketOrNull(form.get('mc_number')),
        dot_number: dot.value,
        contact_name: textOrNull(form.get('contact_name')),
        phone: phone.value,
        email: textOrNull(form.get('email')),
        billing_email: textOrNull(form.get('billing_email')),
        billing_address: textOrNull(form.get('billing_address')),
        days_to_pay: days.value,
        notes: textOrNull(form.get('notes')),
      })
      // No carrier_id in the filter and none in the patch. RLS makes another
      // carrier's customer invisible to this statement, so the worst an edited
      // URL achieves is matching zero rows — and leaving carrier_id out of the
      // patch is what stops anyone moving a customer into a different tenancy.
      .eq('id', id)
      .select('id')

    if (error) return fail(error.message)
    // An UPDATE that matches nothing is not an error in Postgres, so without
    // this the page would report a cheerful "Saved." for a customer that does
    // not exist or belongs to somebody else.
    if (!data || data.length === 0) return toList(NOT_YOURS)
    return back('saved=1')
  }

  // POST always ends in a redirect, including the unrecognised-intent case. A
  // fall-through here would render this page as the response to a POST, and the
  // refresh that follows would re-submit it.
  return back('')
}

const { data: row, error: loadError } = await supabase
  .from('customers')
  .select(
    'id, name, mc_number, dot_number, contact_name, phone, email, billing_email, billing_address, days_to_pay, notes, created_at',
  )
  .eq('id', id)
  .maybeSingle()

if (loadError) return toList(loadError.message)
// maybeSingle() returns null both for "no such id" and for "belongs to another
// carrier", because RLS makes the second one look exactly like the first. That
// is the point: this page cannot be used to find out which brokers another
// carrier on the platform works with.
if (!row) return toList(NOT_YOURS)

const customer = row as CustomerRow & { created_at: string }

/**
 * Recent loads, and the federal lookup, started together.
 *
 * `federalCheck` never rejects — it turns a dead endpoint, a slow one and an
 * empty answer into three different values — so nothing in this Promise.all can
 * take the page down with it. That matters more than it sounds: the thing she
 * actually came here for is a phone number, and a government data service
 * having a bad morning must not cost her that.
 */
const loadsQuery = supabase
  .from('loads')
  .select(
    'id, load_number, broker_reference, status, exception, billing, linehaul_cents, fuel_surcharge_cents, accessorials_cents, created_at',
  )
  // customer_id, not carrier_id. RLS has already limited this table to our own
  // loads; this filter is about WHICH of our loads, which is a different
  // question and the only one this page gets to ask.
  .eq('customer_id', id)
  .order('created_at', { ascending: false })
  .limit(10)

/**
 * The charts get their OWN query, over every load, and that is the whole point.
 *
 * The table above is the last ten. Drawing a twelve-month revenue chart from
 * ten rows would draw empty months for periods this broker was actually busy in
 * — the chart would say "nothing in March" when what happened is that March
 * fell off the end of a LIMIT. That is the precise failure the charts doctrine
 * calls an axis built from the data instead of from the calendar, and on a
 * customer page it would be an accusation against a broker who did nothing
 * wrong.
 *
 * Only the columns the derivations read. No id, no reference numbers: this
 * query can be forty times the size of the one above it and none of that is
 * rendered anywhere.
 */
const HISTORY_COLUMNS =
  'status, exception, billing, linehaul_cents, fuel_surcharge_cents, accessorials_cents, created_at'
// The two dates 0029_load_invoice_dates.sql adds. They are what turns "how much
// of theirs is still out" into "how long they actually take to pay", which is
// the question this page exists to answer and could not.
const HISTORY_COLUMNS_WITH_DATES = `${HISTORY_COLUMNS}, invoiced_on, paid_on`

/**
 * Their whole load history, asked for with the invoice dates and again without.
 *
 * 0029 IS WRITTEN AND NOT YET APPLIED. Until somebody runs it the two columns
 * do not exist and PostgREST answers the first request with "column
 * loads.invoiced_on does not exist" — which would take every chart off this
 * page over a column that is an improvement, not a requirement. So it asks
 * again without them: the revenue columns and the aging bands come back exactly
 * as they did before, the measured pay speed renders as the dashed gap it
 * already rendered as, and the words beside it say the dates are not recorded.
 *
 * The exact count rides on both, so the charts can tell whether PostgREST's row
 * cap ate anything. Without it a capped response draws a quietly short year and
 * there is nothing on screen — or in the data — that says so.
 */
async function historyRows() {
  const withDates = await supabase
    .from('loads')
    .select(HISTORY_COLUMNS_WITH_DATES, { count: 'exact' })
    .eq('customer_id', id)
  if (!withDates.error) return { result: withDates, dates: true }
  const plain = await supabase
    .from('loads')
    .select(HISTORY_COLUMNS, { count: 'exact' })
    .eq('customer_id', id)
  return { result: plain, dates: false }
}

const [loadsResult, history_, federal] = await Promise.all([
  loadsQuery,
  historyRows(),
  // Asked only when there is something to ask about. A customer with neither
  // number gets no federal block at all rather than an empty one, because an
  // empty panel reads as an answer.
  customer.dot_number || customer.mc_number
    ? federalCheck(customer.dot_number, customer.mc_number)
    : null,
])

const loads = (loadsResult.data ?? []) as unknown as CustomerLoadRow[]
const loadsFailed = Boolean(loadsResult.error)

/**
 * What we have hauled for them, drawn.
 *
 * The table underneath answers "what happened lately". Neither it nor the Days
 * to pay card answers the question the owner is really asking on this page —
 * "is this broker worth the terms they are asking for" — because that answer is
 * a shape: a customer who was half the year and has gone quiet looks identical
 * to a steady one in a list of ten rows.
 */
const historyResult = history_.result
/**
 * Whether the two date columns were actually readable.
 *
 * FALSE is the state of this database today, because 0029 is unapplied. It is
 * carried as a value rather than inferred from "every row has no dates",
 * because those are two different facts: a carrier who simply has not typed any
 * invoice dates yet gets a different sentence from a carrier whose database
 * cannot hold them.
 */
const payDatesStored = history_.dates
const history = (historyResult.data ?? []) as unknown as DatedLoad[]
const historyFailed = Boolean(historyResult.error)
// One instant, shared by every derivation on the page. Two calls to new Date()
// can straddle midnight in the yard, and then the revenue axis and the aging
// bands are answering as of two different days.
const now = new Date()
const months = historyFailed || history.length === 0 ? null : revenueByMonth(history, now)
const mix = historyFailed || history.length === 0 ? null : billingMix(history)
// What of theirs is invoiced and still out, by how old the load is. Same rows
// as the two charts above it, so this page cannot disagree with itself.
const aging = historyFailed ? null : receivablesAging(history, now)

/**
 * PROMISED AGAINST ACTUAL, MEASURED.
 *
 * Same rows again — the whole history, not the last ten in the table — so the
 * card in the rail and the bands below it cannot disagree about this broker.
 *
 * `paySpeed` refuses to state a figure from fewer than three finished invoices
 * and refuses an on-time share for a customer who never gave terms, and it
 * hands back the REASON as a sentence in both cases. That is what the card
 * prints beside the dashed gap. It never prints a zero and it never prints an
 * average of two invoices under a heading that reads like a habit.
 */
const speed = historyFailed ? null : paySpeed(history, customer.days_to_pay)
const punctuality =
  speed && speed.onTimePercent !== null ? punctualityVerdict(speed.onTimePercent) : null

const loadWord = (n: number) => (n === 1 ? 'load' : 'loads')
const invoiceWord = (n: number) => (n === 1 ? 'invoice' : 'invoices')

// What the response could not carry. See the note on the count above: a capped
// result drops rows silently, and a chart has no visible end to give the loss
// away the way a table does.
const missing = Math.max(0, (historyResult.count ?? history.length) - history.length)

// Passed to Columns as `max` so the axis label and the bars are scaled by the
// same number rather than by two separate calls that could drift.
const revenueCeiling = months ? ceilingFor(months.columns.map((c) => c.value)) : 0

/**
 * What the revenue columns do not cover.
 *
 * The clause about the table is not housekeeping. The chart is drawn from every
 * load and the table under it is the last ten, so the two will disagree the
 * moment this broker passes a dozen loads — and a reader who adds up the visible
 * rows and gets a different number than the chart concludes that one of them is
 * broken, which is the reputation this whole product is trying not to earn.
 */
const revenueCoverage = months
  ? [
      'Booked rates, by the month the load was entered. This is not money received. Nothing on a load records when it delivered or when it paid.',
      history.length > loads.length &&
        `Drawn from ${missing > 0 ? '' : 'all '}${history.length} loads on file for them. The table below is only the last ${loads.length}.`,
      months.window.unpricedLoads > 0 &&
        `${months.window.unpricedLoads} ${loadWord(months.window.unpricedLoads)} here carry no rate yet and are in no column.`,
      months.window.quotedLoads + months.window.cancelledLoads > 0 &&
        `${months.window.quotedLoads + months.window.cancelledLoads} quoted or cancelled ${loadWord(months.window.quotedLoads + months.window.cancelledLoads)} are left out.`,
      months.window.writtenOffCents > 0 &&
        `${formatCents(months.window.writtenOffCents)} of what is drawn has been written off.`,
      months.outside.countedLoads + months.outside.unpricedLoads > 0 &&
        `${months.outside.countedLoads + months.outside.unpricedLoads} older ${loadWord(months.outside.countedLoads + months.outside.unpricedLoads)} are before this axis starts.`,
      months.undated > 0 && `${months.undated} could not be placed on it at all.`,
      missing > 0 &&
        `${missing} older ${loadWord(missing)} did not fit in one request and are on no chart here.`,
    ]
      .filter(Boolean)
      .join(' ')
  : undefined

/**
 * What the billing bar does not cover.
 *
 * The last clause is the one that matters and it changes with what is on file.
 * This bar is a count of where money sits, never a measure of how long anybody
 * took to send it — that answer is the card in the rail, and the two must not
 * be read as one. Pointing at the card is better than the old flat "we cannot
 * tell you", which stopped being true the moment a load carried both dates.
 */
const mixCoverage = mix
  ? [
      'Bands are counts of loads, not dollars.',
      mix.unpricedLoads > 0 &&
        `${mix.unpricedLoads} of them carry no rate, so the amounts below are lower than the real figures.`,
      mix.quotedLoads + mix.cancelledLoads > 0 &&
        `${mix.quotedLoads + mix.cancelledLoads} quoted or cancelled ${loadWord(mix.quotedLoads + mix.cancelledLoads)} are not on this bar.`,
      missing > 0 && `${missing} older ${loadWord(missing)} did not fit in one request.`,
      'This shows what is still out. How long they take to pay is the "How fast they pay" card at the top of this page.',
    ]
      .filter(Boolean)
      .join(' ')
  : undefined

/**
 * HOW OLD WHAT IS STILL OUT IS, AND THE DAY IT IS COUNTED FROM.
 *
 * A load that carries an invoice date is aged from that day. A load with none
 * is aged from the day it was ENTERED, which is always older than the invoice
 * behind it. `agingSource` writes out how many rows are which, and it is the
 * first line of the coverage note rather than the last: an owner who reads
 * "more than 90 days" off this screen and repeats it to a broker whose invoice
 * went out three weeks ago has been handed an argument he loses, by us.
 */
const agingCoverage = aging
  ? [
      agingSource(aging),
      'Only loads marked invoiced, with the factor, or funded. Anything you have not invoiced yet is not on these bars.',
      aging.unpricedLoads > 0 &&
        `${aging.unpricedLoads} ${loadWord(aging.unpricedLoads)} still out carry no rate yet, so the amounts are lower than the real figures.`,
      aging.undatedLoads > 0 &&
        `${aging.undatedLoads} ${loadWord(aging.undatedLoads)} still out have no readable date and are in no band.`,
      missing > 0 &&
        `${missing} older ${loadWord(missing)} did not fit in one request and are on no bar here.`,
    ]
      .filter(Boolean)
      .join(' ')
  : undefined

const readySlice = mix ? sliceOf(mix, 'ready') : undefined
const awaitingSlice = mix ? sliceOf(mix, 'awaiting') : undefined
const problemSlice = mix ? sliceOf(mix, 'problem') : undefined

// 0 is "pays on delivery", the best terms in the industry, and NULL is "nobody
// has asked them". Rendered through one template they would both come out as a
// number of days, and the broker who never answered would read as the best
// payer on the book — the same trap parseDaysToPay exists to keep out of the
// database.
//
// "Net 30" rather than "pays in 30 days", here and everywhere else on this
// screen. It is the phrase on the rate confirmation, so it reads as the promise
// it is rather than as a measurement of what they actually do.
const termsLine =
  customer.days_to_pay === null
    ? 'They have never given you payment terms, so there is nothing to compare the wait against.'
    : customer.days_to_pay === 0
      ? 'Their agreed terms are payment on delivery.'
      : `Their agreed terms are net ${customer.days_to_pay} — ${daysWord(customer.days_to_pay)} from a clean invoice.`

/**
 * The two bars: what they promised, and what they actually did.
 *
 * ONE SCALE over both, so a bar twice as long really is twice the wait. Scaled
 * separately, a broker taking 60 days against agreed 30 would draw two bars of
 * the same length and the comparison the card exists for would be invisible.
 *
 * A missing half is `null`, never 0. Zero days is the best terms in the
 * industry — payment on delivery — and a customer nobody has measured must
 * never be drawn sitting on top of the best payer on the book.
 */
const promisedValue = customer.days_to_pay
const actualValue = speed?.typicalDays ?? null
const speedCeiling = ceilingFor([promisedValue, actualValue])
const speedBars = [
  {
    label: 'What they promised',
    value: promisedValue,
    display:
      promisedValue === null
        ? 'not recorded'
        : promisedValue === 0
          ? 'on delivery'
          : `net ${promisedValue} — ${daysWord(promisedValue)}`,
    note: promisedValue === null ? 'Nobody has asked them for terms yet.' : 'Agreed terms, off the rate confirmation.',
    tone: 'brand' as const,
  },
  {
    label: 'What they really take',
    value: actualValue,
    display: actualValue === null ? 'not known yet' : daysWord(actualValue),
    note: (() => {
      if (!speed) return 'We could not read their load history just now, so there is nothing measured here.'
      if (actualValue === null) return speed.absence ?? ''
      const range =
        speed.fastestDays !== null && speed.slowestDays !== null
          ? ` Fastest ${daysWord(speed.fastestDays)}, slowest ${daysWord(speed.slowestDays)}.`
          : ''
      return `The middle wait across ${speed.measured} paid ${invoiceWord(speed.measured)}.${range}`
    })(),
    // GREEN ONLY WHEN THEY ACTUALLY KEPT THE TERMS, and blue — "simply a fact"
    // — when there is no term to keep. Red is not used here: it means act now
    // in this app, and the thing to act on is the money still out, which is the
    // bands lower down. A broker who runs a few days over gets amber and the
    // sentence that says so.
    tone:
      actualValue === null || promisedValue === null
        ? ('brand' as const)
        : actualValue <= promisedValue
          ? ('good' as const)
          : ('soon' as const),
  },
]

/**
 * The finding under the two bars, written out.
 *
 * A pair of bar lengths is a shape, and a shape is not a number. This is the
 * sentence that survives being read on a phone in the sun by somebody reading
 * a second language, and it is the one an owner repeats down the phone — so it
 * names both figures rather than the difference alone.
 */
const speedFinding =
  actualValue === null || promisedValue === null || !speed
    ? null
    : actualValue > promisedValue
      ? `They agreed net ${promisedValue} and typically take ${daysWord(actualValue)} — ${daysWord(actualValue - promisedValue)} longer than they promised. Price that in before the next load.`
      : actualValue === promisedValue
        ? `They agreed net ${promisedValue} and typically take ${daysWord(actualValue)}. They pay the way they said they would.`
        : `They agreed net ${promisedValue} and typically take ${daysWord(actualValue)} — ${daysWord(promisedValue - actualValue)} sooner than they promised.`

/** The counts behind the gauge. A share never travels without them. */
const punctualityLine =
  speed && speed.onTimePercent !== null && speed.promisedDays !== null
    ? `${speed.onTime} of ${speed.measured} paid ${invoiceWord(speed.measured)} ${
        speed.promisedDays === 0
          ? 'arrived on the day you invoiced'
          : `arrived within the agreed ${daysWord(speed.promisedDays)}`
      }. ${speed.late === 0 ? 'None came late.' : `${speed.late} came late.`}`
    : null

/**
 * What the card does NOT cover, one line each.
 *
 * Every one of these is a load that is deliberately in none of the figures
 * above. Left unsaid, a customer with nine invoices out and three paid would
 * read as a customer we have measured properly.
 */
const speedCoverage = speed
  ? [
      !payDatesStored &&
        'FleetView is not storing invoice dates or payment dates yet, so nothing on this card can be measured. Ask for that to be switched on.',
      payDatesStored &&
        speed.awaiting > 0 &&
        `${speed.awaiting} ${invoiceWord(speed.awaiting)} out with them ${speed.awaiting === 1 ? 'has' : 'have'} no payment date yet, so ${speed.awaiting === 1 ? 'it is' : 'they are'} in no figure here. Waiting is not the same as late.`,
      payDatesStored &&
        speed.unrecorded > 0 &&
        `${speed.unrecorded} of their ${loadWord(speed.unrecorded)} carry no invoice date, so ${speed.unrecorded === 1 ? 'it is' : 'they are'} not counted. Type the date when you send the invoice.`,
      speed.unreadable > 0 &&
        `${speed.unreadable} ${loadWord(speed.unreadable)} show money arriving before the invoice went out. That is a typed date in the wrong box, and ${speed.unreadable === 1 ? 'it is' : 'they are'} in no figure here.`,
      missing > 0 &&
        `${missing} older ${loadWord(missing)} did not fit in one request and are in no figure here.`,
    ].filter((line): line is string => typeof line === 'string')
  : []

// The banner only fires on a definite finding: we reached the federal file, it
// returned dockets for this DOT number, and not one of them is Active. Anything
// less certain than that stays in the card below, where it can be explained.
const authorityRows =
  federal?.state === 'checked' && federal.authority.state === 'rows' ? federal.authority.rows : []
const noActiveAuthority = authorityRows.length > 0 && !hasActiveAuthority(authorityRows)

const params = Astro.url.searchParams
const error = params.get('error')
const added = params.get('added') === '1'
const saved = params.get('saved') === '1'

/**
 * The docket goes in the subtitle exactly as it is stored, prefix and all.
 *
 * An earlier version stripped a leading "MC" and re-added it, which rendered a
 * cross-border broker's MX123456 as "MC MX123456" — a docket number that does
 * not exist, on the one line she reads when she is checking a docket number.
 */
const subtitle = customer.mc_number
  ? `Docket ${customer.mc_number}`
  : 'No MC number on file'

// Advisory, and deliberately not a save-time refusal — see parsePhoneEdit. The
// save lets a legacy number through so nobody is blocked on a field they did not
// touch, and the cost is a number that reads as answered when it is not. On this
// page that is the line a dispatcher dials at 5am with a load sitting, so it is
// said here, on the record, rather than found out at the dock.
// Keyed off what the box SHOWS, not off the column: '' is supposed to reach
// Postgres as NULL and a row written before that rule still holds one, and an
// advisory pointing at a visibly empty field is a warning nobody can act on.
const phoneUndialable = formatPhone(customer.phone) !== '' && toE164(customer.phone) === null

const card = 'rounded-xl border border-ink-100 bg-white p-5'
/**
 * ONE FIELD CONSTRUCTION, AND IT LIVES IN global.css.
 *
 * `.field-input` carries the visible ink-500 border — the old ink-100 was
 * 1.18:1 against white, a border nobody could see — 16px type so iOS does not
 * zoom the page when a thumb lands in a box, and the focus border colour. The
 * focus RING is the single `:focus-visible` rule in global.css, so there is no
 * per-field ring written here and none to get wrong: the `ring-brand-500/20`
 * this page used to carry was 1.33:1 and failed WCAG 2.2 outright.
 */
const field = 'field-input mt-1'

/**
 * ONE HEADING SCALE, THREE STEPS, THE SAME ON EVERY SCREEN IN THIS APP.
 *
 *   h2  text-lg font-semibold tracking-tight        — a section of the page
 *   h3  text-sm font-semibold tracking-tight        — a subsection inside a card
 *   h3  text-xs tracking-wide text-ink-700 uppercase — the label on a small card
 *
 * Both cards in the rail on this page are the third kind, so the string is
 * written out where it is used rather than kept in a constant: it has to stay
 * BYTE-IDENTICAL to the same label on /app/dispatch, /app/settlements and
 * /app/ifta — one string, greppable, on fourteen screens. They were `<div>`s,
 * which are not headings at all — invisible to the document outline and to
 * anybody moving through the page by headings. The element changed; the class
 * string did not, so nothing moved.
 */

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * The loads table is 48rem wide and the window on a 375px phone is about 341px,
 * so most of every row — the total among it — was behind a sideways scroll.
 * Below `sm` every cell becomes a block; from `sm` the same markup is a table
 * again. ONE set of cells, not two. The pattern is written down in
 * src/components/Documents.astro.
 *
 * THE BLOCKS ARE ORDERED, WHICH IS THE ONE ADDITION TO THAT PATTERN. This table
 * is on a CUSTOMER page, and what is read off it is whether their money arrives:
 * the total and the billing state were fifth and fourth, furthest off the edge.
 * Where the truck is belongs to the dispatch board, so the load status drops
 * below them here. `order-*` needs the row to be a flex column below `sm`; from
 * `sm` it is `table-row` again and the property is ignored, so the desktop table
 * is untouched and the header row still names the columns in their own order.
 */
const cell = 'block px-4 sm:table-cell sm:py-3'
/** The column name, said on the block that has no column. */
const said = 'text-ink-500 sm:hidden'
---

<App title={customer.name} subtitle={subtitle}>
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}
  {
    added && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Customer added. Add their USDOT number when you have it. Then we will check their
        operating authority every time you open this page.
      </p>
    )
  }
  {saved && <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Saved.</p>}

  {
    /* The loud one. This is a statement of fact from the federal record, not an
       inference from silence — see `noActiveAuthority` above, which requires
       that we actually reached the file and that it actually returned dockets. */
  }
  {
    noActiveAuthority && (
      <div class="mb-5 rounded-xl border border-red-200 bg-red-50/60 p-4">
        <p class="font-medium text-red-800">No active operating authority on the federal record</p>
        <p class="mt-1 text-sm text-ink-700">
          Every docket on file for USDOT <span class="tabular-nums">{federal?.state === 'checked' ? federal.dot : ''}</span>{' '}
          reads {authorityRows.map((a) => a.op_auth_status).filter(Boolean).join(', ')}. A broker
          without active authority cannot legally arrange your freight. Your insurer and your
          factor both check this before anyone pays the invoice. Call them before the next load.
        </p>
      </div>
    )
  }

  <div class="grid gap-6 lg:grid-cols-[1fr_minmax(0,22rem)]">
    <form method="POST" class="space-y-4 rounded-xl border border-ink-100 bg-white p-5">
      <h2 class="text-lg font-semibold tracking-tight">Customer record</h2>

      <label class="block">
        <span class="field-label">Company name <span class="text-red-600">*</span></span>
        <input type="text" name="name" value={customer.name} required class={field} />
      </label>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="field-label">MC number</span>
          <input
            type="text"
            name="mc_number"
            value={customer.mc_number ?? ''}
            placeholder="MC123456"
            class={`${field} tabular-nums`}
          />
        </label>
        <label class="block">
          <span class="field-label">USDOT number</span>
          <input
            type="text"
            name="dot_number"
            inputmode="numeric"
            value={customer.dot_number ?? ''}
            placeholder="1234567"
            class={`${field} tabular-nums`}
          />
          <span class="field-hint block">
            This is the number the federal authority check runs on.
          </span>
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="field-label">Contact name</span>
          <input type="text" name="contact_name" value={customer.contact_name ?? ''} class={field} />
        </label>
        <label class="block">
          <span class="field-label">Phone</span>
          {/*
            Read as a person reads it, stored as E.164. The two are deliberately
            different: E.164 is what makes two spellings of one number compare
            equal, and it is also what nobody recognises as their own broker's
            line at a glance.
          */}
          <input
            type="tel"
            name="phone"
            value={formatPhone(customer.phone)}
            placeholder="(818) 334-0168"
            class={`${field} tabular-nums`}
          />
          {
            phoneUndialable && (
              <span class="badge badge-warning mt-1.5">
                <span aria-hidden="true">⚠</span> We cannot dial or text this number as it is
                written. We saved it anyway.
              </span>
            )
          }
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="field-label">Email</span>
          <input type="email" name="email" value={customer.email ?? ''} class={field} />
        </label>
        <label class="block">
          <span class="field-label">Billing email</span>
          <input
            type="email"
            name="billing_email"
            value={customer.billing_email ?? ''}
            class={field}
          />
          <span class="field-hint block">
            Invoices sent to the dispatch address do not get paid.
          </span>
        </label>
      </div>

      <label class="block">
        <span class="field-label">Billing address</span>
        <textarea name="billing_address" rows="3" class={field}>{customer.billing_address ?? ''}</textarea>
      </label>

      <label class="block">
        {/* "Payment terms", not "Days to pay". What goes in this box is what
            they AGREED to — net 30 — and the card in the rail is where what
            they actually do is measured. Running the two words together is how
            a promise starts being read as a record. */}
        <span class="field-label">Payment terms</span>
        <input
          type="text"
          name="days_to_pay"
          inputmode="numeric"
          value={customer.days_to_pay === null ? '' : String(customer.days_to_pay)}
          placeholder="30"
          class={`${field} tabular-nums`}
        />
        <span class="field-hint block">
          Days from a clean invoice, as agreed. Type 30 for net 30. If you leave it blank, it stays
          blank — a guessed 30 here would be a payment term we made up.
        </span>
      </label>

      <label class="block">
        <span class="field-label">Notes</span>
        <textarea name="notes" rows="4" class={field}>{customer.notes ?? ''}</textarea>
      </label>

      <div class="flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
        <button type="submit" name="intent" value="save_customer" class="btn btn-primary">
          Save customer
        </button>
        {/* A link goes places; a button does things. This one navigates, so it
            is a link — wearing the tertiary 44px pattern rather than a 20px
            line of text, and the arrow is decoration the reader is not read. */}
        <a href="/app/customers" class="btn btn-tertiary">
          <span aria-hidden="true">←</span> Back to customers
        </a>
      </div>
    </form>

    <div class="space-y-4">
      {/*
        PROMISED AGAINST ACTUAL, with the actual half drawn as the absence it is.

        The pair is the whole point of the card. A single "30" reads as a fact
        about this broker's behaviour; it is a fact about a sentence on a rate
        confirmation. The second box is where the measured figure would go, and
        it is empty because nothing in this database records the day an invoice
        went out or the day the money arrived — so it renders as the dashed slot
        this app draws for every figure it does not have, never as a 0 and never
        as a guess.
      */}
      <div class={card}>
        {/* 12px, so ink-700. */}
        <h3 class="text-xs tracking-wide text-ink-700 uppercase">How fast they pay</h3>

        {/* TWO BARS, ONE SCALE. The pair is the point: a lone "30" reads as a
            fact about this broker's behaviour when it is a fact about a
            sentence on a rate confirmation. Where the measured half does not
            exist, Bars draws the dashed slot every unknown gets in this app and
            the note under it says why — never a zero, never a guess. */}
        <div class="mt-3">
          <Bars items={speedBars} max={speedCeiling} />
        </div>

        {speedFinding && <p class="mt-3 text-sm text-ink-700">{speedFinding}</p>}

        {/* ------------------------------------------------- the gauge

            "Did they keep their word", as one share with both counts beside it.
            The two bars above say how long; this says how often they made it.

            The WORD carries the finding and the colour is the second signal —
            roughly one man in twelve cannot separate the red from the amber,
            and this is read in a yard. The counts are printed under it, so the
            share is never a score nobody can check.

            No figure without terms to judge against, and no figure from one or
            two invoices: both come back as the dashed slot and the sentence
            that says which of the two it is. */}
        <div class="mt-4 border-t border-ink-100 pt-3">
          <div class="text-sm font-medium text-ink-700">Paid on time</div>
          {
            speed && punctuality && speed.onTimePercent !== null ? (
              <>
                <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-3">
                  <span class:list={['text-3xl font-semibold tabular-nums', TONES[punctuality.tone].text]}>
                    {speed.onTimePercent}%
                  </span>
                  <span class:list={['text-sm font-semibold', TONES[punctuality.tone].text]}>
                    {punctuality.word}
                  </span>
                </div>
                <div
                  class:list={['mt-1.5 h-3 overflow-hidden rounded-full', TONES[punctuality.tone].track]}
                  role="img"
                  aria-label={`${punctuality.word}. ${speed.onTime} of ${speed.measured} paid ${invoiceWord(speed.measured)} arrived by the agreed day.`}
                >
                  <div
                    class:list={['h-full rounded-full', TONES[punctuality.tone].bar]}
                    style={`width:${speed.onTimePercent}%`}
                  />
                </div>
                <p class="mt-1.5 text-sm text-ink-700">{punctualityLine}</p>
              </>
            ) : (
              <>
                {/* The dashed slot, same treatment every unknown gets on every
                    chart in this app. Announced as text, not as a shape. */}
                <div class:list={['mt-1.5 h-8 rounded-lg', UNKNOWN_SLOT]} aria-hidden="true" />
                <p class="mt-1.5 text-sm text-ink-700">
                  {speed?.punctualityAbsence ??
                    'We could not read their load history just now, so there is no figure here. That is not the same as them paying on time.'}
                </p>
              </>
            )
          }
        </div>

        {
          speedCoverage.length > 0 && (
            <ul class="mt-3 space-y-1 border-t border-ink-100 pt-3 text-sm text-ink-700">
              {speedCoverage.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          )
        }

        <p class="mt-3 border-t border-ink-100 pt-3 text-xs text-ink-700">
          Added <span class="tabular-nums">{formatStamp(customer.created_at)}</span>
        </p>
      </div>

      {
        /* ------------------------------------------------------------------
           The federal block.

           Four outcomes, four different sentences, and the distinctions are the
           feature. `rows` is a finding. `empty` means the file answered and had
           nothing, which is NOT the same as the broker having no authority —
           the authority datasets do not cover every entity. `error` means we
           did not get an answer at all, and in that case the page says nothing
           whatsoever about their authority, because the alternative is an
           absence of red that reads as a green light. `mc_only` means we hold a
           docket number and no USDOT number, and the public lookup is keyed by
           USDOT — so we could not ask, and we say so rather than implying we
           did.
           ------------------------------------------------------------------ */
      }
      {
        federal && (
          <div class={card}>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-xs tracking-wide text-ink-700 uppercase">Operating authority</h3>
              <span class="text-xs text-ink-700">Public FMCSA record</span>
            </div>

            {federal.state === 'mc_only' && (
              <p class="mt-2 text-sm text-ink-500">
                We have a docket number for them but no USDOT number. The public authority file is
                searched by USDOT number, so we have not checked. This says nothing about their
                authority either way. Add their USDOT number above and this fills in.
              </p>
            )}

            {federal.state === 'checked' && federal.authority.state === 'rows' && (
              <>
                <ul class="mt-3 space-y-1.5 text-sm">
                  {federal.authority.rows.map((a) => (
                    <li class="flex flex-wrap items-center gap-2">
                      <span class="font-medium tabular-nums">{a.docket_number ?? '—'}</span>
                      {a.op_auth_type && <span class="text-ink-500">{a.op_auth_type}</span>}
                      <span
                        class:list={authorityPillClass(a.op_auth_status)}
                      >
                        {a.op_auth_status ?? 'Unknown'}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="mt-3 text-xs text-ink-700">
                  Read live from the federal authority file for USDOT{' '}
                  <span class="tabular-nums">{federal.dot}</span>. Your insurer and your factor
                  read the same record.
                </p>
              </>
            )}

            {federal.state === 'checked' && federal.authority.state === 'empty' && (
              <p class="mt-2 text-sm text-ink-500">
                No authority record came back for USDOT{' '}
                <span class="tabular-nums">{federal.dot}</span>.{' '}
                <strong class="font-medium text-ink-700">
                  That is not the same as having none.
                </strong>{' '}
                The federal authority file does not cover every company. A company that only
                operates inside one state never needed authority, and some companies are simply
                not in the file. Read this as "we did not find one", not as "there is none". Ask
                them to confirm.
              </p>
            )}

            {federal.state === 'checked' && federal.authority.state === 'error' && (
              <p class="mt-2 text-sm text-ink-500">
                We could not reach the federal authority file just now. So we will not tell you
                anything about their authority, not even that it looks fine. Nothing here has been
                checked. Try again in a moment.
              </p>
            )}

            {
              /* The census line is strictly supporting detail, and it gets its
                 own three outcomes for the same reason: silence where a name
                 usually sits would be read as a finding. Note that a broker
                 having NO carrier-census entry is completely normal — brokers
                 are not carriers — so that case is worded to mean nothing. */
            }
            {federal.state === 'checked' && (
              <p class="mt-3 border-t border-ink-100 pt-3 text-xs text-ink-700">
                {federal.census.state === 'row' && (
                  <>
                    Federal carrier census:{' '}
                    <span class="text-ink-700">{federal.census.row.legal_name ?? 'name withheld'}</span>
                    {federal.census.row.phy_city && (
                      <> · {federal.census.row.phy_city}, {federal.census.row.phy_state}</>
                    )}
                  </>
                )}
                {federal.census.state === 'none' && (
                  <>
                    No entry in the federal carrier census for this USDOT number. That file lists
                    carriers, so most brokers have no entry. This says nothing bad about them.
                  </>
                )}
                {federal.census.state === 'error' && (
                  <>The carrier census did not answer either, so there is nothing to show from it.</>
                )}
              </p>
            )}
          </div>
        )
      }

      <p class="px-1 text-xs text-ink-700">
        Federal data is retrieved live from the FMCSA public files. FleetView Compliance is not
        affiliated with FMCSA, the DOT, or any government agency.
      </p>
    </div>
  </div>

  {
    historyFailed && (
      <p class="mt-8 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
        We could not read their load history just now, so there are no charts on this page. This
        does not mean you have hauled nothing for them. It means we have no answer.
      </p>
    )
  }

  {
    months && mix && (
      <div class="mt-8 space-y-4">
        <Figure
          title="What they have been worth"
          subtitle={`Booked rates over the last ${months.months} months`}
          coverage={revenueCoverage}
        >
          <Columns
            columns={months.columns.map((c) => ({
              label: c.label,
              value: c.value,
              // THE FULL FIGURE, WITH COMMAS AND CENTS. `revenueByMonth`
              // hands back a compact display — '$12.4k' — and that is not a
              // number anybody can check against an invoice. It is overridden
              // here rather than in the derivation because the derivation is
              // shared with screens this pass does not own. `c.display` is
              // still used where there is no figure at all, because it carries
              // the two different absences in words ('no rate' against '—').
              display: c.value === null ? c.display : formatCents(c.value),
              // The part month is toned down and named in the sentence below.
              // A broker who is having a perfectly normal September must not
              // appear to have stopped calling on the 15th of it.
              inProgress: c.isCurrent,
            }))}
            max={revenueCeiling}
            axisLabel={revenueCeiling > 0 ? `Full height ${formatCents(revenueCeiling)}` : undefined}
            emptyMessage="No rates have been typed on any of their loads, so there is nothing to draw."
          />
          {months.window.countedLoads > 0 && (
            <p class="mt-3 text-sm text-ink-500">
              <span class="font-medium text-ink-900 tabular-nums">
                {formatCents(months.window.totalCents)}
              </span>{' '}
              booked with them across {months.window.countedLoads} priced{' '}
              {loadWord(months.window.countedLoads)}. The last column is the month still running.
            </p>
          )}
        </Figure>

        <Figure
          title="Where their money is"
          subtitle="Their loads by billing status. This is a different question from where the trucks are"
          coverage={mixCoverage}
        >
          <Proportion
            segments={mix.slices}
            total={mix.total}
            emptyMessage="Nothing booked with them has passed the quote stage yet."
          />
          <div class="mt-3 space-y-1 text-sm text-ink-500">
            {readySlice && readySlice.count > 0 && (
              <p>
                <span class="font-medium text-ink-900 tabular-nums">
                  {formatCents(readySlice.cents)}
                </span>{' '}
                across {readySlice.count} {loadWord(readySlice.count)} is ready to invoice and has
                not been sent to them.
              </p>
            )}
            {awaitingSlice && awaitingSlice.count > 0 && (
              <p>
                <span class="tabular-nums">{formatCents(awaitingSlice.cents)}</span> across{' '}
                {awaitingSlice.count} {loadWord(awaitingSlice.count)} is invoiced and still out.{' '}
                {termsLine}
              </p>
            )}
            {problemSlice && problemSlice.count > 0 && (
              <p class="text-red-700">
                {problemSlice.count} {loadWord(problemSlice.count)} short paid, in dispute or
                written off: <span class="tabular-nums">{formatCents(problemSlice.cents)}</span>.
              </p>
            )}
            {awaitingSlice?.count === 0 && <p>{termsLine}</p>}
          </div>
        </Figure>
      </div>
    )
  }

  {/*
    THE AGE OF WHAT IS STILL OUT.

    The bar above says WHERE their money is. This says HOW LONG it has been
    there, which is the question "do they pay on time" rearranged into one this
    database can actually answer. Only rendered when something is out: four
    $0.00 bands on a broker who owes nothing is a wall of zeros that says less
    than the card in the rail already does.
  */}
  {
    aging && aging.waitingLoads + aging.disputedLoads > 0 && (
      <div class="mt-4">
        <Figure
          title="What they owe you, and how long it has sat"
          subtitle="Their loads you have invoiced and not been paid for, by how old the load is"
          coverage={agingCoverage}
        >
          <Bars
            items={aging.bands.map((b) => ({
              label: b.label,
              value: b.value,
              display: b.display,
              note:
                b.loads === 0
                  ? 'Nothing this old'
                  : `${b.loads} ${loadWord(b.loads)}${b.unpricedLoads > 0 ? `, ${b.unpricedLoads} with no rate yet` : ''}`,
              tone: b.tone,
            }))}
            emptyMessage="Nothing of theirs is invoiced and waiting."
          />

          <div class="mt-4 space-y-1.5 border-t border-ink-100 pt-3 text-sm text-ink-700">
            {aging.waitingLoads > 0 ? (
              <p>
                <span class="font-semibold tabular-nums">{formatCents(aging.totalCents)}</span> of
                theirs is invoiced and not paid, across {aging.countedLoads}{' '}
                {loadWord(aging.countedLoads)}
                {aging.oldestDays !== null && (
                  /* "Has been out", not "was entered": some of these rows are
                     aged from an invoice date and some from the day the load
                     was typed in. The coverage line above says exactly which,
                     in numbers, and this sentence must not contradict it by
                     naming one of the two. */
                  <>
                    . The oldest has been out{' '}
                    <span class="tabular-nums">{daysWord(aging.oldestDays)}</span>
                  </>
                )}
                . {termsLine}
              </p>
            ) : (
              <p>Nothing of theirs is invoiced and waiting. {termsLine}</p>
            )}
            {(aging.chaseLoads > 0 || aging.chaseUnpricedLoads > 0) && (
              <p class="font-medium text-red-700">
                {aging.chaseLoads > 0 && (
                  <>
                    <span class="tabular-nums">{formatCents(aging.chaseCents)}</span> has been out
                    more than <span class="tabular-nums">{daysWord(aging.chaseAfterDays)}</span>, on{' '}
                    {aging.chaseLoads} {loadWord(aging.chaseLoads)}.{' '}
                  </>
                )}
                {aging.chaseUnpricedLoads > 0 && (
                  <>
                    {aging.chaseUnpricedLoads} more {loadWord(aging.chaseUnpricedLoads)} past that
                    line carry no rate, so {aging.chaseUnpricedLoads === 1 ? 'it is' : 'they are'} in
                    no figure here.{' '}
                  </>
                )}
                Ring them today.
              </p>
            )}
            {aging.disputedLoads > 0 && (
              <p class="font-medium text-red-700">
                Separately, {aging.disputedLoads} {loadWord(aging.disputedLoads)} are short paid or
                in dispute: <span class="tabular-nums">{formatCents(aging.disputedCents)}</span>.
                Those are not on the bars above, because waiting will not fix them.
              </p>
            )}
          </div>
        </Figure>
      </div>
    )
  }

  <div class="mt-8">
    <h2 class="text-lg font-semibold tracking-tight">Recent loads</h2>
    <p class="mt-1 max-w-3xl text-sm text-ink-500">
      The last ten loads you booked with them. Where the truck is and where the money is are two
      separate columns. A load can be delivered and still unpaid, and that is the pair worth
      reading on a customer page.
    </p>

    {
      loadsFailed ? (
        <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
          We could not read the load history just now. This does not mean there are no loads. It
          means we have no answer.
        </p>
      ) : loads.length === 0 ? (
        <div class="mt-4 rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
          <p class="font-medium">No loads for this customer yet</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
            Loads booked against this customer will appear here, newest first, with what each one
            pays and whether the money has arrived.
          </p>
        </div>
      ) : (
        <div class="mt-4 overflow-x-auto rounded-xl border border-ink-100 bg-white">
          <table class="w-full text-sm sm:min-w-[48rem]">
            {/*
              No header line on a phone. Five column names above blocks that are
              not columns explain nothing — each block says what it is in its own
              words instead.
            */}
            <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
              <tr>
                <th class="px-4 py-3 font-medium">Load</th>
                <th class="px-4 py-3 font-medium">Booked</th>
                <th class="px-4 py-3 font-medium">Status</th>
                <th class="px-4 py-3 font-medium">Billing</th>
                <th class="px-4 py-3 text-right font-medium">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-100">
              {loads.map((l) => (
                /* The block leads with the load number, which is what a broker
                   quotes down the phone and what this table is looked up by. */
                <tr class="flex flex-col py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                  <td class={`${cell} order-1`}>
                    <a href={`/app/loads/${l.id}`} class="link-row">
                      {loadLabel(l)}
                    </a>
                    {l.broker_reference && l.load_number && (
                      <div class="text-xs text-ink-700 tabular-nums">
                        Their ref {l.broker_reference}
                      </div>
                    )}
                  </td>
                  {/* Last on a phone. The day it was booked is how the list is
                      sorted, not something read off a row. */}
                  <td
                    class={`${cell} order-5 mt-0.5 text-xs whitespace-nowrap text-ink-700 tabular-nums sm:mt-0 sm:text-sm sm:text-ink-900`}
                  >
                    <span class="sm:hidden">Booked </span>
                    {formatStamp(l.created_at)}
                  </td>
                  {/* Fourth on a phone. Where the truck is has its own screen. */}
                  <td class={`${cell} order-4 mt-1.5 sm:mt-0`}>
                    <span
                      class={statusPillClass(l.status)}
                    >
                      {loadStatusLabel(l.status)}
                    </span>
                    {
                      /* The exception sits NEXT TO the status, never instead of
                         it. A detained load is still at the shipper, and losing
                         that loses where the truck actually is. */
                    }
                    {l.exception && (
                      <span
                        class:list={['ml-1.5', exceptionPillClass(l.exception)]}
                      >
                        {exceptionLabel(l.exception)}
                      </span>
                    )}
                  </td>
                  {/* The billing state keeps its own line on a phone: where the
                      truck is and where the money is are two different answers,
                      and running them together is what this table is at pains
                      not to do. */}
                  <td class={`${cell} order-3 mt-1.5 sm:mt-0`}>
                    <span
                      class={billingPillClass(l.billing)}
                    >
                      {billingStatusLabel(l.billing)}
                    </span>
                  </td>
                  {
                    /* formatCents renders NULL as '—' and never as '$0.00'. An
                       unpriced load and a load that pays nothing go to two
                       different people. */
                  }
                  {/* SECOND ON A PHONE. What the load pays is the number this
                      page is opened for, and it was the furthest off the edge. */}
                  <td
                    class={`${cell} order-2 mt-1.5 font-medium whitespace-nowrap tabular-nums sm:mt-0 sm:text-right sm:font-normal`}
                  >
                    <span class={said}>Total </span>
                    {formatCents(totalRateCents(l))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</App>
