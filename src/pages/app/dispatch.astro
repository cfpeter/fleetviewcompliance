---
/**
 * The board. Every load that is on the hook right now, and who is under it.
 *
 * This screen answers one question twenty times a day — "what still needs a
 * truck?" — so the unassigned loads are not a filter you select, they are the
 * first thing on the page. Everything else is reference.
 *
 * It is also where compliance stops being a tab. Each assigned load is run back
 * through the same `eligibility()` engine the assignment screen uses, because a
 * driver who was qualified when he was assigned on Monday can be unqualified by
 * Thursday, and nothing else in the product would ever say so.
 *
 * Read-only: no POST, no intents. Every action on this page is a link to the
 * assignment screen, which owns the writes.
 */
import Columns from '../../components/charts/Columns.astro'
import Figure from '../../components/charts/Figure.astro'
import App from '../../layouts/App.astro'
import { flashText } from '../../lib/flash.ts'
import { bucketValues, ceilingFor, weekBuckets, weekStart } from '../../lib/charts/scale.ts'
import { loadDeadlines } from '../../lib/deadlines.ts'
import { eligibility, isBlocked } from '../../lib/dispatch/eligibility.ts'
// The status and exception colours are NOT decided here. They come from the same
// four functions the Loads list and the load page call, so one status is one
// colour everywhere in the app — see src/lib/loads.ts.
import {
  exceptionLabel,
  exceptionPillClass,
  loadStatusLabel,
  statusPillClass,
  totalRateCents,
} from '../../lib/loads.ts'
import type { DeadlineItem } from '../../lib/rules/index.ts'
import { formatCents } from '../../lib/stops.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

/**
 * "Booked or later, and not finished."
 *
 * Written out as a list rather than as a `gte`/`lt` pair on the enum. PostgREST
 * WILL order an enum by its declaration position, so `status=gte.booked` parses
 * and returns rows — which makes it exactly the kind of clever filter that goes
 * silently wrong the day somebody adds a value to `load_status` in the middle of
 * the enum to keep it tidy. A list breaks loudly instead: a new status simply
 * does not appear here until someone decides it belongs on the board.
 *
 * `quoted` is out because it is not work yet, `delivered` and `pod_received`
 * because the truck is off it.
 */
const BOARD_STATUSES = [
  'booked',
  'assigned',
  'dispatched',
  'at_shipper',
  'loaded',
  'in_transit',
  'at_consignee',
] as const

/** The carrier's own day. Every time on this page is rendered in it. */
const TZ = 'America/Los_Angeles'

interface LoadRow {
  id: string
  load_number: string | null
  broker_reference: string | null
  customer_id: string | null
  status: string
  exception: string | null
  /** Integer cents, or null when nobody has typed a rate yet. Never a float. */
  linehaul_cents: number | null
  fuel_surcharge_cents: number | null
  accessorials_cents: number | null
  created_at: string
}

interface StopRow {
  load_id: string
  sequence: number
  stop_type: string
  company_name: string | null
  city: string | null
  state: string | null
  window_start: string | null
}

interface AssignmentRow {
  load_id: string
  driver_id: string | null
  co_driver_id: string | null
  tractor_id: string | null
  trailer_id: string | null
  assigned_at: string
}

interface DriverRow {
  id: string
  first_name: string
  last_name: string
  status: string
}

interface VehicleRow {
  id: string
  kind: string
  unit_number: string | null
  vin: string | null
}

// There is no .eq('carrier_id', ...) on any SELECT in this file. RLS already
// limits every row to the signed-in user's carrier, and repeating the check here
// would read as though the policy might not hold — which is how somebody
// eventually "fixes" a bug by loosening the policy instead of the query.
const { data: loadData, error: loadError } = await supabase
  .from('loads')
  .select(
    'id, load_number, broker_reference, customer_id, status, exception, linehaul_cents, fuel_surcharge_cents, accessorials_cents, created_at',
  )
  .in('status', BOARD_STATUSES)
  // `.neq('exception', 'cancelled')` looks equivalent and is not: in SQL
  // `NULL <> 'cancelled'` is NULL, not true, so every load with no exception at
  // all — which is nearly all of them — would be filtered straight off the
  // board. The board would come up empty on a carrier with twelve running loads.
  .or('exception.is.null,exception.neq.cancelled')
  .order('created_at', { ascending: true })

const loads = (loadData ?? []) as LoadRow[]
const loadIds = loads.map((l) => l.id)

// ---------------------------------------------------------------------------
// Weekly pace
// ---------------------------------------------------------------------------

/** How many weeks the pace chart draws. Two months is one season of freight. */
const PACE_WEEKS = 8
const MS_DAY = 86_400_000

/**
 * The carrier's calendar day for an instant, as UTC midnight of that day.
 *
 * `weekBuckets` cuts weeks on UTC Mondays, and the rest of this file is careful
 * that a 7am Fontana time is never rendered as a UTC one. Without this the two
 * disagree: a load given a driver at 6pm Sunday in Los Angeles is already
 * Monday in UTC, so it would be counted in the following week — every Sunday
 * evening, on every column.
 */
const LA_DAY = new Intl.DateTimeFormat('en-CA', {
  timeZone: TZ,
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
})
function carrierDay(ms: number): Date {
  return new Date(`${LA_DAY.format(new Date(ms))}T00:00:00Z`)
}

/** Eight consecutive weeks ending with the one the carrier is standing in. */
const paceBuckets = weekBuckets(
  new Date(weekStart(carrierDay(Date.now())).getTime() - (PACE_WEEKS - 1) * 7 * MS_DAY),
  PACE_WEEKS,
)

/**
 * A ceiling on the rows read for the chart, so one busy carrier cannot turn a
 * board request into an unbounded read. If it is ever hit the chart says so
 * rather than quietly drawing short columns.
 */
const PACE_ROW_CAP = 2000

/**
 * Everything else the board needs, in parallel.
 *
 * The name lookups are fetched whole rather than embedded into the load query.
 * `load_assignments` has TWO foreign keys into `drivers` and TWO into
 * `vehicles`, so a PostgREST embed has to be disambiguated with a hint naming
 * the constraint — a string that is not checked at build time and that renames
 * itself the next time somebody rewrites the migration. A carrier has tens of
 * drivers, not thousands; two flat selects and a Map are cheaper to be right
 * about. They are also fetched WITHOUT a status filter, because a terminated
 * driver can still be sitting on an open load and rendering him as a blank cell
 * would hide exactly the row that needs attention.
 */
const [
  { data: stopData },
  { data: assignmentData },
  { data: driverData },
  { data: vehicleData },
  deadlines,
  { data: paceData },
  { data: firstEverData },
] = await Promise.all([
  loadIds.length > 0
    ? supabase
        .from('load_stops')
        .select('load_id, sequence, stop_type, company_name, city, state, window_start')
        .in('load_id', loadIds)
        .order('sequence', { ascending: true })
    : Promise.resolve({ data: [] as StopRow[] }),
  loadIds.length > 0
    ? supabase
        .from('load_assignments')
        .select('load_id, driver_id, co_driver_id, tractor_id, trailer_id, assigned_at')
        // The partial index on this table is `where unassigned_at is null`, and
        // so is the definition of "who is on this load right now". A released
        // assignment is history, not a current answer.
        .is('unassigned_at', null)
        .in('load_id', loadIds)
        .order('assigned_at', { ascending: false })
    : Promise.resolve({ data: [] as AssignmentRow[] }),
  supabase.from('drivers').select('id, first_name, last_name, status'),
  supabase.from('vehicles').select('id, kind, unit_number, vin'),
  loadDeadlines(supabase, carrierId),
  // The pace chart, and the ONLY query on this page that is not about what is
  // happening right now. No `unassigned_at is null` here on purpose: a load
  // that got a driver five weeks ago and has long since delivered still
  // happened, and filtering it out would draw a chart of the current board
  // eight times over instead of eight weeks of work.
  supabase
    .from('load_assignments')
    .select('load_id, assigned_at')
    .gte('assigned_at', paceBuckets[0].start.toISOString())
    .order('assigned_at', { ascending: false })
    .limit(PACE_ROW_CAP),
  // The oldest assignment this carrier has, ever. It is what separates "you
  // ran nothing that week" from "you were not here that week" — see below.
  supabase
    .from('load_assignments')
    .select('assigned_at')
    .order('assigned_at', { ascending: true })
    .limit(1),
])

const stops = (stopData ?? []) as StopRow[]
const assignments = (assignmentData ?? []) as AssignmentRow[]
const drivers = (driverData ?? []) as DriverRow[]
const vehicles = (vehicleData ?? []) as VehicleRow[]

/**
 * Loads given a driver, per week.
 *
 * Counted on the FIRST assignment each load got inside the window, so a load
 * whose driver was swapped twice on Tuesday is one load, not three. A load that
 * was already running before the window and got a new driver inside it counts
 * in the week of the change — the earlier row is outside the query and there is
 * no way to know about it from here, so the chart says so rather than guessing.
 */
const paceRows = (paceData ?? []) as { load_id: string; assigned_at: string }[]
const paceTruncated = paceRows.length >= PACE_ROW_CAP

const firstByLoad = new Map<string, number>()
for (const r of paceRows) {
  const t = Date.parse(r.assigned_at)
  if (Number.isNaN(t)) continue
  const prev = firstByLoad.get(r.load_id)
  if (prev === undefined || t < prev) firstByLoad.set(r.load_id, t)
}

// `emptyIsZero` because this is a count of records we write ourselves: a week
// with no assignment row really is a week in which no load got a driver. That
// is only true from the day the carrier started here, which the next block
// handles.
const paceCounts = bucketValues(
  [...firstByLoad.values()],
  paceBuckets,
  (t) => carrierDay(t),
  () => 1,
  true,
)

/**
 * The day this carrier first put a driver under anything, in bucket space.
 *
 * Pushed through `carrierDay` for the same reason the counts are: the buckets
 * are the carrier's weeks, and comparing a raw UTC instant against them puts
 * anything assigned late on a Sunday evening in the wrong week.
 */
const firstEverRow = ((firstEverData ?? []) as { assigned_at: string }[])[0]
const firstEverParsed = firstEverRow ? Date.parse(firstEverRow.assigned_at) : Number.NaN
const firstEverMs = Number.isNaN(firstEverParsed) ? null : carrierDay(firstEverParsed).getTime()

const paceColumns = paceBuckets.map((b, i) => {
  /**
   * A week that ended before this carrier ever put a driver under a load is not
   * a quiet week. Zero there is a claim about his business; the dashed slot is
   * a claim about our records, and ours is the only one we can evidence. A
   * carrier who signed up on Thursday must not open this page and see seven
   * weeks of failure.
   */
  const beforeUs = firstEverMs === null || b.end.getTime() <= firstEverMs
  const value = beforeUs ? null : (paceCounts[i] ?? 0)
  return {
    label: b.label,
    value,
    display: value === null ? 'no records' : String(value),
    // The week in progress is short for a reason that has nothing to do with
    // the business. Faded and announced as "so far", never dropped.
    inProgress: i === paceBuckets.length - 1,
  }
})

const paceTotal = paceCounts.reduce((sum: number, v) => sum + (v ?? 0), 0)
const paceCeiling = ceilingFor(paceColumns.map((c) => c.value))
const paceMissingWeeks = paceColumns.filter((c) => c.value === null).length

const paceCoverage = [
  'A load is counted on the day you first put a driver under it, not the day it was booked or the day it delivered.',
  'A driver change on a load that was already running counts that load again, in the week of the change.',
  paceMissingWeeks > 0 &&
    `${paceMissingWeeks} ${paceMissingWeeks === 1 ? 'week is' : 'weeks are'} marked "no records" because they are before your first load here. That is not zero loads.`,
  paceTruncated &&
    `Only the newest ${PACE_ROW_CAP.toLocaleString('en-US')} driver assignments were read, so the oldest weeks may be short.`,
].filter((v): v is string => typeof v === 'string')

const driverById = new Map(drivers.map((d) => [d.id, d]))
const vehicleById = new Map(vehicles.map((v) => [v.id, v]))
const customerIds = [...new Set(loads.map((l) => l.customer_id).filter((v): v is string => !!v))]
const { data: customerData } =
  customerIds.length > 0
    ? await supabase.from('customers').select('id, name').in('id', customerIds)
    : { data: [] as { id: string; name: string }[] }
const customerById = new Map(
  ((customerData ?? []) as { id: string; name: string }[]).map((c) => [c.id, c.name]),
)

/**
 * The deadline items for one driver, keyed by driver id.
 *
 * `loadDeadlines()` returns every subject the carrier has; `eligibility()` wants
 * one subject's worth. Filtering by BOTH subjectType and subjectId matters: a
 * driver id and a vehicle id are both uuids out of the same generator, so an id
 * comparison alone would happily mix a truck's inspection into a driver's
 * qualification check the first time the two ever collided.
 */
const itemsByDriver = new Map<string, DeadlineItem[]>()
for (const item of deadlines as DeadlineItem[]) {
  if (item.subjectType !== 'driver' || !item.subjectId) continue
  const bucket = itemsByDriver.get(item.subjectId)
  if (bucket) bucket.push(item)
  else itemsByDriver.set(item.subjectId, [item])
}

/** The one assignment that counts for each load: the most recent open one. */
const assignmentByLoad = new Map<string, AssignmentRow>()
for (const a of assignments) {
  // Ordered assigned_at DESC above, so the first one seen for a load wins. There
  // should only ever be one open row per load — the assignment screen closes the
  // previous one before inserting — but a board that renders two overlapping
  // answers is worse than one that picks the newest and says so.
  if (!assignmentByLoad.has(a.load_id)) assignmentByLoad.set(a.load_id, a)
}

const stopsByLoad = new Map<string, StopRow[]>()
for (const s of stops) {
  const bucket = stopsByLoad.get(s.load_id)
  if (bucket) bucket.push(s)
  else stopsByLoad.set(s.load_id, [s])
}

function driverName(id: string | null | undefined): string | null {
  if (!id) return null
  const d = driverById.get(id)
  return d ? `${d.first_name} ${d.last_name}`.trim() : 'Unknown driver'
}

function unitName(id: string | null | undefined): string | null {
  if (!id) return null
  const v = vehicleById.get(id)
  if (!v) return 'Unknown unit'
  // A VIN is a terrible thing to read off a screen, but it beats a blank cell on
  // a trailer nobody has given a number to yet.
  return v.unit_number || (v.vin ? `VIN ${v.vin.slice(-6)}` : 'Unnumbered unit')
}

/**
 * A timestamptz rendered in the carrier's day, never the server's.
 *
 * Astro runs this on Cloudflare, where the process timezone is UTC. A 7am
 * Fontana appointment formatted without a zone comes out as 2pm — the single
 * number on this row that a dispatcher acts on, wrong by seven hours, on every
 * load, silently.
 */
function formatWhen(ts: string | null): string {
  if (!ts) return ''
  const d = new Date(ts)
  if (Number.isNaN(d.getTime())) return ''
  return d.toLocaleString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: TZ,
  })
}

function place(s: StopRow | undefined): string {
  if (!s) return ''
  const town = [s.city, s.state].filter(Boolean).join(', ')
  return town || s.company_name || ''
}

/** Ours if we have it, theirs if we do not — and never a bare uuid. */
function loadLabel(l: LoadRow): string {
  return l.load_number || l.broker_reference || `Load ${l.id.slice(0, 8)}`
}

/*
 * There is no status colour table in this file any more.
 *
 * There was one, and it disagreed with the Loads list on six of the seven
 * statuses the board can show: `booked` was grey here and blue there,
 * `at_shipper` through `at_consignee` were green here and blue there, and
 * `breakdown` was red-700 here and red-800 there. A dispatcher who reads the
 * board and then opens the Loads list is looking at the same load twice, and the
 * colour changed underneath her. `statusPillClass` and `exceptionPillClass` are
 * imported at the top instead, and the words come from `loadStatusLabel` and
 * `exceptionLabel` so "at_shipper" renders as "At shipper" on both screens.
 */

/**
 * The one state a load is in for the dot on its card.
 *
 * It answers one question and only one: can this load roll with the people on
 * it. The colours are the deadline palette and mean what they always mean here
 * — red act now, amber check it, grey we do not know, green on track — and
 * every one of them is printed with its word beside it, never on its own. The
 * operational exception (detained, breakdown, late) keeps its own pill and is
 * deliberately NOT folded in: where the truck is and whether the driver is
 * legal are two different questions, and one dot cannot answer both.
 */
type Readiness = 'blocked' | 'off_roster' | 'ready' | 'nobody'

const READINESS: Record<Readiness, { dot: string; text: string; word: string }> = {
  blocked: { dot: 'bg-red-500', text: 'text-red-700', word: 'Not qualified' },
  off_roster: { dot: 'bg-amber-500', text: 'text-amber-800', word: 'Not on the roster' },
  ready: { dot: 'bg-emerald-500', text: 'text-emerald-800', word: 'Driver is good' },
  // ink-700, not ink-500: this word is printed at 12px, and 12px is where the
  // floor in global.css moves up. Grey still means "we do not know" — it is just
  // grey somebody can read.
  nobody: { dot: 'bg-ink-300', text: 'text-ink-700', word: 'No driver yet' },
}

interface BoardRow {
  id: string
  label: string
  brokerReference: string | null
  customer: string | null
  status: string
  exception: string | null
  pickupWhere: string
  pickupWhen: string
  deliveryWhere: string
  deliveryWhen: string
  driver: string | null
  coDriver: string | null
  tractor: string | null
  trailer: string | null
  /** The driver on this load is not qualified to be on it, right now. */
  blocked: boolean
  /** The engine has never seen this driver — inactive, terminated, or deleted. */
  driverOffRoster: boolean
  /** What the dot on the card says. Derived from the two flags above. */
  readiness: Readiness
  /**
   * What the load pays all in — linehaul, fuel surcharge and accessorials — in
   * integer cents, or null when nobody has typed any of the three. The same
   * `totalRateCents` /app/loads and the load page print, so one load is one
   * figure on every board.
   */
  rateCents: number | null
  sortKey: number
}

const rows: BoardRow[] = loads.map((l) => {
  const mine = stopsByLoad.get(l.id) ?? []
  // First PICKUP and last DELIVERY by sequence, not first and last stop. A load
  // that ends on a drop-and-hook or a fuel stop would otherwise print the fuel
  // stop as the delivery, which is where the truck is going least.
  const pickup = mine.find((s) => s.stop_type === 'pickup')
  const delivery = [...mine].reverse().find((s) => s.stop_type === 'delivery')

  const a = assignmentByLoad.get(l.id)
  const items = a?.driver_id ? itemsByDriver.get(a.driver_id) : undefined
  const driver = driverName(a?.driver_id)

  // The same engine the assignment screen gates on, asked again about today.
  // The label is the driver's real name so that the issue messages this
  // produces stay usable if this row ever grows a tooltip or an expander.
  const blocked = items ? isBlocked(eligibility({ items, label: driver ?? 'This driver' })) : false
  // `loadDeadlines()` only evaluates ACTIVE drivers. So a driver who has been
  // terminated since he was assigned has no items at all, and an absent bucket
  // reads identically to a spotless file. Distinguishing the two here is what
  // stops "no issues" being printed next to a man who no longer works here.
  const driverOffRoster = Boolean(a?.driver_id) && !items

  return {
    id: l.id,
    label: loadLabel(l),
    brokerReference: l.broker_reference,
    customer: l.customer_id ? (customerById.get(l.customer_id) ?? null) : null,
    status: l.status,
    exception: l.exception,
    pickupWhere: place(pickup),
    pickupWhen: formatWhen(pickup?.window_start ?? null),
    deliveryWhere: place(delivery),
    deliveryWhen: formatWhen(delivery?.window_start ?? null),
    driver,
    coDriver: driverName(a?.co_driver_id),
    tractor: unitName(a?.tractor_id),
    trailer: unitName(a?.trailer_id),
    blocked,
    driverOffRoster,
    // Worst first. A driver who is off the roster AND fails a date is a red
    // card, not an amber one.
    readiness: blocked
      ? 'blocked'
      : driverOffRoster
        ? 'off_roster'
        : driver
          ? 'ready'
          : 'nobody',
    // Integer cents all the way. It is formatted once, at the point it is
    // printed, and never divided into a float on the way here.
    rateCents: totalRateCents(l),
    sortKey: pickup?.window_start ? Date.parse(pickup.window_start) : Number.POSITIVE_INFINITY,
  }
})

// Soonest pickup first, undated loads last. A load with no stops yet is not more
// urgent than one leaving in an hour, it is less finished.
rows.sort((a, b) => a.sortKey - b.sortKey || a.label.localeCompare(b.label))

const needsDriver = rows.filter((r) => !r.driver)
const running = rows.filter((r) => r.driver)
const notQualified = running.filter((r) => r.blocked || r.driverOffRoster)

const params = Astro.url.searchParams
const assigned = params.get('assigned')
const released = params.get('released')
// The message is read only when the browser says the request came from this
// site, and a database failure is said in plain words, never in its own.
const error =
  flashText(Astro.url, Astro.request) ??
  (loadError ? 'We could not load the board. Reload the page.' : null)

const card = 'card'

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * This table is 68rem and the window inside it is 341px, so 747px of every row
 * — 69% of it — was behind a sideways scroll, including the Assign link at the
 * far right, which is the only thing on the row anybody presses. Below `sm`
 * every cell becomes a block; from `sm` the same markup is a table again. ONE
 * set of cells, not two, exactly as src/components/Documents.astro does it.
 *
 * The blocks are ORDERED rather than left in column order, which is the one
 * addition to that pattern. The dispatcher is scanning for the load and for
 * whether the driver on it can legally take it, and in column order those two
 * are first and fifth with the customer and both stops between them. `order-*`
 * needs the row to be a flex column below `sm`; from `sm` it is `table-row`
 * again and the property is ignored, so the desktop table is untouched.
 */
const cell = 'block px-4 py-1 sm:table-cell sm:py-3'
/**
 * "Assign" and "Change" ARE BUTTONS, not links that happen to be pressed.
 *
 * They were a bare `<a>` with no padding — a 20px line of text, which is the
 * shortest thing on this page and the only thing on the row anybody touches. A
 * thumb in a yard misses it. `.btn .btn-tertiary` is the shared repeated-action
 * skin from global.css and carries the 44px floor with it, so the target is the
 * button rather than the six characters inside it.
 *
 * Below `sm` it stays the full-width bordered tap at the end of the block,
 * because that is where it used to be off the side of the screen entirely; from
 * `sm` it is the tertiary button at the end of the row. The `flex gap-2` on the
 * cell keeps 8px under it, which is the minimum gap between two 44px targets.
 */
const rowAction =
  'btn btn-tertiary btn-sm flex-1 rounded-lg border border-ink-100 sm:-mr-4 sm:flex-none sm:border-0'

/**
 * What one column of the board is worth.
 *
 * Summed in integer cents and only over the loads that actually carry a rate.
 * A load nobody has priced is NOT a $0 load, so it is counted separately and
 * printed beside the total — a figure that quietly swallows four unpriced loads
 * is the kind of number an owner repeats to a broker and then has to take back.
 */
function columnMoney(rowsIn: BoardRow[]) {
  const priced = rowsIn.filter((r) => r.rateCents !== null)
  return {
    cents: priced.reduce((sum, r) => sum + (r.rateCents ?? 0), 0),
    priced: priced.length,
    unpriced: rowsIn.length - priced.length,
  }
}

const sections = [
  {
    key: 'unassigned',
    title: 'Needs a driver',
    blurb: 'No driver on these yet. This is the list to work first.',
    rows: needsDriver,
    wrapper: 'overflow-x-auto rounded-xl border border-brand-500/30 bg-champagne-50',
    action: 'Assign',
    // Same tint the tile at the top of the page uses for this column, so the
    // big number up there and the big number down here read as one count.
    countClass: 'bg-champagne text-brand-700',
    money: columnMoney(needsDriver),
  },
  {
    key: 'running',
    title: 'On the board',
    blurb: 'These have a driver. We check compliance again every time this page loads.',
    rows: running,
    wrapper: 'overflow-x-auto rounded-xl border border-ink-100 bg-white',
    action: 'Change',
    countClass: 'bg-ink-100 text-ink-900',
    money: columnMoney(running),
  },
]
---

<App title="Dispatch" subtitle="Every load working right now, and who is on it.">
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}
  {
    assigned && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Load {assigned} assigned.
      </p>
    )
  }
  {
    released && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Load {released} released. It is back at the top of the board and needs a driver.
      </p>
    )
  }

  <div class="grid gap-4 sm:grid-cols-3">
    <div
      class:list={[
        'rounded-xl border p-5',
        needsDriver.length > 0 ? 'border-brand-500/40 bg-champagne-50' : 'border-ink-100 bg-white',
      ]}
    >
      {/* A real heading, not a styled div. The label on a tile is the name of
          the number under it, and as a `div` it was invisible to the document
          outline and to a screen reader walking the page by headings.

          ink-700 and not ink-500 on every one of these: they are 12px, and the
          floor in global.css is ink-700 at 12px and under. */}
      <h3 class="text-xs tracking-wide text-ink-700 uppercase">Needs a driver</h3>
      <div class="mt-1 text-3xl font-semibold tabular-nums">{needsDriver.length}</div>
    </div>
    <div class={card}>
      <h3 class="text-xs tracking-wide text-ink-700 uppercase">On the board</h3>
      <div class="mt-1 text-3xl font-semibold tabular-nums">{running.length}</div>
    </div>
    <div
      class:list={[
        'rounded-xl border p-5',
        notQualified.length > 0 ? 'border-red-200 bg-red-50/40' : 'border-ink-100 bg-white',
      ]}
    >
      <h3
        class:list={[
          'text-xs tracking-wide uppercase',
          notQualified.length > 0 ? 'text-red-700' : 'text-ink-700',
        ]}
      >
        Driver not qualified today
      </h3>
      <div
        class:list={[
          'mt-1 text-3xl font-semibold tabular-nums',
          notQualified.length > 0 ? 'text-red-700' : '',
        ]}
      >
        {notQualified.length}
      </div>
    </div>
  </div>

  {
    /*
      PACE, UNDER THE THREE COUNTS AND ABOVE THE WORK.
      The counts are today. This is the only thing on the page that is not, and
      it is here because "am I busier than last month" is a question an owner
      answers by feel and is usually wrong about. Drawn only when there is
      something to draw: eight flat columns at zero is not an answer, and a
      carrier in his first week is not having a bad quarter.
    */
  }
  {
    paceTotal > 0 && (
      <Figure
        class="mt-4"
        title={`${paceTotal} ${paceTotal === 1 ? 'load' : 'loads'} given a driver in the last ${PACE_WEEKS} weeks`}
        subtitle="One column per week. The last column is the week you are in now, so it is not a full week."
        coverage={paceCoverage}
        action={{ href: '/app/loads', label: 'All loads →' }}
      >
        <Columns
          columns={paceColumns}
          max={paceCeiling}
          axisLabel={
            paceCeiling > 0
              ? `Full height ${paceCeiling} ${paceCeiling === 1 ? 'load' : 'loads'}`
              : undefined
          }
          emptyMessage="No load has been given a driver yet, so there is nothing to draw here."
        />
      </Figure>
    )
  }

  {
    rows.length === 0 && (
      <div class="mt-6 rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
        <p class="font-medium">Nothing on the board</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          A load shows here once you book it, and drops off once it is delivered. A new load stays
          at the top of this page until it has a driver.
        </p>
        {/* The one Primary on this page, and it only exists while the board is
            empty. Hand-rolled it was 36px tall; `.btn .btn-primary` is 44px. */}
        <a href="/app/loads/new" class="btn btn-primary mt-4">
          Book a load →
        </a>
      </div>
    )
  }

  {
    sections.map((section) =>
      section.rows.length === 0 ? null : (
        <section class="mt-6">
          {/*
            THE COUNT IS THE HEADING, not a footnote after it. The number of
            loads with nobody under them is the thing this page is opened to
            find out, and at 14px after the words it was the smallest text in
            the block that carried the largest fact.
          */}
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <h2 class="flex items-center gap-2.5 text-base font-semibold tracking-tight">
              <span
                class:list={[
                  'inline-flex min-w-11 justify-center rounded-lg px-2.5 py-1 text-2xl tabular-nums',
                  section.countClass,
                ]}
              >
                {section.rows.length}
              </span>{' '}
              {section.title}
            </h2>
            {/*
              Not a section of its own: every one of these loads is already in
              the list below, and printing them twice would have a dispatcher
              chasing the same load two ways. It is a count on the column that
              holds them, in the colour it always has.
            */}
            {section.key === 'running' && notQualified.length > 0 && (
              <span class="badge badge-danger">
                <span class="size-2 shrink-0 rounded-full bg-red-500" aria-hidden="true" />
                <span class="tabular-nums">{notQualified.length}</span> not qualified today
              </span>
            )}
            {/*
              What is sitting in this column, in money. Only the loads that
              carry a rate, and the ones that do not are counted beside it
              rather than folded in at zero.
            */}
            {/* The same figure /app/loads prints for the same load: linehaul,
                fuel surcharge and accessorials added, through `totalRateCents`.
                This column used to sum linehaul alone — $1,850 here against
                $2,010.45 there for one load, with nothing on either screen
                saying which was which. ink-700, not ink-500: these lines sit on
                the page tint. */}
            {section.money.priced > 0 && (
              <span class="text-sm text-ink-700">
                <span class="font-semibold text-ink-900 tabular-nums">
                  {formatCents(section.money.cents)}
                </span>{' '}
                on {section.money.priced} {section.money.priced === 1 ? 'load' : 'loads'}
              </span>
            )}
            {section.money.unpriced > 0 && (
              <span class="text-sm text-ink-700 tabular-nums">
                {section.money.unpriced} with no rate typed
              </span>
            )}
          </div>
          <p class="mt-1.5 mb-3 text-sm text-ink-700">{section.blurb}</p>

          <div class={section.wrapper}>
            <table class="w-full text-sm sm:min-w-[68rem]">
              {/*
                No header line on a phone. Nine column names above blocks that
                are not columns explain nothing — each block says what it is in
                its own words instead.
              */}
              <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
                <tr>
                  <th class="px-4 py-3 font-medium">Load</th>
                  <th class="px-4 py-3 font-medium">Customer</th>
                  <th class="px-4 py-3 font-medium">First pickup</th>
                  <th class="px-4 py-3 font-medium">Last delivery</th>
                  <th class="px-4 py-3 font-medium">Driver</th>
                  <th class="px-4 py-3 font-medium">Tractor</th>
                  <th class="px-4 py-3 font-medium">Trailer</th>
                  <th class="px-4 py-3 font-medium">Status</th>
                  <th class="px-4 py-3" />
                </tr>
              </thead>
              <tbody class="divide-y divide-ink-100">
                {section.rows.map((r) => (
                  <tr class="flex flex-col py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                    {/* THE LOAD LEADS. It is the one thing on the row that is
                        never empty and the thing she is holding paperwork for. */}
                    <td class={`${cell} order-1`}>
                      {/* `.link-row` is the shared 44px row link — the record
                          name is the target, not the twelve characters in it. */}
                      <a href={`/app/loads/${r.id}/assign`} class="link-row tabular-nums">
                        {r.label}
                      </a>
                      {/* THEIRS, printed under ours. The number on the rate
                          confirmation lying on the desk is the one the broker
                          says on the phone, and a board that only shows our own
                          number makes her open every load to find the right one. */}
                      {r.brokerReference && r.brokerReference !== r.label && (
                        <div class="text-xs text-ink-700 tabular-nums">
                          Broker ref {r.brokerReference}
                        </div>
                      )}
                      {/*
                        WHAT IT IS WORTH AND WHETHER IT CAN GO, on one line under
                        the number. These are the two things that decide which of
                        four stuck loads gets worked first, and before this they
                        were on a different screen and in a different cell. The
                        dot never travels alone: the word beside it says the same
                        thing, because roughly one man in twelve cannot tell the
                        red one from the amber one.
                      */}
                      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                        <span class="inline-flex items-center gap-1.5 text-xs">
                          <span
                            class:list={[
                              'size-2 shrink-0 rounded-full',
                              READINESS[r.readiness].dot,
                            ]}
                            aria-hidden="true"
                          />
                          <span class={READINESS[r.readiness].text}>
                            {READINESS[r.readiness].word}
                          </span>
                        </span>
                        {/* A load nobody has priced is not a $0 load, and
                            printing one as $0.00 is the kind of number that ends
                            up in a conversation with a broker. */}
                        {r.rateCents === null ? (
                          <span class="text-xs text-ink-700 italic">No rate typed</span>
                        ) : (
                          <span class="text-sm font-semibold tabular-nums">
                            {formatCents(r.rateCents)}
                          </span>
                        )}
                      </div>
                    </td>
                    {/* An empty cell is a blank line on a phone, so it is not
                        rendered there at all. The em dash still holds the
                        column open from `sm` up, where a table needs it. */}
                    <td class:list={[cell, 'order-6', !r.customer && 'hidden sm:table-cell']}>
                      {r.customer ? (
                        <>
                          <span class="text-ink-500 sm:hidden">Customer </span>
                          {r.customer}
                        </>
                      ) : (
                        <span class="text-ink-500">—</span>
                      )}
                    </td>
                    <td class={`${cell} order-4`}>
                      {r.pickupWhere || r.pickupWhen ? (
                        <>
                          {/* The column names are hidden on a phone, so the two
                              stops carry their own words. "From" and "To" are
                              shorter than the headings and read the same. */}
                          <div>
                            <span class="text-ink-500 sm:hidden">From </span>
                            {r.pickupWhere || '—'}
                          </div>
                          {r.pickupWhen && (
                            <div class="text-xs text-ink-700 tabular-nums">{r.pickupWhen}</div>
                          )}
                        </>
                      ) : (
                        /* The rest of the row goes to assign; this one goes to
                           the stops page, because a load with no pickup has
                           nowhere to send the driver she is about to assign. */
                        <a
                          href={`/app/loads/${r.id}/stops`}
                          class="link inline-flex min-h-11 items-center"
                        >
                          No stops yet
                        </a>
                      )}
                    </td>
                    <td
                      class:list={[
                        cell,
                        'order-5',
                        !r.deliveryWhere && !r.deliveryWhen && 'hidden sm:table-cell',
                      ]}
                    >
                      {r.deliveryWhere || r.deliveryWhen ? (
                        <>
                          <div>
                            <span class="text-ink-500 sm:hidden">To </span>
                            {r.deliveryWhere || '—'}
                          </div>
                          {r.deliveryWhen && (
                            <div class="text-xs text-ink-700 tabular-nums">{r.deliveryWhen}</div>
                          )}
                        </>
                      ) : (
                        <span class="text-ink-500">—</span>
                      )}
                    </td>
                    {/*
                      THE DRIVER IS SECOND ON A PHONE, under the load and the
                      status. "Can this man legally be under this load today" is
                      the other half of what this board is read for, and the two
                      warnings below are the only place in the product that ever
                      says so about a load already running.
                    */}
                    <td class={`${cell} order-3`}>
                      {r.driver ? (
                        <>
                          <div class="font-medium">{r.driver}</div>
                          {r.coDriver && (
                            <div class="text-xs text-ink-700">with {r.coDriver}</div>
                          )}
                          {/* Full width on a phone, the shared badge from `sm`
                              up. It is wider than the text because this is the
                              line that must not be skimmed past, and making it
                              bigger is the only lever a layout has. The colours
                              are the shared badge pairs — red-800 on red-100,
                              amber-800 on amber-100 — so this line is the same
                              red the rest of the app spends on "act now". */}
                          {r.blocked && (
                            <span class="badge badge-danger mt-1 flex w-full sm:inline-flex sm:w-auto">
                              Not qualified today
                            </span>
                          )}
                          {r.driverOffRoster && (
                            <span class="badge badge-warning mt-1 flex w-full sm:inline-flex sm:w-auto">
                              Not on the active roster
                            </span>
                          )}
                        </>
                      ) : (
                        <span class="font-medium text-brand-700">Nobody yet</span>
                      )}
                    </td>
                    <td class:list={[cell, 'order-7', !r.tractor && 'hidden sm:table-cell']}>
                      {r.tractor ? (
                        <>
                          <span class="text-ink-500 sm:hidden">Tractor </span>
                          {r.tractor}
                        </>
                      ) : (
                        <span class="text-ink-500">—</span>
                      )}
                    </td>
                    <td class:list={[cell, 'order-8', !r.trailer && 'hidden sm:table-cell']}>
                      {r.trailer ? (
                        <>
                          <span class="text-ink-500 sm:hidden">Trailer </span>
                          {r.trailer}
                        </>
                      ) : (
                        <span class="text-ink-500">—</span>
                      )}
                    </td>
                    {/* Straight under the load number on a phone: where the
                        truck is, in two words, before anything else. */}
                    <td class={`${cell} order-2`}>
                      {/* The exception sits ALONGSIDE the status, never
                          replacing it: a detained load is still at_shipper, and
                          collapsing the two loses where the truck actually is.
                          Both pills are the shared `.badge` construction with
                          the colour the Loads list gives the same value, so the
                          two screens cannot drift apart again. */}
                      <div class="flex flex-wrap items-center gap-1">
                        <span class={statusPillClass(r.status)}>{loadStatusLabel(r.status)}</span>
                        {r.exception && (
                          <span class={exceptionPillClass(r.exception)}>
                            {exceptionLabel(r.exception)}
                          </span>
                        )}
                      </div>
                    </td>
                    <td
                      class={`${cell} order-9 mt-2 flex gap-2 sm:mt-0 sm:table-cell sm:py-3 sm:text-right sm:whitespace-nowrap`}
                    >
                      <a href={`/app/loads/${r.id}/assign`} class={rowAction}>
                        {section.action} →
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ),
    )
  }
</App>
