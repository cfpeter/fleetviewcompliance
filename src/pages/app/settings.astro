                            "suppressed" both mean it never arrived and have entirely
                            different fixes. */}
                        {row.error && <div class="mt-1 text-xs text-ink-700">{row.error}</div>}
                        {row.delivery_detail && row.delivery_state !== 'delivered' && (
                          <div class="mt-1 text-xs text-ink-700">{row.delivery_detail}</div>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>
    </Fragment>
  )}

</App>
