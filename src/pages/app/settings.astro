---
/**
 * Settings: the person, the people, and who gets told what.
 *
 * Every form on this page POSTs to the page itself, dispatches on `intent`, and
 * every branch ends in a 303. That is not boilerplate here: a replayed POST
 * would re-run an upsert (harmless), DELETE a snooze (not harmless — a snooze
 * is the record that somebody looked at an item and decided it could wait, and
 * there is no undo for removing it by pressing F5), or send a second email
 * change confirmation on a refresh.
 *
 * WHAT WAS MISSING UNTIL TODAY, in the owner's words: "there is no place to add
 * or update emails or phone number or any other information for the owner to
 * manage." He was right. This page edited a USDOT number and a pile of
 * notification preferences, and nothing at all about the person reading it — no
 * name, no phone, no email, and no way to change a password. The first two
 * sections are that gap. The other half of it — a person who has FORGOTTEN the
 * password, whom no form on this page can help, because every form here is
 * behind the sign-in they cannot get through — is now /auth/forgot-password.
 *
 * The honesty rule on this screen is load-bearing. Everything it offers either
 * works today or says, in words, that it does not. A settings page that quietly
 * accepts a preference nothing reads is worse than one that lacks the control,
 * because the owner then believes he is covered — and this product's entire
 * claim is that when it tells you something, it is true. Where a control is
 * stored but not yet acted on, the copy says so next to the control, not in a
 * footnote.
 *
 * THE WORDS. This is read by small-fleet owners in Los Angeles, and many of
 * them do not read English fluently. Labels, buttons, help lines and errors on
 * this page are short, literal sentences. No wordplay, nothing implied. The
 * email and password blocks especially say what will happen and what the person
 * has to do next, because getting either of those half-right locks somebody out
 * of the account they are paying for.
 */
import ErrorSummary from '../../components/ui/ErrorSummary.astro'
import App from '../../layouts/App.astro'
import { formText, formatDate, todayInCalifornia } from '../../lib/drivers.ts'
// The three "how you operate" facts: the same shape the census fills at signup,
// so the settings form and the federal record write the same columns.
import {
  effectiveOperation,
  operationAnswer,
  operationAnswers,
  operationFromAnswers,
} from '../../lib/fmcsa.ts'
import {
  DEFAULT_LEAD_DAYS,
  NOTIFY_CATEGORIES,
  NOTIFY_CHANNELS,
  describeLeadDays,
  formatLeadDays,
  isKnownTimezone,
  parseLeadDays,
  timeForInput,
  timezoneOptions,
} from '../../lib/notify/preferences.ts'
// One rule, one number: the same minimum the sign-up form and the reset
// screen enforce, imported rather than re-typed.
import { MIN_PASSWORD } from '../../lib/onboarding.ts'
import { formatPhone, parsePhoneEdit, toE164 } from '../../lib/phone.ts'
import { ruleByCode } from '../../lib/rules/index.ts'
import { site } from '../../lib/site.ts'
import { anonClient } from '../../lib/supabase/server.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!
const userId = Astro.locals.userId!

/**
 * ONE PAGE THAT WAS FOUR PAGES.
 *
 * This screen held eight sections and 2,200 lines of markup in one column: the
 * owner's name, his password, his USDOT number, a nine-box notification matrix,
 * quiet hours, snoozes and a log of every message we ever sent him. In his
 * words: "the setting page is too much to scroll and update changes". He was
 * right — on a phone the Save button for his own phone number was eight
 * screens above the Save button for quiet hours, and nothing told him which
 * one he was about to press.
 *
 * So the sections are grouped by WHO OR WHAT they are about — you, the
 * company, what we send, what we sent — and only the group he asked for is
 * rendered. Four short pages instead of one long one.
 *
 * NO SCRIPT, AND NOT A `#fragment`. The tab is a query parameter because a
 * fragment never reaches the server and this page has to render the right
 * group on the server. Each tab is a plain link; the strip is `.filter-tab` /
 * `.is-current`, the same selected pill the rest of the app uses, so it is
 * navigation a screen reader can already read and not a `role="tablist"` that
 * would need arrow-key handling this app has no JavaScript to provide.
 *
 * WHY THE FORMS DID NOT HAVE TO CHANGE. Not one of them carries an `action`,
 * so each POSTs to the address of the page it is standing on — which now
 * carries `?tab=`. The server reads the tab back off that, and `back()` below
 * puts it in the 303, so a save returns to the group the person was working
 * in rather than dropping them at the top of the page.
 */
const TABS = [
  {
    id: 'you',
    label: 'You',
    subtitle: 'Your name, your phone, your email and your password.',
  },
  {
    id: 'company',
    label: 'Company',
    subtitle: 'Your USDOT number, how your company operates, and who can sign in.',
  },
  {
    id: 'alerts',
    label: 'Alerts',
    subtitle: 'Who gets told what, quiet hours, and anything you snoozed.',
  },
  {
    id: 'messages',
    label: 'Messages',
    subtitle: 'Every email and text we sent you, and what became of it.',
  },
] as const
type TabId = (typeof TABS)[number]['id']

/**
 * The group being shown. Anything we do not recognise falls back to the first
 * one rather than being echoed anywhere — the same reason `?error=` on this
 * page carries codes and not text.
 */
const current = TABS.find((t) => t.id === Astro.url.searchParams.get('tab')) ?? TABS[0]
const tab: TabId = current.id

/**
 * Every POST branch leaves through here. 303, never the 302 that
 * `Astro.redirect` defaults to: a 302 permits the browser to repeat the POST at
 * the new location, so a refresh after un-snoozing would try to delete the row
 * again — and after a save it would re-send the whole matrix.
 */
/**
 * THE TAB TRAVELS WITH THE REDIRECT. Without it every save landed back on the
 * first group, so changing quiet hours bounced the reader to the top of the
 * account form and the confirmation he needed to read was on a page he was no
 * longer looking at.
 */
const back = (query = '') =>
  Astro.redirect(`/app/settings?tab=${tab}${query ? `&${query}` : ''}`, 303)
/**
 * Failures travel as CODES, never as text.
 *
 * `?error=` was rendered into the page verbatim, so anyone could hand a
 * customer a link to their own settings page reading "Your account is locked,
 * call 555-0100" — in our styling, on our domain, over HTTPS, with our padlock.
 * Astro escapes the value so it is not script injection; it is worse than that
 * in practice, because the text is the attack and escaping does nothing to it.
 *
 * Raw database messages went the same way: a Postgres error string is written
 * for an operator, can name columns and constraints, and is not ours to show.
 */
/**
 * `#form-errors` is how the focus reaches the message with no script on the
 * page: the summary box is `tabindex="-1"`, so a 303 to its id both scrolls to
 * it and focuses it, and each line inside it is a link to the box it is about.
 * A fragment never reaches the server, so the destination is unchanged.
 */
const fail = (code: string) => back(`error=${code}#form-errors`)

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

/**
 * Deliberately loose. The address is checked for real by the one thing that can
 * check it — the confirmation link, which either arrives or does not. A clever
 * regex here only ever refuses somebody's genuine address.
 */
const EMAIL_SHAPE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

/**
 * Does the person holding this session actually know the password on it?
 *
 * BOTH sensitive changes below require this, and it matters more now that
 * password reset exists, not less. A signed-in browser is no longer the only
 * way back into an account — but it is still the whole of what somebody
 * standing at an open laptop on the yard desk has, and without this check that
 * is enough to take the account over: change the password, then change the
 * email, and the owner cannot even use the new reset link, because the link
 * goes to an address that is no longer his. The reset flow proves control of
 * the INBOX. This form proves knowledge of the PASSWORD. Neither substitutes
 * for the other, and this page is the one that must not be satisfied by
 * proximity to a chair.
 *
 * Supabase does not expose "check this password"; signing in IS the check. So:
 * a THROWAWAY client, never `Astro.locals.supabase`. The request's own client
 * writes session cookies, so signing in on it would rewrite the cookies of the
 * page the person is standing on — and a mistyped password would do it too.
 * `anonClient` carries no cookies and `persistSession: false` means nothing it
 * mints is ever written down.
 *
 * And NO signOut afterwards. The default scope of `signOut` is GLOBAL: it
 * revokes every refresh token the user holds, including the phone in the cab.
 * Checking a password must not sign anybody out of anything. The token minted
 * here is never stored and expires on its own.
 */
async function passwordHolds(email: string, password: string): Promise<boolean> {
  // A blank box is not a guess worth spending a login attempt on, and letting
  // it through to Supabase would count against the rate limit that protects
  // this check from being used to guess.
  if (email === '' || password === '') return false
  const { error } = await anonClient().auth.signInWithPassword({ email, password })
  return !error
}

/** The address this person actually signs in with. `auth.users`, not `profiles`. */
async function signInEmailNow(): Promise<string> {
  const { data } = await supabase.auth.getUser()
  return data.user?.email ?? ''
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  // --------------------------------------------------------- your details

  /**
   * Name, phone and timezone for the SIGNED-IN PERSON. One form, one button.
   *
   * Three fields that used to be two screens and one missing screen: the
   * timezone control lived in the carrier block, where a person looking for
   * their own details would never find it, and the name and phone did not
   * exist. They are one form because they are one answer to one question — who
   * are you and where are you — and three save buttons on a page like this is
   * three chances to fill a box and walk away without pressing anything.
   *
   * THIS MUST NOT BECOME THE DIGEST BUG. `save_alerts` below writes with an
   * UPSERT, which replaces the whole row, which is why it has to read `digest`
   * back from the database before writing — a field the form does not render
   * would otherwise be blanked on every save. This statement is an UPDATE: a
   * PostgREST update is a PATCH and touches only the columns named in the
   * object. `email`, `quiet_from`, `quiet_to` and `quiet_allow_critical` are
   * not named, so they are not written. Anyone changing this to an upsert takes
   * on the read-back obligation with it.
   */
  if (intent === 'save_profile') {
    // The stored row, read here rather than taken from `profile` further down:
    // the load section runs only on a GET, so on a POST there is nothing in
    // scope yet — and `parsePhoneEdit` needs the column to decide whether this
    // phone was actually changed.
    const { data: current, error: readError } = await supabase
      .from('profiles')
      .select('phone, timezone')
      .eq('id', userId)
      .maybeSingle()

    // A read that FAILED is not a person with no row. Carrying on would hand
    // `parsePhoneEdit` an undefined "stored" value, and a legacy number nobody
    // touched would be refused as though it had just been typed.
    if (readError) return fail('save_failed')

    /**
     * `parsePhoneEdit`, not `parsePhone`, and this is the same rule the driver
     * and customer forms follow. Refuse only a phone the person actually
     * CHANGED; a legacy value that was already in the column goes back exactly
     * as it came out. Nobody must be blocked on a field they did not edit —
     * here that would mean an owner who cannot save his own NAME because of a
     * seven-digit number somebody typed in 2019.
     *
     * The comparison inside is against `formatPhone(stored)` because that is
     * what the input below renders, so "unchanged" is measured against what the
     * form DISPLAYED, never against the raw column.
     */
    const phone = parsePhoneEdit(form.get('phone'), current?.phone)
    // The parser's own message is not forwarded. `?error=` on this page carries
    // CODES, never text, so that nobody can hand a customer a link to their own
    // settings page with a sentence of their choosing across the top of it.
    if (!phone.ok) return fail('phone_bad')

    // A zone we cannot resolve does not raise anywhere — it quietly makes every
    // "is this overdue yet" answer wrong by up to a day. `current?.timezone` is
    // passed so that a row already holding a zone this build's list has not got
    // is not refused for being what it already is.
    const requestedZone = String(form.get('timezone') ?? '')
    if (!isKnownTimezone(requestedZone, current?.timezone)) return fail('tz_unknown')

    const { error } = await supabase
      .from('profiles')
      .update({
        // Blank stays NULL rather than ''. An empty string is a VALUE: it reads
        // as answered and sorts as one.
        full_name: formText(form, 'full_name'),
        phone: phone.value,
        timezone: requestedZone,
      })
      // `profiles` holds a row per PERSON and the policy scopes it to
      // `id = auth.uid()`. Naming the id is how this statement says which row it
      // means, not a second guess at the policy.
      .eq('id', userId)

    if (error) return fail('save_failed')
    return back('saved=profile')
  }

  // ----------------------------------------------------- sign-in email

  /**
   * THE TWO EMAILS, and why only one of them is editable.
   *
   * `auth.users.email` is what he signs in with. `profiles.email` is a copy the
   * public schema can join against, and it is what the morning digest actually
   * sends to. Offering a box for the second one would be a trap with no bottom:
   * he types the new address, the page shows it, the sign-in page keeps
   * demanding the old one, and nothing on screen explains why.
   *
   * So there is exactly ONE email on this page, it is the sign-in address, and
   * `profiles.email` is a mirror the application never writes. Migration 0027
   * puts a trigger on `auth.users` that copies the address across the moment it
   * changes — in the database, because the confirmation link can be opened on a
   * phone, in another browser, or next week, and that write may never pass
   * through a request this app serves.
   *
   * Supabase does NOT change the sign-in address here. `updateUser({ email })`
   * sends a confirmation link to the new address and changes nothing until it
   * is opened. That is the honest behaviour and the screen says so in those
   * words rather than reporting a save that has not happened.
   */
  if (intent === 'change_email') {
    const requested = String(form.get('new_email') ?? '')
      .trim()
      .toLowerCase()
    if (!EMAIL_SHAPE.test(requested)) return fail('email_shape')

    const signInEmail = await signInEmailNow()
    if (signInEmail === '') return fail('save_failed')
    // Caught here rather than sent to Supabase, which accepts it and emails a
    // link that changes nothing — a confirmation for a change that is not one.
    if (requested === signInEmail.toLowerCase()) return fail('email_same')

    if (!(await passwordHolds(signInEmail, String(form.get('current_password') ?? '')))) {
      return fail('password_wrong')
    }

    const { error } = await supabase.auth.updateUser({ email: requested })
    // Every failure is reported the same way, on purpose. Supabase distinguishes
    // "that address already has an account" from the rest, and repeating that
    // distinction turns this form into a way of asking whether a given person is
    // a customer here. login.astro refuses to leak the same fact.
    if (error) return fail('email_failed')
    return back('saved=email_sent')
  }

  // -------------------------------------------------------- password

  /**
   * The signed-in person changes their own password.
   *
   * THE HALF THAT NEEDS THE OLD PASSWORD. This form is for a person who knows
   * their password and wants a different one; it asks for the current one and
   * refuses without it, for the reason passwordHolds() gives.
   *
   * Somebody who has FORGOTTEN their password cannot be here at all — this page
   * is behind the sign-in they cannot get through — and is served by
   * /auth/forgot-password, which proves control of the email instead. Two
   * doors, two proofs; neither one weakens the other.
   */
  if (intent === 'change_password') {
    const current = String(form.get('current_password') ?? '')
    const next = String(form.get('new_password') ?? '')
    const again = String(form.get('new_password_again') ?? '')

    // Checked before the password is verified, so that a typo in the new boxes
    // does not cost a sign-in attempt against the rate limit.
    if (next.length < MIN_PASSWORD) return fail('password_short')
    // Twice, because there is no reset. A typo repeated into one box is a
    // password nobody knows, on an account nobody can recover.
    if (next !== again) return fail('password_mismatch')
    if (next === current) return fail('password_same')

    const signInEmail = await signInEmailNow()
    if (signInEmail === '') return fail('save_failed')
    if (!(await passwordHolds(signInEmail, current))) return fail('password_wrong')

    const { error } = await supabase.auth.updateUser({ password: next })
    if (error) return fail('password_failed')
    // The session on this browser stays valid — Supabase refreshes it in place
    // — so nobody is thrown out of the page they just used.
    return back('saved=password')
  }

  // -------------------------------------------------------- USDOT number

  /**
   * SUPPLYING a missing USDOT number, which is not the same as correcting one.
   *
   * This section says, correctly, that carrier details come from the federal
   * record and cannot be edited here — a legal name typed over FMCSA's is a
   * second answer nobody can adjudicate. None of that applies to a carrier who
   * has NO number on file: `register_carrier` stores `nullif(trim(...), '')`, so
   * signing up without one is reachable, and from then on there is nothing to
   * sync FROM. The MCS-150 rule reports `missing_data` needing `dot_number`
   * forever, the dashboard asks for it on every visit, and the only screen that
   * has ever written the column is the signup form he cannot go back to.
   *
   * So: settable exactly once, never editable afterwards. The form does not
   * render when a number is on file, and the update carries `.is('dot_number',
   * null)` so a second submit — a stale tab, a double tap, a crafted body —
   * cannot overwrite one that arrived in between.
   */
  if (intent === 'set_dot_number') {
    const raw = String(form.get('dot_number') ?? '').trim()
    // Digits only. FMCSA issues plain integers and every lookup in this codebase
    // passes the string straight into a Socrata query; a 'DOT 123' typed here
    // would fail that lookup with an error about the query, not about the value.
    if (!/^\d{1,8}$/.test(raw)) {
      return fail('dot_digits')
    }

    const { data: updated, error: e } = await supabase
      .from('carriers')
      .update({ dot_number: raw })
      .eq('id', carrierId)
      .is('dot_number', null)
      .select('id')

    if (e) {
      return fail(e.message.includes('carriers_dot_number_key') ? 'dot_taken' : 'save_failed')
    }
    // Zero rows means the guard held: a number arrived between the page render
    // and this submit. Saying so is better than a success message over a value
    // he did not type.
    if (!updated || updated.length === 0) {
      return fail('dot_present')
    }
    return back('saved=dot')
  }

  // ------------------------------------------------- how the company operates

  /**
   * The owner's own answer to "which rules apply to me".
   *
   * Three questions, three columns (0031), one save. Every rule gate in
   * src/lib/rules reads these off the carrier row, and until this form existed
   * the only writer was the census row at signup — so an owner whose federal
   * record was stale, or blank, had nowhere to say "that rule does not apply
   * to me" (docs/product/REVIEW-2026-09-18.md § 2.1).
   *
   * "I'm not sure" stores NULL, and NULL keeps every gated rule on the board.
   * The form never defaults an unanswered question to "no": the mapping in
   * `operationFromAnswers` is the only place the three values are decided, and
   * the test file pins it.
   *
   * `operation_source` is stamped 'owner' so the page can say whose answer is
   * on file, and so the backfill script leaves this row alone.
   */
  if (intent === 'save_operation') {
    const crossesStateLines = operationAnswer(form.get('crosses_state_lines'))
    const forHire = operationAnswer(form.get('for_hire'))
    const hazmat = operationAnswer(form.get('hazmat'))
    if (!crossesStateLines || !forHire || !hazmat) return fail('operation_choice')

    const { error: e } = await supabase
      .from('carriers')
      .update({
        ...operationFromAnswers({ crossesStateLines, forHire, hazmat }),
        operation_source: 'owner',
      })
      .eq('id', carrierId)
    // PGRST204, naming one of the four columns, is 0031 not being applied here.
    // It is NOT a transient failure and must not be reported as one — the
    // difference between "try again in a moment" and "this is not switched on
    // yet" is the difference between an owner pressing a button forty times and
    // an owner who knows where he stands.
    if (e) {
      const notThere = /carrier_operation|for_hire|hazmat|operation_source/.test(e.message)
      return fail(notThere ? 'operation_not_ready' : 'save_failed')
    }
    return back('saved=operation')
  }

  // ------------------------------------------------------------- the matrix

  if (intent === 'save_alerts') {
    const channelRows: Record<string, unknown>[] = []
    const categoryRows: Record<string, unknown>[] = []

    /**
     * `digest` is READ BACK, never taken from the form.
     *
     * The box is disabled in the markup now, for the same reason the SMS box
     * is: the job batches into one message unconditionally, so a box you could
     * untick promised separate messages that no code anywhere sends. But a
     * disabled checkbox posts NOTHING, and the upsert below replaces the whole
     * row — so `form.has('digest_…')` would come back false for all three
     * categories and the first save after that change would quietly rewrite
     * every stored preference to false. The column is kept precisely because it
     * is meant to be honoured later; erasing it on the way past would make the
     * keeping pointless.
     *
     * Carrier AND user, not user alone: the row key is (carrier, user,
     * category) and one person can belong to more than one carrier. Reading
     * across carriers here would copy a choice made on one account onto another.
     */
    const storedCategories = await supabase
      .from('notification_category_preferences')
      .select('category, digest')
      .eq('carrier_id', carrierId)
      .eq('user_id', userId)

    // A read that FAILED is not an account that has never saved. Treating the
    // two alike is exactly how a deliberate choice gets overwritten with the
    // column default and called a successful save. Refuse, and let the person
    // press the button again.
    if (storedCategories.error) return fail('save_failed')

    const storedDigest = new Map(
      (storedCategories.data ?? []).map((r) => [r.category as string, r.digest as boolean]),
    )

    for (const category of NOTIFY_CATEGORIES) {
      // A category whose lead time lives on each item has no array to save, and
      // writing one would store a number nothing reads — the failure this
      // screen's own doctrine calls out. The channel rows below are still
      // written for it: the on/off switch is real.
      if (category.perItemLeadDays) {
        for (const channel of NOTIFY_CHANNELS) {
          channelRows.push({
            carrier_id: carrierId,
            user_id: userId,
            category: category.value,
            channel: channel.value,
            enabled: channel.live && form.has(`on_${category.value}_${channel.value}`),
          })
        }
        continue
      }

      // One array per category, stored once. This used to be parsed once per
      // category and then written to all three channel rows, because the schema
      // hung `lead_days` off (category, CHANNEL) — three copies of one fact,
      // free to disagree, with no screen able to show the disagreement.
      // 0010_cleanup.sql gave it a table whose key is the fact's actual shape.
      categoryRows.push({
        carrier_id: carrierId,
        user_id: userId,
        category: category.value,
        lead_days: parseLeadDays(form.get(`lead_${category.value}`)),
        // Carried through untouched. `?? true` is the column default in
        // 0008_notifications.sql, so a category with no row yet is written with
        // the value the database would have chosen for it anyway — which is
        // also what the job actually does.
        digest: storedDigest.get(category.value) ?? true,
      })

      for (const channel of NOTIFY_CHANNELS) {
        // An unticked checkbox posts NOTHING — it is not sent as "off". Reading
        // `has()` rather than a value is what makes unticking a box actually
        // turn something off instead of leaving the old row alone.
        //
        // A channel we cannot deliver on is written as `false` regardless of
        // what arrived. Its box is disabled in the markup, so nothing should
        // arrive; forcing it here means a hand-crafted POST cannot leave the
        // database claiming we will text somebody when we cannot.
        const enabled = channel.live && form.has(`on_${category.value}_${channel.value}`)

        channelRows.push({
          // carrier_id is SET, never filtered on. RLS checks the value against
          // the caller's memberships but does not fill it in, so leaving it out
          // fails the policy rather than defaulting to anything sensible.
          carrier_id: carrierId,
          user_id: userId,
          category: category.value,
          channel: channel.value,
          enabled,
        })
      }
    }

    // Upsert on each table's own key, not delete-then-insert.
    //
    // The delete-then-insert version has a failure mode with teeth: the delete
    // succeeds, the insert fails (a bad lead_days cast, a dropped connection),
    // and the owner is left with NO preference rows at all. The digest job then
    // falls back to compliance-email-only, so the person who just tried to turn
    // SMS on has silently lost every other setting and has no way to tell.
    //
    // TWO statements, because the two facts now live in two tables, and
    // PostgREST gives us no transaction spanning them. The lead times go FIRST:
    // if the second call fails the page says so and the person retries, and the
    // half that landed is the half that decides whether a warning is early
    // enough to act on. The reverse order would leave channels switched on with
    // lead times that were not saved — alerts arriving on a schedule nobody
    // chose, which is worse than a save that visibly did not finish.
    const categorySave = await supabase
      .from('notification_category_preferences')
      .upsert(categoryRows, { onConflict: 'carrier_id,user_id,category' })
    if (categorySave.error) return fail('save_failed')

    const channelSave = await supabase
      .from('notification_preferences')
      .upsert(channelRows, { onConflict: 'carrier_id,user_id,category,channel' })
    if (channelSave.error) {
      return fail('channels_failed')
    }

    return back('saved=alerts')
  }

  // ------------------------------------------------------------- quiet hours

  if (intent === 'save_quiet') {
    const from = formText(form, 'quiet_from')
    const to = formText(form, 'quiet_to')

    // `withinQuietHours` returns false the moment either end is null, so half a
    // window is not "quiet from 10pm onwards" — it is no quiet hours at all,
    // saved successfully, with a filled-in box on screen saying otherwise.
    if ((from === null) !== (to === null)) {
      return fail('quiet_pair')
    }

    // Identical ends are the same trap by another route: the window is zero
    // minutes long and silences nothing, while the screen shows two times.
    if (from !== null && from === to) {
      return fail('quiet_same')
    }

    const { error } = await supabase
      .from('profiles')
      .update({
        quiet_from: from,
        quiet_to: to,
        quiet_allow_critical: form.has('quiet_allow_critical'),
      })
      .eq('id', userId)

    if (error) return fail('save_failed')
    return back('saved=quiet')
  }

  // ------------------------------------------------------------- un-snooze

  if (intent === 'unsnooze') {
    const snoozeId = String(form.get('snooze_id') ?? '')

    // A hand-edited id is a failed uuid cast, not a missing row: Postgres
    // raises, and without this check the owner gets "invalid input syntax for
    // type uuid" across the top of his settings page.
    if (!UUID.test(snoozeId)) return fail('snooze_unknown')

    const { error } = await supabase
      .from('notification_snoozes')
      .delete()
      // RLS makes another carrier's snooze invisible to this statement, so the
      // worst a tampered id achieves is deleting zero rows.
      .eq('id', snoozeId)

    if (error) return fail('save_failed')
    return back('saved=unsnoozed')
  }

  // An intent we do not recognise is a bug or a probe. Either way it must not
  // fall through into rendering a POST response.
  return back()
}

// ---------------------------------------------------------------- loading

const today = todayInCalifornia()

interface PrefRow {
  category: string
  channel: string
  enabled: boolean
}

/** One row per category since 0010, which is the shape the fact actually has. */
interface CategoryPrefRow {
  category: string
  lead_days: number[] | null
  digest: boolean
}

interface SnoozeRow {
  id: string
  rule_code: string
  subject_type: string
  subject_id: string | null
  until: string
  reason: string | null
}

interface LogRow {
  sent_at: string
  channel: string
  destination: string
  subject: string | null
  status: string
  error: string | null
  /** What the provider says BECAME of it. See 0022 and notify/suppression.ts. */
  delivery_state: string
  delivery_detail: string | null
  /**
   * The provider's id for the ONE message these rows rode in. The digest logs a
   * row per item so each item's dedup key is spent, which means one morning
   * email with 22 items in it is 22 rows here — and printed one per row, the
   * list said we sent 22 emails when we sent one.
   */
  provider_message_id: string | null
}

/** One line on screen: the message, and how many items it carried. */
interface LogMessage {
  row: LogRow
  items: number
}

/**
 * Rows folded into messages. Rows that share a provider id are one message;
 * rows with no provider id (a refused send, a failure) are grouped by the
 * second they were written, the address and the channel, which is how the job
 * writes them. Order is kept: newest first, as the query returned them.
 */
function foldMessages(rows: readonly LogRow[]): LogMessage[] {
  const out: LogMessage[] = []
  const seen = new Map<string, LogMessage>()
  for (const row of rows) {
    const key = row.provider_message_id
      ? `id:${row.provider_message_id}`
      : `at:${row.sent_at}|${row.channel}|${row.destination}|${row.status}`
    const hit = seen.get(key)
    if (hit) {
      hit.items += 1
      continue
    }
    const entry = { row, items: 1 }
    seen.set(key, entry)
    out.push(entry)
  }
  return out
}

/**
 * One person who can sign in to this carrier. See migration 0027.
 *
 * `memberships` and `profiles` are both scoped to `auth.uid()` by RLS, so a
 * signed-in person can see exactly one membership and one profile — their own.
 * `carrier_members` is a SECURITY DEFINER function that checks membership and
 * then returns these four fields and nothing else, which is a narrower opening
 * than widening either policy would have been.
 */
interface MemberRow {
  user_id: string
  full_name: string | null
  email: string | null
  role: 'owner' | 'staff'
  joined_at: string
}

/**
 * ONLY WHAT THIS TAB RENDERS.
 *
 * Every one of these ran on every view of this page, which meant somebody
 * changing their phone number pulled 200 notification_log rows and the whole
 * member list to draw a screen that shows neither. On a Worker that is not
 * free: the subrequest budget is shared with everything else the request does,
 * and the digest job already spends most of it.
 *
 * `carriers` and `profiles` are NOT gated — one row each, and between the
 * timezone fallback, the quiet hours and the carrier name on a snooze they are
 * read by more than one group. `skip` stands in for the rest with the shape the
 * code below already handles: no rows, no error.
 */
const skip = <T,>(data: T) => Promise.resolve({ data, error: null })

/**
 * Whether the four columns behind "How your company operates" exist here.
 *
 * FALSE UNTIL 0031 IS APPLIED, and false is not a detail: the form below writes
 * those columns, so every Save on it comes back "We could not save that just
 * now. Try again in a moment." — a sentence that is not true, because no amount
 * of trying again will make a column appear. This page's whole rule is that
 * what it says is so; a control it cannot honour is not offered at all, and the
 * reason is printed where the control was.
 */
let operationReady = true

const [
  carrierResult,
  profileResult,
  prefsResult,
  catPrefsResult,
  snoozeResult,
  logResult,
  authResult,
  membersResult,
] = await Promise.all([
    // `.eq('id', carrierId)` names WHICH carrier row, which is not the same thing
    // as a defensive `carrier_id` filter on a tenant table. RLS still decides
    // whether that row is visible at all.
    //
    // `timezone` is selected because it is the fallback for a person who has not
    // chosen one: since 0010 `profiles.timezone` is nullable, and NULL means
    // "never chose" rather than "Pacific".
    (async () => {
      const full = await supabase
        .from('carriers')
        .select(
          // One literal, not a concatenation: supabase-js types the row from the
          // select string, and anything but a literal comes back as an error type.
          'legal_name, dba_name, dot_number, phy_street, phy_city, phy_state, phy_zip, timezone, carrier_operation, for_hire, hazmat, operation_source, fmcsa_carrier_operation, fmcsa_for_hire, fmcsa_hazmat',
        )
        .eq('id', carrierId)
        .maybeSingle()
      if (!full.error) return full

      // UNTIL 0040 IS APPLIED the three census-only columns do not exist while
      // the owner's three do. Without this middle step the next fallback would
      // read 0040's absence as 0031's and blank a block that works.
      const withOperation = await supabase
        .from('carriers')
        .select(
          'legal_name, dba_name, dot_number, phy_street, phy_city, phy_state, phy_zip, timezone, carrier_operation, for_hire, hazmat, operation_source',
        )
        .eq('id', carrierId)
        .maybeSingle()
      if (!withOperation.error) {
        const data = withOperation.data
          ? {
              ...withOperation.data,
              fmcsa_carrier_operation: null,
              fmcsa_for_hire: null,
              fmcsa_hazmat: null,
            }
          : null
        return { ...withOperation, data: data as typeof full.data }
      }

      // UNTIL 0031 IS APPLIED the four operation columns do not exist, and
      // naming them makes PostgREST refuse the whole select — which rendered
      // the "Your carrier" block blank on the running dev server. Read the
      // columns that do exist so the page still stands, and let the operation
      // block say "we do not have these yet", which is true. The customer pages
      // do the same for their invoice-date columns; the pattern is deliberate.
      const base = await supabase
        .from('carriers')
        .select('legal_name, dba_name, dot_number, phy_street, phy_city, phy_state, phy_zip, timezone')
        .eq('id', carrierId)
        .maybeSingle()
      operationReady = false
      const data = base.data
        ? {
            ...base.data,
            carrier_operation: null,
            for_hire: null,
            hazmat: null,
            operation_source: null,
            fmcsa_carrier_operation: null,
            fmcsa_for_hire: null,
            fmcsa_hazmat: null,
          }
        : null
      return { ...base, data: data as typeof full.data }
    })(),

    // `email` is selected but never rendered as this person's address, and that
    // is deliberate: it is a mirror of `auth.users.email` (0027), and the
    // address shown on this page comes from the session below so that the page
    // and the sign-in screen can never disagree.
    supabase
      .from('profiles')
      .select('full_name, email, phone, timezone, quiet_from, quiet_to, quiet_allow_critical')
      .eq('id', userId)
      .maybeSingle(),

    // The user filter is required, not defensive. The policy on this table scopes
    // to the CARRIER, so a colleague's preferences are legitimately visible here —
    // and rendering them as this person's settings would be a stranger's inbox
    // shown as your own.
    tab === 'alerts'
      ? supabase
          .from('notification_preferences')
          .select('category, channel, enabled')
          .eq('user_id', userId)
      : skip<PrefRow[]>([]),

    // Same reasoning for the user filter, same reason it is not optional.
    tab === 'alerts'
      ? supabase
          .from('notification_category_preferences')
          .select('category, lead_days, digest')
          .eq('user_id', userId)
      : skip<CategoryPrefRow[]>([]),

    // Active only. A lapsed snooze is already doing nothing, and listing it would
    // make this section a growing pile of history with the live ones buried in it.
    tab === 'alerts'
      ? supabase
          .from('notification_snoozes')
          .select('id, rule_code, subject_type, subject_id, until, reason')
          .gte('until', today)
          .order('until', { ascending: true })
      : skip<SnoozeRow[]>([]),

    // 200 ROWS, not 20. A row is an item, not a message — one email carries
    // many — and `foldMessages` below turns the rows into messages before the
    // page counts to twenty. At 20 rows, one morning's email filled the whole
    // list on its own.
    tab === 'messages'
      ? supabase
          .from('notification_log')
          .select(
            'sent_at, channel, destination, subject, status, error, delivery_state, delivery_detail, provider_message_id',
          )
          .order('sent_at', { ascending: false })
          .limit(200)
      : skip<LogRow[]>([]),

    // The sign-in address, from the session rather than from `profiles`. The
    // whole point of the section below is that it names the address the login
    // page will accept, and only `auth.users` knows that.
    tab === 'you' ? supabase.auth.getUser() : skip({ user: null }),

    tab === 'company'
      ? supabase.rpc('carrier_members', { p_carrier_id: carrierId })
      : skip<MemberRow[]>([]),
  ])

const carrier = carrierResult.data
const profile = profileResult.data
const prefRows = (prefsResult.data ?? []) as PrefRow[]
const catPrefRows = (catPrefsResult.data ?? []) as CategoryPrefRow[]
const snoozes = (snoozeResult.data ?? []) as SnoozeRow[]
const log = (logResult.data ?? []) as LogRow[]
const messages = foldMessages(log).slice(0, 20)

const signInEmail = authResult.data.user?.email ?? ''
const members = (membersResult.data ?? []) as MemberRow[]
// A list that failed to load and a carrier with one person on it look identical
// once both are empty, and one of those is a lie about who can reach the
// account. They are told apart here so the page can say which happened.
const membersFailed = Boolean(membersResult.error)

/**
 * Advisory, never a refusal — the save grandfathers a number nobody touched,
 * and this is what asks for it to be fixed. Keyed off what the box SHOWS rather
 * than off the column, because a warning pointing at a visibly empty field is a
 * warning nobody can act on.
 */
const phoneUndialable = formatPhone(profile?.phone) !== '' && toE164(profile?.phone) === null

/**
 * Theirs, then the carrier's, then Pacific — the same chain the digest job walks.
 *
 * `profiles.timezone` is nullable since 0010, and NULL means "never chose". It
 * used to be NOT NULL DEFAULT 'America/Los_Angeles', which made every new account
 * silently CLAIM Pacific, so `carriers.timezone` — written at signup, read by
 * nothing — could never be reached. An office manager at a Phoenix carrier had
 * her digest timed on a clock an hour off the one on her wall, and the only
 * remedy was opening this page.
 */
const timezone = profile?.timezone || carrier?.timezone || 'America/Los_Angeles'

// Labels for the snoozed items, fetched only when there is something to label.
// RLS scopes both to this carrier, so neither carries a carrier_id filter.
const subjectLabels = new Map<string, string>()
if (snoozes.length > 0) {
  const [drivers, vehicles] = await Promise.all([
    supabase.from('drivers').select('id, first_name, last_name'),
    supabase.from('vehicles').select('id, unit_number, vin'),
  ])
  for (const d of drivers.data ?? []) {
    subjectLabels.set(d.id, `${d.first_name} ${d.last_name}`.trim())
  }
  for (const v of vehicles.data ?? []) {
    subjectLabels.set(v.id, v.unit_number || v.vin || 'Unnumbered unit')
  }
}

/**
 * What a snooze is actually about, in words.
 *
 * `notification_snoozes.subject_type` speaks the rule engine's vocabulary since
 * 0010 — carrier, driver, employee, power_unit, trailer, terminal — so the noun
 * below is now the right noun. It used to be the `document_subject` enum, which
 * said 'vehicle' where the engine says 'power_unit'; `isSnoozed` ignored the
 * column entirely, which is the only reason the mismatch never bit.
 *
 * The LABEL still comes from the id rather than the type, because a name is what
 * the reader recognises. The type is the fallback noun for a record that has
 * since been deleted.
 */
function snoozeSubject(s: SnoozeRow): string {
  if (s.subject_id && subjectLabels.has(s.subject_id)) {
    return subjectLabels.get(s.subject_id) as string
  }
  if (s.subject_type === 'carrier') return carrier?.legal_name ?? 'This carrier'
  if (!s.subject_id) return 'The whole fleet'
  // A record that has since been deleted, or a subject type with no roster page.
  return `A ${s.subject_type.replaceAll('_', ' ')} that is no longer on file`
}

// ---------------------------------------------------------------- the matrix

/**
 * Whether this person has ever saved anything.
 *
 * It matters because the digest job has a fallback: somebody with NO preference
 * rows is treated as compliance-by-email-enabled, so that a person who has never
 * opened this page still gets told. A screen that showed every box unticked for
 * that person would say "you will hear nothing from us" while the job emails
 * them every morning. So the empty case renders the fallback, not zeroes.
 */
const hasSavedPrefs = prefRows.length > 0
const prefByKey = new Map(prefRows.map((r) => [`${r.category}:${r.channel}`, r]))
const catPrefByCategory = new Map(catPrefRows.map((r) => [r.category, r]))

function isEnabled(category: string, channel: string): boolean {
  const row = prefByKey.get(`${category}:${channel}`)
  if (row) return row.enabled
  if (!hasSavedPrefs) return category === 'compliance' && channel === 'email'

  // A CATEGORY THAT DID NOT EXIST WHEN HE LAST SAVED IS NOT A CATEGORY HE
  // TURNED OFF.
  //
  // 'reminder' arrived in 0023, after every existing customer had already
  // written their rows. The rule below would read those rows as "reminders: off"
  // while the digest job — which applies the same default in
  // `reminderEmailEnabled` — goes on sending them. The screen and the job must
  // answer this question the same way, and the answer is yes: he typed the
  // reminder, he means to be told about it.
  if (category === 'reminder' && channel === 'email') return true

  // A row that is absent while others exist is genuinely off: the save writes
  // all nine every time, so a gap means somebody's row predates a channel.
  return false
}

/**
 * The lead times for a category. One row, one answer.
 *
 * This used to walk the three channel rows and return the first `lead_days` it
 * found, because the schema hung the column off (category, CHANNEL) and one
 * category therefore stored three copies free to disagree. That loop was a
 * workaround for a schema bug, not a design: a disagreement between the copies
 * was invisible here and permanent in the data. 0010_cleanup.sql moved the
 * column to a table keyed (carrier, user, category) and the loop went with it.
 */
function leadDaysFor(category: string): number[] {
  const row = catPrefByCategory.get(category)
  // An empty array is treated as absent. `[]` means "warn me never", which
  // `parseLeadDays` refuses to save, so a stored one is a hand-edited row or an
  // older build — and showing a blank box for it would hide that.
  if (row?.lead_days && row.lead_days.length > 0) return row.lead_days
  return [...DEFAULT_LEAD_DAYS]
}

function digestFor(category: string): boolean {
  return catPrefByCategory.get(category)?.digest ?? true // the column default
}

// ---------------------------------------------------------------- formatting

/**
 * A timestamp in the reader's own day.
 *
 * `toLocaleString` throws RangeError on a zone it cannot resolve, and a settings
 * page that 500s because somebody's profile holds a bad string would take the
 * un-snooze button down with it. The fallback is UTC and labelled as such.
 */
function stamp(value: string): string {
  const when = new Date(value)
  if (Number.isNaN(when.getTime())) return '—'
  try {
    return when.toLocaleString('en-US', {
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      timeZone: timezone,
    })
  } catch {
    return `${when.toISOString().slice(0, 16).replace('T', ' ')} UTC`
  }
}

/**
 * The shared badge from global.css, so a delivery result reads the same here as
 * a compliance standing does on the dashboard. It used to hand back a bare
 * colour pair — a second badge construction beside `.badge`, and in the grey
 * case `text-ink-500` on a tint, which is under the contrast floor.
 */
function statusPill(status: string): string {
  switch (status) {
    case 'sent':
    case 'delivered':
      return 'badge badge-success'
    case 'failed':
    case 'not delivered':
    case 'marked as spam':
      return 'badge badge-danger'
    case 'skipped':
      return 'badge badge-neutral'
    default:
      return 'badge badge-warning'
  }
}

/**
 * What this row should SAY happened, which is not always what `status` holds.
 *
 * `status` records that the provider accepted the message — and it returns that
 * same acceptance for an address it has suppressed and then silently drops. A
 * row reading "sent" about a message that reached nobody is the same lie as a
 * green digest run, told to the person it hurts most: the whole value of this
 * table is answering "did you tell me?" months later, and it cannot answer that
 * with a word the provider has since contradicted.
 *
 * `unknown` deliberately shows the send status unchanged. Most rows are
 * unresolved for the first few minutes of their life, and flagging every one of
 * them would train the reader to ignore the column.
 */
function deliveryLabel(row: LogRow): string {
  if (row.status !== 'sent') return row.status
  if (row.delivery_state === 'undelivered') return 'not delivered'
  if (row.delivery_state === 'delivered') return 'delivered'
  if (row.delivery_state === 'complained') return 'marked as spam'
  return row.status
}

const channelLabel = (value: string) =>
  NOTIFY_CHANNELS.find((c) => c.value === value)?.label ?? value

const addressLines = [
  carrier?.phy_street,
  [carrier?.phy_city, carrier?.phy_state].filter(Boolean).join(', '),
  carrier?.phy_zip,
].filter((line) => Boolean(line && String(line).trim()))

const params = Astro.url.searchParams
const ERRORS: Record<string, string> = {
  dot_digits: 'A USDOT number is digits only — no letters, spaces or punctuation.',
  dot_present: 'A USDOT number is already on file, so this one was not saved.',
  dot_taken: 'Another account is already using that USDOT number.',
  // Short, literal sentences. Each one says what is wrong and what to type
  // instead, because the person reading it may not read English easily and a
  // refusal they cannot act on is the same as a broken button.
  phone_bad: 'We could not read that phone number. Type 10 digits, like (818) 334-0168.',
  email_shape: 'That is not an email address. Type it like name@company.com.',
  email_same: 'That is the email you use now. Nothing changed.',
  email_failed: 'We could not change your email. Try again in a moment.',
  password_wrong: 'That password is not right. Type the password you use now.',
  password_short: `Your new password is too short. Use ${MIN_PASSWORD} letters or numbers or more.`,
  password_mismatch: 'The two new passwords are not the same. Type the same one in both boxes.',
  password_same: 'Your new password is the same as your old one. Pick a different one.',
  password_failed: 'We could not change your password. Try again in a moment.',
  tz_unknown: 'That is not a timezone we recognise.',
  quiet_pair: 'Quiet hours need both a start and an end, or neither.',
  quiet_same: 'Quiet hours that start and end at the same minute do not silence anything.',
  snooze_unknown: 'That snooze is not one of yours.',
  channels_failed: 'Your lead times were saved, but the channels were not. Try that part again.',
  save_failed: 'We could not save that just now. Try again in a moment.',
  operation_choice: `Pick one answer for each of the three questions. "I'm not sure" is fine.`,
  operation_not_ready:
    'We cannot save these answers yet. This part is not switched on. Nothing changed, and we ' +
    'keep showing you every rule until it is.',
}

// `Object.hasOwn`, not `ERRORS[code]`: a plain lookup answers `?error=toString`
// with a function, which renders as source code across the top of the page.
const errorCode = params.get('error')
const error = errorCode && Object.hasOwn(ERRORS, errorCode) ? ERRORS[errorCode] : null

/**
 * Which box the refusal is about.
 *
 * The summary line at the top becomes a link to that box, and the box itself
 * carries `aria-invalid` and points back at its own message through
 * `aria-describedby`. Six forms share this page, so a message with no field
 * attached is a message the reader has to go and find; a name here is what
 * makes it one tap on a phone instead.
 *
 * Codes that belong to no single box — `save_failed`, `channels_failed`,
 * `snooze_unknown` — map to null and ErrorSummary prints them without a link.
 */
const ERROR_FIELD: Record<string, string> = {
  dot_digits: 'dot_number',
  dot_present: 'dot_number',
  dot_taken: 'dot_number',
  phone_bad: 'phone',
  tz_unknown: 'timezone',
  email_shape: 'new_email',
  email_same: 'new_email',
  email_failed: 'new_email',
  password_wrong: 'current_password',
  password_short: 'new_password',
  password_mismatch: 'new_password_again',
  password_same: 'new_password',
  password_failed: 'new_password',
  quiet_pair: 'quiet_from',
  quiet_same: 'quiet_from',
  operation_choice: 'crosses_state_lines_yes',
}
const errorField = error && errorCode ? (ERROR_FIELD[errorCode] ?? null) : null

/** The three attributes a rejected box needs, written once so none goes missing. */
const invalid = (name: string) =>
  errorField === name
    ? { 'aria-invalid': 'true' as const, 'aria-describedby': `${name}-error` }
    : {}
const saved = params.get('saved')

const savedMessage: Record<string, string> = {
  profile: 'Your details are saved.',
  /**
   * The new address is NOT put in this message, and the reason is the query
   * string it would have to travel in. An email address in a URL is personal
   * data in the browser history, in any proxy log, and in the referrer header of
   * the next request — and `?error=` on this page already carries codes rather
   * than text precisely so that nobody can choose what appears across the top of
   * somebody else's settings page. The sentence is written to work without it.
   */
  email_sent:
    'Check your new email. We sent you a link. Open the email and click the link to finish. ' +
    'Your sign-in email does not change until you click it. Until then, sign in with your old ' +
    'email. If you do not see it, look in your spam folder.',
  password: 'Your password is changed. Use the new password next time you sign in.',
  alerts: 'Alert settings saved.',
  quiet: 'Quiet hours saved.',
  unsnoozed: 'Un-snoozed. That item is back in the alerts.',
  dot: 'USDOT number saved. Your federal record will start filling in the rest.',
  operation: 'Saved. Your dashboard now shows only the rules that fit your answers.',
}

/**
 * Which radio is checked in "How your company operates", from the stored
 * columns. NULL → "I am not sure", so a carrier that signed up before 0031, or
 * whose federal record left a box blank, sees the honest state and not a
 * default answer somebody else picked for him.
 */
const operation = operationAnswers({
  carrier_operation: carrier?.carrier_operation ?? null,
  for_hire: carrier?.for_hire ?? null,
  hazmat: carrier?.hazmat ?? null,
})
const operationSource: string | null = carrier?.operation_source ?? null

/**
 * The answers the FEDERAL RECORD is providing because the owner said he is not
 * sure (0040). `effectiveOperation` decides which of the three those are; this
 * only turns them back into the words the three questions are asked in.
 *
 * Shown, never silent. A fact that decides which rules a man is charged to
 * watch is a fact he has to be able to see and overrule, and one radio button
 * above each note does overrule it.
 */
const effective = effectiveOperation(carrier)
const borrowed = new Set(effective.federal)
const yesNo = (b: boolean | null): string | null =>
  b === true ? 'Yes' : b === false ? 'No' : null

const federalAnswer = {
  crossesStateLines: borrowed.has('carrier_operation')
    ? effective.carrier_operation === 'A'
      ? 'Yes'
      : 'No'
    : null,
  forHire: borrowed.has('for_hire') ? yesNo(effective.for_hire) : null,
  hazmat: borrowed.has('hazmat') ? yesNo(effective.hazmat) : null,
}

const card = 'card'
// The shared field construction. The local one it replaces was 40px tall and
// bordered ink-100, which is 1.35:1 against the card it sits on.
const field = 'field-input mt-1'
// No `size-4`. The base rule in global.css sizes every checkbox and radio at
// 20px for a thumb; a 16px utility over the top of it was undoing that.
const checkbox = 'rounded'
const th = 'px-4 py-3 font-medium'

/**
 * ON A PHONE THE TWO TABLES ON THIS PAGE ARE NOT TABLES.
 *
 * The matrix is 56rem and the message log is 48rem; the window inside each is
 * 341px. So 555px and 427px of every row was behind a sideways scroll — and on
 * the matrix that meant the boxes themselves, which is the entire control. A
 * grid of bare checkboxes is also unreadable without its column heads, so below
 * `sm` each box carries its own name and its own caveat.
 *
 * Below `sm` every cell is a block; from `sm` the same markup is a table again.
 * ONE set of cells, not two, the same way src/components/Documents.astro does
 * it. The matrix keeps its column order down a phone because that order already
 * reads correctly; the log is reordered with `order-*` so a message leads with
 * what it was about rather than with a timestamp. `order-*` needs the row to be
 * a flex column below `sm`, and from `sm` it is `table-row` again and the
 * property is ignored, so neither desktop table moves.
 */
const cell = 'block px-4 py-1 sm:table-cell sm:py-3'
/** The column name, carried into the block that no longer has a header row. */
const colName = 'text-ink-500 sm:hidden'
/**
 * A checkbox with its name beside it on a phone, a centred box in a column from
 * `sm`. The 44px row is kept at EVERY width now: `sm:min-h-0` used to drop the
 * desktop target back to the 20px of the box itself, and a matrix of 20px
 * targets is the hardest thing on this page to hit with any pointer.
 */
const boxRow = 'flex min-h-11 items-center gap-3 sm:justify-center'
const button = 'btn btn-primary'
const help = 'field-hint block'
---

<App title="Settings" subtitle={current.subtitle}>
  {/*
    FOUR LINKS, NOT A TABLIST. `role="tablist"` is a promise to handle arrow
    keys, Home and End in script, and this app ships none — so the honest markup
    for four addresses is four links inside a nav, which every screen reader and
    every browser already knows how to work. `aria-current` is what says which
    one you are on; the tint is the second signal, never the only one.

    .filter-tab / .is-current are the same 44px pill the loads, drivers and
    vehicle lists use, so the selected state here looks like the selected state
    everywhere else. The strip does not stick: the header above it is already
    fixed, and a second fixed bar was what made jump links land underneath the
    first one.

    IT WRAPS, IT DOES NOT SCROLL. The eleven-tab strips on the loads and drivers
    lists scroll sideways behind a fade, because eleven tabs cannot wrap into
    anything readable. Four can — and at 375px these four are 426px wide, so a
    scrolling strip put "Messages" off the right edge with nothing on screen to
    say it was there. Wrapping costs one 44px row on a phone and hides nothing,
    at any font size, in any translation.
  */}
  <nav aria-label="Settings sections" class="mb-5 flex flex-wrap items-center gap-2">
    {
      TABS.map((t) => (
        <a
          href={`/app/settings?tab=${t.id}`}
          aria-current={t.id === tab ? 'page' : undefined}
          class:list={['filter-tab shrink-0', t.id === tab && 'is-current']}
        >
          {t.label}
        </a>
      ))
    }
  </nav>

  {/* The designed error state. `fail()` redirects to this box's id, so the
      browser scrolls to it and focuses it with no script running, and the line
      inside is a link to the box the refusal is about — which matters here,
      where six forms share one page. */}
  {error && <ErrorSummary class="mb-5" errors={[{ message: error, field: errorField ?? undefined }]} />}
  {
    saved && savedMessage[saved] && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        {savedMessage[saved]}
      </p>
    )
  }

  {tab === 'you' && (
    <Fragment>
      {/* ======================================================== your account */}

      <section>
        <h2 class="text-base font-semibold tracking-tight">Your account</h2>
        <p class="mt-1 max-w-3xl text-sm text-ink-500">
          This is you, not the company. Everyone who signs in has their own name, phone, email and
          password.
        </p>

        <div class="mt-3 grid items-start gap-4 lg:grid-cols-2">
          <form method="POST" class={card}>
            <h3 class="text-sm font-semibold tracking-tight">Your details</h3>

            <div class="mt-3">
              <label class="field-label" for="full_name">Your name</label>
              <input
                type="text"
                id="full_name"
                name="full_name"
                value={profile?.full_name ?? ''}
                autocomplete="name"
                class={field}
                aria-describedby="full_name-hint"
              />
              <span class={help} id="full_name-hint">You can leave this blank.</span>
            </div>

            <div class="mt-3">
              <label class="field-label" for="phone">Your phone</label>
              {/*
                Shown the way a person reads it, stored as E.164. The two are
                deliberately different, and the save compares what was typed against
                what this box DISPLAYED — see `parsePhoneEdit` — so an old number
                nobody touched is never the reason a name will not save.
              */}
              <input
                type="tel"
                inputmode="tel"
                id="phone"
                name="phone"
                value={formatPhone(profile?.phone)}
                placeholder="(818) 334-0168"
                autocomplete="tel"
                class={`${field} tabular-nums`}
                {...invalid('phone')}
              />
              {
                errorField === 'phone' && (
                  <p class="field-error" id="phone-error">
                    <span aria-hidden="true">⚠</span>
                    <span>{error}</span>
                  </p>
                )
              }
              <span class={help}>
                10 digits. You can leave this blank. We do not send text messages yet.
              </span>
              {
                /*
                  A NOTE, NOT A BADGE, and the badge is why. `.badge` is
                  `whitespace-nowrap` — it is a one-word label, "Overdue" or "Paid" —
                  so this three-sentence warning rendered as a single unbreakable
                  pill about 350px wide inside a card on a 341px phone window, and
                  the end of it was off the screen.

                  The sentence itself stays exactly as it was. This number was
                  already saved: `parsePhoneEdit` grandfathers a legacy value on
                  purpose, because tightening the check locked owners out of their
                  own rows, so this is a standing note about a number we hold and not
                  a refusal of anything. Amber, because it is a thing to fix and not
                  a thing that is wrong right now, and the glyph is decoration beside
                  words that say it — colour is never the only signal.
                */
                phoneUndialable && (
                  <p class="mt-1.5 flex items-start gap-1.5 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-900">
                    <span aria-hidden="true">⚠</span>
                    <span>We cannot text this number. Type 10 digits. We saved it anyway.</span>
                  </p>
                )
              }
            </div>

            <div class="mt-3">
              <label class="field-label" for="timezone">Your timezone</label>
              <select id="timezone" name="timezone" class={field} {...invalid('timezone')}>
                {
                  timezoneOptions(timezone).map((tz) => (
                    <option value={tz.value} selected={tz.value === timezone}>
                      {tz.label}
                    </option>
                  ))
                }
              </select>
              {
                errorField === 'timezone' && (
                  <p class="field-error" id="timezone-error">
                    <span aria-hidden="true">⚠</span>
                    <span>{error}</span>
                  </p>
                )
              }
              {/*
                This control used to live in the carrier block. It is a setting about
                the PERSON — it decides what time their own email arrives and what
                their own quiet hours mean — and a person looking for their own
                details never found it under the company's federal record.
              */}
              <span class={help}>
                Your clock, not the company's. It sets when your morning email arrives, what your
                quiet hours mean, and how times are printed on this page. Until you pick one, we use
                the company's.
              </span>
            </div>

            <button type="submit" name="intent" value="save_profile" class={`${button} mt-4`}>
              Save my details
            </button>
          </form>

          <div class="space-y-4">
            {/* ------------------------------------------------ sign-in email */}

            <div class={card}>
              <h3 class="text-sm font-semibold tracking-tight">Your email</h3>
              <p class="mt-3 text-sm text-ink-500">You sign in with this email:</p>
              <p class="mt-1 text-base font-medium break-all">
                {signInEmail || <span class="font-normal text-ink-500">not known</span>}
              </p>
              <p class="mt-2 text-sm text-ink-500">
                Your morning compliance email goes to this address too.
              </p>

              <form method="POST" class="mt-4 border-t border-ink-100 pt-4">
                <div>
                  <label class="field-label" for="new_email">New email</label>
                  <input
                    type="email"
                    id="new_email"
                    name="new_email"
                    required
                    autocomplete="email"
                    class={field}
                    {...invalid('new_email')}
                  />
                  {
                    errorField === 'new_email' && (
                      <p class="field-error" id="new_email-error">
                        <span aria-hidden="true">⚠</span>
                        <span>{error}</span>
                      </p>
                    )
                  }
                </div>
                <div class="mt-3">
                  {/* The id is scoped to this form: the password block below has a
                      box with the same `name`, and two elements cannot share an id
                      on one page — which is what `aria-describedby` resolves. */}
                  <label class="field-label" for="email_current_password">Your password</label>
                  <input
                    type="password"
                    id="email_current_password"
                    name="current_password"
                    required
                    autocomplete="current-password"
                    class={field}
                    aria-describedby="email_current_password-hint"
                  />
                  <span class={help} id="email_current_password-hint">
                    We ask for it so nobody else can change your email.
                  </span>
                </div>

                {/*
                  Said BEFORE the button, not after it. `updateUser({ email })` does
                  not change the sign-in address — it sends a link and waits — and a
                  person who presses this expecting an immediate change will try the
                  new address on the login page and conclude the account is broken.
                */}
                <div class="mt-3 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
                  <p class="font-medium">What happens next</p>
                  <ol class="mt-1 list-decimal space-y-0.5 pl-5">
                    <li>We send a link to the new email.</li>
                    <li>You open that email and click the link.</li>
                    <li>Then the new email works for signing in.</li>
                  </ol>
                  <p class="mt-2">
                    Your email does not change until you click the link. Until then, keep signing in
                    with your old email. Do not close your account or sign out to wait.
                  </p>
                </div>

                <button type="submit" name="intent" value="change_email" class={`${button} mt-3`}>
                  Send the link
                </button>
              </form>
            </div>

            {/* ---------------------------------------------------- password */}

            <div class={card}>
              <h3 class="text-sm font-semibold tracking-tight">Your password</h3>

              {/*
                THIS BOX USED TO BE A WARNING, and it was amber because it carried
                bad news: there was no forgot-password anywhere in the application,
                so a person who could not remember their password never got back in,
                and the only thing this screen could honestly do was say so and give
                them an address to write to.

                /auth/forgot-password now exists, so the warning would be a lie —
                and an expensive one, because the person who reads it is deciding
                what to do on the morning they are locked out. It is an instruction
                now, not an alarm, which is why it is no longer amber: nothing here
                is going wrong. The steps are numbered because they are steps, and
                because they will be read by somebody who is worried.
              */}
              <div class="mt-3 rounded-lg bg-ink-50 px-4 py-3 text-sm text-ink-700">
                <p class="font-medium">If you forget your password</p>
                <ol class="mt-1 list-decimal space-y-1 pl-4">
                  <li>Go to the sign-in page and press "Forgot your password?".</li>
                  <li>Type your email. We send you a link.</li>
                  <li>Open the link and pick a new password.</li>
                </ol>
                <p class="mt-2">
                  The link goes to the email you sign in with, so keep that email working. If you
                  cannot get into that email, write to{' '}
                  <a href={`mailto:${site.email}`} class="link font-medium">{site.email}</a>.
                </p>
              </div>

              <form method="POST" class="mt-4">
                <div>
                  <label class="field-label" for="current_password">Password you use now</label>
                  <input
                    type="password"
                    id="current_password"
                    name="current_password"
                    required
                    autocomplete="current-password"
                    class={field}
                    {...invalid('current_password')}
                  />
                  {
                    errorField === 'current_password' && (
                      <p class="field-error" id="current_password-error">
                        <span aria-hidden="true">⚠</span>
                        <span>{error}</span>
                      </p>
                    )
                  }
                </div>
                <div class="mt-3">
                  <label class="field-label" for="new_password">New password</label>
                  <input
                    type="password"
                    id="new_password"
                    name="new_password"
                    required
                    minlength={MIN_PASSWORD}
                    autocomplete="new-password"
                    class={field}
                    aria-invalid={errorField === 'new_password' ? 'true' : undefined}
                    aria-describedby={
                      errorField === 'new_password'
                        ? 'new_password-error new_password-hint'
                        : 'new_password-hint'
                    }
                  />
                  {
                    errorField === 'new_password' && (
                      <p class="field-error" id="new_password-error">
                        <span aria-hidden="true">⚠</span>
                        <span>{error}</span>
                      </p>
                    )
                  }
                  <span class={help} id="new_password-hint">
                    Use {MIN_PASSWORD} letters or numbers or more.
                  </span>
                </div>
                <div class="mt-3">
                  <label class="field-label" for="new_password_again">New password again</label>
                  <input
                    type="password"
                    id="new_password_again"
                    name="new_password_again"
                    required
                    minlength={MIN_PASSWORD}
                    autocomplete="new-password"
                    class={field}
                    aria-invalid={errorField === 'new_password_again' ? 'true' : undefined}
                    aria-describedby={
                      errorField === 'new_password_again'
                        ? 'new_password_again-error new_password_again-hint'
                        : 'new_password_again-hint'
                    }
                  />
                  {
                    errorField === 'new_password_again' && (
                      <p class="field-error" id="new_password_again-error">
                        <span aria-hidden="true">⚠</span>
                        <span>{error}</span>
                      </p>
                    )
                  }
                  <span class={help} id="new_password_again-hint">
                    Type the same new password one more time.
                  </span>
                </div>

                <p class="mt-3 text-sm text-ink-500">
                  You stay signed in on this computer. Use the new password next time you sign in.
                </p>

                <button type="submit" name="intent" value="change_password" class={`${button} mt-3`}>
                  Change my password
                </button>
              </form>
            </div>
          </div>
        </div>
      </section>
    </Fragment>
  )}

  {tab === 'company' && (
    <Fragment>
      {/* ============================================================ carrier */}

      <section>
        <h2 class="text-base font-semibold tracking-tight">Your carrier</h2>
        <p class="mt-1 max-w-3xl text-sm text-ink-500">
          These come from your federal record at FMCSA. You cannot change them here. If something is
          wrong, file an MCS-150 update with FMCSA. It changes here after that.
        </p>

        {
          /*
            Only when there is no number on file. A carrier who signed up without one
            has an MCS-150 row on his dashboard that nothing in the app can ever
            answer — the column is written by the signup form and nowhere else — and
            every federal lookup we do is keyed on this number, so until it is here
            the promise to "fill in what we can" has nothing to fill in from.

            Deliberately not an edit. Once a number is on file this disappears, and
            the paragraph above it goes back to being the whole truth.
          */
          !carrier?.dot_number && (
            <form method="POST" class="mt-3 rounded-xl border border-amber-200 bg-amber-50/40 p-5">
              <h3 class="text-sm font-semibold tracking-tight">
                We do not have your USDOT number
              </h3>
              <p class="mt-1 max-w-2xl text-sm text-amber-900">
                Without it we cannot read your federal record, and the MCS-150 update on your
                dashboard has nothing to count from. You can set it once here; after that it comes
                from FMCSA like everything else above.
              </p>
              <div class="mt-3 flex flex-wrap items-end gap-3">
                <div>
                  <label class="field-label" for="dot_number">USDOT number</label>
                  <input
                    type="text"
                    id="dot_number"
                    name="dot_number"
                    inputmode="numeric"
                    pattern="[0-9]{1,8}"
                    required
                    autocomplete="off"
                    class={`${field} w-48 tabular-nums`}
                    {...invalid('dot_number')}
                  />
                  {
                    errorField === 'dot_number' && (
                      <p class="field-error" id="dot_number-error">
                        <span aria-hidden="true">⚠</span>
                        <span>{error}</span>
                      </p>
                    )
                  }
                </div>
                <button type="submit" name="intent" value="set_dot_number" class="btn btn-primary">
                  Save it
                </button>
              </div>
            </form>
          )
        }

        {/* One card since the timezone control moved into "Your account", where the
            person it belongs to is. */}
        <div class="mt-3 max-w-3xl">
          <div class={card}>
            <dl class="divide-y divide-ink-100 text-sm">
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-500">Legal name</dt>
                <dd class="text-right font-medium">{carrier?.legal_name ?? '—'}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-500">Doing business as</dt>
                <dd class="text-right font-medium">
                  {carrier?.dba_name || <span class="font-normal text-ink-500">none on file</span>}
                </dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-500">USDOT number</dt>
                <dd class="text-right font-medium tabular-nums">{carrier?.dot_number ?? '—'}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-500">Physical address</dt>
                <dd class="text-right font-medium">
                  {
                    addressLines.length > 0 ? (
                      addressLines.map((line) => <div class="tabular-nums">{line}</div>)
                    ) : (
                      <span class="font-normal text-ink-500">none on file</span>
                    )
                  }
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      {/* ========================================= how the company operates */}

      {/*
        NOT inside a <details>, and not below the fold of anything. The review of
        2026-09-18 found that a carrier had nowhere in the product to say "that
        rule does not apply to me", and put it first on the list of things that
        stop him paying. Three radio groups, one save, and the sentence above them
        says in plain words what an answer does to his dashboard.

        Every "No" is stated in words on the page: "we stop showing the rules that
        only apply when the answer is Yes". "I'm not sure" is a real option, not a
        fallback — it stores NULL and the rules keep tracking.
      */}
      <section class="mt-10">
        <h2 class="text-base font-semibold tracking-tight">How your company operates</h2>
        <p class="mt-1 max-w-3xl text-sm text-ink-500">
          Your answers decide which rules we show you. If you answer No, we stop showing the rules
          that only apply when the answer is Yes. If you are not sure, we use what your USDOT record
          says. If your USDOT record does not say either, we keep showing them.
        </p>

        {
          operationReady ? (
            <form method="POST" class={`${card} mt-3 max-w-3xl`}>
              <p class="text-sm text-ink-700">
                {
                  operationSource === 'owner'
                    ? 'You set these answers. You can change them here any time.'
                    : operationSource === 'fmcsa'
                      ? 'These answers came from your federal record at FMCSA. If one is wrong, change it here.'
                      : 'We do not have these answers yet. Please answer the three questions.'
                }
              </p>

              <fieldset class="mt-5">
                <legend class="text-sm font-medium">Do your trucks cross state lines?</legend>
                <p class="field-hint">
                  Answer Yes if any truck goes into another state, or carries freight that is going to
                  or coming from another state.
                </p>
                <div class="mt-2">
                  <label class="check-row">
                    <input
                      type="radio"
                      name="crosses_state_lines"
                      value="yes"
                      id="crosses_state_lines_yes"
                      checked={operation.crossesStateLines === 'yes'}
                      {...invalid('crosses_state_lines_yes')}
                    />
                    <span class="text-sm">Yes</span>
                  </label>
                  <label class="check-row">
                    <input
                      type="radio"
                      name="crosses_state_lines"
                      value="no"
                      checked={operation.crossesStateLines === 'no'}
                    />
                    <span class="text-sm">No. Our trucks stay inside one state.</span>
                  </label>
                  <label class="check-row">
                    <input
                      type="radio"
                      name="crosses_state_lines"
                      value="unsure"
                      checked={operation.crossesStateLines === 'unsure'}
                    />
                    <span class="text-sm">I'm not sure</span>
                  </label>
                </div>
                {
                  federalAnswer.crossesStateLines && (
                    <p class="mt-2 text-sm text-ink-700">
                      Your USDOT record says <strong>{federalAnswer.crossesStateLines}</strong>. We use that
                      answer while you are not sure.
                    </p>
                  )
                }
                {
                  errorField === 'crosses_state_lines_yes' && (
                    <p class="field-error" id="crosses_state_lines_yes-error">
                      <span aria-hidden="true">⚠</span>
                      <span>{error}</span>
                    </p>
                  )
                }
              </fieldset>

              <fieldset class="mt-5 border-t border-ink-100 pt-5">
                <legend class="text-sm font-medium">Do you haul for other people for pay?</legend>
                <p class="field-hint">
                  Answer Yes if you get paid to carry freight for a shipper or a broker. Answer No if
                  your trucks only carry your own goods.
                </p>
                <div class="mt-2">
                  <label class="check-row">
                    <input
                      type="radio"
                      name="for_hire"
                      value="yes"
                      checked={operation.forHire === 'yes'}
                    />
                    <span class="text-sm">Yes</span>
                  </label>
                  <label class="check-row">
                    <input type="radio" name="for_hire" value="no" checked={operation.forHire === 'no'} />
                    <span class="text-sm">No. We only carry our own goods.</span>
                  </label>
                  <label class="check-row">
                    <input
                      type="radio"
                      name="for_hire"
                      value="unsure"
                      checked={operation.forHire === 'unsure'}
                    />
                    <span class="text-sm">I'm not sure</span>
                  </label>
                </div>
                {
                  federalAnswer.forHire && (
                    <p class="mt-2 text-sm text-ink-700">
                      Your USDOT record says <strong>{federalAnswer.forHire}</strong>. We use that
                      answer while you are not sure.
                    </p>
                  )
                }
              </fieldset>

              <fieldset class="mt-5 border-t border-ink-100 pt-5">
                <legend class="text-sm font-medium">
                  Do you carry placarded hazardous materials?
                </legend>
                <p class="field-hint">
                  Placarded means the load needs the diamond hazmat signs on the truck. Answer No if you
                  never carry a load like that.
                </p>
                <div class="mt-2">
                  <label class="check-row">
                    <input type="radio" name="hazmat" value="yes" checked={operation.hazmat === 'yes'} />
                    <span class="text-sm">Yes</span>
                  </label>
                  <label class="check-row">
                    <input type="radio" name="hazmat" value="no" checked={operation.hazmat === 'no'} />
                    <span class="text-sm">No</span>
                  </label>
                  <label class="check-row">
                    <input
                      type="radio"
                      name="hazmat"
                      value="unsure"
                      checked={operation.hazmat === 'unsure'}
                    />
                    <span class="text-sm">I'm not sure</span>
                  </label>
                </div>
                {
                  federalAnswer.hazmat && (
                    <p class="mt-2 text-sm text-ink-700">
                      Your USDOT record says <strong>{federalAnswer.hazmat}</strong>. We use that
                      answer while you are not sure.
                    </p>
                  )
                }
              </fieldset>

