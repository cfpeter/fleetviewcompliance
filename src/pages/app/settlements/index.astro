---
/**
 * Driver pay, by period and by driver.
 *
 * "DRIVER PAY" ON EVERY HEADING AND EVERY LINK, NOT "SETTLEMENTS".
 *
 * The navigation has said "Driver pay" since the header was swept, and a
 * section whose nav label and whose H1 are two different words is a section the
 * reader cannot tell he has arrived at. "Settlement" is the wrong word for this
 * reader on its own terms as well: three syllables, abstract, and a legal word
 * besides, on a screen opened by an owner reading a second language to work out
 * what he owes a man this week. One record is a PAY STATEMENT — the sheet that
 * goes to the driver with the cheque, which is what it physically is.
 *
 * THE ROUTE, THE TABLES AND EVERY `Settlement*` IDENTIFIER ARE UNTOUCHED. This
 * is what the screen says, not what the database calls it: /app/settlements
 * stays /app/settlements, so a bookmark or a texted link still works, and
 * `settlements`, `settlement_lines` and `settlementTotals` keep their names.
 *
 * NOT PAYROLL. This screen produces the statement that goes with the cheque and
 * exports it; nothing here withholds tax or files anything. The banner says so
 * because a carrier who believes otherwise is a carrier who stops withholding,
 * and that is a mistake this product must not help anyone make.
 *
 * The totals column mixes two different kinds of number on purpose, and the
 * difference is the whole design:
 *
 *   A DRAFT'S total is re-derived from its lines on every page load. Nothing is
 *   stored, so it cannot drift from the lines underneath it.
 *
 *   A LOCKED settlement's total is the frozen `net_cents` written the moment it
 *   was paid. Its lines are immutable by then (0016_settlements.sql), so the two
 *   can never disagree — and the number that was actually on the cheque is a
 *   fact on the row rather than an arithmetic result that depends on today's code.
 *
 * The filters are plain GET parameters, so a filtered list is a URL that can be
 * bookmarked or texted to the owner. Nothing on this page runs JavaScript.
 */
import Bars from '../../../components/charts/Bars.astro'
import Columns from '../../../components/charts/Columns.astro'
import Figure from '../../../components/charts/Figure.astro'
import App from '../../../layouts/App.astro'
import { flashText } from '../../../lib/flash.ts'
import {
  driverYearToDate,
  monthsEnding,
  netForDisplay,
  paidCoverage,
  paidSettlements,
  payByMonth,
} from '../../../lib/charts/pay.ts'
// `compactMoney` is deliberately NOT imported. Every figure on this page is
// money somebody reconciles against a cheque, and the one place a compact
// figure is allowed — an axis tick — is written out in full here too, because
// the exact per-column figures are hidden below 640px and a reader on a phone
// would have no full number anywhere on the picture to check the axis against.
import { ceilingFor } from '../../../lib/charts/scale.ts'
import { formatDate, fullName, todayInCalifornia } from '../../../lib/drivers.ts'
import { formatCents } from '../../../lib/loads.ts'
import {
  SETTLEMENT_STATUSES,
  type SettlementCategory,
  isLocked,
  isSettlementStatus,
  settlementStatusLabel,
  settlementStatusPillClass,
} from '../../../lib/settlements/compute.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!
const userId = Astro.locals.userId!

const back = (params: string) => Astro.redirect(`/app/settlements${params ? `?${params}` : ''}`, 303)
const fail = (message: string) => back(`error=${encodeURIComponent(message)}`)

/** ISO date arithmetic in UTC. Never `new Date('2026-03-01')` in local time —
 *  on a Los Angeles carrier that parses as the previous afternoon, which has
 *  silently moved a settlement period a day early before. */
function shiftDays(iso: string, days: number): string {
  const d = new Date(`${iso}T00:00:00Z`)
  d.setUTCDate(d.getUTCDate() + days)
  return d.toISOString().slice(0, 10)
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  if (intent === 'create') {
    const driverId = String(form.get('driver_id') ?? '')
    if (!driverId) return fail('Pick the driver this settlement is for.')
    // Shape first, then ownership. A hand-edited value that is not a uuid used
    // to reach Postgres and come back as "invalid input syntax for type uuid"
    // across the top of the page; a uuid from another carrier's roster used to
    // come back as the trigger's own words. Both are now one sentence about the
    // list, and the read below goes through RLS, so a driver who is not ours is
    // simply not there.
    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(driverId)) {
      return fail('Pick the driver from the list.')
    }
    const { data: driverRow, error: driverError } = await supabase
      .from('drivers')
      .select('id')
      .eq('id', driverId)
      .maybeSingle()
    if (driverError) return fail('We could not check that driver. Try again.')
    if (!driverRow) return fail('That driver is not on your roster. Pick one from the list.')

    const start = String(form.get('period_start') ?? '')
    const end = String(form.get('period_end') ?? '')
    // Checked as strings before Postgres sees them. An empty date column is
    // `invalid input syntax for type date: ""` — a 500 on a form somebody
    // tabbed through, rather than a sentence about the box they missed.
    if (!/^\d{4}-\d{2}-\d{2}$/.test(start) || !/^\d{4}-\d{2}-\d{2}$/.test(end)) {
      return fail('A settlement covers a period. Enter a first day and a last day.')
    }
    if (end < start) return fail('The last day is before the first day. Check the two dates.')

    const { data, error } = await supabase
      .from('settlements')
      .insert({
        // Supplied on INSERT, never filtered on SELECT: RLS checks carrier_id
        // but does not fill it in, and a trigger separately refuses a driver_id
        // belonging to somebody else's carrier.
        carrier_id: carrierId,
        driver_id: driverId,
        period_start: start,
        period_end: end,
        created_by: userId,
      })
      .select('id')
      .single()

    if (error) {
      // The unique index on (carrier, driver, period, revision) is the one a
      // person actually hits, by opening the same week twice. Postgres says
      // "duplicate key value violates unique constraint", which tells them
      // nothing they can act on.
      if (error.code === '23505') {
        return fail('That driver already has a settlement for those exact dates. Open it instead.')
      }
      // Postgres words are for an operator, not for the person at the desk.
      console.error('settlement insert failed:', error.message)
      return fail('We could not start that settlement. Wait a moment and try again.')
    }
    // Redirect rather than render: a refresh would otherwise open a second
    // settlement for the same week, and two statements for one week is the
    // thing a driver notices and nobody else does.
    return Astro.redirect(`/app/settlements/${data.id}?created=1`, 303)
  }

  return back('')
}

interface DriverRow {
  id: string
  first_name: string
  last_name: string
  status: string
}

interface LineRow {
  category: SettlementCategory
  amount_cents: number
}

/**
 * The four columns a stage total is made of. A settlement row satisfies it, so
 * the strip can be fed either the list already on screen or the smaller query
 * the filtered view makes for it.
 */
interface StageRow {
  status: string
  superseded_at: string | null
  net_cents: number | null
  /** Embedded so a draft's total is the truth rather than a stored guess. */
  settlement_lines: LineRow[] | null
}

interface SettlementRow extends StageRow {
  id: string
  driver_id: string
  period_start: string
  period_end: string
  revision: number
  paid_on: string | null
  /**
   * PostgREST returns a to-one embed as an object and a to-many embed as an
   * array depending on how it reads the foreign key, and it has been both
   * across versions. Accepted either way rather than betting the name column.
   */
  drivers: { first_name: string; last_name: string } | { first_name: string; last_name: string }[] | null
}

const params = Astro.url.searchParams
const requestedStatus = params.get('status') ?? 'all'
/**
 * THE DEFAULT VIEW IS EVERYTHING.
 *
 * A paid settlement is not finished business the way a terminated driver is:
 * it is the row a driver rings about, and hiding it behind a filter is how the
 * office ends up saying "I can't see it" about a statement they produced. An
 * unrecognised value also lands here rather than being handed to Postgres —
 * `.eq('status', '')` is an enum cast error, which is a 500 on the page reached
 * by clearing a filter.
 */
const status = isSettlementStatus(requestedStatus) ? requestedStatus : 'all'
const driverFilter = params.get('driver') ?? ''

/**
 * THE RESTING VIEW: everything, nobody filtered.
 *
 * Declared here rather than beside the charts because the query below reads it.
 * The charts belong to the resting view and only to it — see the note above
 * `pay`. The STAGE STRIP is the exception, and the reason is in the note there.
 */
const resting = status === 'all' && !driverFilter

let query = supabase
  .from('settlements')
  .select(
    'id, driver_id, period_start, period_end, status, revision, superseded_at, net_cents, paid_on, drivers ( first_name, last_name ), settlement_lines ( category, amount_cents )',
  )
  // Most recent period first. A settlement list is worked from the top: the
  // week that just closed is the one being built.
  .order('period_start', { ascending: false })
  .order('revision', { ascending: false })

// No .eq('carrier_id', …) anywhere on this page. RLS already limits every row
// to the signed-in user's carrier, and repeating it in the query would read as
// though the policy might not hold.
if (status !== 'all') query = query.eq('status', status)
if (/^[0-9a-f-]{36}$/i.test(driverFilter)) query = query.eq('driver_id', driverFilter)

const [{ data, error: listError }, { data: driverData }, stageResult] = await Promise.all([
  query,
  supabase
    .from('drivers')
    .select('id, first_name, last_name, status')
    .order('last_name', { ascending: true }),
  /**
   * The stage strip's own rows, and ONLY when the list is filtered.
   *
   * The strip is a filter control, so unlike the charts it cannot vanish the
   * moment somebody uses it — a row of stages that empties itself when you tap
   * one is a control that lies about the other three. But the list query above
   * IS filtered, so on a filtered view its rows would report every other stage
   * as nought.
   *
   * So the strip gets the whole book, and the cost is paid only by the filtered
   * view: at rest it reuses the rows already on screen. Five columns, no
   * ordering, no driver names — a stage total needs the status, whether the row
   * has been replaced, the frozen net, and the lines a draft's total is derived
   * from, and nothing else.
   */
  resting
    ? null
    : supabase
        .from('settlements')
        .select('status, superseded_at, net_cents, settlement_lines ( category, amount_cents )'),
])

const rows = (data ?? []) as unknown as SettlementRow[]
const drivers = (driverData ?? []) as DriverRow[]
const activeDrivers = drivers.filter((d) => d.status === 'active')

function driverName(row: SettlementRow): string {
  const embedded = Array.isArray(row.drivers) ? row.drivers[0] : row.drivers
  if (embedded) return fullName(embedded)
  // Reachable when the embed is filtered out by a future select. Falling back
  // to the roster we already loaded beats printing a bare uuid.
  const hit = drivers.find((d) => d.id === row.driver_id)
  return hit ? fullName(hit) : 'Unknown driver'
}

/**
 * The number to show, and whether it is frozen.
 *
 * A locked settlement shows what was paid. A draft shows what its lines add up
 * to right now. The rule lives in `netForDisplay` rather than here because the
 * driver page prints the same figure, and two pages that decide separately which
 * of the two numbers a settlement gets are two pages that will eventually
 * disagree about what a driver was paid.
 */
function netOf(row: StageRow) {
  return netForDisplay(
    row.status,
    row.net_cents,
    (row.settlement_lines ?? []).map((l) => ({
      category: l.category,
      amountCents: l.amount_cents,
    })),
  )
}

/** A link that keeps the other filter intact. */
function withParam(key: string, value: string): string {
  const next = new URLSearchParams(params)
  if (value) next.set(key, value)
  else next.delete(key)
  // Notices from a previous action must not survive a filter click, or the
  // green "Created." banner follows her around the screen.
  next.delete('error')
  const s = next.toString()
  return `/app/settlements${s ? `?${s}` : ''}`
}

const today = todayInCalifornia()
// A week, ending today. The commonest settlement period in the segment by a
// distance, and it is only a prefill — both boxes are editable.
const defaultStart = shiftDays(today, -6)

// Only honoured when the request came from our own 303. See src/lib/flash.ts.
const error = flashText(Astro.url, Astro.request) ?? listError?.message ?? null
const tabs = [{ value: 'all', label: 'All' }, ...SETTLEMENT_STATUSES]
const card = 'card'

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * The table is 46rem and the window inside it is 341px, so 395px of every row
 * was behind a sideways scroll — including the Net column, which is the figure
 * the whole screen exists to produce. Below `sm` every cell is a block; from
 * `sm` the same markup is a table again. ONE set of cells, not two, the same
 * way src/components/Documents.astro does it.
 *
 * The blocks are ordered rather than left in column order: a settlement is
 * looked up by whose it is and what it comes to, and in column order the driver
 * is second and the net is last. `order-*` needs the row to be a flex column
 * below `sm`; from `sm` it is `table-row` again and the property is ignored.
 */
const cell = 'block px-4 py-1 sm:table-cell sm:py-3'
/**
 * ONE FIELD CONSTRUCTION, AND IT LIVES IN global.css.
 *
 * `.field-input` carries the visible ink-500 border — the old ink-100 was
 * 1.18:1 against white, a border nobody could see — 16px type so iOS does not
 * zoom the page when a thumb lands in a box, and the focus border colour. The
 * focus RING is the single `:focus-visible` rule in global.css: no per-field
 * ring is written here and none can be got wrong. The `ring-brand-500/20` this
 * page used to carry was 1.33:1 and failed WCAG 2.2 outright.
 */
const field = 'field-input mt-1'


/**
 * DRAFT → APPROVED → PAID, WITH THE COUNT AND THE MONEY AT EACH STAGE.
 *
 * The question this page is opened with is "who still needs paying", and the
 * three tiles that used to sit here could not answer it: they counted open
 * settlements and paid ones and added the open money into one figure, so a
 * fleet with four drafts and a week's approved statements read as one number
 * with no stage to it. The strip is the same numbers, cut by stage, each one a
 * tap that filters the list underneath.
 *
 * TWO KINDS OF MONEY ARE ON THIS STRIP AND THEY ARE NEVER ADDED TOGETHER.
 *
 * A draft's total is re-derived from its lines on every page load, so it is
 * still moving. A paid settlement's total is the frozen `net_cents` that was on
 * the cheque. Adding a moving figure to a frozen one produces a number nobody
 * can reconcile against anything afterwards — not the bank, not the lines, not
 * this page next week — so each stage prints its own total, the strip prints no
 * grand total, and the words under each figure say which kind it is.
 *
 * VOID GETS NO MONEY AT ALL. A voided statement has a stored net because voiding
 * snapshots one, but no money moved, and a dollar figure under the word "Void"
 * reads as money that went somewhere.
 *
 * A REPLACED ROW IS IN NO TOTAL. A paid settlement that has since been revised
 * is superseded, and its revision carries the corrected amount — count both and
 * one week's pay appears twice. Excluded here exactly as the table below fades
 * them out, and counted in a sentence so the exclusion is visible rather than
 * silent.
 */
const stageFailed = Boolean(stageResult?.error)
// A failed stage query falls back to the rows already on screen rather than to
// an empty array: four stages reading nought over a list that plainly has rows
// in it is worse than a partial answer that says it is partial, and the amber
// line under the strip says which one this is.
const stageRows: StageRow[] = resting || stageFailed
  ? rows
  : ((stageResult?.data ?? []) as unknown as StageRow[])

const STAGES: readonly { value: string; label: string; money: boolean; note: string }[] = [
  {
    value: 'draft',
    label: 'Draft',
    money: true,
    note: 'Added up from the lines every time this page loads.',
  },
  {
    value: 'approved',
    label: 'Approved',
    money: true,
    note: 'Signed off, not paid. You can still change these.',
  },
  { value: 'paid', label: 'Paid', money: true, note: 'Locked. This is what was paid.' },
  { value: 'void', label: 'Void', money: false, note: 'Cancelled. No money moved.' },
]

const live = stageRows.filter((r) => !r.superseded_at)
const stages = STAGES.map((s) => {
  const mine = live.filter((r) => r.status === s.value)
  return {
    ...s,
    count: mine.length,
    // Integer cents, added. `netOf` hands back the frozen figure on a locked
    // row and the live sum on an open one, which is the whole reason it is
    // shared with the table below rather than written again here.
    cents: mine.reduce((n, r) => n + (netOf(r).cents ?? 0), 0),
  }
})
/**
 * What is still to pay: draft and approved together, from the same rows the
 * strip is built from so the two can never disagree.
 *
 * Locked settlements are excluded, because money already paid is not money
 * still owed, and replaced rows are excluded with them.
 */
const owing = live
  .filter((r) => !isLocked(r.status))
  .reduce((n, r) => n + (netOf(r).cents ?? 0), 0)

const replaced = stageRows.filter((r) => r.superseded_at).length
// Anything with a stored total that does not match its own lines. It cannot
// happen through this app, so it is reported and never quietly averaged away.
const drifting = live.filter((r) => netOf(r).drift).length

/**
 * THE CHARTS BELONG TO THE RESTING VIEW, AND ONLY TO IT.
 *
 * Two reasons, and the second is the one that matters. A chart above a filtered
 * list pushes the rows somebody just filtered for further down the page, which
 * undoes the reason the filter exists. And the figures would be wrong: filtered
 * to Paid, a revision chain arrives with its drafts missing and nothing can say
 * a correction is in flight; filtered to one driver, "paid by driver" is one
 * bar. So `pay` is derived only when the list is everything — not computed and
 * then hidden, because a value that exists is a value a later edit will render.
 *
 * The stage strip above is the one exception, and it is a filter control rather
 * than a chart — see the note on the query it runs.
 */
const pay = resting
  ? paidSettlements(
      // Mapped rather than passed through: the derivation takes a settlement's
      // seven relevant columns and knows nothing about PostgREST, which is what
      // lets the double-count rule be tested against hand-built revisions
      // instead of against a fleet.
      rows.map((r) => ({
        id: r.id,
        driverId: r.driver_id,
        periodStart: r.period_start,
        periodEnd: r.period_end,
        status: r.status,
        revision: r.revision,
        supersededAt: r.superseded_at,
        netCents: r.net_cents,
        paidOn: r.paid_on,
      })),
    )
  : null

// Twelve months: a year of shape, and still under the ~14 columns beyond which
// they are stripes on a phone.
const monthWindow = monthsEnding(today, 12)
const monthly = pay ? payByMonth(pay.rows, monthWindow.from, monthWindow.to) : null
// The ceiling is taken once and passed in, so the axis label and the columns
// cannot be scaled to two different numbers.
const monthlyCeiling = monthly ? ceilingFor(monthly.values) : 0
/**
 * WHAT FULL HEIGHT IS WORTH, WRITTEN OUT IN FULL.
 *
 * An axis tick is the one figure THE MONEY RULE in src/lib/charts/scale.ts
 * lets stay compact, and only where the exact number is also on the picture in
 * words. It is not on this one below 640px: Columns hides a known column's
 * figure at that width, so on the phone this page is read on, '$12k' would be
 * the only money on the chart and there would be nothing to check it against.
 * So it is `formatCents`, and "Full height" names what the number measures — a
 * bare figure floating over a chart gets read as a total.
 *
 * Guarded on the ceiling, because `niceCeiling` returns 0 when there is nothing
 * to scale, and "Full height $0.00" is a claim that nobody was paid.
 */
const monthlyAxisLabel =
  monthlyCeiling > 0 ? `Full height ${formatCents(monthlyCeiling)}` : undefined
const monthlyEnd = monthly ? monthly.buckets[monthly.buckets.length - 1].end : null
const chartedRows =
  pay && monthlyEnd
    ? pay.rows.filter((p) => p.on >= monthWindow.from && p.on < monthlyEnd)
    : []
const chartedCents = chartedRows.reduce((n, p) => n + p.cents, 0)

const payYear = Number(today.slice(0, 4))
// Active drivers seed the ranking so the ones with NOTHING paid this year are on
// it, as absences rather than as zero bars. A driver nobody has settled with is
// invisible on a chart built from settlements alone, and invisible reads as
// fine — the same failure the dashboard runway exists to prevent.
const ytd = pay ? driverYearToDate(pay.rows, activeDrivers.map((d) => d.id), today) : []
const nameById = new Map(drivers.map((d) => [d.id, fullName(d)]))
const ytdItems = ytd.map((d) => ({
  label: nameById.get(d.driverId) ?? 'Unknown driver',
  value: d.cents,
  // Exact cents, never `compactMoney`. This is the figure a driver rings about,
  // and '$12.4k' is not a number anybody can check against a cheque.
  display: formatCents(d.cents),
  note:
    d.cents === null
      ? 'Nothing marked paid this year'
      : `${d.settlements} ${d.settlements === 1 ? 'settlement' : 'settlements'}`,
  href: `/app/settlements?driver=${d.driverId}`,
}))
const ytdCents = ytd.reduce((n, d) => n + (d.cents ?? 0), 0)
const ytdPaidDrivers = ytd.filter((d) => d.cents !== null).length

/**
 * THIS MONTH AGAINST LAST MONTH, PER DRIVER.
 *
 * The year-to-date bars say who earned what. They cannot say whether it is
 * going up or down, and that is the question a driver asks first — "am I making
 * less than last month" — and the one an owner needs an answer to before the
 * driver asks it. A year-to-date total is the one figure that can never show it:
 * it only ever grows.
 *
 * MONTHS, not settlement periods. A period is whatever week or fortnight each
 * driver is settled on, and periods do not line up between two drivers or even
 * between two of the same driver's statements, so "this period against last"
 * would compare a fortnight with a week and call the difference a pay cut. The
 * month is the one span every driver shares, it is the span the chart above
 * already uses, and it is the span a bank statement uses.
 *
 * Both lists share one ceiling (`max` on Bars), so a bar that is half as long
 * really is half the money. Scaled to their own maxima, a month where everyone
 * earned less would draw exactly like the month before it.
 *
 * NO GROUPING IS DONE HERE THAT IS NOT PLAIN ADDITION. The hard parts — one row
 * per revision chain, drafts excluded because their totals are still moving, a
 * settlement placed on the day the money moved — are all inside
 * `paidSettlements` in src/lib/charts/pay.ts, where they are tested. This adds
 * up integer cents per driver inside two date windows and nothing else.
 */
const monthPair =
  pay && monthly && monthly.buckets.length >= 2
    ? (() => {
        const thisMonth = monthly.buckets[monthly.buckets.length - 1]
        const lastMonth = monthly.buckets[monthly.buckets.length - 2]
        const sumIn = (bucket: { start: Date; end: Date }) => {
          const out = new Map<string, { cents: number; settlements: number }>()
          for (const p of pay.rows) {
            const t = p.on.getTime()
            if (t < bucket.start.getTime() || t >= bucket.end.getTime()) continue
            const entry = out.get(p.driverId) ?? { cents: 0, settlements: 0 }
            entry.cents += p.cents
            entry.settlements += 1
            out.set(p.driverId, entry)
          }
          return out
        }
        const nowMap = sumIn(thisMonth)
        const prevMap = sumIn(lastMonth)
        const ids = [...new Set([...nowMap.keys(), ...prevMap.keys()])]
        const rowsFor = ids
          .map((driverId) => ({
            driverId,
            name: nameById.get(driverId) ?? 'Unknown driver',
            now: nowMap.get(driverId) ?? null,
            prev: prevMap.get(driverId) ?? null,
          }))
          .sort(
            (a, b) =>
              (b.now?.cents ?? -1) - (a.now?.cents ?? -1) ||
              (b.prev?.cents ?? -1) - (a.prev?.cents ?? -1) ||
              a.name.localeCompare(b.name),
          )
        return {
          thisLabel: thisMonth.label,
          lastLabel: lastMonth.label,
          rows: rowsFor,
          // One ceiling over both months, taken from the whole set and not from
          // the eight rows that get drawn.
          ceiling: ceilingFor([
            ...rowsFor.map((r) => r.now?.cents ?? null),
            ...rowsFor.map((r) => r.prev?.cents ?? null),
          ]),
          // Drivers on the roster who were paid in neither month. Named in a
          // sentence rather than drawn as two empty rows each.
          quiet: activeDrivers.filter((d) => !ids.includes(d.id)).length,
        }
      })()
    : null

/** "$420.00 more than last month", in words, never an arrow on its own. */
function changeNote(
  now: { cents: number; settlements: number } | null,
  prev: { cents: number; settlements: number } | null,
): string {
  if (!now && !prev) return 'Nothing marked paid in either month'
  if (!now) return 'Nothing marked paid this month'
  if (!prev) return 'Nothing marked paid last month, so there is nothing to compare'
  const diff = now.cents - prev.cents
  if (diff === 0) return 'The same as last month'
  return `${formatCents(Math.abs(diff))} ${diff > 0 ? 'more' : 'less'} than last month`
}

const payCoverage = pay ? paidCoverage(pay) : undefined
// The trailing month is short by however much of it is left, every load, all
// month — and a chart that always ends on a runt column reads as pay falling
// off a cliff. That is now carried by the column itself (`inProgress`: faded,
// open top edge, announced as "so far"), where it is read at the same moment
// the shape is, rather than by a sentence underneath that is read second.
const monthCoverage = payCoverage
// Nothing paid, no pay chart. Two empty frames on a carrier's first week are
// furniture, and the tiles above already say how much is open.
const showPayCharts = (pay?.rows.length ?? 0) > 0
---

<App title="Driver pay" subtitle="What each driver is owed for a period, and the paper that shows why.">
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}

  <p class="mb-5 rounded-lg bg-champagne-50 px-4 py-3 text-sm text-brand-700">
    This is not payroll. FleetView works out what each driver is owed and prints the statement. It
    does not take out tax, work out FICA, or file anything. Give the net figure to whoever runs
    your payroll.
  </p>

  {/*
    THE STAGE STRIP. Draft → Approved → Paid, and Void when there is one.

    Each stage is a tap that filters the list below, and the one that is filtered
    wears the same tinted pill the header and the tabs use — one selected
    metaphor for the whole app, so "the Champagne pill means you are here" is a single rule.
    They are `<a>` and not buttons because they go somewhere; each card is far
    over the 44px a thumb needs, and the 12px gap keeps two of them from being
    one mis-tap.
  */}
  <nav aria-label="Filter pay statements by stage" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      stages
        .filter((s) => s.value !== 'void' || s.count > 0)
        .map((s) => (
          <a
            href={withParam('status', s.value)}
            aria-current={status === s.value ? 'page' : undefined}
            class:list={[
              'rounded-xl border p-4 transition-colors',
              // No `bg-white` on the selected card: a utility outranks the
              // .is-current component class in Tailwind v4's cascade layers, so
              // a white background left on it would quietly cancel the tint
              // that says which stage you are looking at.
              status === s.value
                ? 'is-current border-brand-600'
                : 'border-ink-100 bg-white hover:bg-ink-50',
            ]}
          >
            {/* ink-700, not ink-500: this is 12px type, and it sits on a
                tinted pill the moment the stage is the one being looked at.
                Both of those raise the floor. */}
            <span class="text-xs tracking-wide text-ink-700 uppercase">{s.label}</span>
            <span class="mt-1 block text-3xl font-semibold tabular-nums">{s.count}</span>
            <span class="mt-0.5 block text-sm font-normal text-ink-700">
              {s.count === 0
                ? 'Nothing at this stage'
                : s.money
                  ? /* Exact cents. Never compact money on a figure somebody
                       reconciles against a cheque. */
                    formatCents(s.cents)
                  : 'No money moved'}
            </span>
            <span class="mt-1 block text-xs font-normal text-ink-700">
              {s.count > 0 && s.money && s.cents === 0
                ? 'Nothing has been put on these yet.'
                : s.note}
            </span>
          </a>
        ))
    }
  </nav>

  {/*
    The two sentences the strip cannot carry, and both are about money that is
    deliberately in none of the figures above it.
  */}
  <div class="mt-3 space-y-1 text-sm text-ink-700">
    <p>
      Still to pay: <span class="font-semibold tabular-nums">{formatCents(owing)}</span> across{' '}
      <span class="tabular-nums">{stages[0].count + stages[1].count}</span> open{' '}
      {stages[0].count + stages[1].count === 1 ? 'settlement' : 'settlements'} — draft and approved
      together. That figure is added up from the lines every time this page loads, so it moves as
      you work.
    </p>
    {
      replaced > 0 && (
        <p>
          <span class="tabular-nums">{replaced}</span>{' '}
          {replaced === 1 ? 'settlement has' : 'settlements have'} been replaced by a later
          revision. {replaced === 1 ? 'It is' : 'They are'} in none of the figures above, so one
          period is never counted twice.
        </p>
      )
    }
    {
      drifting > 0 && (
        <p class="font-medium text-red-700">
          <span class="tabular-nums">{drifting}</span>{' '}
          {drifting === 1 ? 'settlement does' : 'settlements do'} not match{' '}
          {drifting === 1 ? 'its' : 'their'} own lines. That cannot happen through this app. Open{' '}
          {drifting === 1 ? 'it' : 'them'} below — {drifting === 1 ? 'it is' : 'they are'} marked.
        </p>
      )
    }
    {
      stageFailed && (
        <p class="rounded-lg bg-amber-50 px-4 py-3 text-amber-900">
          We could not add up the other stages just now, so the counts above cover only the
          settlements you are looking at. The list below is still correct.
        </p>
      )
    }
  </div>


  <form method="POST" class={`mt-6 ${card}`}>
    <h2 class="text-base font-semibold tracking-tight">Start a pay statement</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto_auto_auto] sm:items-end">
      <label class="block">
        <span class="field-label">Driver <span class="text-red-600">*</span></span>
        <select name="driver_id" required class={field}>
          <option value="">— choose —</option>
          {
            activeDrivers.map((d) => (
              <option value={d.id} selected={driverFilter === d.id}>
                {fullName(d)}
              </option>
            ))
          }
        </select>
      </label>
      <label class="block">
        <span class="field-label">From</span>
        <input
          type="date"
          name="period_start"
          value={defaultStart}
          required
          class={`${field} tabular-nums`}
        />
      </label>
      <label class="block">
        <span class="field-label">To</span>
        <input type="date" name="period_end" value={today} required class={`${field} tabular-nums`} />
      </label>
      <button type="submit" name="intent" value="create" class="btn btn-primary">
        Start
      </button>
    </div>
    {
      activeDrivers.length === 0 && (
        <p class="mt-3 text-sm text-ink-500">
          No active drivers yet.{' '}
          {/* Underlined at rest, and 44px tall. It sits in a sentence, so it
              stays a link rather than becoming a button — but it is the way off
              this screen, and a 20px line of text is not a thumb target. */}
          <a href="/app/drivers/new" class="link inline-flex min-h-11 items-center">
            Add one <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
  </form>

  <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
    {/* gap-2, not gap-1: two 44px targets closer than 8px apart are one
        mis-tap, and this row is worked with a thumb. */}
    <nav aria-label="Filter pay statements by status" class="flex flex-wrap gap-2">
      {
        tabs.map((t) => {
          const here = status === t.value || (t.value === 'all' && status === 'all')
          return (
            /* .filter-tab is 44px tall — the old tab was 34px — and .is-current
               is the one selected metaphor in this app: a tinted pill plus
               semibold, which survives colour blindness and a phone screen in
               the sun. aria-current is what a screen reader gets, and it is
               never the colour on its own. */
            <a
              href={withParam('status', t.value === 'all' ? '' : t.value)}
              aria-current={here ? 'page' : undefined}
              class:list={['filter-tab', here && 'is-current']}
            >
              {t.label}
            </a>
          )
        })
      }
    </nav>

    {/* A GET form, so the chosen driver lands in the URL and the view stays
        shareable. `onchange` would need script; the button does not. */}
    <form method="GET" class="flex items-end gap-2">
      {status !== 'all' && <input type="hidden" name="status" value={status} />}
      <label class="block">
        <span class="field-label">Driver</span>
        <select name="driver" class={field}>
          <option value="">Everyone</option>
          {
            drivers.map((d) => (
              <option value={d.id} selected={driverFilter === d.id}>
                {fullName(d)}
              </option>
            ))
          }
        </select>
      </label>
      <button type="submit" class="btn btn-secondary">Filter</button>
    </form>
  </div>

  {
    rows.length === 0 ? (
      <div class="mt-4 rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
        <p class="font-medium">Nothing here</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          {status === 'all' && !driverFilter
            ? 'Start a pay statement above. Its lines come from the driver’s pay agreements, plus anything you add by hand.'
            : 'No pay statement matches that filter. Clear it to see the rest.'}
        </p>
      </div>
    ) : (
      <div class="mt-4 overflow-x-auto rounded-xl border border-ink-100 bg-white">
        <table class="w-full text-sm sm:min-w-[46rem]">
          {/* No header line on a phone. Five column names above blocks that are
              not columns explain nothing; each block says what it is. */}
          {/* 12px type, so ink-700 and not ink-500: the floor rises at 12px and
              under, and a column name nobody can read is a table with no header
              at all. */}
          <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
            <tr>
              <th class="px-4 py-3 font-medium">Period</th>
              <th class="px-4 py-3 font-medium">Driver</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3 text-right font-medium">Lines</th>
              <th class="px-4 py-3 text-right font-medium">Net</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {rows.map((r) => {
              const net = netOf(r)
              return (
                <tr
                  class:list={[
                    'flex flex-col py-3 hover:bg-ink-50/60 sm:table-row sm:py-0',
                    r.superseded_at && 'opacity-60',
                  ]}
                >
                  {/* The period carries the row's only link, so on a phone it
                      sits third — under the driver and the net, but well inside
                      the block rather than off the right-hand edge — and the
                      link itself is a 44px tap there. */}
                  <td class={`${cell} order-3 sm:whitespace-nowrap`}>
                    {/* .link-row is the shared 44px row link. It keeps its
                        height at every width here — this is the only link in
                        the row, and a 20px line of tabular numbers is not a
                        thumb target on the page a settlement is opened from. */}
                    <a href={`/app/settlements/${r.id}`} class="link-row tabular-nums">
                      {formatDate(r.period_start)} – {formatDate(r.period_end)}
                    </a>
                    {r.revision > 1 && (
                      <span class="badge badge-neutral ml-2 tabular-nums">rev {r.revision}</span>
                    )}
                    {r.superseded_at && (
                      <span class="block text-xs text-ink-700">Replaced by a later revision</span>
                    )}
                  </td>
                  {/* THE DRIVER LEADS. This list is opened to answer "what does
                      this man get", and his name is the way in. */}
                  <td class={`${cell} order-1 font-medium sm:font-normal`}>{driverName(r)}</td>
                  <td class={`${cell} order-4`}>
                    {/* settlementStatusPillClass hands back the shared
                        `badge badge-*` pair, so there is no padding to repeat
                        here — one badge construction for the whole app. */}
                    <span class={settlementStatusPillClass(r.status)}>
                      {settlementStatusLabel(r.status)}
                    </span>
                    {r.paid_on && (
                      <span class="ml-2 text-xs text-ink-700 tabular-nums">
                        {formatDate(r.paid_on)}
                      </span>
                    )}
                  </td>
                  <td class={`${cell} order-5 text-ink-500 tabular-nums sm:text-right`}>
                    {(r.settlement_lines ?? []).length}
                    <span class="sm:hidden"> lines</span>
                  </td>
                  {/* THE NET IS SECOND. It is the figure that goes on the
                      cheque, and it was the column furthest off the screen. */}
                  <td class={`${cell} order-2 sm:text-right sm:whitespace-nowrap`}>
                    <span class="text-ink-500 sm:hidden">Net </span>
                    <span class="font-medium tabular-nums">{formatCents(net.cents)}</span>
                    <span class="text-xs text-ink-700 sm:block">
                      {' '}
                      {net.frozen ? 'as paid' : 'from the lines'}
                    </span>
                    {net.drift && (
                      <span class="badge badge-danger mt-1">
                        <span aria-hidden="true">⚠</span> does not match its lines
                      </span>
                    )}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    )
  }
  {/*
    BELOW the table and the start-a-settlement form, not above them.

    Measured on a phone with these above: the first settlement row sat at
    1,932px — two and a half screens down — and the charts were 632px of it.
    The dashboard leads with its chart because it is a summary; this is a work
    surface, and on a work surface the rows come first.

    Two questions the table cannot answer, because both are sums across rows
    sorted by period: what we have actually paid out lately, and what each
    driver has had this year. Neither figure exists anywhere else in the product.

    Both are drawn from PAID settlements only, one row per revision chain. A
    draft's total is still moving — it is re-derived from its lines on every load
    — and a column that adds a moving total to a frozen one is a number nobody
    can reconcile against a cheque afterwards. The open ones are named in the
    coverage line instead.
  */}
  {
    showPayCharts && monthly && (
      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <Figure
          title="Paid out, by month"
          subtitle="Pay statements marked paid, in the month the money moved"
          coverage={monthCoverage}
        >
          <Columns
            columns={monthly.buckets.map((b, i) => {
              const v = monthly.values[i]
              return {
                label: b.label,
                value: v,
                // THE FULL FIGURE, COMMAS AND CENTS. Columns prints `display`
                // above the column AND reads it out as the column's aria-label,
                // so this is a value label and not an axis tick — '$12.4k' is a
                // hundred-dollar band printed as if it were a number, and this
                // is a month's driver pay. `formatCents` renders an absent
                // month as '—' by itself, never as $0.00.
                display: formatCents(v),
                // The trailing month is the one we are standing in, so it is
                // short by however much of it is left — every load, all month.
                inProgress: i === monthly.buckets.length - 1,
              }
            })}
            max={monthlyCeiling}
            axisLabel={monthlyAxisLabel}
            emptyMessage="Nothing marked paid in the last twelve months."
          />
          <p class="mt-3 text-xs text-ink-700">
            {chartedRows.length > 0
              ? `${formatCents(chartedCents)} across ${chartedRows.length} ${chartedRows.length === 1 ? 'settlement' : 'settlements'} in the last twelve months.`
              : 'Nothing has been marked paid in the last twelve months.'}
          </p>
        </Figure>

        <Figure
          title={`Paid to each driver in ${payYear}`}
          subtitle="This year so far. Each period is counted once, however many revisions it took"
          coverage={payCoverage}
        >
          <Bars items={ytdItems} limit={10} emptyMessage="Nobody has been marked paid yet." />
          <p class="mt-3 text-xs text-ink-700">
            {ytdPaidDrivers > 0
              ? `${formatCents(ytdCents)} paid to ${ytdPaidDrivers} ${ytdPaidDrivers === 1 ? 'driver' : 'drivers'} so far this year. Every settlement behind these totals is in the list below.`
              : `Nothing has been marked paid in ${payYear} yet.`}
          </p>
        </Figure>
      </div>
    )
  }

  {/*
    THE THIRD FIGURE, AND THE ONLY ONE THAT SHOWS A DIRECTION.

    Three charts is the limit on one screen and this one earns the third slot:
    the chart above it can only grow, because a year-to-date total is a running
    sum, so neither of the two says whether a driver is making less than he made
    last month. That is the first thing a driver asks and the last thing an
    owner finds out.

    Two lists, one ceiling, the same driver order in both, so a bar half as long
    really is half the money. Drawn only when both months have somebody in them:
    a paired chart with one side empty is a comparison with nothing to compare.
  */}
  {
    monthPair && monthPair.rows.length > 0 && (
      <div class="mt-4">
        <Figure
          title="Paid to each driver, this month and last"
          subtitle={`${monthPair.thisLabel} against ${monthPair.lastLabel}. Both sides are drawn to the same scale`}
          coverage={[
            'This month is not over yet, so its bars are short by however much of it is left.',
            payCoverage,
          ]
            .filter(Boolean)
            .join(' ')}
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              {/* 12px, so ink-700. */}
              <h4 class="text-xs tracking-wide text-ink-700 uppercase">
                {monthPair.thisLabel} — so far
              </h4>
              <div class="mt-3">
                <Bars
                  items={monthPair.rows.map((r) => ({
                    label: r.name,
                    // `null`, never 0. Nothing marked paid is a fact about our
                    // records; "he earned nothing" is a claim about his month,
                    // and only the first one is ours to make.
                    value: r.now ? r.now.cents : null,
                    display: r.now ? formatCents(r.now.cents) : 'nothing marked paid',
                    note: changeNote(r.now, r.prev),
                    href: `/app/settlements?driver=${r.driverId}`,
                  }))}
                  max={monthPair.ceiling}
                  limit={8}
                />
              </div>
            </div>
            <div>
              <h4 class="text-xs tracking-wide text-ink-700 uppercase">
                {monthPair.lastLabel} — the whole month
              </h4>
              <div class="mt-3">
                <Bars
                  items={monthPair.rows.map((r) => ({
                    label: r.name,
                    value: r.prev ? r.prev.cents : null,
                    display: r.prev ? formatCents(r.prev.cents) : 'nothing marked paid',
                    note: r.prev
                      ? `${r.prev.settlements} ${r.prev.settlements === 1 ? 'settlement' : 'settlements'}`
                      : 'No settlement was marked paid last month',
                    href: `/app/settlements?driver=${r.driverId}`,
                  }))}
                  max={monthPair.ceiling}
                  limit={8}
                />
              </div>
            </div>
          </div>
          {monthPair.quiet > 0 && (
            <p class="mt-4 border-t border-ink-100 pt-3 text-sm text-ink-700">
              <span class="tabular-nums">{monthPair.quiet}</span> active{' '}
              {monthPair.quiet === 1 ? 'driver had' : 'drivers had'} nothing marked paid in either
              month, so {monthPair.quiet === 1 ? 'he is' : 'they are'} on neither list. That is
              about the statements, not about the work.
            </p>
          )}
        </Figure>
      </div>
    )
  }

</App>
