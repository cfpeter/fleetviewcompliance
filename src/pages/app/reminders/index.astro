---
/**
 * My reminders: the owner's own list, beside the ones the law keeps for him.
 *
 * Five intents, one page, and every one of them ends in a 303. A replayed POST
 * here would add the same reminder twice, or mark a repeating one done twice —
 * which is not a duplicate row but a date silently pushed a whole year further
 * out, with nothing on screen to show it happened.
 *
 * No client JavaScript, like every other screen in this app. The person using it
 * is standing in a yard on one bar of signal.
 *
 * THE COPY RULE ON THIS SCREEN. Every label, button and message is short and
 * plain, because the owners this is built for run four trucks in Los Angeles and
 * many do not read English as a first language. No jokes, no metaphors, no long
 * sentences. "Write what you need to do." is an instruction; "Please provide a
 * valid value" teaches nothing.
 */
import ErrorSummary from '../../../components/ui/ErrorSummary.astro'
import Flash from '../../../components/ui/Flash.astro'
import App from '../../../layouts/App.astro'
import { formatDate, todayInCalifornia } from '../../../lib/drivers.ts'
import { suggestionByKey, suggestionsFor } from '../../../lib/reminder-suggestions.ts'
import {
  DEFAULT_REMINDER_LEAD_DAYS,
  MAX_NOTE,
  MAX_TITLE,
  REMINDER_ORIGIN,
  REPEAT_OPTIONS,
  isRepeatMonths,
  loadReminders,
  nextCycle,
  parseDateOnly,
  parseDueOn,
  parseNote,
  parseReminderLeadDays,
  parseTitle,
  repeatLabel,
  toDateOnly,
  toReminderItem,
  type ReminderItem,
  type ReminderRow,
} from '../../../lib/reminders.ts'
import { dueLine, standingPill } from '../../../lib/rules/index.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!
const userId = Astro.locals.userId ?? null

const today = new Date()
const todayField = todayInCalifornia()

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

const go = (query = '') => Astro.redirect(`/app/reminders${query}`, 303)

/**
 * Failures travel as CODES, never as text — the rule settings.astro spells out.
 * A page that renders `?error=` verbatim lets anyone hand this owner a link to
 * his own reminders reading "Your account is locked, call 555-0100", in our
 * styling, on our domain, behind our padlock.
 */
const fail = (code: string, editId = '') =>
  // `#form-errors` is how the focus reaches the summary box with no script on
  // the page: the box is `tabindex="-1"`, so a 303 to its id both scrolls to it
  // and focuses it, and the next Tab is the first field. A fragment is never
  // sent to the server, so nothing about where this goes changes.
  //
  // `show=done` rides along for the same reason it rides on a good save: a
  // refusal that also folds up the Finished list has taken something away from
  // him on top of not doing what he asked.
  go(
    `?error=${code}${editId ? `&edit=${editId}` : ''}` +
      `${Astro.url.searchParams.get('show') === 'done' ? '&show=done' : ''}#form-errors`,
  )

/** The drivers and trucks a reminder may be attached to. */
const [{ data: driverRows }, { data: vehicleRows }] = await Promise.all([
  supabase
    .from('drivers')
    .select('id, first_name, last_name')
    .eq('status', 'active')
    .order('last_name'),
  supabase.from('vehicles').select('id, unit_number, vin').neq('status', 'sold').order('unit_number'),
])

const drivers = (driverRows ?? []) as { id: string; first_name: string; last_name: string }[]
const vehicles = (vehicleRows ?? []) as { id: string; unit_number: string | null; vin: string | null }[]

/**
 * One `<select>` for "what is this about", because two would let somebody pick a
 * driver AND a truck — a row the check constraint refuses and no screen could
 * label. The value carries its own kind: 'driver:<id>', 'vehicle:<id>', or ''.
 */
function parseSubject(
  raw: unknown,
): { driver_id: string | null; vehicle_id: string | null; subject_scope: string | null } | null {
  const text = typeof raw === 'string' ? raw.trim() : ''
  if (text === '') return { driver_id: null, vehicle_id: null, subject_scope: null }

  // THE TWO FLEET-WIDE SCOPES (0032). Matched before the `kind:id` split
  // because they carry no id at all — one reminder that belongs to every driver
  // or every truck, rather than a row per record that drifts the first time he
  // edits one. The database refuses a scope alongside an id, and so does this.
  if (text === 'all_drivers' || text === 'all_vehicles') {
    return { driver_id: null, vehicle_id: null, subject_scope: text }
  }

  const [kind, id] = text.split(':')
  if (!UUID.test(id ?? '')) return null

  // Checked against the lists this page just rendered rather than left to the
  // trigger in 0023. Both refuse a driver from another carrier; only this one
  // refuses it with a sentence about a driver instead of a database exception.
  if (kind === 'driver' && drivers.some((d) => d.id === id)) {
    return { driver_id: id, vehicle_id: null, subject_scope: null }
  }
  if (kind === 'vehicle' && vehicles.some((v) => v.id === id)) {
    return { driver_id: null, vehicle_id: id, subject_scope: null }
  }
  return null
}

/** Everything the add form and the edit form both write, parsed once so the two
 *  cannot drift — the same doctrine the stops page applies to its two forms. */
function readFields(form: FormData):
  | { ok: true; value: Record<string, unknown> }
  | { ok: false; code: string } {
  const title = parseTitle(form.get('title'))
  if (!title.ok) return { ok: false, code: 'title' }

  const dueOn = parseDueOn(form.get('due_on'))
  if (!dueOn.ok) return { ok: false, code: 'date' }

  const note = parseNote(form.get('note'))
  if (!note.ok) return { ok: false, code: 'note' }

  const leadDays = parseReminderLeadDays(form.get('lead_days'))
  if (!leadDays.ok) return { ok: false, code: 'days' }

  const repeatMonths = Number(form.get('repeat_months') ?? 0)
  // A `<select>` posts what the browser sends; a crafted POST posts anything,
  // and an unlisted interval would be a repeat nobody chose and no label names.
  if (!Number.isInteger(repeatMonths) || !isRepeatMonths(repeatMonths)) {
    return { ok: false, code: 'repeat' }
  }

  const subject = parseSubject(form.get('subject'))
  if (!subject) return { ok: false, code: 'subject' }

  return {
    ok: true,
    value: {
      title: title.value,
      due_on: dueOn.value,
      note: note.value,
      lead_days: leadDays.value,
      repeat_months: repeatMonths,
      ...subject,
    },
  }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')
  const id = String(form.get('id') ?? '')

  /**
   * WHICH LIST THE BUTTON WAS PRESSED IN, and it settles two things at once.
   *
   * The owner's words: "when I click show finished reminders or done or change
   * or delete, it refreshes the page and it goes all the way up. It's closed
   * up." Two separate faults in one sentence:
   *
   *   1. IT GOES ALL THE WAY UP. Every action is a POST and a 303, and a fresh
   *      document starts at the top — so pressing Done on the ninth row put him
   *      at the add form with no idea whether anything had happened. The
   *      fragment is what HTML gives us instead, and it costs no script.
   *   2. IT'S CLOSED UP. `?show=done` is the whole of what keeps the Finished
   *      list open, and every redirect dropped it — so deleting one finished
   *      reminder shut the list he was working through. Twice over, because
   *      Delete exists in BOTH lists and the handler could not tell them apart.
   *
   * `delete_reminder` is the reason this is a posted value rather than
   * something read off the row: it is the same intent from two places, and
   * where he goes back to is the one thing only the button knows.
   *
   * Checked against the two names we write, never pasted through — it ends up
   * in a Location header.
   */
  const pressedIn = String(form.get('from') ?? '')
  const where = pressedIn === 'open' || pressedIn === 'finished' ? pressedIn : ''
  /**
   * IS THE FINISHED LIST OPEN RIGHT NOW? Read off the address the form posted
   * to, because none of these forms carries an `action` — so each one submits
   * to the page it is standing on, `?show=done` and all.
   *
   * This is deliberately NOT derived from `where`. Tying the two together was
   * the first thing I wrote and it was wrong: pressing Done in the OPEN list
   * shut the Finished list underneath it, which is the same "it's closed up"
   * with a different button. The fold is a property of the screen, not of the
   * list the button happened to be in.
   */
  const stillShowingDone = Astro.url.searchParams.get('show') === 'done'

  /** `a=1` in, `?a=1&show=done#open` out. One place, every exit. */
  const land = (query: string) =>
    go(`?${query}${stillShowingDone ? '&show=done' : ''}${where ? `#${where}` : ''}`)

  if (intent === 'add_reminder') {
    const fields = readFields(form)
    if (!fields.ok) return fail(fields.code)

    const { error } = await supabase.from('reminders').insert({
      // carrier_id is SET on insert, never filtered on. RLS checks the value but
      // does not fill it in, so a row without it fails the WITH CHECK half of
      // the policy and reads as a permissions error about the owner's own list.
      carrier_id: carrierId,
      created_by: userId,
      ...fields.value,
    })
    if (error) return fail('save')
    return land('added=1')
  }

  if (intent === 'save_reminder') {
    if (!UUID.test(id)) return fail('gone')
    const fields = readFields(form)
    if (!fields.ok) return fail(fields.code, id)

    // `.is('completed_at', null)` is not a filter for tidiness. A repeating
    // reminder may not be closed (0023), so editing a closed one into a
    // repeating one would fail at the constraint with a message naming it.
    // Closed reminders are opened first, which is a button on this page.
    const { data, error } = await supabase
      .from('reminders')
      .update(fields.value)
      .eq('id', id)
      .is('completed_at', null)
      .select('id')

    if (error) return fail('save', id)
    // An UPDATE matching nothing is not an error in Postgres, so without this
    // the page reports a cheerful "Saved" for a reminder deleted in another tab.
    if (!data || data.length === 0) return fail('gone')
    return land('saved=1')
  }

  if (intent === 'done_reminder') {
    if (!UUID.test(id)) return fail('gone')

    // Read first, because what Done MEANS depends on the row: a one-time
    // reminder closes, a repeating one moves to its next cycle. Deciding that
    // from a hidden form field would let a stale tab close a reminder the owner
    // has since set to repeat.
    const { data: row, error: readError } = await supabase
      .from('reminders')
      .select('id, due_on, repeat_months, completed_at')
      .eq('id', id)
      .is('completed_at', null)
      .maybeSingle()

    if (readError) return fail('save')
    if (!row) return fail('gone')

    const dueOn = parseDateOnly(row.due_on as string)
    if (!dueOn) return fail('save')

    const repeatMonths = Number(row.repeat_months ?? 0)
    const doneOn = toDateOnly(new Date())

    if (repeatMonths > 0) {
      // Forward to the next cycle, counted from the date it was DUE and not from
      // today: an annual policy paid three weeks late still renews on its own
      // date next year. See `nextCycle`.
      const next = nextCycle(dueOn, repeatMonths, today)
      const { error } = await supabase
        .from('reminders')
        .update({ due_on: toDateOnly(next), last_done_on: doneOn })
        .eq('id', id)
        .is('completed_at', null)
      if (error) return fail('save')
      return land(`next=${toDateOnly(next)}`)
    }

    const { error } = await supabase
      .from('reminders')
      .update({ completed_at: new Date().toISOString(), completed_by: userId, last_done_on: doneOn })
      .eq('id', id)
      .is('completed_at', null)
    if (error) return fail('save')
    return land('done=1')
  }

  if (intent === 'reopen_reminder') {
    if (!UUID.test(id)) return fail('gone')
    const { error } = await supabase
      .from('reminders')
      .update({ completed_at: null, completed_by: null })
      .eq('id', id)
      .not('completed_at', 'is', null)
    if (error) return fail('save')
    return land('reopened=1')
  }

  if (intent === 'delete_reminder') {
    if (!UUID.test(id)) return fail('gone')
    // A real DELETE, unlike a compliance record, which is superseded and kept.
    // This is the owner's own list, not evidence anybody is entitled to inspect;
    // a line he typed by mistake goes away when he says so.
    const { error } = await supabase.from('reminders').delete().eq('id', id)
    if (error) return fail('save')
    return land('deleted=1')
  }

  // An unknown intent is a form from an older deploy. Redirect rather than fall
  // through to rendering: a 200 answer to a POST is replayed by the next refresh.
  return go('')
}

// ---------------------------------------------------------------- reading

const params = Astro.url.searchParams
const showDone = params.get('show') === 'done'
const editId = params.get('edit') ?? ''

const open = await loadReminders(supabase, null, today)

/** The closed ones, read only when he asks for them. */
const done: ReminderItem[] = []
if (showDone) {
  const { data } = await supabase
    .from('reminders')
    .select(
      'id, title, note, due_on, repeat_months, lead_days, driver_id, vehicle_id, completed_at, last_done_on, drivers(first_name, last_name), vehicles(unit_number, vin)',
    )
    .not('completed_at', 'is', null)
    .order('completed_at', { ascending: false })
    // Bounded. A carrier who has been here three years has a long tail of
    // finished errands, and none of it is what he opened this page for.
    .limit(50)
  for (const row of (data ?? []) as unknown as ReminderRow[]) {
    const item = toReminderItem(row, today)
    if (item) done.push(item)
  }
}

/**
 * Plain sentences, one per failure. Short enough to read on a phone, and each
 * one says what to do rather than what went wrong.
 */
const ERRORS: Record<string, string> = {
  title: 'Write what you need to do — a few words, like "Pay truck insurance".',
  date: `Pick the day it must be done. Type it like ${todayField}, or use the calendar.`,
  days: 'Type how many days before, as a whole number from 0 to 365. 7 means one week before.',
  note: `The note is too long. Cut it to ${MAX_NOTE} letters or fewer.`,
  repeat: 'Pick how often it repeats from the list. Pick "Does not repeat" if it is a one-time job.',
  subject: 'Pick a driver or a truck from the list, or pick "Whole company".',
  gone: 'That reminder is gone. Somebody deleted it, or it was already finished.',
  save: 'We could not save it. Wait a moment and press the button again.',
}
const errorCode = params.get('error') ?? ''
const errorMessage = errorCode ? (ERRORS[errorCode] ?? ERRORS.save) : null

/**
 * Which box the refusal is about, so the summary line jumps to it and the box
 * itself carries `aria-invalid`. `gone` and `save` are about the whole form and
 * belong to no field — ErrorSummary prints those without a link.
 */
const FIELD_OF: Record<string, string> = {
  title: 'title',
  date: 'due_on',
  days: 'lead_days',
  note: 'note',
  repeat: 'repeat_months',
  subject: 'subject',
}
const badField = errorMessage ? (FIELD_OF[errorCode] ?? null) : null
/** The four attributes a rejected field needs, in one place so none goes missing. */
const invalid = (name: string) =>
  badField === name
    ? { 'aria-invalid': 'true' as const, 'aria-describedby': `${name}-error` }
    : {}

const nextDate = params.get('next')
const nextDateShown = nextDate && /^\d{4}-\d{2}-\d{2}$/.test(nextDate) ? formatDate(nextDate) : null

const good = params.has('added')
  ? 'Reminder added.'
  : params.has('saved')
    ? 'Saved.'
    : nextDateShown
      ? `Done. Next one: ${nextDateShown}.`
      : params.has('done')
        ? 'Done. It is off your list.'
        : params.has('reopened')
          ? 'Open again.'
          : params.has('deleted')
            ? 'Deleted.'
            : null

/** The row being edited, if the URL names one that is still open. */
const editing = open.find((r) => r.id === editId) ?? null

// The shared field and button classes from global.css. The local ones this
// replaces were 32px tall at `sm` and up — the row actions on this page are
// pressed with a thumb in a yard, and 32px is a miss.
const field = 'field-input'
const label = 'field-label'
const hint = 'field-hint block'

/**
 * ON A PHONE THE ROWS ARE NOT ROWS.
 *
 * The list is 46rem wide and the window on a 375px phone is about 341px, so
 * over half of every row was behind a sideways scroll — Done, Change and Delete
 * among it, which meant the three things this page is for were invisible on the
 * device it is read on. Below `sm` every cell becomes a block and the buttons
 * are full-width taps; from `sm` the same markup is a table again. ONE set of
 * cells, not two. The pattern is written down in src/components/Documents.astro.
 */
const cell = 'block px-4 sm:table-cell sm:py-3'

/** The value the subject `<select>` posts for a row we already hold. */
const subjectValue = (item: { subject: { kind: string; id: string | null } }) => {
  // A scope is its own value with no id after it — the same string
  // `parseSubject` accepts, so editing a fleet-wide reminder reopens on the
  // option it was saved with rather than falling back to "Whole company".
  if (item.subject.kind === 'all_drivers' || item.subject.kind === 'all_vehicles') {
    return item.subject.kind
  }
  return item.subject.id ? `${item.subject.kind}:${item.subject.id}` : ''
}

/**
 * The record a truck or driver page sent him here to add a reminder for.
 *
 * `?for=vehicle:<id>` is written by src/components/Reminders.astro, and the
 * value is the same `kind:id` string this page's own `<select>` already uses —
 * so the two cannot drift, and there is no second way of naming a subject.
 *
 * MATCHED AGAINST THE OPTIONS, NEVER ECHOED. It is only ever compared to ids
 * this carrier can already see in the two lists below; an id belonging to
 * somebody else, a typo, or a hand-edited value matches nothing and the select
 * falls back to "Whole company". Nothing out of the query string reaches the
 * page, and nothing reaches the save either — the POST re-reads the select.
 *
 * Ignored entirely while EDITING: an existing reminder's own subject wins over
 * a link somebody followed to get here.
 */
const prefillSubject = params.get('for') ?? ''

/**
 * A suggestion he tapped instead of thinking of one himself.
 *
 * Resolved against the catalogue, so `?suggest=` can only ever name a row we
 * wrote — anything else is null and the form opens empty, which is exactly
 * where it started. Nothing out of the query string is rendered.
 *
 * It fills the TITLE and the REPEAT and stops there. The due date stays on
 * today, because a suggestion knows what the job is and cannot know when he
 * last did it — and a date we invented, sitting in a box he is about to save,
 * is the product telling him something it does not know.
 */
const suggested = editing ? null : suggestionByKey(params.get('suggest'))

/**
 * WHICH OPTION THE SUBJECT DROPDOWN OPENS ON. Decided once, here, because three
 * things want a say and only one of them can win:
 *
 *   1. EDITING beats everything. A reminder's own subject is a fact; a link
 *      somebody followed to get here is not.
 *   2. `?for=` — he pressed "Add a reminder for this truck" on that truck's
 *      page, so he means that truck.
 *   3. A SUGGESTION's own shape. In the owner's words: "when they select
 *      something that applies to the driver, we select the dropdown to driver."
 *      A suggestion that fits drivers and nothing else can only mean the
 *      drivers — so "TWIC card expires" opens on All drivers rather than on
 *      the whole company, which would have filed it where no driver can see it.
 *      A suggestion that fits more than one kind picks none: "Safety meeting"
 *      is as much the company's as the drivers'.
 *
 * Anything that matches no option leaves the select on its first entry, which
 * is "Whole company" — the same safe end it has always failed to.
 */
const suggestedScope =
  suggested && suggested.fits.length === 1
    ? suggested.fits[0] === 'driver'
      ? 'all_drivers'
      : suggested.fits[0] === 'vehicle'
        ? 'all_vehicles'
        : ''
    : ''
const selectedSubject = editing
  ? subjectValue(editing)
  : prefillSubject !== ''
    ? prefillSubject
    : suggestedScope
---

{/*
  `live` — THE FIRST PAGE TO SUBMIT WITHOUT RELOADING, and it is this one
  because the owner named it: "when I click show finished reminders or done or
  change or delete, it refresh the page and it goes all the way up."

  Nothing on the server side of this page changed. Every intent still posts to
  this address and still answers with a 303, so with the script blocked or
  broken the page behaves exactly as it did before.
*/}
<App live title="My reminders" subtitle="Your own reminders. We email you before the date.">
  {/* A confirmation, which the script lifts into the corner of the screen —
      it used to be read because a save put the reader back at the top of the
      page, and he stays where he was now. See src/components/ui/Flash.astro. */}
  {good && <Flash>{good}</Flash>}

  {/*
    Said once, at the top, in the plainest words available. These rows sit next
    to federal deadlines on the dashboard, and the owner has to know which is
    which before he decides what to do this morning.
  */}
  <p class="mb-5 max-w-2xl rounded-xl border border-brand-500/25 bg-champagne-50 px-4 py-3 text-sm">
    These are your own reminders. They are <strong class="font-medium">not laws</strong>. The
    deadlines on the <a href="/app" class="link font-medium">Deadlines</a>{' '}
    page come from the rules. These come from you.
  </p>

  {/* ------------------------------------------------------------ add / edit */}

  {/* `id` is how Change reaches this form without a script: the link carries
      `#reminder-form`, so the browser scrolls here and `scroll-padding-top`
      keeps the sticky header off the heading. */}
  <form method="POST" id="reminder-form" class="rounded-xl border border-ink-100 bg-white p-5">
    <h2 class="text-lg font-semibold tracking-tight">
      {editing ? 'Change this reminder' : 'Add a reminder'}
    </h2>
    {editing && <input type="hidden" name="id" value={editing.id} />}
    {/* A saved reminder shows up in the list below, so that is where the 303
        puts him — not back at the top of the form he has finished with. */}
    <input type="hidden" name="from" value="open" />

    {/* The designed error state. `fail()` redirects to this box's id, so the
        browser scrolls to it and focuses it with no script running, and each
        line is a link to the box it is about. */}
    {
      errorMessage && (
        <ErrorSummary
          class="mt-4"
          errors={[{ message: errorMessage, field: badField ?? undefined }]}
        />
      )
    }

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class={label} for="title">What do you need to do?</label>
        <input
          type="text"
          id="title"
          name="title"
          required
          maxlength={MAX_TITLE}
          value={editing?.title ?? suggested?.title ?? ''}
          placeholder="Pay truck insurance"
          class={`${field} mt-1`}
          {...invalid('title')}
        />
        {badField === 'title' && (
          <p class="field-error" id="title-error">
            <span aria-hidden="true">⚠</span>
            <span>{errorMessage}</span>
          </p>
        )}
      </div>

      <div>
        <label class={label} for="due_on">Date</label>
        <input
          type="date"
          id="due_on"
          name="due_on"
          required
          min="2000-01-01"
          max="2100-12-31"
          value={editing ? toDateOnly(editing.dueOn) : todayField}
          class={`${field} mt-1 tabular-nums`}
          {...invalid('due_on')}
        />
        {badField === 'due_on' && (
          <p class="field-error" id="due_on-error">
            <span aria-hidden="true">⚠</span>
            <span>{errorMessage}</span>
          </p>
        )}
        <span class={hint}>The day it must be done.</span>
      </div>

      <div>
        <label class={label} for="repeat_months">How often?</label>
        <select id="repeat_months" name="repeat_months" class={`${field} mt-1`} {...invalid('repeat_months')}>
            {
              REPEAT_OPTIONS.map((o) => (
                <option
                  value={o.value}
                  selected={(editing?.repeatMonths ?? suggested?.repeatMonths ?? 0) === o.value}
                >
                  {o.label}
                </option>
              ))
            }
        </select>
        {badField === 'repeat_months' && (
          <p class="field-error" id="repeat_months-error">
            <span aria-hidden="true">⚠</span>
            <span>{errorMessage}</span>
          </p>
        )}
        <span class={hint}>A repeating reminder moves to the next date when you press Done.</span>
      </div>

      <div>
        <label class={label} for="lead_days">Tell me this many days before</label>
        <input
          type="number"
          id="lead_days"
          name="lead_days"
          min="0"
          max="365"
          inputmode="numeric"
          value={editing?.leadDays ?? DEFAULT_REMINDER_LEAD_DAYS}
          class={`${field} mt-1 tabular-nums`}
          {...invalid('lead_days')}
        />
        {badField === 'lead_days' && (
          <p class="field-error" id="lead_days-error">
            <span aria-hidden="true">⚠</span>
            <span>{errorMessage}</span>
          </p>
        )}
        {/* Said out loud, because two of the three emails are not his setting.
            A reminder that warns a month early and then goes quiet on the day
            is worse than no reminder. */}
        <span class={hint}>We also email you on the day, and one day after.</span>
      </div>

      <div>
        <label class={label} for="subject">Who or what is it for?</label>
        <select id="subject" name="subject" class={`${field} mt-1`} {...invalid('subject')}>
            {/* Still the default, and still the fallback for a `?for=` that
                matches nothing — but it must not stay selected when a truck
                page has just named the truck. Two selected options in one
                select is the LAST one winning, silently. */}
            <option value="" selected={selectedSubject === ''}>Whole company</option>
            {/* THE FLEET-WIDE PAIR, right under the company and above the
                individual records — because that is the order of the question
                he is answering: everyone, every one of a kind, or this one.
                Drawn only when there is something for them to mean: "All
                drivers" on a carrier with no drivers is an option that saves a
                reminder nobody will ever see. */}
            {drivers.length > 0 && (
              <option value="all_drivers" selected={selectedSubject === 'all_drivers'}>
                All drivers
              </option>
            )}
            {vehicles.length > 0 && (
              <option value="all_vehicles" selected={selectedSubject === 'all_vehicles'}>
                All trucks
              </option>
            )}
            {
              drivers.length > 0 && (
                <optgroup label="Drivers">
                  {drivers.map((d) => (
                    <option
                      value={`driver:${d.id}`}
                      selected={selectedSubject === `driver:${d.id}`}
                    >
                      {`${d.first_name} ${d.last_name}`.trim()}
                    </option>
                  ))}
                </optgroup>
              )
            }
            {
              vehicles.length > 0 && (
                <optgroup label="Trucks">
                  {vehicles.map((v) => (
                    <option
                      value={`vehicle:${v.id}`}
                      selected={selectedSubject === `vehicle:${v.id}`}
                    >
                      {v.unit_number || v.vin || 'Truck'}
                    </option>
                  ))}
                </optgroup>
              )
            }
        </select>
        {badField === 'subject' && (
          <p class="field-error" id="subject-error">
            <span aria-hidden="true">⚠</span>
            <span>{errorMessage}</span>
          </p>
        )}
      </div>

      <div class="sm:col-span-2">
        <label class={label} for="note">Note (you can leave this empty)</label>
        <textarea id="note" name="note" rows="2" maxlength={MAX_NOTE} class={`${field} mt-1`} {...invalid('note')}>{editing?.note ?? ''}</textarea>
        {badField === 'note' && (
          <p class="field-error" id="note-error">
            <span aria-hidden="true">⚠</span>
            <span>{errorMessage}</span>
          </p>
        )}
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button
        type="submit"
        name="intent"
        value={editing ? 'save_reminder' : 'add_reminder'}
        class="btn btn-primary"
      >
        {editing ? 'Save' : 'Add reminder'}
      </button>
      {/* Cancel is tertiary, never red. It throws nothing away. */}
      {editing && <a href="/app/reminders" class="btn btn-tertiary">Cancel</a>}
    </div>
  </form>

  {/* -------------------------------------------------------- the suggestions

      THE BLANK PAGE PROBLEM. In the owner's words: "how can we have options
      for my reminders — things he should do but are not tracked by federal
      rules, like tyre check." He knows he wants reminders and cannot think of
      them standing at the screen, so he sets one and never comes back.

      Every one of these is something the catalogue does NOT track. A suggestion
      for the annual DOT inspection would put a second row on his dashboard for
      a deadline we already watch — one with a citation, one without — and the
      day the two disagree he stops believing both.

      They fill the TITLE and the REPEAT and nothing else. The due date stays on
      today, because a suggestion knows what the job is and cannot know when he
      last did it.

      Links, not buttons: each one is an address, so the back button undoes a
      tap and no script is needed to fill a form.
  */}
  {
    !editing && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold tracking-tight">Not sure what to put?</h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-700">
          These are the ones owners usually set. None of them is a rule, and nothing here is
          already on your deadlines list. Tap one to fill the form, then change anything you
          like.
        </p>
        {/* GROUPED, because there are two dozen of them. A flat row of 25 chips
            is a wall, and the owner reading it is looking for one of three
            things: something about the company, something about a truck, or
            something about a driver. So that is the split. */}
        {(
          [
            ['carrier', 'Your company'],
            ['vehicle', 'Your trucks'],
            ['driver', 'Your drivers'],
          ] as const
        ).map(([fit, heading]) => (
          <div class="mt-4">
            <h3 class="text-xs font-semibold tracking-wide text-ink-500 uppercase">{heading}</h3>
            <div class="mt-2 flex flex-wrap gap-2">
              {suggestionsFor(fit).map((sg) => (
                <a
                  href={`/app/reminders?suggest=${sg.key}${prefillSubject ? `&for=${encodeURIComponent(prefillSubject)}` : ''}${showDone ? '&show=done' : ''}#reminder-form`}
                  class="filter-tab border border-ink-100 bg-white text-sm"
                  title={sg.note}
                >
                  {sg.title}
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    )
  }

  {/* ---------------------------------------------------------- the open list */}

  <section id="open" class="mt-8">
    <h2 class="text-lg font-semibold tracking-tight">
      Your reminders
      <span class="ml-2 text-sm font-normal text-ink-500 tabular-nums">{open.length}</span>
    </h2>

    {
      open.length === 0 ? (
        <div class="mt-3 rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
          <p class="font-medium">No reminders yet</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
            Write down anything you must not forget. Insurance, truck payment, DMV. We email you
            before the date, and it shows on your Deadlines page.
          </p>
        </div>
      ) : (
        <div class="mt-3 overflow-x-auto rounded-xl border border-ink-100 bg-white">
          <table class="w-full text-sm sm:min-w-[46rem]">
            {/*
              No header line on a phone. Four column names above blocks that are
              not columns explain nothing — each block says what it is in its own
              words instead.

              THE DATE MOVED TO THE SECOND COLUMN. On a phone the block reads
              down, so the second column is the second line — and what he wants
              under the title is when it is due, not who it is for.
            */}
            {/* ink-700: a column head is text, and at 12px that is the floor. */}
            <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
              <tr>
                <th class="px-4 py-3 font-medium">What</th>
                <th class="px-4 py-3 font-medium">Date</th>
                <th class="px-4 py-3 font-medium">For</th>
                <th class="px-4 py-3 font-medium">Repeat</th>
                <th class="px-4 py-3 font-medium">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-100">
              {open.map((r) => {
                const pill = standingPill(r.status.standing)
                return (
                  /* The block leads with what he wrote down and when it is due.
                     Those two are the whole reminder; everything else on the row
                     is how it was set up. */
                  <tr class="block py-3 hover:bg-ink-50/60 sm:table-row sm:py-0">
                    <td class={cell}>
                      <div class="font-medium">{r.title}</div>
                      {r.note && <div class="mt-0.5 max-w-sm text-xs text-ink-700">{r.note}</div>}
                    </td>
                    <td class={`${cell} mt-1.5 whitespace-nowrap sm:mt-0`}>
                      {/* `standingPill` already hands back the shared
                          `badge badge-*` pair, so there is no second
                          construction to repeat over the top of it. */}
                      <span class={pill.className}>{pill.label}</span>
                      <span class="ml-2 tabular-nums sm:mt-1 sm:ml-0 sm:block">{dueLine(r)}</span>
                    </td>
                    <td class={`${cell} mt-1 sm:mt-0`}>
                      <span class="text-ink-500 sm:hidden">For </span>
                      {r.subject.href ? (
                        <a href={r.subject.href} class="link-row">
                          {r.subject.label}
                        </a>
                      ) : (
                        <span class="text-ink-500">{r.subject.label}</span>
                      )}
                    </td>
                    <td class={`${cell} mt-0.5 text-xs text-ink-700 sm:mt-0`}>
                      {r.repeatMonths > 0 ? repeatLabel(r.repeatMonths) : '—'}
                      {/* Was ink-300 — 1.85:1 on white. A "last done" date is a
                          fact the owner reads, not a divider. */}
                      {r.lastDoneOn && (
                        <span class="text-ink-700 sm:mt-0.5 sm:block">
                          <span class="sm:hidden"> · </span>
                          Last done {formatDate(toDateOnly(r.lastDoneOn))}
                        </span>
                      )}
                    </td>
                    <td class={`${cell} mt-3 sm:mt-0`}>
                      {/*
                        Three taps that used to be off the right edge of the
                        screen. Below `sm` they share the width as full-width
                        bordered blocks and stand 44px tall, because this is
                        pressed with a thumb in a yard; from `sm` they are the
                        small buttons at the end of the row again.
                      */}
                      {/* 44px at every width now, not only below `sm`: the old
                          desktop size was 32px. Done is the action, Change only
                          opens a form, and Delete is the one that destroys
                          something — so they are secondary, tertiary and the red
                          text variant, in that order. `gap-2` is the floor
                          between two 44px targets. */}
                      <div class="flex items-center gap-2 sm:flex-wrap sm:justify-end">
                        <form method="POST" class="flex-1 sm:flex-none">
                          <input type="hidden" name="id" value={r.id} />
                          <button
                            type="submit"
                            name="intent"
                            value="done_reminder"
                            class="btn btn-secondary btn-sm w-full sm:w-auto"
                          >
                            Done
                          </button>
                          <input type="hidden" name="from" value="open" />
                        </form>
                        {/* `show=done` rides along or the Finished list below
                            shuts itself the moment he edits something in this
                            one — "it's closed up", in his words. */}
                        <a
                          href={`/app/reminders?edit=${r.id}${showDone ? '&show=done' : ''}#reminder-form`}
                          class="btn btn-tertiary btn-sm w-full flex-1 sm:w-auto sm:flex-none"
                        >
                          Change
                        </a>
                        <form method="POST" class="flex-1 sm:flex-none">
                          <input type="hidden" name="id" value={r.id} />
                          <input type="hidden" name="from" value="open" />
                          <button
                            type="submit"
                            name="intent"
                            value="delete_reminder"
                            class="btn btn-danger-text btn-sm w-full sm:w-auto"
                          >
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  {/* ------------------------------------------------------------- done list */}

  <section id="finished" class="mt-8">
    {
      !showDone ? (
        /* The fragment is the whole point: opening the finished list used to
           reload the page and drop him at the top, so the list he had just
           asked for was three screens below the fold. */
        <a href="/app/reminders?show=done#finished" class="btn btn-secondary btn-sm">
          Show finished reminders
        </a>
      ) : (
        <>
          <h2 class="text-lg font-semibold tracking-tight">
            Finished
            <span class="ml-2 text-sm font-normal text-ink-500 tabular-nums">{done.length}</span>
          </h2>
          <p class="mt-1 text-sm text-ink-500">The last 50. You can open one again or delete it.</p>

          {done.length === 0 ? (
            <p class="mt-3 rounded-xl border border-dashed border-ink-100 bg-white p-6 text-center text-sm text-ink-500">
              Nothing is finished yet.
            </p>
          ) : (
            <ul class="mt-3 space-y-2">
              {done.map((r) => (
                <li class="flex flex-wrap items-center gap-3 rounded-xl border border-ink-100 bg-white px-4 py-3">
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium">{r.title}</span>
                    <span class="block text-xs text-ink-700 tabular-nums">
                      {r.subject.label} · was due {formatDate(toDateOnly(r.dueOn))}
                    </span>
                  </span>
                  <form method="POST" class="shrink-0">
                    <input type="hidden" name="id" value={r.id} />
                    {/* `from=finished` is what keeps `?show=done` on the way
                        back. Without it this button closes the very list it
                        stands in. */}
                    <input type="hidden" name="from" value="finished" />
                    <button
                      type="submit"
                      name="intent"
                      value="reopen_reminder"
                      class="btn btn-secondary btn-sm"
                    >
                      Open again
                    </button>
                  </form>
                  <form method="POST" class="shrink-0">
                    <input type="hidden" name="id" value={r.id} />
                    <input type="hidden" name="from" value="finished" />
                    <button
                      type="submit"
                      name="intent"
                      value="delete_reminder"
                      class="btn btn-danger-text btn-sm"
                    >
                      Delete
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}

          <a href="/app/reminders#finished" class="btn btn-secondary btn-sm mt-4">
            Hide finished
          </a>
        </>
      )
    }
  </section>

  {/* Where these show up next, said plainly. The badge is the same one the
      dashboard prints where a regulation prints its CFR citation. */}
  <p class="mt-8 flex flex-wrap items-center gap-2 text-sm text-ink-500">
    On the Deadlines page your reminders carry this mark:
    {/* The shared badge, not the bare colour pair `REMINDER_ORIGIN.className`
        still carries — see the note in the report: that constant lives in
        src/lib/reminders.ts and is read by the dashboard too. */}
    <span class="badge badge-info">{REMINDER_ORIGIN.label}</span>
  </p>
</App>
