---
/**
 * The IFTA quarterly return.
 *
 * Read-only on purpose: there is no form on this page and nothing here writes.
 * The two inputs are typed on the other two screens — the gallons off a shoebox
 * of receipts, the miles off trip sheets — and this is where they are turned
 * into the number that goes on the form. Keeping the writes elsewhere is what
 * lets this page be the one place that can say "do not file this return yet"
 * without anything on it offering a way to proceed anyway.
 *
 * Every figure below comes from `quarterlyReturn()` in src/lib/ifta/compute.ts.
 * Nothing on this page multiplies, divides or rounds: the arithmetic is money
 * owed to a tax authority that audits, it is tested in tests/ifta.test.ts, and a
 * second implementation in a template is a second answer nobody tests.
 */
import Bars from '../../../components/charts/Bars.astro'
import Columns from '../../../components/charts/Columns.astro'
import Diverging from '../../../components/charts/Diverging.astro'
import Figure from '../../../components/charts/Figure.astro'
import Proportion from '../../../components/charts/Proportion.astro'
import App from '../../../layouts/App.astro'
import {
  milesFigure,
  mpgTrend,
  netTaxFigure,
  quarterStillOpen,
  quarterTotals,
  truckCoverage,
} from '../../../lib/charts/ifta.ts'
import { returnReadiness } from '../../../lib/charts/ifta-readiness.ts'
import { ceilingFor, compactNumber } from '../../../lib/charts/scale.ts'
import { TONES } from '../../../lib/charts/tones.ts'
import { formatDate } from '../../../lib/drivers.ts'
import {
  type FuelRow,
  type MileRow,
  gallons,
  mpg,
  quarterLabel,
  quarterlyReturn,
  rate,
  returnDueOn,
} from '../../../lib/ifta/compute.ts'
import {
  FUEL_TYPE,
  type RateSourceRow,
  carrierToday,
  daysUntil,
  effectiveRates,
  isoDay,
  jurisdictionName,
  nextQuarterStart,
  periodFromParam,
  recentQuarters,
} from '../../../lib/ifta/input.ts'
import { formatCents } from '../../../lib/loads.ts'
import { vehicleLabel } from '../../../lib/vehicles.ts'

const supabase = Astro.locals.supabase!

const today = carrierToday()
const period = periodFromParam(Astro.url.searchParams.get('q'), today)
const periodIso = isoDay(period)
// Half-open range, so nothing has to work out the last day of a quarter and get
// 30 September wrong. `purchased_on >= 1 Jul AND < 1 Oct` is every day of Q3 and
// no day of Q4, in two comparisons a database index can use.
const nextIso = isoDay(nextQuarterStart(period))

/**
 * The quarters on offer: this one and the four before it.
 *
 * A bookmarked or shared URL pointing further back is added to the list rather
 * than silently redirected — an old quarter is exactly what someone opens when
 * an auditor asks about it, and a picker that cannot show the quarter the page
 * is displaying reads as a broken page.
 */
const quarters = recentQuarters(today, 5)
if (!quarters.some((q) => isoDay(q) === periodIso)) {
  quarters.push(period)
  quarters.sort((a, b) => b.getTime() - a.getTime())
}

/**
 * The quarters the MPG chart at the bottom of this page is drawn over.
 *
 * Anchored on the quarter being DISPLAYED rather than on today, so a Q2 return
 * opened from a bookmark carries Q2's history instead of a trend that runs on
 * past the return it sits under. It also bounds the two reads below: everything
 * this page needs lives in [oldest quarter start, next quarter start).
 */
const trendQuarters = recentQuarters(period, 5)
const oldestIso = isoDay(trendQuarters[trendQuarters.length - 1])

/**
 * Four reads, and the errors are kept rather than swallowed.
 *
 * A FAILED READ MUST NEVER RENDER AS A NIL RETURN. `(data ?? [])` on a query
 * that errored produces an empty array, which produces a return with no travel,
 * no tax and `complete: true` — a page that cheerfully reports nothing to file
 * for a quarter the trucks ran all of. So `readError` below does not merely add
 * a banner: it replaces the entire return, because a nil return and a broken
 * database look identical once the numbers are on screen.
 *
 * No `.eq('carrier_id', …)` on any of them: RLS already limits every row to the
 * signed-in user's carrier, and repeating the filter here would say in code that
 * we do not quite believe the policy. `ifta_rates` is reference data shared by
 * every tenant and has no carrier column at all.
 *
 * The miles and fuel reads span the five quarters on the trend rather than this
 * one, and the return is then filtered back out of them. Two wide reads rather
 * than four narrow ones: the same rows either way, one round trip each.
 */
const [milesResult, fuelResult, ratesResult, vehiclesResult] = await Promise.all([
  supabase
    .from('jurisdiction_miles')
    .select('jurisdiction, miles, vehicle_id, period_start')
    .gte('period_start', oldestIso)
    .lt('period_start', nextIso),
  supabase
    .from('fuel_purchases')
    .select('jurisdiction, gallons_milli, tax_paid, purchased_on')
    .gte('purchased_on', oldestIso)
    .lt('purchased_on', nextIso),
  // Every rate that had started by this quarter, for every jurisdiction.
  // `effectiveRates()` then keeps the latest per jurisdiction — PostgREST has no
  // DISTINCT ON, and taking whichever row came back first would price a quarter
  // at a superseded rate.
  supabase
    .from('ifta_rates')
    .select('jurisdiction, fuel_type, period_start, rate_mills')
    .eq('fuel_type', FUEL_TYPE)
    .lte('period_start', periodIso),
  // Ids and unit numbers, and only so the charts can say "4 of 7 trucks have
  // miles" and then NAME the three that do not — "3 trucks still need miles" is
  // a sentence somebody can act on only once it comes with unit numbers. Its
  // error is deliberately NOT part of `readError` below: a failure here leaves
  // every figure on this page correct, and costs only the sentence about what
  // those figures cover — which `truckCoverage(null, …)` then says instead of
  // claiming the fleet all reported.
  // POWER UNITS ONLY. IFTA is a fuel tax: a trailer has no engine, buys no
  // diesel and can never have miles of its own. Counting trailers here made the
  // readiness bar read "4 of 9 trucks still need miles" on a fleet of seven
  // trucks and two trailers — sending the owner to hunt for numbers that cannot
  // exist, on the one screen whose job is telling him what is still missing.
  // This list is only the denominator and the "still waiting on" names; the
  // miles themselves come from the mileage rows, so no reported total moves.
  supabase.from('vehicles').select('id, unit_number, vin').eq('kind', 'power_unit'),
])

const readError =
  milesResult.error?.message ?? fuelResult.error?.message ?? ratesResult.error?.message ?? null

const mileRecords = (
  (milesResult.data ?? []) as {
    jurisdiction: string
    miles: number
    vehicle_id: string | null
    period_start: string
  }[]
).map((r) => ({
  jurisdiction: r.jurisdiction,
  miles: Number(r.miles),
  vehicleId: r.vehicle_id,
  periodStart: r.period_start,
}))

const fuelRecords = (
  (fuelResult.data ?? []) as {
    jurisdiction: string
    gallons_milli: number
    tax_paid: boolean
    purchased_on: string
  }[]
).map((r) => ({
  jurisdiction: r.jurisdiction,
  // `gallons_milli` is bigint. PostgREST sends it as a JSON number, and Number()
  // here is a statement that the value is already an integer count of
  // thousandths — not a conversion from gallons, which is the mistake that would
  // divide the whole return by a thousand.
  gallonsMilli: Number(r.gallons_milli),
  taxPaid: r.tax_paid,
  purchasedOn: r.purchased_on,
}))

// THE RETURN IS THIS QUARTER'S ROWS AND NOTHING ELSE. `period_start` is a
// quarter's first day, so the mileage filter is an exact match; the fuel read is
// already capped at `nextIso`, so its lower bound is the whole test. Getting
// either wrong would file one quarter's return with another quarter's figures.
const currentMiles = mileRecords.filter((r) => r.periodStart === periodIso)
const mileRows: MileRow[] = currentMiles.map((r) => ({
  jurisdiction: r.jurisdiction,
  miles: r.miles,
}))

const fuelRows: FuelRow[] = fuelRecords
  .filter((r) => r.purchasedOn >= periodIso)
  .map((r) => ({
    jurisdiction: r.jurisdiction,
    gallonsMilli: r.gallonsMilli,
    taxPaid: r.taxPaid,
  }))

const rates = effectiveRates((ratesResult.data ?? []) as RateSourceRow[], period)

const result = quarterlyReturn({ miles: mileRows, fuel: fuelRows, rates })

const due = returnDueOn(period)
const daysLeft = daysUntil(due, today)
const label = quarterLabel(period)

/**
 * Miles run with no fuel recorded: the failure mode `complete` cannot see.
 *
 * `quarterlyReturn()` reports a quarter complete when every jurisdiction has a
 * rate. But with zero gallons the fleet MPG is zero, so the taxable gallons for
 * EVERY jurisdiction compute as zero, and the return renders as a fully-priced
 * $0.00 owed on thousands of miles. That is a short filing that looks finished —
 * the same failure the rate_unknown outcome exists to prevent, arriving through
 * the other input. It is called out here with the same volume.
 */
const milesWithoutFuel = result.totalMiles > 0 && result.totalGallonsMilli === 0
const fuelWithoutMiles = result.totalGallonsMilli > 0 && result.totalMiles === 0
const nilReturn = result.totalMiles === 0 && result.totalGallonsMilli === 0

/**
 * Both inputs are on file and the average still rounds to nothing.
 *
 * Usually a gallons figure in the wrong unit. `quarterlyReturn()` has reported
 * this in `blockers` since it was written and this page never showed it, so a
 * quarter in this state rendered a fully-priced $0.00 return with no banner of
 * any kind over it.
 */
const mpgUnusable = result.totalMiles > 0 && result.totalGallonsMilli > 0 && result.mpgCentis === 0

/**
 * Incomplete, and it is the ENGINE's answer rather than a second one worked out
 * here.
 *
 * This used to read `missingRates.length > 0 || milesWithoutFuel`, which let the
 * two states `blockers` was added for through as finished. A quarter with fuel
 * and no miles prices every jurisdiction as a pure credit, and the tile below
 * then announced a net refund, in green, as fact; a quarter whose average rounds
 * to zero prices every line at nothing and said so nowhere. There is deliberately
 * no way to dismiss this.
 */
const incomplete = !result.complete

/**
 * A fleet MPG outside this band is a question, not a refusal.
 *
 * A loaded class-8 truck runs 5 to 8 mpg. Well outside that usually means a
 * missing stack of receipts (MPG too high, which under-reports every
 * jurisdiction) or a mistyped gallons figure (MPG too low, which over-reports).
 * Worth asking about; not worth blocking a return over, because a light-duty
 * fleet legitimately sits above it.
 */
const mpgSuspect = result.mpgCentis > 0 && (result.mpgCentis < 300 || result.mpgCentis > 1200)

/**
 * The quarter drawn as three shapes.
 *
 * All three derivations live in src/lib/charts/ifta.ts and all three can refuse:
 * the half-entered quarter is the ORDINARY state of a return for months at a
 * time — receipts arrive daily, odometers at quarter end — and every half-state
 * has a confident, wrong picture waiting to be drawn from it. The refusals are
 * honoured below by simply not rendering the figure, because a caveat printed
 * under a wall of green credits is read second and the shape is read first.
 */
const open = quarterStillOpen(period, today)

/**
 * How much of the fleet these miles cover.
 *
 * Built from the same rows the return is, so the chart and the caveat under it
 * cannot drift apart. `null` for the id list when the read failed, which is not
 * the same claim as a carrier with no trucks.
 */
type VehicleRow = { id: string; unit_number: string | null; vin: string | null }

const fleet = vehiclesResult.error
  ? null
  : ((vehiclesResult.data ?? []) as VehicleRow[]).map((v) => ({
      id: v.id,
      label: vehicleLabel(v),
    }))

const trucks = truckCoverage(fleet === null ? null : fleet.map((v) => v.id), currentMiles)

const milesChart = milesFigure({ result, fuel: fuelRows, trucks, open })
const netChart = netTaxFigure({ result, trucks, open })

/**
 * What is still missing before this quarter can go on a form.
 *
 * The one thing this page could not say before: it had a coverage SENTENCE
 * under a chart reading "only 4 of 7 trucks have miles entered", read second and
 * only if the chart above it drew at all — and when the quarter is half-entered
 * the charts refuse to draw, so the sentence went with them. The quarter that
 * most needs this told the owner least about it.
 *
 * It is drawn as progress and it must never be read as permission. Three things
 * hold that line, and none of them is the wording alone:
 *
 *   - The bar counts TYPING, and it is labelled as typing. "4 of 7 trucks have
 *     miles entered" is a fact about the boxes, not about the return.
 *   - The checklist under it ends with two steps no software can ever tick —
 *     you checking the figures, and the form actually being filed — so the list
 *     still has open items on it at the moment every truck turns green.
 *   - There is no button anywhere on this page that files anything, which is the
 *     same absence the "do not file this return yet" banners rely on.
 *
 * `fleet === null` is a failed read, which is NOT a carrier with no trucks. It
 * says so and counts nothing.
 */
const readiness = returnReadiness({
  trucks: fleet,
  rows: currentMiles,
  missingRates: result.missingRates,
  totalMiles: result.totalMiles,
  totalGallonsMilli: result.totalGallonsMilli,
  daysLeft,
  dueLabel: formatDate(isoDay(due)),
  hrefs: {
    miles: `/app/ifta/miles?q=${periodIso}`,
    fuel: `/app/ifta/fuel?q=${periodIso}`,
    trucks: '/app/vehicles/new',
  },
})

/**
 * The trucks with no miles, by name, each carrying its own link.
 *
 * `returnReadiness` already names up to six of them inside one sentence on the
 * checklist. A sentence is something to read; this is something to work
 * through. The miles screen takes a `v=` parameter, so every truck here can
 * link straight to its own form — which is the difference between being told
 * "3 trucks still need miles" and three taps.
 *
 * The test is the same one src/lib/charts/ifta-readiness.ts applies: at least
 * one MILE, not merely a row. If the two ever drifted, the count printed above
 * this list and the names printed in it would contradict each other on one
 * card. Both are derived from `currentMiles` and `fleet` so they cannot.
 *
 * `fleet === null` is a failed read of the truck list, which is not a carrier
 * with no trucks. Nothing is listed and `readiness` says why.
 */
const waitingTrucks =
  fleet === null
    ? []
    : fleet.filter(
        (t) =>
          currentMiles.filter((r) => r.vehicleId === t.id).reduce((n, r) => n + r.miles, 0) <= 0,
      )

/**
 * How many names are printed before the rest are counted instead.
 *
 * The tail is a count with a link rather than a `<details>` the owner has to
 * open: the miles screen's own per-truck chart lists every truck including the
 * empty ones, so nothing is lost by sending him there, and a fleet with nothing
 * entered at all would otherwise put twenty-five rows between the bar and the
 * checklist under it.
 */
const NAMED_WAITING = 8
const waitingShown = waitingTrucks.slice(0, NAMED_WAITING)
const waitingRest = waitingTrucks.length - waitingShown.length

/**
 * Fleet MPG over five quarters — far enough back that the same quarter a year
 * ago is on the axis, and the widest span these two reads can cover cheaply.
 *
 * Reversed because `recentQuarters` hands them back newest-first for the picker
 * at the top of the page, and an axis reads oldest to newest.
 */
const totalsByQuarter = quarterTotals([...trendQuarters].reverse(), mileRecords, fuelRecords)

const trend = mpgTrend(totalsByQuarter, today)
// The same ceiling `Columns` computes internally, so the label names the line
// the columns are actually scaled against rather than a number near it.
const mpgCeiling = ceilingFor(trend.columns.map((c) => c.value))

/**
 * Total miles per quarter — "are we running more or less than we were".
 *
 * FOUR quarters, where the MPG chart under it takes five. The two spans are
 * different on purpose and neither is a rounding of the other: MPG is compared
 * against the same quarter a year ago, because fuel economy is seasonal and a
 * winter quarter is not evidence against a summer one. Miles are compared
 * against the recent run of quarters, which is the question actually being
 * asked here.
 *
 * NO ARITHMETIC ON THE RETURN HAPPENS HERE. `quarterTotals()` has already added
 * the mileage rows up per quarter — the same integers the return is built from,
 * summed once, in the library that is tested.
 */
const MILES_TREND_QUARTERS = 4
const milesTrendQuarters = totalsByQuarter.slice(-MILES_TREND_QUARTERS)

const milesTrendColumns = milesTrendQuarters.map((q) => {
  const stillOpen = quarterStillOpen(q.periodStart, today)
  // A quarter with no mileage rows is NOT a quarter in which the trucks stayed
  // in the yard. Nobody types zero miles for a quarter they did not run; they
  // type nothing. Drawn at zero this chart would claim a stopped fleet, so it
  // is `null` and `Columns` draws the dashed empty slot that says we have no
  // figure.
  const value = q.totalMiles > 0 ? q.totalMiles : null
  return {
    label: quarterLabel(q.periodStart),
    value,
    display: value === null ? 'nothing entered' : compactNumber(value),
    // The quarter still being typed into is drawn grey and with an open dashed
    // top, the same way the MPG chart greys it: its height is real and its
    // meaning is not settled, and a solid brand-coloured column beside three
    // finished ones invites a comparison that cannot be made yet.
    tone: stillOpen ? ('neutral' as const) : ('brand' as const),
    inProgress: stillOpen,
  }
})

const milesTrendKnown = milesTrendColumns.filter((c) => c.value !== null).length
const milesTrendCeiling = ceilingFor(milesTrendColumns.map((c) => c.value))

/**
 * The comparison, between CLOSED quarters only.
 *
 * A quarter still being entered holds however many trip sheets somebody has got
 * to, so reading it against a finished one says the fleet slowed down when what
 * happened is that the typing is not done. The open quarter stays on the chart
 * and stays out of this sentence.
 */
const closedMileQuarters = milesTrendQuarters.filter(
  (q) => !quarterStillOpen(q.periodStart, today) && q.totalMiles > 0,
)
const milesTrendTakeaway = (() => {
  if (closedMileQuarters.length < 2) return null
  const earlier = closedMileQuarters[closedMileQuarters.length - 2]
  const later = closedMileQuarters[closedMileQuarters.length - 1]
  // Whole miles, both sides. Integers in and an integer out.
  const delta = later.totalMiles - earlier.totalMiles
  if (delta === 0) {
    return `${quarterLabel(later.periodStart)} has the same miles as ${quarterLabel(earlier.periodStart)}: ${compactNumber(later.totalMiles)}.`
  }
  return `${quarterLabel(later.periodStart)} has ${compactNumber(later.totalMiles)} miles on file, ${compactNumber(Math.abs(delta))} ${delta > 0 ? 'more' : 'less'} than ${quarterLabel(earlier.periodStart)}.`
})()

/**
 * What this chart does not cover, and it always has something to say.
 *
 * Every column is the miles somebody TYPED for that quarter. A quarter two trip
 * sheets short is a short column, and a short column on a trend chart reads as
 * a quiet quarter rather than as a quarter nobody finished entering.
 */
const milesTrendCoverage = [
  'Each column is the miles entered for that quarter. It is not a measurement of what the trucks ran.',
  open ? `${label} is still being entered, so that column will grow.` : null,
].filter((c): c is string => c !== null)

const quarterHref = (p: Date) => `/app/ifta?q=${isoDay(p)}`

const card = 'rounded-xl border border-ink-100 bg-white p-5'
const tab = 'rounded-lg px-3 py-1.5 text-sm font-medium whitespace-nowrap transition'

/**
 * ON A PHONE THE RETURN IS NOT A TABLE.
 *
 * It is 56rem wide and the window inside it is 341px, so 555px of every line —
 * 62% — was behind a sideways scroll, and the column furthest off the edge was
 * the net owed, which is the number the whole page exists to produce. Worse,
 * the "no rate on file" badge lives in that same column: the one cell that says
 * a line is NOT priced was the one cell nobody on a phone could see.
 *
 * Below `sm` every cell is a block; from `sm` the same markup is a table again.
 * ONE set of cells, not two, the same way src/components/Documents.astro does
 * it. The blocks are ordered so a line reads jurisdiction, then miles, then the
 * net — `order-*` needs the row to be a flex column below `sm`, and from `sm`
 * it is `table-row` again and the property is ignored.
 *
 * Every red banner above this table, the net tile, the readiness strip and the
 * nil-return state are untouched by all of it: they are not table rows.
 */
const cell = 'block px-4 py-1 sm:table-cell sm:py-3'
/** The column name, carried into the block that no longer has a header row. */
const colName = 'text-ink-500 sm:hidden'

/**
 * The deadline card's colour, and it earns red. A late return is a penalty.
 *
 * Thirty days, not the 45 of `SOON_DAYS` in src/lib/rules/index.ts. The filing
 * window for a quarter is one month wide — the quarter closes and the return is
 * due the last day of the month after it — so amber at 45 days would light up
 * about two weeks BEFORE the quarter even ends, on every quarter, at which
 * point there is nothing to file yet and nothing the owner can do about it.
 * Amber that is always on is amber nobody looks at. The checklist step in
 * src/lib/charts/ifta-readiness.ts turns amber on the same 30 days, so the card
 * and the step under it never disagree.
 *
 * Both sides of zero are guarded: a negative `daysLeft` is overdue and is
 * caught first, so it can never fall through into the due-soon branch.
 */
const deadlineTone =
  daysLeft < 0
    ? 'border-red-200 bg-red-50'
    : daysLeft <= 30
      ? 'border-amber-300 bg-amber-50'
      : 'border-ink-100 bg-white'
---

<App
  title={`IFTA · ${label}`}
  subtitle="Tax on the fuel you burned in each state or province, minus the fuel tax you already paid at the pump there."
>
  {/* ------------------------------------------------------- quarter picker */}
  <div class="-mx-4 mb-5 flex items-center gap-1 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0">
    {
      quarters.map((q) => (
        <a
          href={quarterHref(q)}
          class:list={[
            tab,
            'tabular-nums',
            isoDay(q) === periodIso
              ? 'bg-brand-500/10 text-brand-700'
              : 'text-ink-500 hover:bg-ink-100 hover:text-ink-900',
          ]}
        >
          {quarterLabel(q)}
        </a>
      ))
    }
  </div>

  {
    /* The deadline is rendered even when the database is unreachable: it comes
       from the calendar, not from a query, and it is still true. */
  }
  <div class:list={['mb-5 flex flex-wrap items-center gap-4 rounded-xl border p-5', deadlineTone]}>
    <div class="min-w-0 flex-1">
      <h3 class="text-xs tracking-wide text-ink-500 uppercase">{label} return is due</h3>
      <div class="mt-1 text-3xl font-semibold tabular-nums">{formatDate(isoDay(due))}</div>
      {
        /* The sentence that makes the date mean something. A nil return is still
           a return: the penalty for not filing is $50 or 10% of the tax due,
           whichever is greater, and 10% of nothing is still $50. */
      }
      <p class="mt-2 max-w-2xl text-sm text-ink-500">
        You must file every quarter, even if the trucks did not run and you owe nothing. If you
        file late, or not at all, the penalty is $50 or 10% of the tax due, whichever is more.
      </p>
    </div>
    <div class="shrink-0 text-right">
      {
        daysLeft < 0 ? (
          <>
            <div class="text-4xl font-semibold tabular-nums text-red-700">{-daysLeft}</div>
            <div class="text-sm font-medium text-red-700">
              {daysLeft === -1 ? 'day overdue' : 'days overdue'}
            </div>
          </>
        ) : (
          <>
            <div
              class:list={[
                'text-4xl font-semibold tabular-nums',
                daysLeft <= 30 ? 'text-amber-800' : '',
              ]}
            >
              {daysLeft}
            </div>
            <div
              class:list={[
                'text-sm font-medium',
                daysLeft <= 30 ? 'text-amber-800' : 'text-ink-500',
              ]}
            >
              {daysLeft === 0 ? 'due today' : daysLeft === 1 ? 'day left' : 'days left'}
            </div>
          </>
        )
      }
    </div>
  </div>

  {
    readError ? (
      /* THE RETURN IS REPLACED, not annotated. Rendering the tiles at zero under
         an error banner would put "0 miles · $0.00 owed · complete" on screen
         for a quarter whose rows simply could not be read — which is the exact
         picture a genuine nil return paints, and the one wrong answer this page
         must never give. */
      <div class="rounded-xl border border-red-200 bg-red-50 p-10 text-center">
        <p class="font-semibold text-red-800">We could not read the {label} return</p>
        <p class="mx-auto mt-2 max-w-xl text-sm text-red-700">{readError}</p>
        <p class="mx-auto mt-2 max-w-xl text-sm text-red-700">
          We show no figures on purpose. An empty screen here would look the same as a quarter
          where the trucks really did not run. Reload this page before you file anything.
        </p>
        <a
          href={quarterHref(period)}
          class="mt-4 inline-block rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-700"
        >
          Try again
        </a>
      </div>
    ) : (
      <>
        {/* --------------------------------------------------- the loud failures */}
        {/* NAMED, never counted. "3 jurisdictions are missing a rate" is a
            sentence nobody can act on; the codes are what she takes to the rate
            tables. There is no button here to file anyway, and that absence is
            the feature. */}
        {result.missingRates.length > 0 && (
          <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-5">
            <p class="font-semibold text-red-800">
              Do not file this return yet — {result.missingRates.length}{' '}
              {result.missingRates.length === 1 ? 'jurisdiction has' : 'jurisdictions have'} no tax
              rate on file
            </p>
            <p class="mt-2 max-w-3xl text-sm text-red-700">
              The trucks ran in{' '}
              {result.missingRates.map((code, i) => (
                <>
                  {i > 0 && ', '}
                  <span class="font-medium">
                    {code} ({jurisdictionName(code)})
                  </span>
                </>
              ))}
              , and we have no tax rate for {result.missingRates.length === 1 ? 'it' : 'them'} for{' '}
              {label}. The miles are on file and the gallons are worked out below, but the tax on
              them is not.
            </p>
            <p class="mt-2 max-w-3xl text-sm text-red-700">
              If you file with these lines at zero, you pay less than you owe. That is what an
              audit finds. IFTA, Inc. publishes the rates every quarter and they load into
              <span class="font-medium"> ifta_rates</span>. Until they are in, the net below is only
              part of the total. It is not the amount to file.
            </p>
          </div>
        )}

        {milesWithoutFuel && (
          <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-5">
            <p class="font-semibold text-red-800">
              Do not file this return yet — you have miles on file but no fuel
            </p>
            <p class="mt-2 max-w-3xl text-sm text-red-700">
              Nobody measures the gallons burned in a jurisdiction. We work them out from the
              fleet's average miles per gallon. With no gallons on file there is no average, so
              every line below comes out at zero taxable gallons and the whole return prices at
              $0.00 on{' '}
              <span class="font-medium tabular-nums">
                {result.totalMiles.toLocaleString('en-US')}
              </span>{' '}
              miles of travel.
            </p>
            <a
              href={`/app/ifta/fuel?q=${periodIso}`}
              class="mt-3 inline-block rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-700"
            >
              Enter the fuel receipts →
            </a>
          </div>
        )}

        {/* The third blocker `quarterlyReturn()` reports, and the only one this
            page never had a banner for. Both inputs are present, so neither
            single-sided warning above fires, and every taxable-gallon figure on
            the return multiplies out to nothing — a fully-priced $0.00 return
            with nothing on screen arguing with it. */}
        {mpgUnusable && (
          <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-5">
            <p class="font-semibold text-red-800">
              Do not file this return yet — the miles and gallons give no usable fleet average
            </p>
            <p class="mt-2 max-w-3xl text-sm text-red-700">
              <span class="font-medium tabular-nums">
                {result.totalMiles.toLocaleString('en-US')}
              </span>{' '}
              miles against{' '}
              <span class="font-medium tabular-nums">{gallons(result.totalGallonsMilli)}</span>{' '}
              gallons is less than 0.01 mpg. We cannot work out taxable gallons for any
              jurisdiction, so every line below prices at nothing. Usually one gallons figure is in
              the wrong unit. A price per gallon typed into the gallons box does this.
            </p>
            <a
              href={`/app/ifta/fuel?q=${periodIso}`}
              class="mt-3 inline-block rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-700"
            >
              Check the receipts →
            </a>
          </div>
        )}

        {fuelWithoutMiles && (
          <p class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
            You have fuel on file for {label} but no miles. Right now this return asks for credit
            on tax paid at the pump while saying the trucks went nowhere. That is the first thing an
            auditor opens.{' '}
            <a href={`/app/ifta/miles?q=${periodIso}`} class="font-medium underline">
              Enter the miles for each jurisdiction
            </a>
            .
          </p>
        )}

        {mpgSuspect && (
          <p class="mb-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Fleet average of{' '}
            <span class="font-medium tabular-nums">{mpg(result.mpgCentis)} mpg</span> is outside
            the normal range for a loaded truck. Too high usually means some receipts are not
            entered yet, which reports every jurisdiction too low. Too low usually means a gallons
            figure was mistyped.
          </p>
        )}

        {/* ----------------------------------------------------- what is missing */}
        {/*
          ABOVE the four tiles, because the net figure in the fourth tile is the
          number somebody copies onto a form, and "3 trucks still need miles" has
          to be read before it rather than after.

          The title is the ANSWER, not the name of a chart. "3 trucks still need
          miles" is something an owner can do; "data completeness" is not.

          The caveat is `Figure`'s own coverage slot, so it prints in the same
          amber "Not the whole picture" voice the rest of the IFTA charts use —
          the warning this page already made, attached to the one widget on the
          page that could be mistaken for a green light.
        */}
        <Figure
          class="mb-5"
          title={readiness.headline}
          subtitle={readiness.countLine}
          coverage={readiness.caveat}
          action={
            readiness.withoutMiles > 0
              ? { href: `/app/ifta/miles?q=${periodIso}`, label: 'Enter miles →' }
              : undefined
          }
        >
          {/* Reused rather than rebuilt: `Proportion` already refuses to ship a
              bar without a legend, and its min-width stops the last grey truck
              in a big fleet rounding away to nothing. Green is trucks with miles
              on file; grey is trucks with none, and grey is NOT progress. */}
          <Proportion
            segments={readiness.segments}
            total={readiness.totalTrucks}
            emptyMessage={
              readiness.unreadable
                ? 'We could not read your truck list, so we cannot count.'
                : 'No trucks on file yet.'
            }
          />

          {/* The trucks the grey part of the bar is made of, by NAME, each with
              a link to its own miles form. The bar says how many; this says
              which, and gives him somewhere to tap for each one. Without it the
              grey segment is a quantity he then has to go and identify. */}
          {
            waitingShown.length > 0 && (
              <div class="mt-4 border-t border-ink-100 pt-4">
                <h4 class="text-xs tracking-wide text-ink-500 uppercase">
                  These trucks have no miles for {label}
                </h4>
                <ul class="mt-2 space-y-1.5 text-sm">
                  {waitingShown.map((truck) => (
                    <li class="flex flex-wrap items-center justify-between gap-x-3">
                      <span class="flex min-w-0 items-center gap-2">
                        {/* Decorative. "no miles yet" beside it carries the same
                            state in words, because roughly one man in twelve
                            cannot separate the grey dot from the green one. */}
                        <span
                          class:list={[
                            'h-2 w-2 shrink-0 rounded-full',
                            TONES.neutral.swatch,
                          ]}
                          aria-hidden="true"
                        />
                        <span class="truncate font-medium">{truck.label}</span>
                        <span class="shrink-0 text-ink-500">no miles yet</span>
                      </span>
                      {/* A full-height tap on a phone, a plain link from `sm`.
                          This is read one-handed in a yard. */}
                      <a
                        href={`/app/ifta/miles?q=${periodIso}&v=${truck.id}`}
                        class="inline-flex min-h-11 shrink-0 items-center font-medium whitespace-nowrap text-brand-600 hover:underline sm:min-h-0"
                      >
                        Enter miles →
                      </a>
                    </li>
                  ))}
                  {waitingRest > 0 && (
                    /* The tail is counted, not hidden behind a control. The
                       miles screen's own per-truck chart lists every truck
                       including the empty ones, so the link is where the rest
                       of the names actually are. */
                    <li class="pt-1 text-ink-500">
                      <a
                        href={`/app/ifta/miles?q=${periodIso}`}
                        class="font-medium text-brand-600 hover:underline"
                      >
                        <span class="tabular-nums">{waitingRest}</span> more{' '}
                        {waitingRest === 1 ? 'truck has' : 'trucks have'} no miles →
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            )
          }

          {/* The list that stops a full bar reading as permission. The last two
              rows are grey on every quarter that ever renders — nothing here can
              see whether the figures are right or whether the form was filed —
              so there is no state of this page in which every row is green. */}
          <ul class="mt-4 space-y-2.5 border-t border-ink-100 pt-4 text-sm">
            {
              readiness.steps.map((step) => (
                <li class="flex gap-2.5">
                  {/* Decorative: the sentence beside it carries the same state in
                      words, because roughly one man in twelve cannot separate the
                      red dot from the amber one. */}
                  <span
                    class:list={['mt-1.5 h-2 w-2 shrink-0 rounded-full', TONES[step.tone].swatch]}
                    aria-hidden="true"
                  />
                  <div class="min-w-0">
                    <span class="font-medium">{step.label}</span>
                    <span class="text-ink-500"> — {step.detail}</span>
                    {step.href && step.action && (
                      <>
                        {' '}
                        <a
                          href={step.href}
                          class="font-medium whitespace-nowrap text-brand-600 hover:underline"
                        >
                          {step.action} →
                        </a>
                      </>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </Figure>

        {/* ------------------------------------------------------------- figures */}
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class={card}>
            <h3 class="text-xs tracking-wide text-ink-500 uppercase">Total miles</h3>
            <div class="mt-1 text-3xl font-semibold tabular-nums">
              {result.totalMiles.toLocaleString('en-US')}
            </div>
            <div class="mt-1 text-xs text-ink-500">Every jurisdiction, every truck.</div>
          </div>

          <div class={card}>
            <h3 class="text-xs tracking-wide text-ink-500 uppercase">Total gallons</h3>
            <div class="mt-1 text-3xl font-semibold tabular-nums">
              {gallons(result.totalGallonsMilli)}
            </div>
            {/* Taxed and untaxed alike. The engine burned bulk fuel the same as
                pump fuel, so it counts toward the average; only the CREDIT side
                cares whether tax was paid on it. */}
            <div class="mt-1 text-xs text-ink-500">Bulk fuel counts here too. The engine burned it.</div>
          </div>

          <div class={card}>
            <h3 class="text-xs tracking-wide text-ink-500 uppercase">Fleet MPG</h3>
            <div class="mt-1 text-3xl font-semibold tabular-nums">
              {result.mpgCentis > 0 ? mpg(result.mpgCentis) : <span class="text-ink-300">—</span>}
            </div>
            <div class="mt-1 text-xs text-ink-500">
              One figure for the whole fleet. Per-truck averages would not add up to the return.
            </div>
          </div>

          <div
            class:list={[
              card,
              // The net gets an accent only when the return can actually be
              // filed. A confident-looking total on an incomplete return is the
              // thing that gets copied onto a form.
              incomplete ? 'border-red-200 bg-red-50/40' : '',
            ]}
          >
            {/* A real heading, not a styled div — the wording, the size and the
                position are exactly as they were. This is the line that tells
                an owner the big number under it is not the one to file. */}
            <h3 class="text-xs tracking-wide text-ink-500 uppercase">
              {incomplete
                ? 'Part of the net — do not file this figure'
                : result.netCents < 0
                  ? 'Net credit'
                  : 'Net owed'}
            </h3>
            <div
              class:list={[
                'mt-1 text-3xl font-semibold tabular-nums',
                incomplete ? 'text-red-700' : result.netCents < 0 ? 'text-emerald-700' : '',
              ]}
            >
              {formatCents(Math.abs(result.netCents))}
            </div>
            <div class="mt-1 text-xs text-ink-500">
              {incomplete
                ? 'This covers only the jurisdictions that have a rate below.'
                : result.netCents < 0
                  ? 'Owed back to you across the fleet.'
                  : 'Across every jurisdiction on the return.'}
            </div>
          </div>
        </div>

        {/* ----------------------------------------------------------- the shape */}
        {/*
          The flagship, and the case `Diverging` was built for. A quarter is a
          list of jurisdictions billing you and jurisdictions crediting you, and
          the question the owner actually has — where is the money going, and is
          any of it coming back — is invisible in a column of signed numbers he
          has to read the sign off, row by row.

          It renders ONLY when there is a net figure to draw. `netTaxFigure`
          refuses the half-entered quarter outright rather than captioning it:
          fuel in and miles not yet is the normal order of a real quarter and
          draws as a full green bar against every jurisdiction, and no sentence
          printed underneath takes a refund back once it has been seen.

          Jurisdictions with no rate on file are NOT on this chart and are named
          in the coverage note instead. They have miles but no net figure, and
          the only place a chart could put them is the centre line, where they
          would read as settled.
        */}
        {netChart.items.length > 0 && (
          <Figure
            class="mt-6"
            title="Where the quarter's money goes"
            subtitle="Tax you owe each jurisdiction, minus the tax you already paid at the pump there"
            coverage={netChart.coverage}
            action={{ href: '#jurisdictions', label: 'The full table' }}
          >
            <Diverging
              items={netChart.items}
              negativeLabel="Owed back to you"
              positiveLabel="You owe"
            />
            {/* The takeaway, written out, because roughly one man in twelve
                cannot separate the green half from the red one and this is read
                on a phone, in a yard, in the sun. */}
            {netChart.takeaway && <p class="mt-3 text-sm text-ink-500">{netChart.takeaway}</p>}
          </Figure>
        )}


        {/* ---------------------------------------------------------- the return */}
        <div id="jurisdictions" class="mt-6 flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-lg font-semibold tracking-tight">Jurisdiction by jurisdiction</h2>
          <div class="flex flex-wrap gap-4">
            <a
              href={`/app/ifta/miles?q=${periodIso}`}
              class="text-sm font-medium text-brand-600 hover:underline"
            >
              Enter miles →
            </a>
            <a
              href={`/app/ifta/fuel?q=${periodIso}`}
              class="text-sm font-medium text-brand-600 hover:underline"
            >
              Fuel receipts →
            </a>
          </div>
        </div>

        {result.lines.length === 0 ? (
          /* A NIL RETURN IS STILL A RETURN, and it still has the deadline above
             it. This is not an empty state inviting her to add data — it is a
             statement that the quarter has nothing in it and must be filed
             anyway. */
          <div class="mt-3 rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
            <p class="font-medium">
              {nilReturn
                ? `Nothing is on file for ${label}. This is a nil return.`
                : `No jurisdictions on the ${label} return yet`}
            </p>
            <p class="mx-auto mt-2 max-w-xl text-sm text-ink-500">
              {nilReturn
                ? 'You still file a quarter with no travel and no fuel, and still by the date above. If the trucks did run, then the miles and the receipts are not entered yet.'
                : 'No miles and no fuel have been entered for this quarter yet.'}
            </p>
            <div class="mt-4 flex flex-wrap justify-center gap-3">
              <a
                href={`/app/ifta/miles?q=${periodIso}`}
                class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-brand-700"
              >
                Enter miles →
              </a>
              <a
                href={`/app/ifta/fuel?q=${periodIso}`}
                class="rounded-lg border border-ink-100 px-4 py-2 text-sm font-medium transition hover:bg-ink-50"
              >
                Fuel receipts →
              </a>
            </div>
          </div>
        ) : (
          <div class="mt-3 overflow-x-auto rounded-xl border border-ink-100 bg-white">
            <table class="w-full text-sm sm:min-w-[56rem]">
              {/* No header line on a phone. Six column names above blocks that
                  are not columns explain nothing; each block says what it is. */}
              <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-500 uppercase sm:table-header-group">
                <tr>
                  <th class="px-4 py-3 font-medium">Jurisdiction</th>
                  <th class="px-4 py-3 text-right font-medium">Miles</th>
                  <th class="px-4 py-3 text-right font-medium">Taxable gallons</th>
                  <th class="px-4 py-3 text-right font-medium">Tax-paid gallons</th>
                  <th class="px-4 py-3 text-right font-medium">Rate</th>
                  <th class="px-4 py-3 text-right font-medium">Net owed / (credit)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-ink-100">
                {result.lines.map((line) => {
                  const unknown = line.outcome.kind === 'rate_unknown'
                  return (
                    <tr
                      class:list={[
                        'flex flex-col py-3 sm:table-row sm:py-0',
                        unknown ? 'bg-red-50/60' : 'hover:bg-ink-50/60',
                      ]}
                    >
                      {/* THE JURISDICTION LEADS, then the miles, then the net.
                          That is the order the return is read in and the order
                          it is copied onto the form in. */}
                      <td class={`${cell} order-1`}>
                        <span class="font-medium">{line.jurisdiction}</span>
                        <span class="ml-2 text-xs text-ink-500">
                          {jurisdictionName(line.jurisdiction)}
                        </span>
                      </td>
                      <td class={`${cell} order-2 tabular-nums sm:text-right`}>
                        <span class={colName}>Miles </span>
                        {line.miles.toLocaleString('en-US')}
                      </td>
                      {/* Derived from miles and fleet MPG, never measured. */}
                      <td class={`${cell} order-4 tabular-nums sm:text-right`}>
                        <span class={colName}>Taxable gallons </span>
                        {gallons(line.taxableGallonsMilli)}
                      </td>
                      {/* Tax-paid purchases ONLY. Bulk gallons are missing from
                          this column on purpose: claiming them is the classic
                          audit finding, and they are already counted in the
                          fleet MPG. */}
                      <td class={`${cell} order-5 tabular-nums sm:text-right`}>
                        <span class={colName}>Tax-paid gallons </span>
                        {gallons(line.purchasedGallonsMilli)}
                      </td>
                      <td class={`${cell} order-6 tabular-nums sm:text-right`}>
                        <span class={colName}>Rate </span>
                        {line.outcome.kind === 'computed' ? (
                          rate(line.outcome.rateMills)
                        ) : (
                          <span class="font-medium text-red-700">unknown</span>
                        )}
                      </td>
                      <td class={`${cell} order-3 tabular-nums sm:text-right`}>
                        <span class={colName}>Net owed / (credit) </span>
                        {line.outcome.kind === 'computed' ? (
                          <span
                            class:list={[
                              'font-medium',
                              line.outcome.netCents < 0 ? 'text-emerald-700' : '',
                            ]}
                          >
                            {line.outcome.netCents < 0
                              ? `(${formatCents(-line.outcome.netCents)})`
                              : formatCents(line.outcome.netCents)}
                          </span>
                        ) : (
                          /* NOT $0.00, and not an em dash either. A blank cell
                             in a money column reads as nothing owed, which is
                             the exact lie this outcome exists to prevent. */
                          <span class="rounded-md bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-800">
                            no rate on file
                          </span>
                        )}
                      </td>
                    </tr>
                  )
                })}
              </tbody>
              <tfoot class="border-t border-ink-100">
                <tr class="flex flex-col py-3 sm:table-row sm:py-0">
                  <td class={`${cell} font-medium`}>{incomplete ? 'Total so far' : 'Total'}</td>
                  <td class={`${cell} font-medium tabular-nums sm:text-right`}>
                    <span class={colName}>Miles </span>
                    {result.totalMiles.toLocaleString('en-US')}
                  </td>
                  {/* Three empty cells. They hold the columns open from `sm` up
                      and are three blank lines on a phone, so they are not
                      rendered there. */}
                  <td class="hidden px-4 py-3 sm:table-cell" />
                  <td class="hidden px-4 py-3 sm:table-cell" />
                  <td class="hidden px-4 py-3 sm:table-cell" />
                  <td
                    class:list={[
                      cell,
                      'font-semibold tabular-nums sm:text-right',
                      incomplete ? 'text-red-700' : result.netCents < 0 ? 'text-emerald-700' : '',
                    ]}
                  >
                    {/* Not `label`: this one inherits the cell's colour instead
                        of going grey, so on an incomplete return the phone
                        reads the warning in the same red as the figure, in the
                        same words as the tile above. A grey caveat beside a red
                        number is the one version of this that must not ship. */}
                    <span class="font-normal sm:hidden">
                      {incomplete ? 'Part of the net — do not file this figure ' : 'Net '}
                    </span>
                    {result.netCents < 0
                      ? `(${formatCents(-result.netCents)})`
                      : formatCents(result.netCents)}
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        )}

        {result.lines.length > 0 && (
          <p class="mt-3 max-w-3xl text-sm text-ink-500">
            Nobody measures taxable gallons. We take the fleet's average miles per gallon and apply
            it to the miles run in each jurisdiction. That is why a jurisdiction the trucks drove
            through without buying fuel still owes tax, and one where you bought fuel but ran no
            miles shows a credit.
          </p>
        )}

        {/* BELOW the table, not above it. Drawn at 811px on a phone, this chart
            alone pushed the return itself — the numbers he is here to read and
            file — most of a screen further down, and it is a ranking of the
            same miles the table's second column already holds. The net chart
            above earns its place because it answers a question the table cannot;
            this one re-sorts an answer the table already gives.

            The input to every figure above it: the tax on a jurisdiction is its
            miles divided by the fleet average, so the mileage ranking IS the
            ranking of exposure. Unpriced jurisdictions stay HERE, because their
            miles are known — it is only the tax on them that is not.

            The subtitle does NOT say "every truck". It leads with the fleet
            total, because that is the number every bar below it is a share of
            and it otherwise sits four tiles up the page — but it says "on
            file", not "the fleet ran", because the coverage note under this
            chart may be about to say only six of nine reported, and a subtitle
            claiming the fleet would contradict it two inches higher up. */}
        {result.totalMiles > 0 && (
          <Figure
            class="mt-6"
            title="Miles by jurisdiction"
            subtitle={`${compactNumber(result.totalMiles)} miles on file for ${label}. The taxable gallons come from these.`}
            coverage={milesChart.coverage}
            action={{ href: `/app/ifta/miles?q=${periodIso}`, label: 'Enter miles →' }}
          >
            {/* The limit is derived, not ten. Unpriced jurisdictions and the
                ones with no miles entered rank last, and a flat limit would
                collapse the tail over exactly those rows. */}
            <Bars items={milesChart.items} limit={milesChart.limit} moreHref="/app/ifta/miles" />
            {milesChart.takeaway && <p class="mt-3 text-sm text-ink-500">{milesChart.takeaway}</p>}
          </Figure>
        )}

        {/*
          "Are we running more or less than we were." Four quarters of total
          miles, which is the same question the jurisdiction bars above answer
          for one quarter, asked across several.

          It sits between the two charts it belongs with: the bars above break
          this quarter's miles up by state, and the MPG chart below divides them
          to get the taxable gallons. Same input, three questions, in the order
          they are asked.

          Two known quarters is the floor, the same floor the MPG chart uses.
          One real column beside three dashed slots is not a trend.
        */}
        {milesTrendKnown >= 2 && (
          <Figure
            class="mt-6"
            title="Miles quarter by quarter"
            subtitle="Total miles on file for each of the last four quarters"
            coverage={milesTrendCoverage}
            action={{ href: `/app/ifta/miles?q=${periodIso}`, label: 'Enter miles →' }}
          >
            <Columns
              columns={milesTrendColumns}
              axisLabel={`${compactNumber(milesTrendCeiling)} miles`}
            />
            {/* Written out, because the shape is read first and one man in
                twelve reads the colours differently. */}
            {milesTrendTakeaway && (
              <p class="mt-3 text-sm text-ink-500">{milesTrendTakeaway}</p>
            )}
          </Figure>
        )}

        {/*
          Below the table, not above it, because this is the follow-up question
          rather than the return. "Is this getting worse" is asked after "what do
          I owe", and the figure for THIS quarter is already the third tile.

          Two known quarters is the floor. One real column beside four dashed
          slots is not a trend, it is a sentence — and the tile above already
          says it.
        */}
        {trend.known >= 2 && (
          <Figure
            class="mt-6"
            title="Fleet MPG, quarter by quarter"
            subtitle="We divide the miles above by this number to get the taxable gallons"
            coverage={trend.coverage}
          >
            <Columns columns={trend.columns} axisLabel={`${mpg(mpgCeiling)} mpg`} />
            {trend.takeaway && <p class="mt-3 text-sm text-ink-500">{trend.takeaway}</p>}
          </Figure>
        )}
      </>
    )
  }
</App>
