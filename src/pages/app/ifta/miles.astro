---
/**
 * Miles by jurisdiction, for one truck, for one quarter.
 *
 * This is the half of IFTA that comes off trip sheets or an ELD export rather
 * than out of a shoebox, and 0015_ifta.sql deliberately stores it as a SUMMARY
 * row per quarter rather than a trip log: small carriers reconstruct the total
 * and do not have a per-trip breakdown, and a screen that demanded one would get
 * nothing entered at all.
 *
 * The unique constraint (carrier_id, vehicle_id, period_start, jurisdiction) is
 * the whole design of this page. Re-entering a jurisdiction is not an error to
 * be refused, it is the correction anyone makes when a second trip sheet turns
 * up — so every write here is an upsert onto that constraint, and typing NV
 * twice fixes NV rather than failing on a unique violation with a sentence
 * naming an index.
 *
 * Two intents, one page, both ending in a 303.
 */
import Bars from '../../../components/charts/Bars.astro'
import Figure from '../../../components/charts/Figure.astro'
import App from '../../../layouts/App.astro'
import { flashText } from '../../../lib/flash.ts'
import { truckMilesFigure } from '../../../lib/charts/ifta.ts'
import { jurisdictionMilesBars } from '../../../lib/charts/ifta-readiness.ts'
import { quarterLabel, returnDueOn } from '../../../lib/ifta/compute.ts'
import {
  IFTA_JURISDICTIONS,
  carrierToday,
  daysUntil,
  isoDay,
  jurisdictionName,
  parseJurisdiction,
  parseMiles,
  periodFromParam,
  recentQuarters,
} from '../../../lib/ifta/input.ts'
import { vehicleLabel } from '../../../lib/vehicles.ts'

const supabase = Astro.locals.supabase!
const carrierId = Astro.locals.carrierId!

const today = carrierToday()
const period = periodFromParam(Astro.url.searchParams.get('q'), today)
const periodIso = isoDay(period)
const label = quarterLabel(period)

/** How many blank rows the form offers. A quarter's run is rarely more states than this. */
const BLANK_ROWS = 5

interface VehicleOption {
  id: string
  kind: string
  unit_number: string | null
  vin: string | null
}

interface MileRowRecord {
  id: string
  jurisdiction: string
  miles: number
  vehicle_id: string | null
}

/**
 * The carrier's fleet. Loaded before the POST is dispatched, for the same
 * reason the fuel page does it: RLS on `jurisdiction_miles` checks that
 * carrier_id is mine, NOT that vehicle_id points at a truck of mine, so a
 * crafted POST carrying another carrier's vehicle id passes the policy. Proving
 * the id is in this list is what makes the vehicle_id in the upsert trustworthy.
 */
const { data: vehicleData, error: vehicleError } = await supabase
  .from('vehicles')
  .select('id, kind, unit_number, vin')
  .order('unit_number', { ascending: true })

const allVehicles = (vehicleData ?? []) as VehicleOption[]

/**
 * Every mileage row in this quarter, for every truck.
 *
 * The whole quarter rather than just the selected truck, because the summary
 * below is what tells her which trucks she has not done yet — and a page that
 * only ever shows one truck is how a fleet files a return with one truck's
 * miles on it. `.eq('period_start', …)` is a scope, not a tenancy filter; RLS
 * does the tenancy.
 *
 * Read BEFORE the truck list is narrowed, because the narrowing depends on it.
 */
const { data: mileData, error: mileError } = await supabase
  .from('jurisdiction_miles')
  .select('id, jurisdiction, miles, vehicle_id')
  .eq('period_start', periodIso)
  .order('jurisdiction', { ascending: true })

const allRows = (mileData ?? []) as MileRowRecord[]

/**
 * POWER UNITS ONLY — the same rule the return itself counts by.
 *
 * IFTA is a fuel tax. A trailer has no engine, buys no diesel and can never
 * have miles of its own, so counting trailers here made this screen disagree
 * with the return one click away: /app/ifta counts power units and says "6 of 6
 * trucks have miles entered", while the chart in the rail here counted the two
 * trailers as well and said "6 of 8", with two rows telling the owner to go and
 * find numbers that cannot exist. One fleet, one count, and the count is the
 * return's.
 *
 * A UNIT THAT ALREADY HAS MILES ON THIS QUARTER STAYS ON THE LIST whatever kind
 * it is. Nothing on this screen can create such a row any more, but a row
 * imported or typed before this rule would otherwise be unreachable — not
 * editable, not removable, and still counting on the return. A mile on the
 * return that no screen admits to is the worst kind there is.
 */
const unitsWithMiles = new Set(
  allRows.map((r) => r.vehicle_id).filter((id): id is string => id !== null),
)
const vehicles = allVehicles.filter(
  (v) => v.kind === 'power_unit' || unitsWithMiles.has(v.id),
)

const requestedVehicle = Astro.url.searchParams.get('v') ?? ''
/**
 * Which truck the form is for.
 *
 * Defaults to the first truck rather than making her choose: most carriers here
 * run one or two, and a screen that shows nothing until a dropdown is touched
 * reads as broken. An id in the URL that is not hers falls back to the same
 * default rather than erroring — RLS already means she cannot see it, and the
 * selector below always names the truck being written to.
 */
const vehicle = vehicles.find((v) => v.id === requestedVehicle) ?? vehicles[0] ?? null
/** A `?v=` naming something not on the list above. The GET falls back; a POST must not. */
const wrongVehicle = requestedVehicle !== '' && vehicle?.id !== requestedVehicle

const go = (query: string) =>
  Astro.redirect(
    `/app/ifta/miles?q=${periodIso}${vehicle ? `&v=${vehicle.id}` : ''}${query}`,
    303,
  )
const fail = (message: string) => go(`&error=${encodeURIComponent(message)}`)

const rows = vehicle ? allRows.filter((r) => r.vehicle_id === vehicle.id) : []

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')

  if (intent === 'save_miles') {
    if (!vehicle) return fail('Add a truck first, then enter miles for it.')
    // The form named a unit this screen does not record miles for — a trailer,
    // or a truck that has left the fleet — and `vehicle` has already fallen back
    // to the first one on the list. Saving now would file this quarter's miles
    // against a truck she never picked, silently. Refuse instead.
    if (wrongVehicle) {
      return fail(
        'That unit is not one we record miles for. A trailer has no engine, so it has no miles of its own. Pick a truck and enter the miles again.',
      )
    }
    // The rows already on file could not be read, so this handler cannot tell an
    // edit of an existing jurisdiction from a new one — it would silently ignore
    // every corrected line while reporting the new ones as saved. Refusing the
    // whole save keeps what she typed wrong out of the quarter.
    if (mileError) {
      return fail(`We could not read the miles already on file, so nothing was saved: ${mileError.message}`)
    }

    /**
     * ONE WRITE PER JURISDICTION, keyed by the jurisdiction itself.
     *
     * Two rows on this form naming the same jurisdiction is the failure this Map
     * exists to catch. They would not be added together: both would upsert onto
     * the same unique key and the second would REPLACE the first, so 300 miles
     * typed on one line and 500 on another files as 500 and loses 300 silently.
     * Sent as one array they do not even get that far — Postgres refuses with
     * "ON CONFLICT DO UPDATE command cannot affect row a second time", which is
     * a true sentence about nothing she can see.
     */
    const writes = new Map<string, number>()
    const duplicate = (code: string) =>
      fail(
        `${code} is on this form twice. Two lines for one jurisdiction are not added together: the second line replaces the first. Put the whole quarter's total for ${code} on one line.`,
      )

    // Existing rows first. A BLANK box leaves the stored figure alone; it does
    // not mean zero and it does not mean delete. Clearing a box by accident —
    // a thumb on a phone, a tab through the form — must never be the thing that
    // takes a jurisdiction's miles off the return. Zero is typed on purpose and
    // Remove is a separate button.
    for (const row of rows) {
      const parsed = parseMiles(form.get(`miles_${row.id}`), {
        label: `Miles in ${row.jurisdiction}`,
      })
      if (!parsed.ok) return fail(parsed.message)
      if (parsed.value === null) continue
      // Unchanged rows are skipped rather than rewritten: the upsert would
      // succeed, but it would touch updated_at on rows nobody edited and make
      // "12 jurisdictions saved" the message for a form she only fixed one line
      // of.
      if (parsed.value === row.miles) continue
      if (writes.has(row.jurisdiction)) return duplicate(row.jurisdiction)
      writes.set(row.jurisdiction, parsed.value)
    }

    for (let i = 0; i < BLANK_ROWS; i++) {
      const rawJurisdiction = String(form.get(`new_jurisdiction_${i}`) ?? '').trim()
      const rawMiles = String(form.get(`new_miles_${i}`) ?? '').trim()
      if (rawJurisdiction === '' && rawMiles === '') continue

      // A half-filled line is refused rather than skipped. Skipping it silently
      // drops a jurisdiction she believes she entered, and the miles reappear
      // nowhere — the return is then short by exactly one state.
      if (rawJurisdiction === '') {
        return fail(`One line has miles on it (${rawMiles}) but no jurisdiction. Pick the jurisdiction, or clear the miles.`)
      }
      const jurisdiction = parseJurisdiction(rawJurisdiction, { label: 'Jurisdiction' })
      if (!jurisdiction.ok) return fail(jurisdiction.message)

      const parsed = parseMiles(rawMiles, { label: `Miles in ${jurisdiction.value}` })
      if (!parsed.ok) return fail(parsed.message)
      if (parsed.value === null) {
        return fail(`You picked ${jurisdiction.value} but typed no miles beside it.`)
      }

      if (writes.has(jurisdiction.value)) return duplicate(jurisdiction.value)
      writes.set(jurisdiction.value, parsed.value)
    }

    if (writes.size === 0) return go('&saved=0')

    /**
     * The upsert, onto the constraint the migration created for exactly this.
     *
     * `onConflict` names the columns in the unique constraint — all four of
     * them. Naming fewer would not narrow the match, it would fail to find a
     * constraint at all and come back as "there is no unique or exclusion
     * constraint matching the ON CONFLICT specification".
     *
     * vehicle_id is never NULL in these rows, and that is load-bearing rather
     * than incidental: the column is nullable, and in Postgres NULLs are
     * DISTINCT in a unique constraint, so a row with no truck on it would never
     * conflict with anything. Every save would insert another copy, and the
     * quarter's miles would double, then triple, with no error anywhere. That is
     * why this screen requires a truck and the fuel screen does not — the fuel
     * table has no unique constraint to be defeated.
     */
    const { error } = await supabase.from('jurisdiction_miles').upsert(
      [...writes].map(([jurisdiction, miles]) => ({
        // carrier_id is SET on insert and never filtered on: RLS checks it but
        // does not fill it in, and a row without it fails the WITH CHECK half of
        // the policy.
        carrier_id: carrierId,
        vehicle_id: vehicle.id,
        period_start: periodIso,
        jurisdiction,
        miles,
      })),
      { onConflict: 'carrier_id,vehicle_id,period_start,jurisdiction' },
    )
    if (error) return fail(error.message)
    return go(`&saved=${writes.size}`)
  }

  if (intent === 'remove_miles') {
    const id = String(form.get('row_id') ?? '')
    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) {
      return fail('That jurisdiction is no longer on this quarter.')
    }
    // No .eq('carrier_id', …): RLS makes another carrier's row invisible here,
    // so the worst a crafted id achieves is deleting nothing.
    const { data, error } = await supabase
      .from('jurisdiction_miles')
      .delete()
      .eq('id', id)
      .select('id')
    if (error) return fail(error.message)
    // A DELETE matching nothing is not an error in Postgres, so without this the
    // page reports a cheerful "removed" for a row that is still there.
    if (!data || data.length === 0) return fail('That jurisdiction is no longer on this quarter.')
    return go('&removed=1')
  }

  // An unknown intent is a form from an older deploy. Redirecting rather than
  // falling through is what stops the next refresh replaying the POST.
  return go('')
}

/**
 * Per-truck miles for the quarter, ranked, so the trucks not done yet are
 * visible AND the ones only half done are.
 *
 * The list this replaced answered the first question and not the second: 320
 * miles and 41,208 miles both read as a truck that has been entered, and a trip
 * sheet somebody stopped part-way through files a return that is short without
 * ever looking short. Side by side as bars the half-entered truck is the one
 * obviously out of line with the rest of the fleet.
 *
 * Rows belonging to no truck at all are counted in the coverage note rather
 * than dropped. Nothing on this screen can create one — the upsert always
 * carries a vehicle — but a row imported or inserted by hand with a NULL
 * vehicle_id would otherwise be invisible here while still counting on the
 * return, and a mile on the return that no screen admits to is the worst kind
 * there is.
 *
 * The denominator is `vehicles`, which is power units and anything that already
 * has miles on this quarter — the same count /app/ifta reports the return by.
 * Counting trailers made this chart say "6 of 8 trucks have miles entered" on
 * the same fleet the return called "6 of 6".
 */
const truckChart = truckMilesFigure({
  trucks: vehicles.map((v) => ({
    id: v.id,
    label: vehicleLabel(v),
    href: `/app/ifta/miles?q=${periodIso}&v=${v.id}`,
  })),
  rows: allRows.map((r) => ({ vehicleId: r.vehicle_id, miles: Number(r.miles) })),
  // A FAILED READ IS NOT AN EMPTY QUARTER. Every truck comes back as an unknown
  // rather than as a zero, because a zero here is an accusation and on a failed
  // read the whole fleet would be wearing one.
  unreadable: mileError !== null,
})

/**
 * The quarter's miles per jurisdiction, across the whole fleet.
 *
 * BARS. Never a map, and nothing with a territory or a route on it — this
 * product does not know where a truck is and must never look like it does. Miles
 * by jurisdiction earns its place only because it is literally what the return
 * reports: the codes down the left are the lines on the form.
 *
 * The one this chart exists for is the SMALL one. A jurisdiction with twelve
 * miles is sub-pixel against a fleet that ran fifteen thousand, and "a little"
 * versus "none" is the entire question an auditor is asking — `Bars` floors it
 * at `MIN_VISIBLE_PERCENT` so it draws as a visible mark rather than as nothing.
 *
 * A FAILED READ IS NOT AN EMPTY QUARTER: on `mileError` the figure is not
 * rendered at all, rather than drawn from the zero rows that came back.
 */
const stateChart = jurisdictionMilesBars(
  mileError ? [] : allRows.map((r) => ({ jurisdiction: r.jurisdiction, miles: Number(r.miles) })),
)

/** Rows before the tail collapses. The rail is 20rem; more than this is a wall. */
const STATE_ROWS = 8

/**
 * Trucks with nothing entered, taken off the chart above rather than counted a
 * second time here.
 *
 * Every bar on the state chart is built from the trucks somebody has typed in,
 * so a fleet two trip sheets short is a chart on which EVERY bar is too short at
 * once — which looks exactly like a quiet quarter. That is what `Figure`'s
 * coverage slot is for.
 */
const trucksWaiting = truckChart.items.filter((i) => i.value === null).length

const vehicleTotal = rows.reduce((n, r) => n + Number(r.miles), 0)
const quarterTotal = allRows.reduce((n, r) => n + Number(r.miles), 0)

const quarters = recentQuarters(today, 5)
if (!quarters.some((q) => isoDay(q) === periodIso)) {
  quarters.push(period)
  quarters.sort((a, b) => b.getTime() - a.getTime())
}

const params = Astro.url.searchParams
// Only honoured when the request came from our own 303. See src/lib/flash.ts.
const error =
  flashText(Astro.url, Astro.request) ?? mileError?.message ?? vehicleError?.message ?? null
const removed = params.get('removed') === '1'
// Number() of a hand-typed ?saved=soon is NaN, which renders as the word NaN
// inside an otherwise reassuring green banner.
const savedRaw = Number(params.get('saved'))
const saved = params.has('saved') && Number.isFinite(savedRaw) ? savedRaw : null
const confirmRemove = params.get('confirm') ?? ''

const daysLeft = daysUntil(returnDueOn(period), today)

const card = 'card'
/*
  Every box on this page wears `.field-input` from global.css — 46px tall, a
  border a reader can see, 16px type so iOS does not zoom the page on a tap, and
  the one focus ring the whole app shares.
*/

/**
 * ON A PHONE THE LINES ARE NOT ROWS.
 *
 * The table is 34rem and the window inside this card is 301px, so 243px of
 * every line was behind a sideways scroll — the miles box itself was half off
 * the screen, on the page whose only job is typing miles into it. Below `sm`
 * every cell is a block and the box is full width; from `sm` the same markup is
 * a table again. ONE set of cells, not two, the same way
 * src/components/Documents.astro does it.
 *
 * No `order-*` here and no flex row: the column order already IS what a phone
 * wants — the jurisdiction, then its miles, then Remove.
 */
const cell = 'block py-1 sm:table-cell sm:py-2.5'
/** The miles box: the width of the block on a phone, a 128px column from `sm`. */
const milesBox = 'field-input text-right tabular-nums sm:ml-auto sm:w-32'

const usJurisdictions = IFTA_JURISDICTIONS.filter((j) => j.country === 'US')
const caJurisdictions = IFTA_JURISDICTIONS.filter((j) => j.country === 'CA')

/** A quarter link that keeps the truck selection, so switching quarters is one click. */
const quarterHref = (p: Date) =>
  `/app/ifta/miles?q=${isoDay(p)}${vehicle ? `&v=${vehicle.id}` : ''}`
---

<App
  title={`Jurisdiction miles · ${label}`}
  subtitle="The miles each truck ran in each state and province. The taxable gallons come from these."
>
  {error && <p class="mb-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}
  {
    saved !== null &&
      (saved > 0 ? (
        <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          <span class="tabular-nums">{saved}</span>
          {saved === 1 ? ' jurisdiction saved.' : ' jurisdictions saved.'}
        </p>
      ) : (
        <p class="mb-5 rounded-lg bg-champagne-50 px-4 py-3 text-sm text-brand-700">
          Nothing changed, so nothing was saved.
        </p>
      ))
  }
  {
    removed && (
      <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Jurisdiction removed from this quarter.
      </p>
    )
  }

  {/* 44px targets, 8px apart, and the selected quarter is the app's one
      selected metaphor: a tinted pill plus semibold, with aria-current so the
      colour never carries it alone. */}
  <nav
    aria-label="Pick a quarter"
    class="-mx-4 mb-5 flex items-center gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0"
  >
    {
      quarters.map((q) => {
        const here = isoDay(q) === periodIso
        return (
          <a
            href={quarterHref(q)}
            aria-current={here ? 'page' : undefined}
            class:list={['filter-tab shrink-0 tabular-nums', here && 'is-current']}
          >
            {quarterLabel(q)}
          </a>
        )
      })
    }
    <a href={`/app/ifta?q=${periodIso}`} class="btn btn-tertiary btn-sm ml-auto shrink-0">
      The {label} return →
    </a>
  </nav>

  {
    vehicles.length === 0 ? (
      <div class="rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
        <p class="font-medium">No trucks on file</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          We record miles per truck, per quarter. That is what a jurisdiction asks to see if it
          ever checks the work behind your return. Add the truck first.
        </p>
        <a href="/app/vehicles/new" class="btn btn-primary btn-sm mt-4">
          Add a truck →
        </a>
      </div>
    ) : (
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)]">
        {/* --------------------------------------------------- the entry form */}
        <div class="min-w-0">
          {/* The truck selector is a GET form with its own button rather than a
              select that navigates on change: no JavaScript runs on this page at
              all, and a dropdown that only works with script is a dropdown that
              does nothing on one bar of signal in a yard. */}
          <form method="GET" class={`mb-4 flex flex-wrap items-end gap-3 ${card}`}>
            <input type="hidden" name="q" value={periodIso} />
            <label class="block min-w-0 flex-1">
              <span class="field-label">Truck</span>
              <select name="v" class="field-input mt-1">
                {vehicles.map((v) => (
                  <option value={v.id} selected={vehicle?.id === v.id}>
                    {vehicleLabel(v)}
                  </option>
                ))}
              </select>
            </label>
            <button type="submit" class="btn btn-secondary">Show</button>
            {/* Said once, here, so a missing trailer reads as a rule rather than
                as a bug. The list is trucks and anything that already has miles
                on this quarter. */}
            <p class="field-hint w-full">
              Trucks only. A trailer has no engine, so it has no miles of its own.
            </p>
          </form>

          <form method="POST" class={`space-y-4 ${card}`}>
            {/* A FAILED READ IS NOT AN EMPTY QUARTER. Without this the form
                below shows nothing but blank lines, which reads as "this truck
                has no miles entered" for a truck that may have twelve
                jurisdictions on file. The upsert would correct them rather than
                duplicate them, so the damage is bounded — but she would be
                retyping a quarter she has already done. */}
            {mileError && (
              <p class="rounded-lg bg-red-100 px-4 py-3 text-sm text-red-800">
                We could not read the miles already saved for {label}. The lines below are blank
                whether or not something is saved. Reload before you type.
              </p>
            )}

            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="text-base font-semibold tracking-tight">
                {vehicle ? vehicleLabel(vehicle) : 'No truck'} · {label}
              </h2>
              <span class="text-sm text-ink-500">
                <span class="font-medium tabular-nums">{vehicleTotal.toLocaleString('en-US')}</span>{' '}
                miles on this truck
              </span>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-sm sm:min-w-[34rem]">
                {/* No header line on a phone. Each block says what it is: the
                    jurisdiction names itself and the box is labelled. */}
                <thead class="hidden border-b border-ink-100 text-left text-xs tracking-wide text-ink-700 uppercase sm:table-header-group">
                  <tr>
                    <th class="py-2 pr-4 font-medium">Jurisdiction</th>
                    <th class="px-4 py-2 text-right font-medium">Miles this quarter</th>
                    <th class="py-2 pl-4"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                  {rows.map((row) => (
                    <tr
                      class:list={[
                        'block py-2 sm:table-row sm:py-0',
                        confirmRemove === row.id ? 'bg-red-50/60' : '',
                      ]}
                    >
                      <td class={`${cell} sm:pr-4`}>
                        <span class="font-medium">{row.jurisdiction}</span>
                        <span class="ml-2 text-xs text-ink-700">
                          {jurisdictionName(row.jurisdiction)}
                        </span>
                      </td>
                      <td class={`${cell} sm:px-4 sm:text-right`}>
                        <input
                          type="text"
                          name={`miles_${row.id}`}
                          value={row.miles}
                          inputmode="numeric"
                          aria-label={`Miles in ${row.jurisdiction}`}
                          class={milesBox}
                        />
                      </td>
                      <td class={`${cell} sm:pl-4 sm:text-right sm:whitespace-nowrap`}>
                        {/* Removal is a link then a button, in the URL rather
                            than in a dialog, because a dialog needs script. It
                            is a separate intent from Save: clearing the box
                            above deliberately does NOTHING, so that a box
                            emptied by accident cannot take a jurisdiction off
                            the return. */}
                        {confirmRemove === row.id ? (
                          <span class="flex items-center gap-2 sm:justify-end">
                            {/* Rendered ONLY inside the confirm branch. One
                                hidden row_id per row would post as many values
                                for one name, and `form.get()` returns the first
                                — which is a different row than the one whose
                                button was pressed. Only one row can be
                                confirming at a time, so only one exists. */}
                            <input type="hidden" name="row_id" value={row.id} />
                            {/* The only irreversible control on this row, and the
                                only red one. It keeps the full 44px on every
                                screen — the desktop rule used to shrink it. */}
                            <button
                              type="submit"
                              name="intent"
                              value="remove_miles"
                              class="btn btn-danger btn-sm flex-1 sm:flex-none"
                            >
                              Remove {row.jurisdiction}
                            </button>
                            {/* The way out of a destructive step is never red. */}
                            <a href={quarterHref(period)} class="btn btn-tertiary btn-sm flex-1 sm:flex-none">
                              Keep
                            </a>
                          </span>
                        ) : (
                          /* Below `sm` this sat off the right-hand edge of the
                             row. It is the width of the block there now, and its
                             own width from `sm` — a 44px target either way. */
                          <a
                            href={`${quarterHref(period)}&confirm=${row.id}`}
                            class="btn btn-danger-text btn-sm w-full sm:w-auto"
                          >
                            Remove
                          </a>
                        )}
                      </td>
                    </tr>
                  ))}

                  {/* The blank lines are part of the same table and the same
                      form. A separate "add a jurisdiction" form below would mean
                      one page load per state, and a quarter is commonly six. */}
                  {Array.from({ length: BLANK_ROWS }, (_, i) => (
                    <tr class="block py-2 sm:table-row sm:py-0">
                      <td class={`${cell} sm:pr-4`}>
                        <select
                          name={`new_jurisdiction_${i}`}
                          aria-label="Jurisdiction"
                          class="field-input"
                        >
                          <option value="">—</option>
                          <optgroup label="United States">
                            {usJurisdictions.map((j) => (
                              <option value={j.code}>
                                {j.code} — {j.name}
                              </option>
                            ))}
                          </optgroup>
                          {/* Ten Canadian provinces are IFTA jurisdictions. A
                              US-only list quietly tells a carrier running into
                              BC that those miles are not reportable. */}
                          <optgroup label="Canada">
                            {caJurisdictions.map((j) => (
                              <option value={j.code}>
                                {j.code} — {j.name}
                              </option>
                            ))}
                          </optgroup>
                        </select>
                      </td>
                      <td class={`${cell} sm:px-4 sm:text-right`}>
                        <input
                          type="text"
                          name={`new_miles_${i}`}
                          inputmode="numeric"
                          placeholder="0"
                          aria-label="Miles"
                          class={`mt-1 ${milesBox} sm:mt-0`}
                        />
                      </td>
                      {/* Nothing to remove on a line that is not saved yet, so
                          the cell is a blank line on a phone and is not there. */}
                      <td class="hidden py-2.5 pl-4 sm:table-cell"></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="flex flex-wrap items-center gap-3 border-t border-ink-100 pt-4">
              <button type="submit" name="intent" value="save_miles" class="btn btn-primary">
                Save miles
              </button>
              <span class="flex-1 text-sm text-ink-500">
                Typing a jurisdiction again corrects it. It does not add to it. A box left blank
                stays as it is. Type 0 to set a jurisdiction to nothing.
              </span>
            </div>
          </form>
        </div>

        {/* ------------------------------------------------------- the quarter */}
        <div class="space-y-4">
          <div class={card}>
            <h3 class="text-xs tracking-wide text-ink-700 uppercase">{label} fleet miles</h3>
            <div class="mt-1 text-3xl font-semibold tabular-nums">
              {mileError ? (
                <span class="text-ink-500">—</span>
              ) : (
                quarterTotal.toLocaleString('en-US')
              )}
            </div>
            <p class="mt-2 text-sm text-ink-500">
              {daysLeft < 0 ? (
                <span class="font-medium text-red-700">
                  The {label} return is <span class="tabular-nums">{-daysLeft}</span> days overdue.
                </span>
              ) : (
                <>
                  <span class="tabular-nums">{daysLeft}</span> days until the {label} return is due.
                </>
              )}
            </p>
          </div>

          {/*
            In the rail, never above the form. Below `lg` this column stacks
            UNDER the entry table, which is where a chart belongs on a screen
            whose job is typing: a 200px picture between the owner and the boxes
            he opened the page to fill in is a regression however good it is.

            No `limit` on the bars. The trucks with nothing entered rank last,
            so collapsing a tail here would hide the exact rows this chart is
            for behind a link reading "3 more".
          */}
          <Figure
            title="By truck"
            subtitle={`Miles entered for ${label}, biggest first`}
            coverage={truckChart.coverage}
          >
            <Bars items={truckChart.items} emptyMessage="No trucks on file." />
            {truckChart.takeaway && (
              <p class="mt-3 text-sm text-ink-500">{truckChart.takeaway}</p>
            )}
          </Figure>

          {/*
            The other half of the same rows, and the half the return is actually
            filed on: the form has a line per jurisdiction, not per truck. The
            table on this page only ever shows ONE truck, so nothing on this
            screen added the fleet up by state before.

            Bars, never a map. Not rendered on a failed read, and the tail
            collapses to the return's own table rather than running the rail down
            past the form on a phone.

            The fleet total leads the subtitle: it is the number every bar below
            is a share of, and it is taken from `stateChart.total` — the sum of
            the bars themselves — so the sentence and the shape cannot disagree.
          */}
          {!mileError && stateChart.items.length > 0 && (
            <Figure
              title="By state or province"
              subtitle={`${stateChart.total.toLocaleString('en-US')} miles on file for ${label}. Every truck added up, biggest first.`}
              coverage={
                trucksWaiting > 0
                  ? `${trucksWaiting} ${trucksWaiting === 1 ? 'truck has' : 'trucks have'} no miles entered yet. Every bar here is lower than the real total.`
                  : undefined
              }
              action={{ href: `/app/ifta?q=${periodIso}`, label: 'The return →' }}
            >
              <Bars
                items={stateChart.items}
                limit={STATE_ROWS}
                moreHref={`/app/ifta?q=${periodIso}#jurisdictions`}
              />
              {stateChart.takeaway && (
                <p class="mt-3 text-sm text-ink-500">{stateChart.takeaway}</p>
              )}
            </Figure>
          )}

          <div class={card}>
            <h3 class="text-xs tracking-wide text-ink-700 uppercase">Where this number goes</h3>
            <p class="mt-2 text-sm text-ink-500">
              We apply the fleet's average miles per gallon to these miles. That gives the gallons
              burned in each jurisdiction, and the tax is charged on those gallons. Nobody measures
              the fuel burned in a state. It always comes from these two numbers.
            </p>
          </div>
        </div>
      </div>
    )
  }
</App>
