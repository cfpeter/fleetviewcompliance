---
/**
 * The page a broker or an underwriter opens. No account, no session.
 *
 * The token IS the credential, so everything is arranged so that this page
 * cannot read more than the token allows even if this file is wrong. Content
 * comes from four SECURITY DEFINER functions that each take THE TOKEN AND
 * NOTHING ELSE — scope lives in their WHERE clauses, in the database. A function
 * taking (token, driver_id) could be pointed at any driver by guessing ids;
 * these cannot be pointed anywhere at all.
 *
 * See supabase/migrations/0013_share_links.sql and 0014_share_content.sql, and
 * tests/share-scope.test.ts which proves the scoping as the real `anon` role.
 */
import Donut from '../../components/charts/Donut.astro'
import Figure from '../../components/charts/Figure.astro'
import Ring from '../../components/charts/Ring.astro'
import Public from '../../layouts/Public.astro'
import { dqRing } from '../../lib/charts/dq-rings.ts'
import {
  buildHealth,
  donutSlices,
  healthHeadline,
  healthMath,
  type HealthKey,
  missingLine,
} from '../../lib/charts/health.ts'
import { TONES } from '../../lib/charts/tones.ts'
import { lookupAuthority, lookupCarrier } from '../../lib/fmcsa.ts'
import {
  assembleDqf,
  driverFileAnchors,
  gaps,
  holdsSpe,
  stateWord,
} from '../../lib/proof/dqf.ts'
import { evaluate, type EvaluationSubject } from '../../lib/rules/index.ts'
import { anonClient } from '../../lib/supabase/server.ts'

const { token = '' } = Astro.params
const db = anonClient()

// A driver's qualification record, or a carrier's dated checks, behind a
// secret link. Public in the sense of "no sign-in", not in the sense of
// "cacheable": a shared cache between here and the broker's browser must not
// keep a copy, and a revoked link must stop showing the page at once rather
// than for as long as some proxy remembers it. The /app middleware sets this
// for signed-in pages; this route is outside /app, so it says so itself.
Astro.response.headers.set('Cache-Control', 'private, no-store')

const { data: resolved } = await db.rpc('resolve_share_token', { p_token: token })
const link = (Array.isArray(resolved) ? resolved[0] : resolved) as
  | { carrier_id: string; scope: string; subject_id: string | null; expires_at: string }
  | undefined

// A dead link says one thing, and only one thing.
//
// It deliberately does NOT distinguish "never existed" from "revoked" from
// "expired". That difference is information about the carrier — that they once
// shared something and then withdrew it — and whoever is holding a dead link has
// not earned it.
if (!link) Astro.response.status = 404

const observedAt = new Date()

/**
 * `phy_state` is READ HERE AND NEVER PRINTED.
 *
 * share_carrier has always returned it; this page has never shown it and still
 * does not. It is pulled onto the type for one job: the rule engine's state gate
 * (see nexusExcludes in src/lib/rules/index.ts) needs to know which state's
 * rules can reach this carrier, and without it every California rule would be
 * counted against a carrier in Texas — a ring full of grey arcs for obligations
 * that are not theirs. src/lib/deadlines.ts feeds the owner's own dashboard from
 * exactly this field, which is what makes the two agree.
 */
let carrier:
  | {
      legal_name?: string
      dba_name?: string
      dot_number?: string
      phy_state?: string
      /**
       * The three facts that decide which rules apply — read here and never
       * printed, for the same job as `phy_state`. share_carrier returns them
       * since 0031 so that this page and the owner's dashboard build their rule
       * context from the same columns. NULL arrives as null and is passed on
       * as undefined, which the engine reads as UNKNOWN and keeps tracking.
       */
      carrier_operation?: string | null
      for_hire?: boolean | null
      hazmat?: boolean | null
    }
  | undefined
/**
 * `hired_on` IS ON THIS TYPE BECAUSE IT IS LOAD-BEARING, NOT FOR DISPLAY.
 *
 * `share_driver` has returned it since 0026 and this page read it into nothing.
 * Five federal rules hang off the hire date — see `driverFileAnchors` — so
 * without it (b)(1), (b)(2) and (b)(3) printed "Not known" on a file whose
 * owner's own binder printed "On file". It is projected into an anchor below
 * and never shown: when a man started is his business, not the broker's.
 */
let driver:
  | {
      id: string
      first_name: string
      last_name: string
      cdl_number?: string
      cdl_state?: string
      cdl_expires_on?: string
      hired_on?: string
    }
  | undefined
/**
 * The document KINDS held against this driver — 0041's share_documents.
 *
 * UNDEFINED IS LOAD-BEARING AND IS NOT AN EMPTY SET. Undefined means this page
 * has not looked at the paper, and `assembleDqf` prints the plain word for it;
 * an empty set means it looked and found none, and every typed date then reads
 * "Date recorded, no document". A failed RPC must land on the first of those,
 * or a database hiccup turns this page into an accusation.
 */
let uploadedKinds: ReadonlySet<string> | undefined
let counts: { active_drivers: number; power_units: number; trailers: number } | undefined
let anchorRows: { subject_type: string; subject_id: string | null; anchor_key: string; occurred_on: string }[] = []
let authority: Awaited<ReturnType<typeof lookupAuthority>> | undefined

if (link) {
  // Recorded separately from resolution, so a failed render cannot inflate the
  // count. The owner's question is "did they open it", not "did it work".
  await db.rpc('record_share_view', { p_token: token }).then(undefined, () => undefined)

  const [c, a] = await Promise.all([
    db.rpc('share_carrier', { p_token: token }),
    db.rpc('share_anchors', { p_token: token }),
  ])
  carrier = (Array.isArray(c.data) ? c.data[0] : c.data) ?? undefined
  anchorRows = (a.data ?? []) as typeof anchorRows

  if (link.scope === 'driver_file') {
    const [d, docs] = await Promise.all([
      db.rpc('share_driver', { p_token: token }),
      // Kinds and nothing else, scoped in the function's own WHERE clause. This
      // is what lets the item list say "Date recorded, no document" where a date
      // was typed in and the card was never scanned — the first thing the person
      // reading this page would test, and the thing it used to call "On file".
      db.rpc('share_documents', { p_token: token }),
    ])
    driver = (Array.isArray(d.data) ? d.data[0] : d.data) ?? undefined
    uploadedKinds = docs.error
      ? undefined
      : new Set(((docs.data ?? []) as { kind: string }[]).map((r) => r.kind))
  } else {
    const f = await db.rpc('share_fleet_counts', { p_token: token })
    counts = (Array.isArray(f.data) ? f.data[0] : f.data) ?? undefined

    // The outward link is what makes this page credible, so the federal record
    // is fetched live rather than repeated from our own copy. Failure-tolerant:
    // a slow FMCSA must not stop the page rendering.
    if (carrier?.dot_number) {
      authority = await lookupAuthority(carrier.dot_number).catch(() => ({
        state: 'error' as const,
        message: 'unreachable',
      }))
    }
  }
}

const parseDate = (v?: string) => {
  if (!v) return undefined
  const [y, m, d] = v.split('-').map(Number)
  return y && m && d ? new Date(Date.UTC(y, m - 1, d)) : undefined
}

const anchorsFor = (type: string, id: string | null) => {
  const out: Record<string, Date | undefined> = {}
  for (const r of anchorRows) {
    if (r.subject_type !== type) continue
    if (type !== 'carrier' && r.subject_id !== id) continue
    const d = parseDate(r.occurred_on)
    if (d) out[r.anchor_key] = d
  }
  return out
}

/**
 * Which half of the catalogue applies, on every subject this page evaluates —
 * exactly as src/lib/deadlines.ts spreads the same three onto every subject
 * for the owner. The driver file needs them as much as the summary does:
 * `interstateDriver` decides whether the federal or the California medical
 * rule reports on a card, and it reads `carrierOperation` off the DRIVER.
 */
const operation = {
  carrierOperation: carrier?.carrier_operation ?? undefined,
  forHire: carrier?.for_hire ?? undefined,
  hazmat: carrier?.hazmat ?? undefined,
}

let dqfItems: ReturnType<typeof assembleDqf> = []

if (link?.scope === 'driver_file' && driver) {
  // The anchors the owner's own screens are scored from, built by the same
  // function for the same reason — src/lib/deadlines.ts calls it too. The hire
  // date is not a compliance anchor; it is a column on the driver row, and a
  // file scored without it reports three gaps that are not there.
  const a = driverFileAnchors(anchorsFor('driver', driver.id), {
    hired_on: parseDate(driver.hired_on),
    cdl_expires_on: parseDate(driver.cdl_expires_on),
  })

  const subject: EvaluationSubject = {
    type: 'driver',
    id: driver.id,
    label: `${driver.first_name} ${driver.last_name}`.trim(),
    context: {
      cdl: Boolean(driver.cdl_number),
      registrationState: carrier?.phy_state ?? undefined,
      ...operation,
    },
    anchors: a,
  }
  const items = evaluate([subject], observedAt).filter((i) => i.subjectId === driver!.id)

  dqfItems = assembleDqf({
    items,
    driver: { cdl: Boolean(driver.cdl_number), spe: holdsSpe(items) },
    uploadedKinds,
  })
}

/**
 * The driver file drawn as a ring. Same eight items, same states, no new facts.
 *
 * `dqRing` takes `assembleDqf`'s own output and turns counts into arc lengths —
 * it is not allowed to look at anything the printed binder below did not already
 * decide, which is the only reason a shape is safe to put on this page. A ring
 * reading 8/8 above a list showing a gap would be a false assurance printed on
 * the exact document somebody asks for when they are checking up on you.
 *
 * It replaces the one-line summary that used to sit here. Two statements of the
 * same eight numbers is one too many, and the ring's legend prints a split the
 * line could not: "no date" separated out from "to fix", grey from red.
 */
const ring = dqfItems.length > 0 ? dqRing(dqfItems, observedAt) : undefined

/**
 * WHAT THE CARRIER FILES FOR ITSELF, in the four standings, for the ring a
 * broker sees first.
 *
 * WHAT IT COUNTS AND WHAT IT CANNOT. `share_anchors` returns carrier-level
 * anchors and nothing else for a carrier_summary token — that scope is in the
 * database, in the function's WHERE clause, and it is the right scope. So this
 * ring is the company's own filings: the biennial update, the annual
 * registration, the retention clocks, the state permits. It is NOT the drivers
 * and it is NOT the trucks, and a reader who takes it for the whole fleet has
 * read it wrong. That sentence is attached to the figure, not left to a
 * footnote, because a shape is taken in before any prose on the page is.
 *
 * WHY IT AGREES WITH THE OWNER'S OWN SCREEN. Same engine, same anchors, same
 * `registrationState`, the same `carrierOperation` / `forHire` / `hazmat`
 * (share_carrier returns all three since 0031), and no `lastDone` on either
 * side — see src/lib/deadlines.ts. Before 0031 this page could not see the
 * operation facts at all, and the review of 2026-09-18 caught the result: a
 * broker was told an intrastate private carrier was "missing 12 dates out of
 * 13", most of them for filings it does not owe.
 *
 * `buildHealth` decides the buckets; nothing here does. Grey is its own arc and
 * its own number, it is never folded into green, and the count in the hole is
 * red + grey + amber, which is the whole coloured part of the ring.
 */
const health =
  link?.scope === 'carrier_summary'
    ? buildHealth(
        evaluate(
          [
            {
              type: 'carrier',
              id: link.carrier_id,
              label: carrier?.legal_name ?? 'This carrier',
              context: {
                dotNumber: carrier?.dot_number ?? undefined,
                registrationState: carrier?.phy_state ?? undefined,
                ...operation,
              },
              anchors: anchorsFor('carrier', link.carrier_id),
            } satisfies EvaluationSubject,
          ],
          observedAt,
        ).map((i) => ({ standing: i.status.standing, daysUntil: i.daysUntil })),
      )
    : undefined

/**
 * The four counts beside the ring, which are the ring's legend.
 *
 * Plain text, never links: the reader has no account here and there is nothing
 * to open. Same four colours, same order and same words as the owner's
 * dashboard, so an owner and a broker looking at the same carrier are reading
 * one vocabulary.
 */
const HEALTH_TILE: Record<HealthKey, { box: string; label: string; count: string }> = {
  overdue: { box: 'border-red-200 bg-red-50/40', label: 'text-red-700', count: 'text-red-700' },
  unknown: { box: 'border-ink-200 bg-ink-50', label: 'text-ink-700', count: 'text-ink-900' },
  soon: { box: 'border-amber-200 bg-amber-50/40', label: 'text-amber-800', count: 'text-amber-800' },
  ontrack: {
    box: 'border-emerald-200 bg-emerald-50/40',
    label: 'text-emerald-800',
    count: 'text-emerald-800',
  },
}

/**
 * The addition, printed under the ring.
 *
 * The number in the hole is the one thing on this page a broker will quote back
 * at the carrier down the phone, so it is never allowed to stand on its own. It
 * is 4 overdue + 5 due in 45 days = 9, in the same words and the same order as
 * the four boxes beside it, and then the missing dates and the on-track items
 * are added back on to reach the total — so a reader can see that the number is
 * smaller than the coloured part of the ring, and why, rather than working it
 * out later and deciding this page shades the truth.
 *
 * It is `healthMath` from src/lib/charts/health.ts, the SAME function and the
 * same words the carrier's own dashboard prints. A broker on the phone and an
 * owner at his desk are reading one sentence about one carrier.
 */
const healthArithmetic = health ? healthMath(health) : undefined

/**
 * The grey count in plain words, under the ring and above the arithmetic.
 *
 * A missing date is NOT counted in the number in the hole — it is not a
 * deadline in trouble, it is a date nobody has given us — and the whole risk of
 * taking it out of that number is that it becomes quiet. So it is said here, in
 * a sentence, in the one wording a broker cannot misread: not on file is not
 * the same as OK. The grey box beside the ring carries the same count, and the
 * caveat under the figure says it a third time.
 */
const healthMissing = health ? missingLine(health, 'visitor') : null

const healthCoverage = !health
  ? undefined
  : [
      'This is what the company files for itself. Every driver and every truck has separate dates. They are not counted here.',
      'Grey means we hold no date for that item. Grey is not a pass, and grey is not counted as needing attention. It is counted on its own.',
      'These are dates the carrier gave us. Nobody here has looked at a document.',
      health.unschedulable > 0
        ? `${health.unschedulable} more duties have no fixed date anyone can work out. They are not in the count.`
        : '',
    ].filter(Boolean)

const longDate = (d?: Date) =>
  d ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '—'

/**
 * The clock beside the date, in UTC.
 *
 * `observedAt` is the moment THIS request was served, so the timestamp is the
 * page's own freshness and not a fact about the carrier: the page is built again
 * from the database every time somebody opens it. That is the difference between
 * this and the PDF a broker usually gets, and it is worth one line to say so.
 * UTC because every date in the rule engine is a UTC midnight and two zones on
 * one sheet is how a reader ends up a day out.
 */
const clockUtc = (d: Date) =>
  d.toLocaleTimeString('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'UTC',
  })

const saferUrl = carrier?.dot_number
  ? `https://safer.fmcsa.dot.gov/query.asp?searchtype=ANY&query_type=queryCarrierSnapshot&query_param=USDOT&query_string=${encodeURIComponent(carrier.dot_number)}`
  : null

const driverName = driver ? `${driver.first_name} ${driver.last_name}`.trim() : ''
const outstanding = gaps(dqfItems)
const title = link ? (driver ? `Driver record — ${driverName}` : carrier?.legal_name ?? 'Carrier record') : 'Link not valid'
---

<Public title={title} noindex>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    {
      !link ? (
        <div class="rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
          <p class="font-medium">This link is not valid</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
            It may never have existed, or it may no longer be in use. Ask whoever sent it for a
            current one.
          </p>
        </div>
      ) : (
        <>
          {/*
            There was a Print button here, and one inline script at the bottom of
            the file to make it work. Both are gone. This is a page served to
            strangers and it now runs no JavaScript at all — see the note at the
            top of layouts/Public.astro, which is the rule the rest of the public
            site already keeps. The print stylesheet below is untouched, so the
            reader's own Print command still produces the same clean sheet; only
            the button that called it has to go, because nothing but a script can
            open that dialog.
          */}
          <p class="mb-5 text-sm text-ink-500" data-screen-only>
            To keep a copy, use Print in your browser and choose Save as PDF.
          </p>

          <article class="rounded-xl border border-ink-100 bg-white p-6 sm:p-8" id="sheet">
            <header class="border-b border-ink-100 pb-5">
              <p class="text-xs font-medium tracking-widest text-brand-600 uppercase">
                Shared record
              </p>
              <h1 class="mt-2 text-2xl font-semibold tracking-tight">{carrier?.legal_name}</h1>
              {carrier?.dba_name && (
                <p class="mt-1 text-sm text-ink-500">Doing business as {carrier.dba_name}</p>
              )}
              <p class="mt-1 text-sm text-ink-500 tabular-nums">
                USDOT {carrier?.dot_number ?? '—'}
                {driver && <span> · {driverName}</span>}
              </p>
              {/*
                The timestamp is the point of a link rather than a PDF, so it
                says the time as well as the date and then says what that means
                in one sentence. A PDF a broker was emailed in March is a
                statement about March that still looks current in September; this
                sheet is read out of the database at the moment it is opened, and
                it is worth one line to say which of the two he is holding.
              */}
              <p class="mt-4 text-sm font-medium tabular-nums">
                Last updated {longDate(observedAt)} at {clockUtc(observedAt)} UTC
              </p>
              <p class="mt-1 text-xs text-ink-700">
                This page is read from the carrier's records every time it is opened. It is not a
                copy saved on a date.
              </p>
            </header>

            {/*
              THE PAGE OPENS WITH THE SHAPE.

              A broker reading this has one question before he has any others,
              and it is answered by a proportion rather than by a list: how much
              of this is a problem. Everything below is the evidence for the
              shape, and it is all still here — the figure carries one number and
              the four boxes beside it carry the parts, so nothing on this page
              is a number a reader cannot take apart.
            */}
            {health &&
              (health.total === 0 ? (
                <p class="mt-6 rounded-lg bg-ink-50 px-4 py-3 text-sm text-ink-700">
                  This carrier has no dated company filings on record with us yet. Read that as
                  "we hold nothing", not as "there is nothing to hold".
                </p>
              ) : (
                <Figure
                  title={healthHeadline(health)}
                  subtitle={`Out of ${health.total} we track for this company.`}
                  coverage={healthCoverage}
                  class="mt-6"
                >
                  {/*
                    Stacked on a phone, side by side from `sm`. The dashboard
                    puts this row beside its ring at every width and can afford
                    to: this figure sits inside a bordered sheet inside the
                    section's own padding, which takes about 120px off a 375px
                    screen before anything is drawn. Four boxes sharing what is
                    left put "Missing a date" on three lines. A full-width box
                    per line costs vertical space on a page that is read once.
                  */}
                  <div
                    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6"
                    data-block
                  >
                    <Donut
                      slices={donutSlices(health)}
                      centre={health.needsAttention}
                      centreNote={`of ${health.total}`}
                      centreTone={
                        /* Green ONLY when nothing at all is outstanding. A zero
                           in the hole over a ring of grey arcs would read as a
                           clean bill of health on the one page this carrier is
                           judged by, at the largest type size on it. */
                        health.needsAttention === 0 && health.missing === 0 ? 'clear' : 'attention'
                      }
                      class="self-center sm:self-auto"
                    />

                    <ul class="grid min-w-0 flex-1 gap-2 sm:grid-cols-2 sm:gap-3">
                      {health.buckets.map((b) => (
                        <li
                          class:list={[
                            'flex items-center gap-2 rounded-lg border px-2.5 py-2',
                            HEALTH_TILE[b.key].box,
                          ]}
                        >
                          <span
                            class:list={[
                              'min-w-8 shrink-0 text-right text-xl leading-none font-semibold tabular-nums sm:text-2xl',
                              HEALTH_TILE[b.key].count,
                            ]}
                          >
                            {b.count}
                          </span>
                          <span class="flex min-w-0 flex-1 items-center gap-1.5">
                            <span
                              class:list={['h-2 w-2 shrink-0 rounded-full', TONES[b.tone].swatch]}
                              aria-hidden="true"
                            />
                            <span
                              class:list={['block text-xs leading-tight', HEALTH_TILE[b.key].label]}
                            >
                              {b.label}
                            </span>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/*
                    The grey count in words, then the addition. Same two
                    sentences, same order, same wording as the carrier's own
                    dashboard — one built by `missingLine`, one by `healthMath`,
                    both in src/lib/charts/health.ts.
                  */}
                  {healthMissing && (
                    <p class="mt-4 rounded-lg border border-ink-200 bg-ink-50 px-4 py-3 text-sm tabular-nums text-ink-700">
                      {healthMissing}
                    </p>
                  )}
                  <p class="mt-3 text-sm tabular-nums text-ink-700">{healthArithmetic}</p>
                </Figure>
              ))}

            {/*
              The same opening for a driver file: the binder below drawn as one
              shape, with its own four numbers printed beside it.
            */}
            {ring && (
              <Figure
                title={
                  ring.attention === 0
                    ? `All ${ring.total} items were on file`
                    : `${ring.attention} of ${ring.total} items need attention`
                }
                subtitle="49 CFR 391.51(b) lists eight items. This is what the carrier holds for each one."
                coverage={[
                  'Grey means we hold no date for that item. Grey is not a pass.',
                  'These are the records this carrier keeps. Nobody here has looked at a document.',
                ]}
                class="mt-6"
              >
                <div data-block>
                  <Ring ring={ring} size={76} centre legend />
                </div>
              </Figure>
            )}

            {/* Check us. The outward link is what makes this page worth reading.

                It is a control, so it gets a control's target rather than
                being a run of underlined words inside a sentence: on its own
                line, 44px tall, and the sentence above it says why to press
                it. */}
            {saferUrl && (
              <div class="mt-5 rounded-lg bg-champagne-50 px-4 py-3 text-sm">
                <p>Do not take our word for any of this.</p>
                <a
                  href={saferUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link mt-1 inline-flex min-h-11 items-center font-medium"
                >
                  Look this carrier up on FMCSA's public SAFER record →
                </a>
              </div>
            )}

            {link.scope === 'carrier_summary' && (
              <section class="mt-6" data-block>
                <h2 class="text-lg font-semibold tracking-tight">Fleet</h2>
                <dl class="mt-3 grid gap-4 sm:grid-cols-3">
                  <div class="rounded-xl border border-ink-100 p-4">
                    <dt class="text-xs tracking-wide text-ink-700 uppercase">Drivers</dt>
                    <dd class="mt-1 text-2xl font-semibold tabular-nums">
                      {counts?.active_drivers ?? '—'}
                    </dd>
                  </div>
                  <div class="rounded-xl border border-ink-100 p-4">
                    <dt class="text-xs tracking-wide text-ink-700 uppercase">Power units</dt>
                    <dd class="mt-1 text-2xl font-semibold tabular-nums">
                      {counts?.power_units ?? '—'}
                    </dd>
                  </div>
                  <div class="rounded-xl border border-ink-100 p-4">
                    <dt class="text-xs tracking-wide text-ink-700 uppercase">Trailers</dt>
                    <dd class="mt-1 text-2xl font-semibold tabular-nums">
                      {counts?.trailers ?? '—'}
                    </dd>
                  </div>
                </dl>

                <h2 class="mt-8 text-lg font-semibold tracking-tight">
                  Operating authority, from the federal record
                </h2>
                {authority?.state === 'rows' ? (
                  <ul class="mt-3 space-y-2 text-sm">
                    {authority.rows.map((r) => (
                      <li class="flex flex-wrap items-center gap-2 rounded-lg border border-ink-100 px-4 py-3">
                        <span class="font-medium tabular-nums">{r.docket_number}</span>
                        <span class="text-ink-700">{r.op_auth_type}</span>
                        {/* The app's one badge construction, so this reads like
                            every other status word in the product. */}
                        <span
                          class:list={[
                            'badge',
                            r.op_auth_status === 'Active' ? 'badge-success' : 'badge-warning',
                          ]}
                        >
                          {r.op_auth_status}
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : authority?.state === 'empty' ? (
                  <p class="mt-3 rounded-lg bg-ink-50 px-4 py-3 text-sm text-ink-700">
                    No authority record came back for this USDOT number.{' '}
                    <strong>That is not the same as having none</strong> — the federal authority
                    file does not cover every carrier, and an intrastate-only carrier never needed
                    one. Read it as "we did not find one", not as "there is none".
                  </p>
                ) : (
                  <p class="mt-3 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
                    We could not reach the federal authority file just now, so nothing here has
                    been checked against it — including anything that might look reassuring. Use
                    the SAFER link above.
                  </p>
                )}
              </section>
            )}

            {link.scope === 'driver_file' && (
              <>
                {/* The line that used to be here printed three of these numbers
                    in a row of grey text. The ring above prints four of them,
                    with "no date" pulled out of "needing attention" and given
                    its own colour, and both come from `summarise`. */}
                <section class="mt-6" data-block>
                  <h2 class="text-lg font-semibold tracking-tight">What needs attention</h2>
                  {outstanding.length === 0 ? (
                    <p class="mt-2 rounded-lg bg-ink-50 px-4 py-3 text-sm">
                      Every item below was on file on the date above. That is a statement about
                      this carrier's records on that date and nothing more — no document in it has
                      been examined by anyone here.
                    </p>
                  ) : (
                    <ol class="mt-3 space-y-2">
                      {outstanding.map((i) => (
                        <li class="rounded-lg border border-red-200 bg-red-50/40 px-4 py-3 text-sm">
                          <span class="font-medium">
                            {i.paragraph} {i.title}
                          </span>
                          <span class="ml-2 text-ink-700">— {stateWord(i)}</span>
                        </li>
                      ))}
                    </ol>
                  )}
                </section>

                <section class="mt-8">
                  <h2 class="text-lg font-semibold tracking-tight">
                    Driver qualification file, in 49 CFR 391.51(b) order
                  </h2>
                  {/* All eight are listed, including the ones this driver is not
                      expected to hold, and they say so in place of a state. A
                      document that quietly drops two of the statutory eight is
                      one an auditor cannot check against the statute — and a
                      row reading "Not on file" beside a ring that does not
                      count it is worse still. Same three-way as the owner's
                      printed binder, word for word. */}
                  <div class="mt-3 divide-y divide-ink-100 border-t border-ink-100">
                    {dqfItems.map((i) => (
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3" data-block>
                        <span class="font-mono text-sm text-ink-500 tabular-nums">
                          {i.paragraph}
                        </span>
                        <span class="flex-1 font-medium">{i.title}</span>
                        <span class="text-sm text-ink-500">
                          {i.notApplicable ? 'Does not apply' : stateWord(i)}
                        </span>
                        <div class="w-full text-xs text-ink-700">{i.citation}</div>
                        {i.notApplicable && (
                          <div class="w-full text-xs text-ink-700">{i.notApplicable}</div>
                        )}
                      </div>
                    ))}
                  </div>
                </section>
              </>
            )}

            <footer class="mt-8 border-t border-ink-100 pt-5 text-xs text-ink-700">
              <p>
                This is a record of what this carrier holds and what was observed at the time
                shown above. It is not a certification of compliance, and it is not a statement
                that any document in it is genuine, current, or sufficient.
              </p>
              <p class="mt-2">
                FleetView Compliance is not affiliated with FMCSA, the DOT, or any government agency.
              </p>
            </footer>
          </article>
        </>
      )
    }
  </section>
</Public>

<style is:global>
  @media print {
    @page {
      margin: 18mm 14mm;
    }
    body > header,
    footer.mt-20,
    [data-screen-only] {
      display: none !important;
    }
    #sheet {
      border: 0;
      padding: 0;
    }
    [data-block] {
      break-inside: avoid;
    }
  }
</style>
